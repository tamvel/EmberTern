<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EmberTern.LicenseManager.ViewModels"
        x:Class="EmberTern.LicenseManager.Views.StorageWindow"
        x:DataType="vm:StorageViewModel"
        Title="Storage"
        Width="760" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">

  <!-- ⭐⭐ BACKUP AND RESTORE ARE TWO TASKS, AND THE WINDOW IS SHAPED LIKE THAT.

       They used to share one scrolling form, so an operator reading about restore had a backup
       passphrase field above them and a restore passphrase field below, and the footer carried five
       actions of two different kinds. ⛔ Two tasks in one form is not a spacing problem — no amount of
       gutter makes "which of these fields belongs to what I am about to do" answerable.

       ⭐ The switch is `Border.view-switch` + `Button.view-tab`, the SAME pattern the main window's
       Customers/Licences switch uses, and for the reason §40.2 recorded: `ControlStyles.axaml` (where
       EmberTern's real `TabItem` variants live) is not linkable into this application, so a `TabControl`
       here would fall back to Fluent's own `TabItem` — a fresh set of normal / hover / selected /
       disabled / focus decisions to repin, introduced for a two-item switch.

       ⭐ Each task ends in exactly ONE primary action, and only its own is visible. That is what keeps
       the footer from ever again being a strip of five competing buttons. -->
  <Grid RowDefinitions="Auto,Auto,Auto,Auto">

    <!-- Header ─────────────────────────────────────────────────────────────────────────────────── -->
    <!-- ⚠ The two TOOL actions live up here, away from the task footers, because they belong to
         neither task: an export is not a backup (it is unencrypted, and the body says so) and opening a
         folder changes nothing at all. ⛔ They are `flat` while the task actions are `primary`, so they
         cannot be mistaken for the thing the operator came to do. -->
    <Border Grid.Row="0" Classes="dialog-header">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{DynamicResource Space.Md}">
        <TextBlock Grid.Column="0" Classes="h1" VerticalAlignment="Center" Text="Storage" />
        <Button Grid.Column="2" Classes="flat" Name="ExportJsonl" Content="Export JSONL…"
                VerticalAlignment="Center"
                ToolTip.Tip="A readable, UNENCRYPTED copy of every row. A diagnostic escape hatch, not a backup."
                Command="{Binding ExportJsonlCommand}" />
        <Button Grid.Column="3" Classes="flat" Name="OpenDataFolder" Content="Open data folder"
                VerticalAlignment="Center"
                Command="{Binding OpenDataFolderCommand}" />
      </Grid>
    </Border>

    <!-- Task switch ────────────────────────────────────────────────────────────────────────────── -->
    <Border Grid.Row="1" Classes="view-switch">
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.Xs}">
        <Button Classes="view-tab" Name="BackupTab" Content="Backup"
                Classes.active="{Binding IsBackupTab}"
                Command="{Binding ShowBackupCommand}" />
        <Button Classes="view-tab" Name="RestoreTab" Content="Restore"
                Classes.active="{Binding IsRestoreTab}"
                Command="{Binding ShowRestoreCommand}" />
      </StackPanel>
    </Border>

    <!-- Body ───────────────────────────────────────────────────────────────────────────────────── -->
    <!-- ⛔ No StackPanel `Spacing` in either form: every gap is owned by the element above it, through a
         role, so a caption never sits as far from its own field as two fields sit from each other. -->
    <Border Grid.Row="2" Classes="dialog-body">
      <StackPanel>

        <!-- ══ BACKUP ═══════════════════════════════════════════════════════════════════════════ -->
        <StackPanel Name="BackupForm" IsVisible="{Binding IsBackupTab}">

          <TextBlock Classes="field-label" Text="Register of record" />
          <SelectableTextBlock Name="RegisterPathText" Classes="mono" TextWrapping="Wrap"
                               Margin="{DynamicResource Margin.FieldGap}"
                               Text="{Binding RegisterPath}" />

          <!-- ⛔ Shown so the operator knows the keystore is a SEPARATE thing to look after. It is not in
               any backup this window takes — §12.3 keeps "back up the register" and "back up the key" as
               two operations with two risk profiles, and §24.2 forbids the private key from travelling
               in a backup at all. -->
          <TextBlock Classes="field-label"
                     Text="Signing keystore — a separate file, NOT included in a backup" />
          <SelectableTextBlock Name="KeyStorePathText" Classes="mono" TextWrapping="Wrap"
                               Margin="{DynamicResource Margin.FieldGap}"
                               Text="{Binding KeyStorePath}" />

          <TextBlock Classes="field-label" Text="What a backup will carry" />
          <TextBlock Name="BackupContentsText" TextWrapping="Wrap"
                     Margin="{DynamicResource Margin.SectionGap}"
                     Text="{Binding BackupContents}" />

          <TextBlock Classes="section" Text="Encrypted backup" />
          <TextBlock TextWrapping="Wrap" Margin="{DynamicResource Margin.SectionGap}"
                     Text="The whole register — customers, licences, every artifact ever issued, the current-artifact pointers and the complete audit log — encrypted with AES-256-GCM under a passphrase of its own, and verified row for row against the live register before it is written." />

          <!-- ⭐ D‑1 said in the field's own caption: this is the BACKUP's secret, and the application
               never reaches for the keystore's. Typing the same words is the operator's choice. -->
          <TextBlock Classes="field-label" Text="Backup passphrase — its own secret, not the keystore's" />
          <TextBox Name="BackupPassphraseBox" PasswordChar="•" Text="{Binding BackupPassphrase}" />

          <TextBlock Classes="field-label" Text="Backup passphrase again" />
          <TextBox Name="BackupPassphraseConfirmBox" PasswordChar="•"
                   Text="{Binding BackupPassphraseConfirmation}" />

        </StackPanel>

        <!-- ══ RESTORE ══════════════════════════════════════════════════════════════════════════ -->
        <StackPanel Name="RestoreForm" IsVisible="{Binding IsRestoreTab}">

          <TextBlock Classes="field-label" Text="Passphrase of the backup being restored" />
          <TextBox Name="RestorePassphraseBox" PasswordChar="•"
                   Margin="{DynamicResource Margin.FieldGap}"
                   Text="{Binding RestorePassphrase}" />

          <!-- ⭐ A picker rather than two buttons, so there is ONE Restore action and the paragraph below
               describes the thing that will actually happen. Two buttons would force the text to explain
               both at once, which is how the previous layout let the consequential one go unread. -->
          <TextBlock Classes="field-label" Text="What this Restore will do" />
          <ComboBox Name="RestoreMode" HorizontalAlignment="Stretch"
                    Margin="{DynamicResource Margin.FieldGap}"
                    ItemsSource="{Binding RestoreModes}"
                    SelectedItem="{Binding SelectedRestoreMode}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:RestoreModeOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <!-- ⚠ The stripe follows the CHOICE: warning while the picked mode replaces the working
               register, neutral while it cannot touch it. ⛔ The sentence describes the rule; it is not
               what enforces it — RestoreWorkflow is, by preserving and by verifying twice. -->
          <Border Classes="message"
                  Classes.warning="{Binding IsReplacingActiveRegister}"
                  Classes.info="{Binding !IsReplacingActiveRegister}">
            <TextBlock Name="RestoreConsequenceText" TextWrapping="Wrap"
                       Text="{Binding RestoreConsequence}" />
          </Border>

        </StackPanel>

        <!-- ⭐ ONE message surface for both tasks, and the LAST child: the body band's padding is what
             separates it from the footer, so it carries no bottom margin of its own. -->
        <Border Classes="message" Classes.info="{Binding IsInfo}" Classes.success="{Binding IsSuccess}"
                Classes.warning="{Binding IsWarning}" Classes.error="{Binding IsError}"
                Margin="{DynamicResource Margin.SectionGap}"
                IsVisible="{Binding HasMessage}">
          <TextBlock Name="StorageMessageText" TextWrapping="Wrap" Text="{Binding MessageText}" />
        </Border>

      </StackPanel>
    </Border>

    <!-- Footer ─────────────────────────────────────────────────────────────────────────────────── -->
    <!-- ⭐ ONE action, belonging to the task that is showing. ⚠ Both are `primary` because each IS the
         point of its own tab; only one is ever visible, so they never compete and the strip can never
         overflow the way the five-button footer did. -->
    <Border Grid.Row="3" Classes="dialog-footer">
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.Md}">
        <Button Classes="primary" Name="Backup" Content="Backup…"
                IsVisible="{Binding IsBackupTab}"
                IsDefault="{Binding IsBackupTab}"
                Command="{Binding BackupCommand}" />
        <Button Classes="primary" Name="RunRestore" Content="Restore…"
                IsVisible="{Binding IsRestoreTab}"
                IsDefault="{Binding IsRestoreTab}"
                Command="{Binding RunRestoreCommand}" />
      </StackPanel>
    </Border>

  </Grid>
</Window>
