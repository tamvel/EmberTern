<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EmberTern.LicenseManager.App"
             RequestedThemeVariant="Dark">

  <!-- ⚠ Dark is the BOOTSTRAP value, exactly as in EmberTern.App: the alternative, ThemeVariant.Default,
       follows the operating system, which is a different behaviour rather than an absent one. The
       License Manager has no stored preference yet, so this is also the effective default; the title-bar
       toggle switches it live, which is how both themes get checked. -->

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- ⭐ THE SAME FILES EmberTern loads — linked, not copied (see the csproj). Order matches
             EmberTern.App/App.axaml deliberately: metric and typography first, then colour, then the
             Fluent bridge, which maps FluentTheme's own named resources onto our colours and therefore
             needs them loaded. -->
        <ResourceInclude Source="avares://EmberTern.LicenseManager/Themes/Tokens.axaml" />
        <ResourceInclude Source="avares://EmberTern.LicenseManager/Themes/Typography.axaml" />
        <ResourceInclude Source="avares://EmberTern.LicenseManager/Themes/Colors.axaml" />
        <ResourceInclude Source="avares://EmberTern.LicenseManager/Themes/FluentBridge.axaml" />
        <!-- ⭐ EmberTern's own 86 icon geometries, LINKED (see the csproj) rather than copied. ⛔ The
             three ControlThemes that used to sit at the end of that file are NOT here: they bind to
             EmberTern.App's controls, which this application does not have. Icons are drawn with a
             Viewbox + Path — the `icon` style in LicenseManagerStyles.axaml. -->
        <ResourceInclude Source="avares://EmberTern.LicenseManager/Themes/IconGeometries.axaml" />
        <!-- ⚠ AFTER IconGeometries, and that ordering is load-bearing rather than tidy: the CheckBox
             template resolves its tick mark from `Icon.Check`. Reversed, this loads without a word and
             the box simply never shows a mark. EmberTern's App.axaml carries the identical note over its
             own ControlThemes.axaml, and IconGeometriesSplitTests guards it there. -->
        <ResourceInclude Source="avares://EmberTern.LicenseManager/Themes/LicenseManagerControlThemes.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <!-- ⚠ The DataGrid ships its own Fluent theme in its own package, exactly as in EmberTern.App. -->
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <!-- ⭐⭐ EmberTern's OWN grid standard, LINKED (see the csproj) rather than reproduced: row height,
         header height, cell padding, zebra rows, selection over zebra, hover, header chrome, focus ring.
         ⚠ AFTER the Fluent theme above — every selector in it repins something that theme paints, so the
         reverse order loads silently and leaves Fluent's own metrics in place. Guarded from EmberTern's
         side by DataGridStylesSplitTests. -->
    <StyleInclude Source="avares://EmberTern.LicenseManager/Themes/DataGridStyles.axaml" />
    <StyleInclude Source="avares://EmberTern.LicenseManager/Themes/LicenseManagerStyles.axaml" />
  </Application.Styles>

</Application>
