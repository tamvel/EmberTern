<Project Sdk="Microsoft.NET.Sdk">
  <!-- The one place a NuGet dependency on an Office format is allowed — in BOTH directions.
       It was named EmberTern.Export.Office while it only wrote workbooks; etap I9 made import read
       from it too (XlsxImportProvider), so the name dropped "Export" (design decision D1). Core
       stays zero-dep; this project references Core and implements IExporter / IImportProvider. -->
  <ItemGroup>
    <ProjectReference Include="..\EmberTern.Core\EmberTern.Core.csproj" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EmberTern.Tests" />
  </ItemGroup>
</Project>
