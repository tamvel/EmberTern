<Project Sdk="Microsoft.NET.Sdk">
  <!-- The one place a NuGet dependency on an Office format is allowed — in BOTH directions.
       It was named EmberTern.Export.Office while it only wrote workbooks; etap I9 made import read
       from it too (XlsxImportProvider), so the name dropped "Export" (design decision D1). Core
       stays zero-dep; this project references Core and implements IExporter / IImportProvider. -->
  <ItemGroup>
    <ProjectReference Include="..\EmberTern.Core\EmberTern.Core.csproj" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <!-- Etap I10 (design D2, R5): the legacy .xls (BIFF8) reader. I0 measured that DocumentFormat.OpenXml
         cannot open a .xls at all, so the format genuinely needs a second library — the one remaining NuGet
         decision in the module. ExcelDataReader is MIT and forward-only, which is what design R8 requires:
         measured over a 60 000-row BIFF sheet the heap stayed FLAT at 26.7 MB from row 15 000 to row 60 000. -->
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <!-- SECURITY OVERRIDE, not a feature dependency. DocumentFormat.OpenXml 3.1.0 pulls
         System.IO.Packaging 8.0.0 transitively, which carries two High advisories —
         CVE-2024-43483 (hash flooding) and CVE-2024-43484 (algorithmic complexity), both
         denial of service ON HOSTILE INPUT, both fixed in 8.0.1. This project READS user
         .xlsx files since etap I9 (XlsxImportProvider), so "hostile input" is the ordinary
         use case, not a hypothetical: an untrusted workbook reaches the OPC package reader.
         A direct reference is how NuGet lets a leaf project win over a transitive pin; the
         9.0.x line matches the target framework (net9.0) and the app's other Microsoft
         runtime package (System.Security.Cryptography.ProtectedData). Raise this with the
         framework, and re-run the vulnerable-transitive package scan (see docs/gotchas.md
         #278) whenever DocumentFormat.OpenXml moves. -->
    <PackageReference Include="System.IO.Packaging" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EmberTern.Tests" />
  </ItemGroup>
</Project>
