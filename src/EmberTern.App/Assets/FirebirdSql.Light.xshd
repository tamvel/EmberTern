<?xml version="1.0"?>
<!--
  Light-theme variant of the Firebird SQL highlighter — D15.1 readability palette (3-tier).
  Mirrors FirebirdSql.xshd's hierarchy on the near-white background (BackgroundColor #F3F3F3):
    * SQL keywords (query clauses + DML-action + DDL) share ONE restrained blue, bold.
    * PSQL control-flow / routine-body keywords (BEGIN/END/IF/WHILE/FOR/DECLARE/SUSPEND/
      EXECUTE/…) get a SECOND restrained accent (violet), bold — SQL vs PSQL as two groups.
    * Data types keep a discreet muted-teal accent (they matter in declarations).
    * Built-in functions get a readable dark-gold accent (VS Code light style), a clear fourth hue.
    * Comments and literals (strings / numbers) stay legible but quiet.
    * Operators a soft grey; ordinary identifiers are NEUTRAL (default foreground).
  All foregrounds stay dark enough to read (~WCAG AA-ish). Exact hex is tunable with visual
  verification in the running app.

  Categories and rule ordering mirror FirebirdSql.xshd 1:1 — only colors differ — so
  toggling themes doesn't surface or hide categories. The <Keywords> blocks are pinned
  against FirebirdSyntax by FirebirdSyntaxTests.
-->
<SyntaxDefinition name="Firebird SQL Light" extensions=".sql"
                  xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">

  <!-- Comments: an elegant modern-IDE green (SeaGreen) — clearly green and readable, not the old yellow
       "olive" (#3F6B1F) and not a washed-out gray. -->
  <Color name="Comment"          foreground="#2E8B57" />
  <Color name="String"           foreground="#A31515" />
  <Color name="Number"           foreground="#0B6A5C" />
  <!-- SQL keywords (query + DML-action + DDL) share ONE restrained blue. -->
  <Color name="DmlKeyword"       foreground="#0033B3" fontWeight="bold" />
  <Color name="StatementKeyword" foreground="#0033B3" fontWeight="bold" />
  <!-- PSQL control-flow / routine-body keywords: a distinct restrained violet (SQL vs PSQL),
       a touch more saturated than the first cut so it reads clearly on the near-white background. -->
  <Color name="PsqlKeyword"      foreground="#5D30A6" fontWeight="bold" />
  <!-- Data types: a strong, elegant teal — immediately recognizable in declarations, clearly distinct
       from the blue SQL keywords. -->
  <Color name="DataType"         foreground="#0F766E" />
  <!-- Built-in functions: a readable dark gold (VS Code light-theme style) — a clear accent, distinct
       from the blue keywords / violet PSQL / teal types, readable on the near-white background. -->
  <Color name="Function"         foreground="#795E26" />
  <!-- Operators a soft grey. -->
  <Color name="Operator"         foreground="#4D4D4D" />

  <RuleSet ignoreCase="true">

    <Span color="Comment" begin="--" />
    <Span color="Comment" multiline="true" begin="/\*" end="\*/" />

    <Span color="String" multiline="true">
      <Begin>'</Begin>
      <End>'</End>
      <RuleSet>
        <Span begin="''" end="" />
      </RuleSet>
    </Span>

    <!-- Functions must precede general keywords so CASE/WHEN/THEN/ELSE/END
         resolve to the function color. -->
    <Keywords color="Function">
      <Word>CASE</Word><Word>WHEN</Word><Word>THEN</Word><Word>ELSE</Word>
      <Word>CAST</Word><Word>COALESCE</Word><Word>NULLIF</Word><Word>IIF</Word><Word>DECODE</Word>
      <Word>CONVERT</Word><Word>EXTRACT</Word><Word>OVERLAY</Word>
      <Word>COUNT</Word><Word>SUM</Word><Word>AVG</Word><Word>MIN</Word><Word>MAX</Word><Word>LIST</Word>
      <Word>UPPER</Word><Word>LOWER</Word><Word>TRIM</Word><Word>SUBSTRING</Word><Word>POSITION</Word>
      <Word>CHAR_LENGTH</Word><Word>CHARACTER_LENGTH</Word><Word>OCTET_LENGTH</Word>
      <Word>LPAD</Word><Word>RPAD</Word><Word>REPLACE</Word><Word>REVERSE</Word>
      <Word>LEADING</Word><Word>TRAILING</Word><Word>BOTH</Word>
      <Word>ABS</Word><Word>SIGN</Word><Word>MOD</Word><Word>POWER</Word><Word>SQRT</Word>
      <Word>EXP</Word><Word>LN</Word><Word>LOG</Word><Word>LOG10</Word>
      <Word>FLOOR</Word><Word>CEIL</Word><Word>CEILING</Word><Word>ROUND</Word>
      <Word>PI</Word><Word>RAND</Word>
      <Word>ASIN</Word><Word>ACOS</Word><Word>ATAN</Word><Word>ATAN2</Word>
      <Word>SIN</Word><Word>COS</Word><Word>TAN</Word>
      <Word>DATEADD</Word><Word>DATEDIFF</Word>
      <Word>CURRENT_DATE</Word><Word>CURRENT_TIME</Word><Word>CURRENT_TIMESTAMP</Word>
      <Word>CURRENT_USER</Word><Word>CURRENT_ROLE</Word>
      <Word>CURRENT_CONNECTION</Word><Word>CURRENT_TRANSACTION</Word>
      <Word>GEN_ID</Word>
      <Word>ROW_NUMBER</Word><Word>RANK</Word><Word>DENSE_RANK</Word>
      <Word>FIRST_VALUE</Word><Word>LAST_VALUE</Word>
      <Word>LAG</Word><Word>LEAD</Word>
      <Word>OVER</Word><Word>PARTITION</Word>
    </Keywords>

    <Keywords color="DataType">
      <Word>SMALLINT</Word><Word>INTEGER</Word><Word>INT</Word><Word>BIGINT</Word>
      <Word>FLOAT</Word><Word>DOUBLE</Word><Word>PRECISION</Word><Word>NUMERIC</Word><Word>DECIMAL</Word>
      <Word>CHAR</Word><Word>VARCHAR</Word><Word>NCHAR</Word><Word>CSTRING</Word>
      <Word>BLOB</Word><Word>TEXT</Word><Word>BINARY</Word>
      <Word>DATE</Word><Word>TIME</Word><Word>TIMESTAMP</Word><Word>BOOLEAN</Word>
      <Word>CHARACTER</Word><Word>COLLATE</Word>
      <Word>SUB_TYPE</Word><Word>SEGMENT</Word><Word>SIZE</Word>
    </Keywords>

    <!-- SQL statement keywords (DML-action + DDL + transaction + constraints) — blue, same as DmlKeyword. -->
    <Keywords color="StatementKeyword">
      <!-- DML action -->
      <Word>INSERT</Word><Word>UPDATE</Word><Word>DELETE</Word><Word>MERGE</Word>
      <Word>INTO</Word><Word>VALUES</Word><Word>SET</Word>
      <Word>USING</Word><Word>MATCHED</Word><Word>RETURNING</Word>
      <!-- DDL -->
      <Word>CREATE</Word><Word>RECREATE</Word><Word>ALTER</Word><Word>DROP</Word>
      <Word>TABLE</Word><Word>VIEW</Word><Word>INDEX</Word><Word>SEQUENCE</Word><Word>GENERATOR</Word>
      <Word>PROCEDURE</Word><Word>FUNCTION</Word><Word>TRIGGER</Word>
      <Word>DOMAIN</Word><Word>EXCEPTION</Word><Word>ROLE</Word>
      <Word>GRANT</Word><Word>REVOKE</Word>
      <!-- transaction + constraints -->
      <Word>COMMIT</Word><Word>ROLLBACK</Word><Word>SAVEPOINT</Word><Word>TRANSACTION</Word>
      <Word>PRIMARY</Word><Word>FOREIGN</Word><Word>KEY</Word><Word>REFERENCES</Word>
      <Word>CONSTRAINT</Word><Word>UNIQUE</Word><Word>CHECK</Word><Word>DEFAULT</Word>
      <Word>NEXT</Word><Word>VALUE</Word>
    </Keywords>

    <!-- PSQL control-flow / routine-body keywords — the second (violet) structural accent. -->
    <Keywords color="PsqlKeyword">
      <Word>BEGIN</Word><Word>END</Word>
      <Word>FOR</Word><Word>WHILE</Word><Word>DO</Word><Word>IF</Word>
      <Word>EXIT</Word><Word>SUSPEND</Word><Word>LEAVE</Word>
      <Word>DECLARE</Word><Word>VARIABLE</Word><Word>CURSOR</Word>
      <Word>EXECUTE</Word><Word>BLOCK</Word><Word>STATEMENT</Word>
      <Word>RETURNS</Word><Word>RETURN</Word>
    </Keywords>

    <Keywords color="DmlKeyword">
      <Word>SELECT</Word><Word>FROM</Word><Word>WHERE</Word>
      <Word>GROUP</Word><Word>BY</Word><Word>HAVING</Word>
      <Word>ORDER</Word><Word>ASC</Word><Word>DESC</Word>
      <Word>JOIN</Word><Word>INNER</Word><Word>LEFT</Word><Word>RIGHT</Word>
      <Word>FULL</Word><Word>OUTER</Word><Word>CROSS</Word><Word>ON</Word>
      <Word>AND</Word><Word>OR</Word><Word>NOT</Word>
      <Word>IN</Word><Word>EXISTS</Word><Word>BETWEEN</Word>
      <Word>LIKE</Word><Word>STARTING</Word><Word>CONTAINING</Word>
      <Word>SIMILAR</Word><Word>TO</Word>
      <Word>IS</Word><Word>NULL</Word>
      <Word>AS</Word><Word>DISTINCT</Word><Word>ALL</Word>
      <Word>UNION</Word><Word>EXCEPT</Word><Word>INTERSECT</Word>
      <Word>WITH</Word><Word>RECURSIVE</Word>
      <Word>FIRST</Word><Word>SKIP</Word><Word>ROWS</Word>
      <Word>OFFSET</Word><Word>FETCH</Word><Word>LIMIT</Word>
      <Word>TRUE</Word><Word>FALSE</Word><Word>UNKNOWN</Word>
      <Word>PLAN</Word><Word>NATURAL</Word>
    </Keywords>

    <Rule color="Number">\b0[xX][0-9a-fA-F]+|(\b\d+(\.[0-9]+)?|\.[0-9]+)([eE][+-]?[0-9]+)?\b</Rule>

    <Rule color="Operator">[?,.;()\[\]{}+\-*/%=&lt;&gt;!|&amp;~^]+</Rule>

  </RuleSet>
</SyntaxDefinition>
