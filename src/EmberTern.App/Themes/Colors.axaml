<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Dark">
      <Color x:Key="BackgroundColor">#1E1E1E</Color>
      <Color x:Key="PanelColor">#252526</Color>
      <Color x:Key="ChromeStrongColor">#2D2D2D</Color>
      <!-- ⭐ RB‑4: powierzchnia UNIESIONA — popup, menu, lista uzupełniania, zaznaczona zakładka
           panelu. W motywie ciemnym „o stopień dalej od dokumentu" i „unosi się nad kontenerem"
           zbiegają się na tej samej wartości, dlatego jest identyczna z ChromeStrongColor. W jasnym
           są PRZECIWNE i tam te dwie role się rozchodzą — patrz komentarz w słowniku Light. -->
      <Color x:Key="SurfaceRaisedColor">#2D2D2D</Color>
      <Color x:Key="BorderColor">#3F3F46</Color>
      <!-- ⭐⭐ M3.5 / Z-2 — KONTUR KONTROLKI INTERAKTYWNEJ W SPOCZYNKU. Rola inna niż `BorderColor`
           (separator konstrukcyjny) i to rozróżnienie jest przyczyną defektu, nie jego ozdobą: dopóki
           obie dzieliły jeden token, niezaznaczony `CheckBox` miał 1,60:1 w Dark i 1,35:1 w Light,
           czyli PONIŻEJ progu 3:1 z §10 — kontrolka, którą trzeba kliknąć, była niewidoczna w swoim
           stanie DOMYŚLNYM (zaznaczona jest jaskrawo niebieska, więc krzyczała włączona i nie
           istniała wyłączona).
           ⭐ Wartość policzona NA PRÓG (~3,1:1 wobec `BackgroundColor`), nie wyżej — ta sama droga,
           którą ratyfikowała gotcha #308 dla pól filtra. Wariant na `SubtleForegroundColor` (6,31:1)
           był renderowany i ODRZUCONY: kontur przyciągał więcej uwagi niż własna etykieta.
           ⛔ Nie zamieniać na alias `BorderColor` ani `SubtleForegroundColor` — rola ma mieć WŁASNĄ
           wartość (K1: wspólna wartość dziś nie jest zależnością architektoniczną).
           Konsumenci: `CheckBox` i `RadioButton` (oba nasze własne szablony w `ControlThemes.axaml`). -->
      <Color x:Key="ControlOutlineColor">#6A6A70</Color>
      <Color x:Key="ForegroundColor">#D4D4D4</Color>
      <!-- ⭐ H‑7 / §7.4 — tekst drugorzędny. Poprzednia wartość #858585 dawała 4,52:1, czyli
           DOKŁADNIE na granicy AA, przy FontSize 11 i dla głównego elementu nawigacyjnego narzędzia
           używanego osiem godzin dziennie. ⚠ Specyfikacja twierdziła, że problem dotyczy głównie
           motywu jasnego — pomiar tego NIE potwierdził: ciemny był równie słaby, po prostu mniej
           rzucał się w oczy. Teraz 6,31:1. -->
      <Color x:Key="SubtleForegroundColor">#9AA0A6</Color>
      <Color x:Key="AccentColor">#2D6BBF</Color>
      <Color x:Key="AccentMutedColor">#1A4F8F</Color>
      <Color x:Key="TransactionActiveColor">#F0A458</Color>
      <Color x:Key="ConnectedColor">#4EC994</Color>
      <!-- DEV MODE badge text: DARK on the bright mint green. White on #4EC994 is only
           ~1.7:1 (washed out at 10px bold); this deep green-black is ~9:1. -->
      <Color x:Key="DevModeBadgeForegroundColor">#0E2A1C</Color>
      <SolidColorBrush x:Key="DevModeBadgeForegroundBrush" Color="{StaticResource DevModeBadgeForegroundColor}" />
      <!-- Avalonia color hex is ARGB (alpha-first). #FFFFFF12 = opaque yellow-white;
           #12FFFFFF = 7% white overlay. We meant the latter. -->
      <Color x:Key="HoverOverlayColor">#12FFFFFF</Color>
      <!-- ⭐ M5 / §10: #F44747 → #F55252. `ErrorBrush` maluje TEKST komunikatu 12 px (MessageBanner
           i log Messages), a na `PanelBrush` dawał 4,26:1 przy progu 4,5:1 dla tekstu < 14 px.
           Kandydat policzony PRZY PROGU przez rozjaśnienie (mieszanie z bielą — odcień zachowany,
           ⚠ nasycenie minimalnie niższe): Panel 4,26 → 4,53, Background 4,64 → 4,93.
           ⚠ Zmiana jest WIZUALNIE NIEROZRÓŻNIALNA (delta 0,27) — jej jedynym zyskiem jest zgodność
           z progiem; potwierdzone na renderze `m5c-text-Dark.png`. Pasek i ikona banera miały zapas
           już wcześniej, więc sygnał severity się nie zmienia. -->
      <Color x:Key="ErrorColor">#F55252</Color>
      <Color x:Key="WarningColor">#E8A020</Color>
      <!-- The part of a completion row that MATCHED what the user typed (the IBExpert cue). Red on
           purpose, by user request. Deliberately its own token rather than ErrorColor, which it sits
           next to in the palette: the two must be free to diverge, because this one means "this is why
           the row is here" and never "something is wrong". Chosen to stay legible on BOTH surfaces a row
           can have — the popup's ChromeStrong and the SelectionColor of the selected row. -->
      <Color x:Key="CompletionMatchColor">#FF6B6B</Color>
      <Color x:Key="SelectionColor">#094771</Color>
      <Color x:Key="FocusBorderColor">#007FD4</Color>
      <!-- Zebra-stripe tint for DataGrid alternating rows. ARGB: ~5% white on dark. -->
      <Color x:Key="RowAlternateColor">#0DFFFFFF</Color>
      <!-- Drag-and-drop drop-target overlay: ~33% of the dark accent blue. ARGB hex. -->
      <Color x:Key="DropTargetColor">#552D6BBF</Color>
      <!-- Global-Search preview match highlight — boxes every hit of the search term in the read-only
           DDL preview (SearchMatchHighlighter). A subtle wash of the app's accent blue. Cool so it stays
           true on the near-black editor; kept subtle so it never out-shouts syntax highlighting. ARGB
           alpha-first. -->
      <Color x:Key="SearchMatchColor">#382D6BBF</Color>
      <!-- Stage 8 / M1 — Related Elements Highlighting (matching brackets, BEGIN/END, occurrences),
           one high-contrast, theme-tuned style: a translucent fill + a strong border so the partner
           element is immediately noticeable. Light: a burnt-orange that reads on the near-white editor. -->
      <Color x:Key="RelatedElementHighlightColor">#3DC85A00</Color>
      <Color x:Key="RelatedElementHighlightBorderColor">#E6C85A00</Color>
      <SolidColorBrush x:Key="RelatedElementHighlightBrush" Color="{StaticResource RelatedElementHighlightColor}" />
      <SolidColorBrush x:Key="RelatedElementHighlightBorderBrush" Color="{StaticResource RelatedElementHighlightBorderColor}" />
      <!-- Stage X / D4 — Debugger. The current-statement marker: a translucent amber band over the step
           point the session is paused on. D15.1 Seam B rebuilt it: a CALM BLUE full-line wash (~16% over
           the near-black editor — a quiet backdrop that leads the eye without the old amber "aggression")
           plus a crisp accent bar at the line's left edge (DebugCurrentLineBarBrush). Alpha-first ARGB.
           The breakpoint glyph is a solid red dot in the gutter — its own token (not ErrorColor: a
           breakpoint is a deliberate stop, never an error). -->
      <Color x:Key="DebugCurrentLineColor">#4A5A8AC8</Color>
      <Color x:Key="DebugCurrentLineBarColor">#E65A8AC8</Color>
      <Color x:Key="DebugBreakpointColor">#E51400</Color>
      <SolidColorBrush x:Key="DebugCurrentLineBrush" Color="{StaticResource DebugCurrentLineColor}" />
      <SolidColorBrush x:Key="DebugCurrentLineBarBrush" Color="{StaticResource DebugCurrentLineBarColor}" />
      <SolidColorBrush x:Key="DebugBreakpointBrush" Color="{StaticResource DebugBreakpointColor}" />
      <!-- Variables panel: subtle wash behind a variable the last step changed (change-highlight, spec §9.4).
           Deliberately the SAME hue as the debugger's current-line wash (DebugCurrentLineColor #5A8AC8) —
           "this changed" is part of the debugger's own visual language, not a separate colour accent. The
           two never share a control (marker = editor, wash = Variables panel), so no ambiguity; alpha sits
           just under the editor wash because PanelBrush makes the same value read stronger here. -->
      <Color x:Key="DebugVariableChangedColor">#3D5A8AC8</Color>
      <SolidColorBrush x:Key="DebugVariableChangedBrush" Color="{StaticResource DebugVariableChangedColor}" />
      <!-- Variables panel: per-kind glyph colours (distinct hues for fast recognition) + the pin (gold). -->
      <Color x:Key="DebugParamInColor">#5B9BD5</Color>
      <Color x:Key="DebugParamOutColor">#E8A020</Color>
      <Color x:Key="DebugLocalColor">#4EC994</Color>
      <Color x:Key="DebugPinColor">#F2C94C</Color>
      <!-- Stage X / D10 — trigger NEW/OLD context columns: a distinct purple, apart from IN/OUT/local hues. -->
      <Color x:Key="DebugContextColor">#C678DD</Color>
      <SolidColorBrush x:Key="DebugParamInBrush"  Color="{StaticResource DebugParamInColor}" />
      <SolidColorBrush x:Key="DebugParamOutBrush" Color="{StaticResource DebugParamOutColor}" />
      <SolidColorBrush x:Key="DebugLocalBrush"    Color="{StaticResource DebugLocalColor}" />
      <SolidColorBrush x:Key="DebugPinBrush"      Color="{StaticResource DebugPinColor}" />
      <SolidColorBrush x:Key="DebugContextBrush"  Color="{StaticResource DebugContextColor}" />
      <!-- Indigo/violet overlay marking a row with an unsaved modify edit in the Pola
           grid. The three pending states read at a glance — green = added, indigo =
           modified, red = dropped — and none collides with the blue hover/selection or
           the amber warning/transaction state. Amber was rejected: a low-alpha WARM
           colour over the near-black editor surface composites to brown, which reads as
           a warning, not a pending edit. A cool hue stays true on dark (no muddiness)
           and lands as a soft lavender on light. ~25% alpha, ARGB alpha-first;
           theme-invariant. -->
      <Color x:Key="RowModifiedColor">#407C4DFF</Color>
      <!-- Buffered Table Designer pending-row washes (~20% alpha, alpha-first ARGB). -->
      <Color x:Key="RowAddedColor">#3327AE60</Color>
      <Color x:Key="RowDroppedColor">#33E53935</Color>
      <!-- ⭐ Role R‑2 „Zatwierdź" i R‑3 „Wycofaj transakcję" (`color-language.md` §3, krok K7).
           ⚠⚠ TE WARTOŚCI ZOSTAŁY WYMIENIONE. Wcześniej stało tu `#4CAF50` / `#F44336` — surowy
           Material Design, wstawiony na zapas, IDENTYCZNY w obu motywach i nigdy nieużyty (oba tokeny
           nie miały ani jednego konsumenta). Każdy inny token semantyczny ma osobną wartość dla Light
           i Dark, bo ten sam odcień nie ma poprawnego kontrastu na obu tłach — przyjęcie tamtych
           wprost dałoby regres kontrastu w motywie jasnym (§7.2 języka, klasa problemu V‑1).
           ⭐ Wartości = dostrojone pary `SuccessIconColor` / `DangerIconColor`, czyli DOKŁADNIE to, czym
           Commit i Rollback malowały się dotąd. Dzięki temu K7 nie zmienia niczego na ekranie, a role
           dostają własne tokeny (ten sam zabieg co `ActionRunColor` w K1).
           ⛔ Nie jest to alias — patrz komentarz przy `ActionRunColor`; powód jest ten sam. -->
      <Color x:Key="CommitButtonForeground">#6DBE7E</Color>
      <Color x:Key="RollbackButtonForeground">#D77373</Color>
      <!-- Chrome-on-color tokens. These read identically in Dark + Light because
           they sit on theme-independent fills: OnAccent* over the blue AccentBrush /
           colored lane chips, CloseButtonHover is the Windows caption-close red.
           Tokenized (not hardcoded in styles) so every "white text on accent" /
           "close-button red" use resolves through the theme. -->
      <Color x:Key="OnAccentColor">#FFFFFF</Color>
      <Color x:Key="OnAccentSubtleColor">#80FFFFFF</Color>
      <Color x:Key="CloseButtonHoverColor">#E81123</Color>

      <!-- ⭐⭐ NIEAKTYWNY PRZYCISK GŁÓWNY — WYPEŁNIENIE NIEPRZEZROCZYSTE, NIE PRZEZROCZYSTOŚĆ, i to jest
           mechanizm defektu, nie dobór barwy (zgłoszenie użytkownika 2026-08-03: „na jasnym motywie nieaktywny
           młotek praktycznie znika").
           ⚠ Wcześniej stan nieaktywny to było `Opacity 0.5` na CAŁYM przycisku. `AccentColor` i `OnAccentColor`
           są w obu motywach IDENTYCZNE, więc winna nie mogła być barwa — winne było to, przez co przezroczystość
           przepuszcza: pod spodem stoi pasek narzędzi, w ciemnym `#2D2D2D`, w jasnym `#E8EAED`. Biała ikona
           blaknąca w stronę jasnego tła traci kontrast prawie do zera, a w stronę ciemnego go ZYSKUJE — jedna
           liczba, przeciwny skutek w dwóch motywach.
           ⭐ Dlatego to są dwie role z wartościami PER MOTYW, a nie jedna liczba: nieprzezroczyste wypełnienie
           odcina tło, więc kontrast ikony przestaje zależeć od tego, co za przyciskiem. -->
      <Color x:Key="AccentDisabledColor">#3A3F46</Color>
      <Color x:Key="OnAccentDisabledColor">#9AA0A6</Color>

      <!-- ⭐⭐ POLE STOJĄCE NA POWIERZCHNI UNOSZĄCEJ SIĘ — WYPEŁNIENIE **I** RAMKA (zgłoszenie użytkownika
           2026-08-03, PONOWIONE po pierwszej poprawce: „pola filtrów nadal zlewają się z tłem, na OBU motywach").
           Dotyczy filtra w liście rozwijanej domeny i obu filtrów w okienku wyboru kolumny.

           ⚠⚠ Pierwsza poprawka ruszyła TYLKO ramkę i była za słaba — i to jest zmierzone, nie odczute:
           selektor stosował się poprawnie (`PART_BorderElement`, 1 px, moje kolory na miejscu), ale
           w motywie jasnym tło pola to `#FCFCFD` na powierzchni `#FFFFFF`, czyli **różnica trzech jednostek** —
           wypełnienie nie odcinało pola w ogóle i cały ciężar spoczynkowej widoczności spadał na jedną
           kreskę. ⭐ Dlatego pole dostaje teraz WKLĘSŁE TŁO: to ono nadaje kształt, ramka go tylko domyka.
           Tak samo działa każde pole wyszukiwania na jasnym panelu w dojrzałych edytorach.

           ⚠ Skoki są celowo WYRAŹNE, a nie „o włos": ciemny `#171717` przy powierzchni `#2D2D2D` i jasny
           `#EDEFF2` przy `#FFFFFF`. Trzy jednostki to był właśnie ten włos. -->
      <Color x:Key="FieldOnRaisedColor">#171717</Color>
      <!-- ⭐ Ramka trafia w PRÓG 3:1 wobec powierzchni, na której stoi — to kryterium §10 dla granic
           nietekstowych (WCAG 1.4.11), a nie dobór na oko. Zmierzone: `#6E757E` dawało 2,96 (pod progiem),
           `#767D87` daje 3,31. Dokładnie ten rodzaj różnicy, którego „prawie widać" nie odróżnia od „widać". -->
      <Color x:Key="FieldOnRaisedBorderColor">#767D87</Color>

      <!-- Semantic icon colors (dark theme). Subtle, professional tones — not the
           loud primary green/red. Applied via Foreground on SvgIcon. Disabled state is
           conveyed by button Opacity, not a separate color.

           ⛔⛔ TU STAŁA LEGENDA „Accent=execute-class, Success=commit, Danger=rollback/abort,
           Warning=delete, Info=refresh" — PIERWOTNY schemat, PORZUCONY i NIEAKTUALNY. To ona jest
           źródłem dryfu opisanego w `product-polish.md` §20: „usuń trwale" miało trzy kolory, bo
           osiem edytorów i 131 pozycji menu przeszło na czerwień, a legenda dalej mówiła „żółty".
           ⚠ Komentarz przeżył zmianę, którą opisywał — dokładnie kształt gotchy #284, tylko że
           w komentarzu zamiast w stringu.

           ⭐ JEDYNYM ŹRÓDŁEM PRAWDY O ZNACZENIU KOLORU JEST `docs/design/color-language.md`
           (role akcji R‑1…R‑7 + wyjątki nazwane §5). Tutaj są WARTOŚCI, nie znaczenia — i nie
           dopisuj tu drugiej legendy, bo to ona rozjedzie się jako następna. -->
      <!-- Odpowiedniki ról: R‑4 → Danger · R‑5 → Warning · R‑6 → Accent · R‑7 → Neutral ·
           R‑1 → ActionRun (niżej). -->

      <Color x:Key="AccentIconColor">#5B9BD5</Color>
      <Color x:Key="SuccessIconColor">#6DBE7E</Color>
      <!-- ⭐ Język kolorów / rola R‑1 „Uruchom" (`color-language.md` §3, §7.3 — krok K1).
           „Uruchom" i „Zatwierdź transakcję" to DWIE role (decyzja W4), więc mają dwa tokeny.
           ⚠ Wartość jest DZIŚ CELOWO IDENTYCZNA z `SuccessIconColor` — K1 jest krokiem neutralnym
           wizualnie (§11.1) i nie wolno mu nic przesunąć na ekranie.
           ⛔ To NIE jest alias przez `{StaticResource SuccessIconColor}`, i to jest istota W4: alias
           znaczyłby „Uruchom to kolor sukcesu", więc przestrojenie zieleni Commita przesunęłoby
           po cichu także Execute — czyli dokładnie to zlanie ról, które W4 kończy. Rozdzielenie
           odcieni w przyszłości jest zmianą JEDNEJ linijki i nie dotyka drugiej roli.
           ⭐ I TA PRZYSZŁOŚĆ JUŻ NASTAŁA — w motywie JASNYM para rozeszła się w M5 (§10): tam
           `SuccessIconColor` zszedł na #2A7E48 pod próg tekstowy, a `ActionRunColor` został na
           #2E8B4F, bo maluje wyłącznie ikony. W TYM motywie wartości są nadal identyczne, bo Dark
           nie wymagał korekty. Dowód, że rozdzielenie tokenów zadziałało dokładnie tak, jak W4
           zapowiadał: zmiana jednej roli nie ruszyła drugiej. -->
      <Color x:Key="ActionRunColor">#6DBE7E</Color>
      <Color x:Key="DangerIconColor">#D77373</Color>
      <Color x:Key="WarningIconColor">#DBA13C</Color>
      <Color x:Key="InfoIconColor">#5BA7D0</Color>
      <Color x:Key="NeutralIconColor">#C8CCD2</Color>
      <!-- Stage Q / Q3: the code-action light bulb. Its OWN token, not WarningIconBrush — "a fix is
           available here" is an offer, not a problem, and the two must not drift if either is retuned.
           Amber-gold reads as the universal light-bulb cue at a glance; hover switches to the accent so
           the bulb also says "interactive". -->
      <Color x:Key="CodeActionColor">#F0C05A</Color>
      <!-- D15.2 Seam A: shared subtle accent for the "loop operations" category (Next Iteration /
           Loop Exit). Teal — deliberately NOT the PSQL-keyword violet from D15.1 (that would cross
           the syntax domain into the toolbar). Colour marks the category, not each icon. -->
      <Color x:Key="DebugLoopIconColor">#4FC1B5</Color>
      <SolidColorBrush x:Key="DebugLoopIconBrush" Color="{StaticResource DebugLoopIconColor}" />
      <!-- Icon-button hover overlay — a touch stronger than HoverOverlay so a
           toolbar icon's hover reads clearly. ARGB: ~13% white on dark. -->
      <Color x:Key="IconHoverColor">#22FFFFFF</Color>

      <!-- ⭐ Pasek przewijania (H‑10, Product Polish M2b krok 6) — TRZY WŁASNE ROLE, bo żadna
           istniejąca nie pasuje bez łamania §3.1. Uchwyt jest WYPEŁNIENIEM, a jedyne tokeny o dobrym
           kontraście w obu motywach są rolami TEKSTU (`SubtleForeground`) — użycie ich tutaj
           odebrałoby tamtej roli znaczenie. Konsument istnieje od pierwszej linii (każdy przewijalny
           widok w aplikacji), więc reguła „token bez konsumenta wygląda jak regresja" jest spełniona.
           ⚠ Uchwyt musi być widoczny bez bycia głośnym: to jedyny element chromy, który użytkownik
           śledzi wzrokiem przy przewijaniu i zarazem ignoruje przez resztę czasu. -->
      <Color x:Key="ScrollBarThumbColor">#4A4A50</Color>
      <Color x:Key="ScrollBarThumbHoverColor">#5F5F67</Color>
      <Color x:Key="ScrollBarThumbPressedColor">#7A7A83</Color>

      <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
      <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
      <SolidColorBrush x:Key="ChromeStrongBrush" Color="{StaticResource ChromeStrongColor}" />
      <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
      <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
      <!-- M3.5 / Z-2 — kontur kontrolki interaktywnej; rola i powód przy `ControlOutlineColor`. -->
      <SolidColorBrush x:Key="ControlOutlineBrush" Color="{StaticResource ControlOutlineColor}" />
      <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}" />
      <SolidColorBrush x:Key="SubtleForegroundBrush" Color="{StaticResource SubtleForegroundColor}" />
      <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="AccentMutedBrush" Color="{StaticResource AccentMutedColor}" />
      <SolidColorBrush x:Key="TransactionActiveBrush" Color="{StaticResource TransactionActiveColor}" />
      <SolidColorBrush x:Key="ConnectedBrush" Color="{StaticResource ConnectedColor}" />
      <SolidColorBrush x:Key="HoverOverlayBrush" Color="{StaticResource HoverOverlayColor}" />
      <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
      <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
      <SolidColorBrush x:Key="CompletionMatchBrush" Color="{StaticResource CompletionMatchColor}" />
      <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}" />
      <SolidColorBrush x:Key="FocusBorderBrush" Color="{StaticResource FocusBorderColor}" />
      <SolidColorBrush x:Key="RowAlternateBrush" Color="{StaticResource RowAlternateColor}" />
      <!-- Activity Monitor "operation bands": a 2-shade left stripe that flips on each
           transaction change (theme-independent subtle overlay; alpha-first per gotcha #1). -->
      <SolidColorBrush x:Key="TxBand0" Color="#00000000" />
      <SolidColorBrush x:Key="TxBand1" Color="#20808CA8" />
      <SolidColorBrush x:Key="DropTargetBrush" Color="{StaticResource DropTargetColor}" />
      <SolidColorBrush x:Key="SearchMatchBrush" Color="{StaticResource SearchMatchColor}" />
      <SolidColorBrush x:Key="RowModifiedBrush" Color="{StaticResource RowModifiedColor}" />
      <SolidColorBrush x:Key="RowAddedBrush" Color="{StaticResource RowAddedColor}" />
      <SolidColorBrush x:Key="RowDroppedBrush" Color="{StaticResource RowDroppedColor}" />
      <SolidColorBrush x:Key="CommitButtonBrush" Color="{StaticResource CommitButtonForeground}" />
      <SolidColorBrush x:Key="RollbackButtonBrush" Color="{StaticResource RollbackButtonForeground}" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
      <SolidColorBrush x:Key="OnAccentSubtleBrush" Color="{StaticResource OnAccentSubtleColor}" />
      <SolidColorBrush x:Key="AccentDisabledBrush" Color="{StaticResource AccentDisabledColor}" />
      <SolidColorBrush x:Key="FieldOnRaisedBrush" Color="{StaticResource FieldOnRaisedColor}" />
      <SolidColorBrush x:Key="FieldOnRaisedBorderBrush" Color="{StaticResource FieldOnRaisedBorderColor}" />
      <SolidColorBrush x:Key="OnAccentDisabledBrush" Color="{StaticResource OnAccentDisabledColor}" />
      <SolidColorBrush x:Key="CloseButtonHoverBrush" Color="{StaticResource CloseButtonHoverColor}" />

      <SolidColorBrush x:Key="AccentIconBrush" Color="{StaticResource AccentIconColor}" />
      <SolidColorBrush x:Key="SuccessIconBrush" Color="{StaticResource SuccessIconColor}" />
      <SolidColorBrush x:Key="ActionRunBrush" Color="{StaticResource ActionRunColor}" />
      <SolidColorBrush x:Key="DangerIconBrush" Color="{StaticResource DangerIconColor}" />
      <SolidColorBrush x:Key="WarningIconBrush" Color="{StaticResource WarningIconColor}" />
      <SolidColorBrush x:Key="InfoIconBrush" Color="{StaticResource InfoIconColor}" />
      <SolidColorBrush x:Key="NeutralIconBrush" Color="{StaticResource NeutralIconColor}" />
      <SolidColorBrush x:Key="CodeActionBrush" Color="{StaticResource CodeActionColor}" />
      <SolidColorBrush x:Key="IconHoverBrush" Color="{StaticResource IconHoverColor}" />

      <!-- Override FluentTheme's TreeViewItem state brushes. Without these the dark
           theme inherits SystemAccentColor-derived backgrounds (yellow/beige on a
           default Win11 install). Borders forced transparent to avoid the colored
           ring around selected items. -->
      <SolidColorBrush x:Key="TreeViewItemBackground" Color="Transparent" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="{StaticResource HoverOverlayColor}" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundPressed" Color="{StaticResource SelectionColor}" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="{StaticResource SelectionColor}" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="{StaticResource SelectionColor}" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPressed" Color="{StaticResource SelectionColor}" />
      <SolidColorBrush x:Key="TreeViewItemBorderBrush" Color="Transparent" />
      <SolidColorBrush x:Key="TreeViewItemBorderBrushPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="TreeViewItemBorderBrushPressed" Color="Transparent" />
      <SolidColorBrush x:Key="TreeViewItemBorderBrushSelected" Color="Transparent" />
      <SolidColorBrush x:Key="TreeViewItemBorderBrushSelectedPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="TreeViewItemBorderBrushSelectedPressed" Color="Transparent" />

      <!-- FluentTheme's DataGridCell paints its focus rectangle with
           SystemAccentColor by default (orange-brown on a default Win11 install).
           Override to the app's blue focus-border so the focused cell matches
           every other focus visual in the workbench. Both Primary (outer line)
           and Secondary (inner contrast) need to be set, otherwise the
           SystemAccent inner edge bleeds through. -->
      <SolidColorBrush x:Key="DataGridCellFocusVisualPrimaryBrush" Color="{StaticResource FocusBorderColor}" />
      <SolidColorBrush x:Key="DataGridCellFocusVisualSecondaryBrush" Color="{StaticResource FocusBorderColor}" />
      <!-- Per-cell background overrides — the FluentTheme template paints
           DataGridCellBackgroundColorSelected / Focused / etc., which also pick
           SystemAccent on default themes. Selection background already comes
           from the row-level Rectangle#BackgroundRectangle override, but cells
           in :focus / :current state still paint the cell-level brush over
           the row. Force them through SelectionBrush so the focused cell
           reads as part of the blue selection. -->
      <SolidColorBrush x:Key="DataGridCellBackgroundBrushSelected" Color="{StaticResource SelectionColor}" />
      <SolidColorBrush x:Key="DataGridCellBackgroundBrushFocused" Color="{StaticResource SelectionColor}" />
      <SolidColorBrush x:Key="DataGridCellBackgroundBrushSelectedFocused" Color="{StaticResource SelectionColor}" />
      <SolidColorBrush x:Key="DataGridCellBackgroundBrushSelectedUnfocused" Color="{StaticResource SelectionColor}" />
      <SolidColorBrush x:Key="DataGridCellForegroundBrushFocused" Color="{StaticResource ForegroundColor}" />

      <!-- Per-kind metadata icon brushes (dark theme: Material 300/200 — bright on dark).
           Resolved at render time via DynamicResource through IconBrushConverter so theme
           toggle re-evaluates without rebuilding the tree. -->
      <SolidColorBrush x:Key="IconColor_Table"       Color="#4FC3F7" />
      <SolidColorBrush x:Key="IconColor_View"        Color="#81C784" />

      <!-- Transaction-lane chip backgrounds (C2): Data = blue, Metadata = purple,
           kept clearly distinct so the two title-bar chips read apart at a glance. -->
      <SolidColorBrush x:Key="DataLaneChipBrush"     Color="#2D6BBF" />
      <SolidColorBrush x:Key="MetadataLaneChipBrush" Color="#8157C2" />
      <SolidColorBrush x:Key="IconColor_Procedure"   Color="#FFB74D" />
      <SolidColorBrush x:Key="IconColor_Trigger"     Color="#E57373" />
      <SolidColorBrush x:Key="IconColor_Function"    Color="#FFF176" />
      <SolidColorBrush x:Key="IconColor_Generator"   Color="#4DD0E1" />
      <SolidColorBrush x:Key="IconColor_Domain"      Color="#CE93D8" />
      <SolidColorBrush x:Key="IconColor_Package"     Color="#7986CB" />
      <SolidColorBrush x:Key="IconColor_Exception"   Color="#EF9A9A" />
      <SolidColorBrush x:Key="IconColor_Role"        Color="#90A4AE" />
      <SolidColorBrush x:Key="IconColor_User"        Color="#90A4AE" />
      <SolidColorBrush x:Key="IconColor_Index"       Color="#AED581" />
      <SolidColorBrush x:Key="IconColor_SystemTable" Color="#757575" />
      <!-- Query (SQL Editor) tab icon — neutral on dark, distinct from blue Table. -->
      <SolidColorBrush x:Key="IconColor_Query"       Color="#B0BEC5" />

      <!-- Editor semantic-highlight accents — D15.1 readability pass (readability first,
           colour = the exception that leads the eye). Navigable schema objects reuse the
           IconColor_* palette above (editor colour == tree icon). Ordinary local names
           (FROM/JOIN aliases, PSQL variables/parameters, cursors, CTEs) are now NEUTRAL —
           EditorLocalBrush == the default foreground — so variables no longer claim a hue.
           EditorColumnBrush is retained but the in-editor paint opts columns out (see
           SemanticHighlighter); trigger-context variables keep a restrained accent below. -->
      <SolidColorBrush x:Key="EditorColumnBrush"     Color="#A8C7E0" />
      <SolidColorBrush x:Key="EditorLocalBrush"      Color="#D4D4D4" />
      <!-- A Firebird domain used as a data type paints like a SQL type (D15.1). MUST mirror the xshd
           DataType colour (Assets/FirebirdSql.xshd) so a domain and a builtin type read identically. -->
      <SolidColorBrush x:Key="EditorDataTypeBrush"   Color="#4EC9B0" />
      <!-- Trigger context variables (NEW/OLD/INSERTING/UPDATING/DELETING). Amber, the same family as
           the built-in context constants (CURRENT_DATE / CURRENT_USER) so they read as core language
           constructs — but with more chroma than the pale Function keyword (#DCDCAA) so they clearly
           stand out from the near-grey identifier foreground (#D4D4D4). -->
      <SolidColorBrush x:Key="EditorContextVariableBrush" Color="#E5C07B" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">
      <Color x:Key="BackgroundColor">#FCFCFD</Color>
      <!-- Light theme panel hierarchy: editor/results stay near-white (BackgroundColor),
           sidebar is a step darker (PanelColor), titlebar is darker still
           (ChromeStrongColor). Borders sit between PanelColor and ChromeStrongColor
           so panel edges read clearly without a sharp line.

           ⭐ PRZEPROJEKTOWANE W M2b, KROKU 3 (§7.2). Poprzednia skala — tło #F3F3F3, chroma
           #E0E0E0/#D6D6D6, obramowania #BDBDBD — była po prostu ciężka: rysowała siatkę, która
           konkurowała z treścią, zamiast ją oprawiać (narusza §3.4 specyfikacji, „calm interface").
           Kierunek zmiany: chroma odróżnialna od dokumentu, ale nie dominująca; obramowanie ma
           ODDZIELAĆ, nie RYSOWAĆ.

           ⭐ Tło to #FCFCFD, a NIE czysta biel — ratyfikowana decyzja Q7 (§7.2.1), podjęta
           z powodów ergonomicznych: „aplikacja będzie używana przez wiele godzin dziennie i zależy
           mi bardziej na komforcie pracy niż maksymalnym kontraście". Nadmiar kontrastu nie poprawia
           czytelności — podnosi jasność całego pola widzenia przy ośmiogodzinnej sesji. Tekst główny
           ma tu 16,49:1, czyli ponad trzykrotność progu AA.
           ⚠ Ta decyzja okazała się też poprawna architektonicznie: dopiero odsunięcie tła od bieli
           daje `SurfaceRaisedColor = #FFFFFF` (RB‑4) DOKĄD się unieść. Przy tle #FFFFFF powierzchnia
           uniesiona nie miałaby jak być jaśniejsza i §7.1 wymagałby innego mechanizmu. -->
      <Color x:Key="PanelColor">#F3F4F6</Color>
      <Color x:Key="ChromeStrongColor">#E8EAED</Color>
      <!-- ⭐⭐ RB‑4 — TU JEST CAŁY DEFEKT I JEGO ROZWIĄZANIE.

           Do tej pory jeden token (`ElevatedPanelBrush`) wykonywał DWIE sprzeczne prace:
             (a) „chroma o stopień dalej od dokumentu" — nagłówki kolumn, pasek tytułu,
             (b) „element unosi się nad swoim kontenerem" — popup, menu, zaznaczona zakładka.

           W motywie CIEMNYM obie schodzą się na tej samej wartości i defektu nie widać.
           W JASNYM są przeciwne — i powód jest fizyczny, nie stylistyczny: *uniesienie* czyta się
           jako ruch KU ŚWIATŁU w każdym motywie, bo światło pada z góry. Oddalenie się od bieli
           to wejście w cień, czyli WGŁĘBIENIE. Dlatego zaznaczona zakładka, opisana w kodzie jako
           „a raised, filled segment", w Light wyglądała na wciśniętą.

           Rozwiązaniem musiał być nowy TOKEN, nie nowa wartość: podział na dwie prace jest
           sprawdzalny mechanicznie („czy ten element pływa nad swoim kontenerem?" ma jednoznaczną
           odpowiedź dla każdego z 33 miejsc), więc żadna pojedyncza wartość nie mogła obsłużyć obu.

           ⚠ Biel, nie „jaśniejszy szary": powierzchnia uniesiona musi mieć dokąd się unieść ponad
           tło dokumentu — i to jest ta niezamierzona korzyść z decyzji Q7 (§7.2.1), która odsunęła
           tło od czystej bieli. Krawędź niesie `BorderBrush`, bo różnica wobec tła jest niewielka. -->
      <Color x:Key="SurfaceRaisedColor">#FFFFFF</Color>
      <Color x:Key="BorderColor">#D8DBE0</Color>
      <!-- M3.5 / Z-2 — patrz pełne uzasadnienie w słowniku Dark. Tu defekt był GORSZY (1,35:1),
           bo `BorderColor` #D8DBE0 na tle #FCFCFD to niemal ta sama jasność. ~3,1:1 na progu. -->
      <Color x:Key="ControlOutlineColor">#90939A</Color>
      <Color x:Key="ForegroundColor">#1B1D1F</Color>
      <!-- ⭐ H‑7 / §7.4 — tekst drugorzędny; na nowej chromie #F3F4F6 daje 5,33:1 zamiast
           granicznych 3,86:1, jakie #6E6E6E dawało na #E0E0E0. To jest kolor nieaktywnych zakładek
           i podpisów pól — czyli tego, co użytkownik czyta kątem oka przez cały dzień. -->
      <Color x:Key="SubtleForegroundColor">#5F6570</Color>
      <!-- Light accent shares the dark blue palette so the Execute button + focus
           ring + transaction marker stay consistent across themes. Earlier
           purple values clashed against the rest of the chrome on light. -->
      <Color x:Key="AccentColor">#2D6BBF</Color>
      <Color x:Key="AccentMutedColor">#1A4F8F</Color>
      <Color x:Key="TransactionActiveColor">#B85C00</Color>
      <Color x:Key="ConnectedColor">#1A7F4B</Color>
      <!-- DEV MODE badge text: WHITE on the dark forest green (~4.6:1, good). -->
      <Color x:Key="DevModeBadgeForegroundColor">#FFFFFF</Color>
      <SolidColorBrush x:Key="DevModeBadgeForegroundBrush" Color="{StaticResource DevModeBadgeForegroundColor}" />
      <Color x:Key="HoverOverlayColor">#10000000</Color>
      <Color x:Key="ErrorColor">#CC2929</Color>
      <!-- ⭐⭐ M5 / §10: #C77800 → #A16100 — NAJWIĘKSZA zmiana w tym etapie i jedyna, którą widać.
           `WarningBrush` maluje TEKST komunikatu 12 px, a na `PanelBrush` dawał 3,12:1 przy progu
           4,5:1 — deficyt 1,38, największy w całej palecie. Kandydat policzony PRZY PROGU przez
           mnożenie kanałów RGB, co zachowuje odcień i nasycenie HSV DOKŁADNIE (ta sama barwa,
           ciemniejsza): Panel 3,12 → 4,52, Background 3,35 → 4,85.
           ⚠ Koszt przyjęty świadomie (decyzja użytkownika 2026-08-10, wariant B): bursztyn ciemnieje
           w stronę bursztynowo-brązowego. Render: `m5c-text-Light.png` kolumna B.
           ⛔ To NIE jest poprawka `MessageBanner` — ten pędzel maluje mały tekst w ~9 miejscach
           (Data Import, Debugger, Index Detail, Performance…), więc poprawka lokalna byłaby
           naruszeniem R7. Ikony ostrzeżeń mają WŁASNY token `WarningIconColor` i są nietknięte. -->
      <Color x:Key="WarningColor">#A16100</Color>
      <!-- Matched fragment of a completion row — see the Dark dictionary for why this is its own token
           and not ErrorColor. Darker/denser than the dark theme's red so it carries on the near-white
           popup and on the pale SelectionColor of the selected row. -->
      <Color x:Key="CompletionMatchColor">#C42B1C</Color>
      <Color x:Key="SelectionColor">#CCE4F7</Color>
      <Color x:Key="FocusBorderColor">#0078D4</Color>
      <!-- Zebra-stripe tint for DataGrid alternating rows. ARGB: ~5% black on light. -->
      <Color x:Key="RowAlternateColor">#0D000000</Color>
      <!-- Drag-and-drop drop-target overlay: ~33% of the light accent blue. ARGB hex. -->
      <Color x:Key="DropTargetColor">#552D6BBF</Color>
      <!-- Global-Search preview match highlight — see the Dark note. A subtle wash of the accent blue
           over the near-white editor; slightly lower fill alpha than Dark so it stays gentle on the
           light surface. ARGB alpha-first. -->
      <Color x:Key="SearchMatchColor">#2E2D6BBF</Color>
      <!-- Stage 8 / M1 — Related Elements Highlighting (matching brackets, BEGIN/END, occurrences),
           one high-contrast, theme-tuned style: a translucent fill + a strong border so the partner
           element is immediately noticeable. Dark: a bright amber that pops on the dark editor. -->
      <Color x:Key="RelatedElementHighlightColor">#40E0A030</Color>
      <Color x:Key="RelatedElementHighlightBorderColor">#E6E0A030</Color>
      <SolidColorBrush x:Key="RelatedElementHighlightBrush" Color="{StaticResource RelatedElementHighlightColor}" />
      <SolidColorBrush x:Key="RelatedElementHighlightBorderBrush" Color="{StaticResource RelatedElementHighlightBorderColor}" />
      <!-- Stage X / D4 — Debugger. Current-statement marker + breakpoint glyph (solid red dot).
           D15.1 Seam B light-theme values: a calm blue full-line wash (~11% over the near-white editor)
           + a crisp navy accent bar at the line's left edge; a deeper red for the breakpoint. See the dark
           dictionary for the rationale. -->
      <Color x:Key="DebugCurrentLineColor">#380033B3</Color>
      <Color x:Key="DebugCurrentLineBarColor">#CC0033B3</Color>
      <Color x:Key="DebugBreakpointColor">#C42B1C</Color>
      <SolidColorBrush x:Key="DebugCurrentLineBrush" Color="{StaticResource DebugCurrentLineColor}" />
      <SolidColorBrush x:Key="DebugCurrentLineBarBrush" Color="{StaticResource DebugCurrentLineBarColor}" />
      <SolidColorBrush x:Key="DebugBreakpointBrush" Color="{StaticResource DebugBreakpointColor}" />
      <!-- Variables panel: subtle wash behind a variable the last step changed (change-highlight, spec §9.4).
           Same hue as this theme's current-line wash (DebugCurrentLineColor #0033B3) — see the Dark note. -->
      <Color x:Key="DebugVariableChangedColor">#330033B3</Color>
      <SolidColorBrush x:Key="DebugVariableChangedBrush" Color="{StaticResource DebugVariableChangedColor}" />
      <!-- Variables panel: per-kind glyph colours (distinct hues for fast recognition) + the pin (gold). -->
      <Color x:Key="DebugParamInColor">#2D6BBF</Color>
      <Color x:Key="DebugParamOutColor">#C77800</Color>
      <Color x:Key="DebugLocalColor">#1A7F4B</Color>
      <Color x:Key="DebugPinColor">#C99700</Color>
      <!-- Stage X / D10 — trigger NEW/OLD context columns: a distinct purple, apart from IN/OUT/local hues. -->
      <Color x:Key="DebugContextColor">#8E44AD</Color>
      <SolidColorBrush x:Key="DebugParamInBrush"  Color="{StaticResource DebugParamInColor}" />
      <SolidColorBrush x:Key="DebugParamOutBrush" Color="{StaticResource DebugParamOutColor}" />
      <SolidColorBrush x:Key="DebugLocalBrush"    Color="{StaticResource DebugLocalColor}" />
      <SolidColorBrush x:Key="DebugPinBrush"      Color="{StaticResource DebugPinColor}" />
      <SolidColorBrush x:Key="DebugContextBrush"  Color="{StaticResource DebugContextColor}" />
      <!-- Indigo/violet overlay marking a row with an unsaved modify edit in the Pola
           grid. The three pending states read at a glance — green = added, indigo =
           modified, red = dropped — and none collides with the blue hover/selection or
           the amber warning/transaction state. Amber was rejected: a low-alpha WARM
           colour over the near-black editor surface composites to brown, which reads as
           a warning, not a pending edit. A cool hue stays true on dark (no muddiness)
           and lands as a soft lavender on light. ~25% alpha, ARGB alpha-first;
           theme-invariant. -->
      <Color x:Key="RowModifiedColor">#407C4DFF</Color>
      <!-- Buffered Table Designer pending-row washes (~20% alpha, alpha-first ARGB). -->
      <Color x:Key="RowAddedColor">#3327AE60</Color>
      <Color x:Key="RowDroppedColor">#33E53935</Color>
      <!-- Role R‑2 / R‑3 — patrz komentarz w słowniku Dark. Wartości = dostrojone pary
           `SuccessIconColor` / `DangerIconColor` motywu JASNEGO, czyli dotychczasowy wygląd
           Commita i Rollbacku. To one były powodem, dla którego §7.2 kazało zacząć K7 od wartości:
           wspólne `#4CAF50` / `#F44336` były czytelne na ciemnym tle i za jasne na tym. -->
      <Color x:Key="CommitButtonForeground">#2E8B4F</Color>
      <Color x:Key="RollbackButtonForeground">#C23B3B</Color>
      <!-- Chrome-on-color tokens — identical to the Dark dictionary on purpose
           (they sit on theme-independent fills). See the Dark dictionary comment. -->
      <Color x:Key="OnAccentColor">#FFFFFF</Color>
      <Color x:Key="OnAccentSubtleColor">#80FFFFFF</Color>
      <Color x:Key="CloseButtonHoverColor">#E81123</Color>

      <!-- ⭐ Nieaktywny przycisk główny — patrz komentarz w słowniku Dark, gdzie stoi cały mechanizm.
           ⚠ TU wartości MUSZĄ się różnić od ciemnych i to jest sedno zgłoszenia: nieaktywna kontrolka ma być
           przygaszona względem SWOJEGO otoczenia, a otoczenie w tym motywie jest jasne. Ciemnoszare wypełnienie
           z Darka czytałoby się tutaj jak przycisk WŁĄCZONY, tylko w innym kolorze. -->
      <Color x:Key="AccentDisabledColor">#DDE1E6</Color>
      <Color x:Key="OnAccentDisabledColor">#8A9199</Color>

      <!-- ⭐ Pole na powierzchni unoszącej się — patrz słownik Dark, gdzie stoi cały pomiar. ⚠ TO jest motyw,
           w którym przesłanka zawodzi najmocniej: `SurfaceRaised` to tutaj `#FFFFFF`, a domyślne tło pola
           `#FCFCFD` — trzy jednostki. Wklęsłe `#EDEFF2` daje osiemnaście i pole wreszcie ma kształt
           w spoczynku, bez najeżdżania kursorem. -->
      <Color x:Key="FieldOnRaisedColor">#E9ECF1</Color>
      <!-- ⭐ Ten sam próg 3:1 wobec powierzchni (§10 / WCAG 1.4.11), zmierzony w tym motywie: `#9AA3B0` dawało
           2,55, `#8A94A3` daje 3,08. Na białym podłożu jasna kreska „prawie widoczna" to kreska niewidoczna. -->
      <Color x:Key="FieldOnRaisedBorderColor">#8A94A3</Color>

      <!-- Semantic icon colors (light theme): darker + more saturated than the dark
           variants so icons stay legible on the near-white surfaces. Same semantic
           keys; see the Dark dictionary for the mapping. -->
      <Color x:Key="AccentIconColor">#2D6BBF</Color>
      <!-- ⭐ M5 / §10: #2E8B4F → #2A7E48. `SuccessIconBrush` jest — jako jedyny w rodzinie severity —
           tokenem IKONOWYM użytym przez `MessageBanner.BrushKeyFor` także do TEKSTU (nie istnieje
           `SuccessBrush`), a na `PanelBrush` dawał 3,88:1 przy progu 4,5:1 dla tekstu < 14 px.
           Kandydat policzony PRZY PROGU przez mnożenie kanałów RGB: Panel 3,88 → 4,57,
           Background 4,16 → 4,90. ⚠ Zmiana ledwie zauważalna (render `m5c-text-Light.png`).
           ⏸ Brak `SuccessBrush` jest zapisany jako otwarta asymetria — patrz
           `product-polish-m5-severity-contrast-decision.md` §2.3; ⛔ nie tworzymy go tutaj. -->
      <Color x:Key="SuccessIconColor">#2A7E48</Color>
      <!-- Rola R‑1 „Uruchom" — patrz komentarz w słowniku Dark.
           ⚠⚠ OD M5 TA WARTOŚĆ ROZESZŁA SIĘ Z `SuccessIconColor` W TYM MOTYWIE (2E8B4F vs 2A7E48),
           i to jest projekt działający zgodnie z zamysłem, nie dryf: to dwa tokeny właśnie po to,
           żeby mogły się rozejść. Powód rozejścia jest MERYTORYCZNY — `SuccessIconColor` musiał
           zejść pod próg tekstowy 4,5:1, a R‑1 maluje WYŁĄCZNIE ikony (zmierzone: wszystkie cztery
           wystąpienia to `SvgIcon`), więc obowiązuje ją próg 3:1, który #2E8B4F spełnia z zapasem
           (3,88:1 na Panel). ⛔ Nie „naprawiać" tego przez zrównanie wartości. -->
      <Color x:Key="ActionRunColor">#2E8B4F</Color>
      <Color x:Key="DangerIconColor">#C23B3B</Color>
      <Color x:Key="WarningIconColor">#B5790E</Color>
      <Color x:Key="InfoIconColor">#2A7AA8</Color>
      <Color x:Key="NeutralIconColor">#3C3C3C</Color>
      <!-- Stage Q / Q3: the code-action light bulb. Its OWN token, not WarningIconBrush — "a fix is
           available here" is an offer, not a problem, and the two must not drift if either is retuned.
           Amber-gold reads as the universal light-bulb cue at a glance; hover switches to the accent so
           the bulb also says "interactive". -->
      <Color x:Key="CodeActionColor">#B07B0A</Color>
      <!-- D15.2 Seam A: shared subtle accent for the "loop operations" category (Next Iteration /
           Loop Exit). Teal — deliberately NOT the PSQL-keyword violet from D15.1. -->
      <Color x:Key="DebugLoopIconColor">#0E8074</Color>
      <SolidColorBrush x:Key="DebugLoopIconBrush" Color="{StaticResource DebugLoopIconColor}" />
      <!-- ARGB: ~9% black on light. -->
      <Color x:Key="IconHoverColor">#18000000</Color>

      <!-- ⭐ Pasek przewijania (H‑10) — patrz komentarz w motywie ciemnym. W Light uchwyt jest
           CIEMNIEJSZY od tła, czyli kierunek jest odwrotny, a rola ta sama. -->
      <Color x:Key="ScrollBarThumbColor">#C3C7CE</Color>
      <Color x:Key="ScrollBarThumbHoverColor">#A6ABB4</Color>
      <Color x:Key="ScrollBarThumbPressedColor">#888E98</Color>

      <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
      <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
      <SolidColorBrush x:Key="ChromeStrongBrush" Color="{StaticResource ChromeStrongColor}" />
      <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
      <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
      <!-- M3.5 / Z-2 — kontur kontrolki interaktywnej; rola i powód przy `ControlOutlineColor`. -->
      <SolidColorBrush x:Key="ControlOutlineBrush" Color="{StaticResource ControlOutlineColor}" />
      <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}" />
      <SolidColorBrush x:Key="SubtleForegroundBrush" Color="{StaticResource SubtleForegroundColor}" />
      <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="AccentMutedBrush" Color="{StaticResource AccentMutedColor}" />
      <SolidColorBrush x:Key="TransactionActiveBrush" Color="{StaticResource TransactionActiveColor}" />
      <SolidColorBrush x:Key="ConnectedBrush" Color="{StaticResource ConnectedColor}" />
      <SolidColorBrush x:Key="HoverOverlayBrush" Color="{StaticResource HoverOverlayColor}" />
      <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
      <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
      <SolidColorBrush x:Key="CompletionMatchBrush" Color="{StaticResource CompletionMatchColor}" />
      <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}" />
      <SolidColorBrush x:Key="FocusBorderBrush" Color="{StaticResource FocusBorderColor}" />
      <SolidColorBrush x:Key="RowAlternateBrush" Color="{StaticResource RowAlternateColor}" />
      <!-- Activity Monitor "operation bands": a 2-shade left stripe that flips on each
           transaction change (theme-independent subtle overlay; alpha-first per gotcha #1). -->
      <SolidColorBrush x:Key="TxBand0" Color="#00000000" />
      <SolidColorBrush x:Key="TxBand1" Color="#20808CA8" />
      <SolidColorBrush x:Key="DropTargetBrush" Color="{StaticResource DropTargetColor}" />
      <SolidColorBrush x:Key="SearchMatchBrush" Color="{StaticResource SearchMatchColor}" />
      <SolidColorBrush x:Key="RowModifiedBrush" Color="{StaticResource RowModifiedColor}" />
      <SolidColorBrush x:Key="RowAddedBrush" Color="{StaticResource RowAddedColor}" />
      <SolidColorBrush x:Key="RowDroppedBrush" Color="{StaticResource RowDroppedColor}" />
      <SolidColorBrush x:Key="CommitButtonBrush" Color="{StaticResource CommitButtonForeground}" />
      <SolidColorBrush x:Key="RollbackButtonBrush" Color="{StaticResource RollbackButtonForeground}" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
      <SolidColorBrush x:Key="OnAccentSubtleBrush" Color="{StaticResource OnAccentSubtleColor}" />
      <SolidColorBrush x:Key="AccentDisabledBrush" Color="{StaticResource AccentDisabledColor}" />
      <SolidColorBrush x:Key="FieldOnRaisedBrush" Color="{StaticResource FieldOnRaisedColor}" />
      <SolidColorBrush x:Key="FieldOnRaisedBorderBrush" Color="{StaticResource FieldOnRaisedBorderColor}" />
      <SolidColorBrush x:Key="OnAccentDisabledBrush" Color="{StaticResource OnAccentDisabledColor}" />
      <SolidColorBrush x:Key="CloseButtonHoverBrush" Color="{StaticResource CloseButtonHoverColor}" />

      <SolidColorBrush x:Key="AccentIconBrush" Color="{StaticResource AccentIconColor}" />
      <SolidColorBrush x:Key="SuccessIconBrush" Color="{StaticResource SuccessIconColor}" />
      <SolidColorBrush x:Key="ActionRunBrush" Color="{StaticResource ActionRunColor}" />
      <SolidColorBrush x:Key="DangerIconBrush" Color="{StaticResource DangerIconColor}" />
      <SolidColorBrush x:Key="WarningIconBrush" Color="{StaticResource WarningIconColor}" />
      <SolidColorBrush x:Key="InfoIconBrush" Color="{StaticResource InfoIconColor}" />
      <SolidColorBrush x:Key="NeutralIconBrush" Color="{StaticResource NeutralIconColor}" />
      <SolidColorBrush x:Key="CodeActionBrush" Color="{StaticResource CodeActionColor}" />
      <SolidColorBrush x:Key="IconHoverBrush" Color="{StaticResource IconHoverColor}" />

      <!-- Same TreeViewItem state-brush overrides for Light. See Dark dictionary above. -->
      <SolidColorBrush x:Key="TreeViewItemBackground" Color="Transparent" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="{StaticResource HoverOverlayColor}" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundPressed" Color="{StaticResource SelectionColor}" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="{StaticResource SelectionColor}" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="{StaticResource SelectionColor}" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPressed" Color="{StaticResource SelectionColor}" />
      <SolidColorBrush x:Key="TreeViewItemBorderBrush" Color="Transparent" />
      <SolidColorBrush x:Key="TreeViewItemBorderBrushPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="TreeViewItemBorderBrushPressed" Color="Transparent" />
      <SolidColorBrush x:Key="TreeViewItemBorderBrushSelected" Color="Transparent" />
      <SolidColorBrush x:Key="TreeViewItemBorderBrushSelectedPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="TreeViewItemBorderBrushSelectedPressed" Color="Transparent" />

      <!-- Same DataGridCell focus + background overrides for Light theme.
           See Dark dictionary above. -->
      <SolidColorBrush x:Key="DataGridCellFocusVisualPrimaryBrush" Color="{StaticResource FocusBorderColor}" />
      <SolidColorBrush x:Key="DataGridCellFocusVisualSecondaryBrush" Color="{StaticResource FocusBorderColor}" />
      <SolidColorBrush x:Key="DataGridCellBackgroundBrushSelected" Color="{StaticResource SelectionColor}" />
      <SolidColorBrush x:Key="DataGridCellBackgroundBrushFocused" Color="{StaticResource SelectionColor}" />
      <SolidColorBrush x:Key="DataGridCellBackgroundBrushSelectedFocused" Color="{StaticResource SelectionColor}" />
      <SolidColorBrush x:Key="DataGridCellBackgroundBrushSelectedUnfocused" Color="{StaticResource SelectionColor}" />
      <SolidColorBrush x:Key="DataGridCellForegroundBrushFocused" Color="{StaticResource ForegroundColor}" />

      <!-- Per-kind metadata icon brushes (light theme: Material 700/800 — darker and
           more saturated so glyphs stay legible against the near-white editor background). -->
      <SolidColorBrush x:Key="IconColor_Table"       Color="#0277BD" />
      <SolidColorBrush x:Key="IconColor_View"        Color="#2E7D32" />

      <!-- Transaction-lane chip backgrounds (C2): Data = blue, Metadata = purple.
           Deeper on light so white chip text stays legible. -->
      <SolidColorBrush x:Key="DataLaneChipBrush"     Color="#1F5BAA" />
      <SolidColorBrush x:Key="MetadataLaneChipBrush" Color="#6A3DB5" />
      <SolidColorBrush x:Key="IconColor_Procedure"   Color="#E65100" />
      <SolidColorBrush x:Key="IconColor_Trigger"     Color="#C62828" />
      <SolidColorBrush x:Key="IconColor_Function"    Color="#F9A825" />
      <SolidColorBrush x:Key="IconColor_Generator"   Color="#00838F" />
      <SolidColorBrush x:Key="IconColor_Domain"      Color="#6A1B9A" />
      <SolidColorBrush x:Key="IconColor_Package"     Color="#283593" />
      <SolidColorBrush x:Key="IconColor_Exception"   Color="#B71C1C" />
      <SolidColorBrush x:Key="IconColor_Role"        Color="#37474F" />
      <SolidColorBrush x:Key="IconColor_User"        Color="#37474F" />
      <SolidColorBrush x:Key="IconColor_Index"       Color="#558B2F" />
      <SolidColorBrush x:Key="IconColor_SystemTable" Color="#424242" />
      <SolidColorBrush x:Key="IconColor_Query"       Color="#455A64" />

      <!-- Editor semantic-highlight accent (Etap 6, §9.2) — light theme. Darker + more
           saturated than the dark variant for legibility on the near-white editor, and
           kept distinct in both hue AND lightness from the object palette above (§9.3).
           Conservative default; final visual tuning is a follow-up. -->
      <SolidColorBrush x:Key="EditorColumnBrush"     Color="#2E5C82" />
      <!-- D15.1: ordinary locals neutral (== default foreground); see the Dark block comment. -->
      <SolidColorBrush x:Key="EditorLocalBrush"      Color="#1F1F1F" />
      <!-- Domain-as-type paints like a SQL type (D15.1). MUST mirror the Light xshd DataType (#0F766E). -->
      <SolidColorBrush x:Key="EditorDataTypeBrush"   Color="#0F766E" />
      <!-- Trigger context variables — mirrors the Light "Function" lexical colour (#8C6600). -->
      <SolidColorBrush x:Key="EditorContextVariableBrush" Color="#8C6600" />
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <!-- ============================================================================
       FluentTheme accent override — THEME-INVARIANT, so it lives at the root of this
       dictionary (NOT inside a ThemeDictionary). A default Win11 install resolves
       SystemAccentColor to an orange/gold; FluentTheme derives the checked-CheckBox
       fill, RadioButton, ComboBox/ListBox item selection, ToggleSwitch, Slider, etc.
       from it — that's the amber leakage the per-control overrides (TreeViewItem*,
       DataGridCell*) don't catch. Overriding SystemAccentColor + its 6-step ramp here
       (top-level Application.Resources scope, which FluentTheme reads before the
       platform default) recolors all of them to the EmberTern accent blue at once.
       Our accent is the same blue in both themes, so a single theme-invariant value is
       correct AND simpler than duplicating into both ThemeDictionaries. This is the one
       sanctioned non-theme-scoped color block; every other color stays theme-scoped. -->
  <Color x:Key="SystemAccentColor">#2D6BBF</Color>
  <Color x:Key="SystemAccentColorLight1">#4582CC</Color>
  <Color x:Key="SystemAccentColorLight2">#6699D9</Color>
  <Color x:Key="SystemAccentColorLight3">#85B0E6</Color>
  <Color x:Key="SystemAccentColorDark1">#275CA3</Color>
  <Color x:Key="SystemAccentColorDark2">#214D87</Color>
  <Color x:Key="SystemAccentColorDark3">#1B4072</Color>
</ResourceDictionary>
