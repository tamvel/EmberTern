<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ================================================================================================
       FluentBridge — warstwa TŁUMACZĄCA słownik FluentTheme na katalog EmberTerna.

       ⭐ ZASADA POWSTANIA: nie przestylowujemy Fluenta i nie kopiujemy jego szablonów — PRZEPINAMY GO
       na nasze tokeny. Fluent maluje wnętrza kontrolek (`PART_BorderElement` i podobne) z własnych
       zasobów; ten plik podmienia te zasoby na nasze. Dzięki temu zachowujemy wszystkie sprawdzone
       zachowania frameworka (zaznaczanie tekstu, watermark, walidacja, przewijanie, animacje stanów),
       a wygląd i tak jest sterowany katalogiem.

       ⛔⛔ REGUŁA WIĄŻĄCA (użytkownik, 2026-08-02) — TEN PLIK NIE JEST DRUGIM KATALOGIEM TOKENÓW.
       Wyłącznie mapowanie. ŻADNYCH wartości lokalnych, ŻADNYCH nowych decyzji projektowych.
       Każda liczba i każda rola ma właściciela w `Tokens.axaml` / `Typography.axaml` / `Colors.axaml`;
       tutaj są wyłącznie odwołania. Egzekwuje to test `FluentBridge_ContainsNoLocalValues`.

       ⚠⚠ DLATEGO SĄ TU WYŁĄCZNIE KOLORY — i to jest wynik pomiaru, nie upodobanie.
       XAML nie potrafi ZAALIASOWAĆ zasobu skalarnego: `<x:Double x:Key="TextControlThemeMinHeight">`
       musi zawierać liczbę, bo nie da się w tym miejscu napisać „to samo, co `Size.Control`".
       Gdyby więc Bridge przejął metryki, musiałby wpisać liczby — czyli złamać powyższą regułę
       w pierwszej linijce. Pędzel jest wyjątkiem, bo `Color="{StaticResource …}"` JEST odwołaniem.
       ⭐ Konsekwencja jest korzystna: metryki (`MinHeight`, `Padding`, `FontSize`, `BorderThickness`)
       idą przez SETTERY STYLU w `ControlStyles.axaml`, które potrafią czytać token — a reguła
       „bez wartości lokalnych" staje się w tym pliku strukturalna, bo nie ma tu gdzie wpisać liczby.

       ⚠ Czego tu NIE MA i nie powinno być: `ControlCornerRadius`. Fluent ma tam 3, `Radius.Surface`
       ma 3 — wpis powielałby liczbę, więc zamiast niego zbieżność pinuje test.
       ================================================================================================ -->

  <ResourceDictionary.ThemeDictionaries>

    <!-- ⚠ Oba słowniki mają IDENTYCZNĄ treść, bo mapowanie jest takie samo w obu motywach — różnią
         się wyłącznie tokeny, na które wskazuje, a te są już rozdzielone w `Colors.axaml`. To jedyny
         powód, dla którego ten plik w ogóle ma `ThemeDictionaries`: zasoby Fluenta, które nadpisuje,
         są zależne od motywu, więc nadpisanie też musi być. -->

    <ResourceDictionary x:Key="Dark">
      <!-- ── TextBox (i wszystko, co go osadza: NumericUpDown, edytor komórki siatki) ────────────── -->
      <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource BackgroundColor}" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource BackgroundColor}" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource BackgroundColor}" />
      <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{StaticResource BackgroundColor}" />

      <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource BorderColor}" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{StaticResource AccentMutedColor}" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource FocusBorderColor}" />
      <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="{StaticResource BorderColor}" />

      <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource ForegroundColor}" />
      <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{StaticResource ForegroundColor}" />
      <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{StaticResource ForegroundColor}" />
      <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="{StaticResource SubtleForegroundColor}" />

      <!-- Podpowiedź w pustym polu — rola tekstu drugorzędnego, ta sama co podpisy pól. -->
      <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource SubtleForegroundColor}" />
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{StaticResource SubtleForegroundColor}" />
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{StaticResource SubtleForegroundColor}" />

      <!-- Zaznaczenie tekstu — ten sam pędzel, którym zaznacza się wiersz siatki i pozycja listy. -->
      <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{StaticResource SelectionColor}" />

      <!-- ── ComboBox ────────────────────────────────────────────────────────────────────────────
           ⭐ `ComboBoxDropDownBackground` to lista rozwijana, czyli powierzchnia UNIESIONA (RB‑4) —
           kolejny naturalny konsument `SurfaceRaised`, a nie chromy. W motywie jasnym to właśnie
           ta różnica sprawia, że rozwinięta lista czyta się jako pływająca nad formularzem.
           ⚠ Tło pola NIE zmienia się przy najechaniu ani wciśnięciu — sygnał niesie krawędź.
           Zmiana tła czytałaby się jak zmiana stanu DANYCH, a nie wskazania kursorem. -->
      <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource BackgroundColor}" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource BackgroundColor}" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{StaticResource BackgroundColor}" />
      <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="{StaticResource BackgroundColor}" />

      <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource BorderColor}" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{StaticResource AccentMutedColor}" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="{StaticResource AccentMutedColor}" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="{StaticResource BorderColor}" />

      <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource ForegroundColor}" />
      <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="{StaticResource SubtleForegroundColor}" />
      <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="{StaticResource SubtleForegroundColor}" />
      <!-- Chevron jest afordancją drugorzędną — niesie „to się rozwija", nie treść. -->
      <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="{StaticResource SubtleForegroundColor}" />

      <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource SurfaceRaisedColor}" />
      <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource BorderColor}" />

      <SolidColorBrush x:Key="ComboBoxItemForeground" Color="{StaticResource ForegroundColor}" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{StaticResource HoverOverlayColor}" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{StaticResource SelectionColor}" />

      <!-- ── Button (Product Polish M2b, krok 5.4) ────────────────────────────────────────────────
           H‑8: 25 surowych przycisków Fluenta bez `Classes`. Fluent maluje je pół-przezroczystą
           bielą (`#33ffffff`), a stan najechania CZYSTĄ BIELĄ — stąd „przycisk zapala się na biało",
           efekt obcy palecie warsztatu w obu motywach.

           ⭐ Drabina stanów jest MONOTONICZNA W OBU MOTYWACH i to jest cała jej treść:
           Panel → ChromeStrong to w Dark rozjaśnienie (#252526 → #2D2D2D), a w Light przyciemnienie
           (#F3F4F6 → #E8EAED). Kierunek jest przeciwny, znaczenie to samo — „o stopień bliżej
           kursora". To ta sama zasada, którą RB‑4 wydobyło z `ElevatedPanelBrush`.

           ⚠ WCIŚNIĘCIE NIESIE KRAWĘDŹ, NIE TRZECI ODCIEŃ SZAROŚCI — świadomie, i to jest ten sam
           język, który krok 5.3 ustalił dla `ComboBoxa`. Trzeci stopień szarości musiałby sięgnąć po
           `BorderColor` jako WYPEŁNIENIE, czyli użyć tokenu wbrew jego roli (§3.1) — a rola „krawędź"
           przestałaby cokolwiek znaczyć. Akcent na krawędzi jest czytelniejszy i tańszy.
           ⚠ Stan `:disabled` NIE zmienia tła: przygaszony jest TEKST. Zmiana tła czytałaby się jak
           inny rodzaj przycisku, a nie jak przycisk chwilowo niedostępny. -->
      <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource PanelColor}" />
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource ChromeStrongColor}" />
      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource ChromeStrongColor}" />
      <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{StaticResource PanelColor}" />

      <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource BorderColor}" />
      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{StaticResource AccentMutedColor}" />
      <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{StaticResource BorderColor}" />

      <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource ForegroundColor}" />
      <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource ForegroundColor}" />
      <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource ForegroundColor}" />
      <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{StaticResource SubtleForegroundColor}" />

      <!-- ── RepeatButton — strzałki spinnera (`NumericUpDown`, krok 5.5) ─────────────────────────
           Ta sama rodzina co `Button` i ten sam defekt: Fluent maluje je pół-przezroczystą bielą.
           ⚠ Strzałka jest afordancją drugorzędną — niesie „zwiększ/zmniejsz", a nie treść — więc
           w spoczynku jest BEZ TŁA i dopiero najechanie ją wydobywa. To ten sam podział, który
           `Button.icon` realizuje w pasku narzędzi. -->
      <SolidColorBrush x:Key="RepeatButtonBackground" Color="{StaticResource BackgroundColor}" />
      <SolidColorBrush x:Key="RepeatButtonBackgroundPointerOver" Color="{StaticResource ChromeStrongColor}" />
      <SolidColorBrush x:Key="RepeatButtonBackgroundPressed" Color="{StaticResource ChromeStrongColor}" />
      <SolidColorBrush x:Key="RepeatButtonBackgroundDisabled" Color="{StaticResource BackgroundColor}" />
      <SolidColorBrush x:Key="RepeatButtonBorderBrush" Color="{StaticResource BorderColor}" />
      <SolidColorBrush x:Key="RepeatButtonBorderBrushPointerOver" Color="{StaticResource BorderColor}" />
      <SolidColorBrush x:Key="RepeatButtonBorderBrushPressed" Color="{StaticResource BorderColor}" />
      <SolidColorBrush x:Key="RepeatButtonForeground" Color="{StaticResource SubtleForegroundColor}" />
      <SolidColorBrush x:Key="RepeatButtonForegroundPointerOver" Color="{StaticResource ForegroundColor}" />
      <SolidColorBrush x:Key="RepeatButtonForegroundPressed" Color="{StaticResource ForegroundColor}" />
      <SolidColorBrush x:Key="RepeatButtonForegroundDisabled" Color="{StaticResource SubtleForegroundColor}" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource BackgroundColor}" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource BackgroundColor}" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource BackgroundColor}" />
      <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{StaticResource BackgroundColor}" />

      <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource BorderColor}" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{StaticResource AccentMutedColor}" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource FocusBorderColor}" />
      <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="{StaticResource BorderColor}" />

      <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource ForegroundColor}" />
      <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{StaticResource ForegroundColor}" />
      <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{StaticResource ForegroundColor}" />
      <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="{StaticResource SubtleForegroundColor}" />

      <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource SubtleForegroundColor}" />
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{StaticResource SubtleForegroundColor}" />
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{StaticResource SubtleForegroundColor}" />

      <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{StaticResource SelectionColor}" />

      <!-- ── ComboBox ────────────────────────────────────────────────────────────────────────────
           ⭐ `ComboBoxDropDownBackground` to lista rozwijana, czyli powierzchnia UNIESIONA (RB‑4) —
           kolejny naturalny konsument `SurfaceRaised`, a nie chromy. W motywie jasnym to właśnie
           ta różnica sprawia, że rozwinięta lista czyta się jako pływająca nad formularzem.
           ⚠ Tło pola NIE zmienia się przy najechaniu ani wciśnięciu — sygnał niesie krawędź.
           Zmiana tła czytałaby się jak zmiana stanu DANYCH, a nie wskazania kursorem. -->
      <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource BackgroundColor}" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource BackgroundColor}" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{StaticResource BackgroundColor}" />
      <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="{StaticResource BackgroundColor}" />

      <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource BorderColor}" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{StaticResource AccentMutedColor}" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="{StaticResource AccentMutedColor}" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="{StaticResource BorderColor}" />

      <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource ForegroundColor}" />
      <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="{StaticResource SubtleForegroundColor}" />
      <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="{StaticResource SubtleForegroundColor}" />
      <!-- Chevron jest afordancją drugorzędną — niesie „to się rozwija", nie treść. -->
      <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="{StaticResource SubtleForegroundColor}" />

      <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource SurfaceRaisedColor}" />
      <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource BorderColor}" />

      <SolidColorBrush x:Key="ComboBoxItemForeground" Color="{StaticResource ForegroundColor}" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{StaticResource HoverOverlayColor}" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{StaticResource SelectionColor}" />

      <!-- ── Button (Product Polish M2b, krok 5.4) ────────────────────────────────────────────────
           H‑8: 25 surowych przycisków Fluenta bez `Classes`. Fluent maluje je pół-przezroczystą
           bielą (`#33ffffff`), a stan najechania CZYSTĄ BIELĄ — stąd „przycisk zapala się na biało",
           efekt obcy palecie warsztatu w obu motywach.

           ⭐ Drabina stanów jest MONOTONICZNA W OBU MOTYWACH i to jest cała jej treść:
           Panel → ChromeStrong to w Dark rozjaśnienie (#252526 → #2D2D2D), a w Light przyciemnienie
           (#F3F4F6 → #E8EAED). Kierunek jest przeciwny, znaczenie to samo — „o stopień bliżej
           kursora". To ta sama zasada, którą RB‑4 wydobyło z `ElevatedPanelBrush`.

           ⚠ WCIŚNIĘCIE NIESIE KRAWĘDŹ, NIE TRZECI ODCIEŃ SZAROŚCI — świadomie, i to jest ten sam
           język, który krok 5.3 ustalił dla `ComboBoxa`. Trzeci stopień szarości musiałby sięgnąć po
           `BorderColor` jako WYPEŁNIENIE, czyli użyć tokenu wbrew jego roli (§3.1) — a rola „krawędź"
           przestałaby cokolwiek znaczyć. Akcent na krawędzi jest czytelniejszy i tańszy.
           ⚠ Stan `:disabled` NIE zmienia tła: przygaszony jest TEKST. Zmiana tła czytałaby się jak
           inny rodzaj przycisku, a nie jak przycisk chwilowo niedostępny. -->
      <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource PanelColor}" />
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource ChromeStrongColor}" />
      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource ChromeStrongColor}" />
      <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{StaticResource PanelColor}" />

      <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource BorderColor}" />
      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{StaticResource AccentMutedColor}" />
      <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{StaticResource BorderColor}" />

      <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource ForegroundColor}" />
      <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource ForegroundColor}" />
      <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource ForegroundColor}" />
      <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{StaticResource SubtleForegroundColor}" />

      <!-- ── RepeatButton — strzałki spinnera (`NumericUpDown`, krok 5.5) ─────────────────────────
           Ta sama rodzina co `Button` i ten sam defekt: Fluent maluje je pół-przezroczystą bielą.
           ⚠ Strzałka jest afordancją drugorzędną — niesie „zwiększ/zmniejsz", a nie treść — więc
           w spoczynku jest BEZ TŁA i dopiero najechanie ją wydobywa. To ten sam podział, który
           `Button.icon` realizuje w pasku narzędzi. -->
      <SolidColorBrush x:Key="RepeatButtonBackground" Color="{StaticResource BackgroundColor}" />
      <SolidColorBrush x:Key="RepeatButtonBackgroundPointerOver" Color="{StaticResource ChromeStrongColor}" />
      <SolidColorBrush x:Key="RepeatButtonBackgroundPressed" Color="{StaticResource ChromeStrongColor}" />
      <SolidColorBrush x:Key="RepeatButtonBackgroundDisabled" Color="{StaticResource BackgroundColor}" />
      <SolidColorBrush x:Key="RepeatButtonBorderBrush" Color="{StaticResource BorderColor}" />
      <SolidColorBrush x:Key="RepeatButtonBorderBrushPointerOver" Color="{StaticResource BorderColor}" />
      <SolidColorBrush x:Key="RepeatButtonBorderBrushPressed" Color="{StaticResource BorderColor}" />
      <SolidColorBrush x:Key="RepeatButtonForeground" Color="{StaticResource SubtleForegroundColor}" />
      <SolidColorBrush x:Key="RepeatButtonForegroundPointerOver" Color="{StaticResource ForegroundColor}" />
      <SolidColorBrush x:Key="RepeatButtonForegroundPressed" Color="{StaticResource ForegroundColor}" />
      <SolidColorBrush x:Key="RepeatButtonForegroundDisabled" Color="{StaticResource SubtleForegroundColor}" />
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
