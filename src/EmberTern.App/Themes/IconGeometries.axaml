<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:EmberTern.App.Controls">

  <!-- ============================================================================
       Central icon geometry dictionary — runtime source for all SvgIcon controls.

       Icons are Lucide (https://lucide.dev, ISC license): 24×24 viewBox, stroke-
       based, 2px stroke, round caps/joins. The matching source-of-truth .svg files
       live under Assets/Icons/<category>/ (excluded from the build output — repo
       source only; runtime uses these geometries).

       Reuse before create — see the "Icon System" section in CLAUDE.md.
       Add a new icon by: 1) dropping the Lucide .svg into Assets/Icons/<category>/,
       2) adding its path data here as <StreamGeometry x:Key="Icon.Name">.
       Color flows through a theme token on Foreground — NEVER bake a color here.
       ============================================================================ -->

  <!-- Actions -->
  <StreamGeometry x:Key="Icon.Play">M8 5 L19 12 L8 19 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Stop">M6 6 H18 V18 H6 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Check">M5 12.5 L10 17.5 L19 6.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Undo">M10 8 L5 12.5 L10 17 M5 12.5 H15 A4.5 4.5 0 0 1 15 21.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Plus">M12 5 V19 M5 12 H19</StreamGeometry>
  <!-- Lucide minus / arrow-up / arrow-down — field Drop / Move Up / Move Down + data
       Delete row. Authored as clean primitives (trivial line/chevron shapes). -->
  <StreamGeometry x:Key="Icon.Minus">M5 12 H19</StreamGeometry>
  <StreamGeometry x:Key="Icon.ArrowUp">M5 12 l7-7 7 7 M12 19 V5</StreamGeometry>
  <StreamGeometry x:Key="Icon.ArrowDown">M12 5 V19 M19 12 l-7 7-7-7</StreamGeometry>
  <StreamGeometry x:Key="Icon.Pencil">M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497zM15 5l4 4</StreamGeometry>
  <StreamGeometry x:Key="Icon.Trash">M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M10 11v6M14 11v6</StreamGeometry>
  <StreamGeometry x:Key="Icon.ListX">M11 12H3M16 6H3M16 18H3M19 10l-4 4M15 10l4 4</StreamGeometry>
  <StreamGeometry x:Key="Icon.Save">M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zM17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7M7 3v4a1 1 0 0 0 1 1h7</StreamGeometry>
  <!-- X (Lucide x): generic close / dismiss — tab strip close + Close-tab toolbar.
       Window caption close keeps its own Icon.WindowClose (window-chrome domain). -->
  <StreamGeometry x:Key="Icon.X">M18 6 L6 18 M6 6 L18 18</StreamGeometry>
  <!-- Copy (Lucide copy): front rounded-rect (x8 y8 14×14 rx2 → authored as M…Z)
       + the back document path (verbatim Lucide). -->
  <StreamGeometry x:Key="Icon.Copy">M10 8 H20 A2 2 0 0 1 22 10 V20 A2 2 0 0 1 20 22 H10 A2 2 0 0 1 8 20 V10 A2 2 0 0 1 10 8 Z M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2</StreamGeometry>
  <!-- Eraser (Lucide eraser): the 2nd Lucide path's relative "m5.082 11.09" is
       re-anchored to absolute "M5.082 11.09" so concatenation doesn't shift it
       relative to the 1st figure's endpoint (see gotcha on multi-path icons). -->
  <StreamGeometry x:Key="Icon.Eraser">M21 21H8a2 2 0 0 1-1.42-.587l-3.994-3.999a2 2 0 0 1 0-2.828l10-10a2 2 0 0 1 2.829 0l5.999 6a2 2 0 0 1 0 2.828L12.834 21 M5.082 11.09 l8.828 8.828</StreamGeometry>
  <!-- Braces (Lucide braces): "{ }" code — Format SQL. Both sub-paths start
       absolute M and use only explicit commands — verbatim. -->
  <StreamGeometry x:Key="Icon.Braces">M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5c0 1.1.9 2 2 2h1 M16 21h1a2 2 0 0 0 2-2v-5c0-1.1.9-2 2-2a2 2 0 0 1-2-2V5a2 2 0 0 0-2-2h-1</StreamGeometry>
  <!-- Hammer (Lucide hammer): build / compile structural DDL. The three relative
       "m…" sub-paths are re-anchored to absolute M + explicit l so figure
       concatenation doesn't carry the previous endpoint. -->
  <StreamGeometry x:Key="Icon.Hammer">M15 12 l-9.373 9.373a1 1 0 0 1-3.001-3L12 9 M18 15 l4-4 M21.5 11.5 l-1.914-1.914A2 2 0 0 1 19 8.172v-.344a2 2 0 0 0-.586-1.414l-1.657-1.657A6 6 0 0 0 12.516 3H9l1.243 1.243A6 6 0 0 1 12 8.485V10l2 2h1.172a2 2 0 0 1 1.414.586L18.5 14.5</StreamGeometry>
  <!-- Folder-plus (Lucide folder-plus): all sub-paths start absolute M — verbatim. -->
  <StreamGeometry x:Key="Icon.FolderPlus">M12 10v6 M9 13h6 M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z</StreamGeometry>
  <!-- New Table — composed from Lucide primitives (no `table-plus` in Lucide core):
       a small rounded table grid (top-left) + a plus (bottom-right) = "create table". -->
  <StreamGeometry x:Key="Icon.TablePlus">M5 3 H12 A2 2 0 0 1 14 5 V12 A2 2 0 0 1 12 14 H5 A2 2 0 0 1 3 12 V5 A2 2 0 0 1 5 3 Z M3 8.5 H14 M8.5 3 V14 M18.5 15 V22 M15 18.5 H22</StreamGeometry>
  <!-- New View: an eye (lens + pupil) shrunk into the top-left + the SAME
       bottom-right "+" overlay as Icon.TablePlus, so "New View" reads as a create
       action visually consistent with "New Table". -->
  <StreamGeometry x:Key="Icon.ViewPlus">M2 9.5 C4.5 4 11.5 4 14 9.5 C11.5 15 4.5 15 2 9.5 Z M5.4 9.5 A2.6 2.6 0 1 0 10.6 9.5 A2.6 2.6 0 1 0 5.4 9.5 Z M18.5 15 V22 M15 18.5 H22</StreamGeometry>
  <!-- New Procedure: a small rounded terminal square (top-left) with a ">" prompt +
       the SAME bottom-right "+" overlay as Icon.TablePlus / Icon.ViewPlus, so
       "New Procedure" reads as a create action consistent with the others. -->
  <StreamGeometry x:Key="Icon.ProcedurePlus">M5 3 H12 A2 2 0 0 1 14 5 V12 A2 2 0 0 1 12 14 H5 A2 2 0 0 1 3 12 V5 A2 2 0 0 1 5 3 Z M6 6.5 l2 2 -2 2 M9.5 10.5 h3 M18.5 15 V22 M15 18.5 H22</StreamGeometry>
  <!-- New Trigger: a lightning bolt (top-left) + the SAME bottom-right "+" overlay,
       so "New Trigger" reads as a create action consistent with the others (the bolt
       matches the metadata-tree Trigger glyph Icon.Trigger). -->
  <StreamGeometry x:Key="Icon.TriggerPlus">M9 2 L4 11 H8 L7 16 L13 7 H9 Z M18.5 15 V22 M15 18.5 H22</StreamGeometry>
  <!-- New Function: a rounded square with an ƒ glyph (top-left) + the SAME bottom-right
       "+" overlay, consistent with the other New-object create actions. -->
  <StreamGeometry x:Key="Icon.FunctionPlus">M5 3 H12 A2 2 0 0 1 14 5 V12 A2 2 0 0 1 12 14 H5 A2 2 0 0 1 3 12 V5 A2 2 0 0 1 5 3 Z M10 5.4 c-1.5 0 -2.1 0.9 -2.1 2.3 V11.4 M6.6 8.3 H10.4 M18.5 15 V22 M15 18.5 H22</StreamGeometry>
  <!-- New Generator: a small "#" (top-left, matching the metadata-tree Generator glyph
       Icon.Generator) + the SAME bottom-right "+" overlay as the other New-object icons. -->
  <StreamGeometry x:Key="Icon.GeneratorPlus">M2 6 H13 M2 10 H13 M7 2 L6 14 M11 2 L10 14 M18.5 15 V22 M15 18.5 H22</StreamGeometry>
  <!-- New Domain: a small diamond (top-left, matching the metadata-tree Domain glyph
       Icon.Domain) + the SAME bottom-right "+" overlay as the other New-object icons. -->
  <StreamGeometry x:Key="Icon.DomainPlus">M8 2 L14 8 L8 14 L2 8 Z M18.5 15 V22 M15 18.5 H22</StreamGeometry>
  <!-- Pencil-ruler (Lucide pencil-ruler): design / edit table structure (the inline
       field-edit toggle). Relative "m…" sub-paths re-anchored to absolute M + l. -->
  <StreamGeometry x:Key="Icon.PencilRuler">M13 7 8.7 2.7a2.41 2.41 0 0 0-3.4 0L2.7 5.3a2.41 2.41 0 0 0 0 3.4L7 13 M8 6 l2-2 M18 16 l2-2 M17 11 l4.3 4.3c.94.94.94 2.46 0 3.4l-2.6 2.6c-.94.94-2.46.94-3.4 0L11 17 M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z M15 5 l4 4</StreamGeometry>

  <!-- Connection -->
  <!-- Plug-zap (Lucide plug-zap): connect — energized plug reads as an action and
       stays legible at toolbar size (clearer than a plain plug). The relative
       "m…" sub-paths are re-anchored to absolute M + explicit l. -->
  <StreamGeometry x:Key="Icon.PlugZap">M6.3 20.3a2.4 2.4 0 0 0 3.4 0L12 18l-6-6-2.3 2.3a2.4 2.4 0 0 0 0 3.4Z M2 22 l3-3 M7.5 13.5 10 11 M10.5 16.5 13 14 M18 3 l-4 4h6l-4 4</StreamGeometry>
  <!-- Unplug (Lucide unplug): disconnect. The two relative "m…" sub-paths
       ("m19 5", "m2 22", "m12 6") are re-anchored to absolute M with explicit l
       so figure concatenation doesn't carry the previous endpoint. -->
  <StreamGeometry x:Key="Icon.Unplug">M19 5 l3-3 M2 22 l3-3 M6.3 20.3a2.4 2.4 0 0 0 3.4 0L12 18l-6-6-2.3 2.3a2.4 2.4 0 0 0 0 3.4Z M7.5 13.5 10 11 M10.5 16.5 13 14 M12 6 l6 6 l2.3-2.3 a2.4 2.4 0 0 0 0-3.4 l-2.6-2.6 a2.4 2.4 0 0 0-3.4 0 Z</StreamGeometry>

