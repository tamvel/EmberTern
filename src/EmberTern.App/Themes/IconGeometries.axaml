  <StreamGeometry x:Key="Icon.ExceptionPlus">M8 2 L14 13 H2 Z M8 6 V9 M8 11 h.01 M18.5 15 V22 M15 18.5 H22</StreamGeometry>
  <!-- Pencil-ruler (Lucide pencil-ruler): design / edit table structure (the inline
       field-edit toggle). Relative "m…" sub-paths re-anchored to absolute M + l. -->
  <StreamGeometry x:Key="Icon.PencilRuler">M13 7 8.7 2.7a2.41 2.41 0 0 0-3.4 0L2.7 5.3a2.41 2.41 0 0 0 0 3.4L7 13 M8 6 l2-2 M18 16 l2-2 M17 11 l4.3 4.3c.94.94.94 2.46 0 3.4l-2.6 2.6c-.94.94-2.46.94-3.4 0L11 17 M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z M15 5 l4 4</StreamGeometry>

  <!-- Connection -->
  <!-- Plug-zap (Lucide plug-zap): connect — energized plug reads as an action and
       stays legible at toolbar size (clearer than a plain plug). The relative
       "m…" sub-paths are re-anchored to absolute M + explicit l. -->
