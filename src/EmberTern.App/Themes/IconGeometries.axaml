  <StreamGeometry x:Key="Icon.ChevronLeft">M15 18 L9 12 L15 6</StreamGeometry>
  <StreamGeometry x:Key="Icon.ChevronRight">M9 18 L15 12 L9 6</StreamGeometry>
  <StreamGeometry x:Key="Icon.ChevronLast">M7 18 L13 12 L7 6 M17 6 V18</StreamGeometry>
  <!-- chevrons-up / chevrons-down (Lucide): maximize / restore the results panel. -->
  <StreamGeometry x:Key="Icon.ChevronsUp">M17 11 L12 6 L7 11 M17 18 L12 13 L7 18</StreamGeometry>
  <StreamGeometry x:Key="Icon.ChevronsDown">M7 6 L12 11 L17 6 M7 13 L12 18 L17 13</StreamGeometry>
  <StreamGeometry x:Key="Icon.ChevronDown">M6 9 L12 15 L18 9</StreamGeometry>
  <!-- Search (Lucide search): circle cx11 cy11 r8 + handle. -->
  <StreamGeometry x:Key="Icon.Search">M19 11 A8 8 0 1 1 3 11 A8 8 0 1 1 19 11 Z M21 21 L16.65 16.65</StreamGeometry>

  <!-- Window controls -->
  <StreamGeometry x:Key="Icon.WindowMinimize">M5 12 H19</StreamGeometry>
  <StreamGeometry x:Key="Icon.WindowMaximize">M6 6 H18 V18 H6 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.WindowRestore">M6 9 H16 V19 H6 Z M9 9 V6 H19 V16 H16</StreamGeometry>
  <StreamGeometry x:Key="Icon.WindowClose">M6 6 L18 18 M18 6 L6 18</StreamGeometry>

  <!-- ============================================================================
       Metadata object kinds (Etap 2) — one geometry per MetadataObjectKind, keyed
       "Icon.<KindName>" so MetadataNodeViewModel.GeometryKeyFor(kind) = $"Icon.{kind}".
       Resolved at render time via IconGeometryConverter; color flows separately through
       IconBrushConverter + the per-kind IconColor_* tokens. All authentic Lucide except
       Domain (diamond) / Generator (hash) authored as clean primitives, and circles/
       ellipses written in canonical relative-arc form. Plus tree-chrome icons: Query
       (SQL editor tab), Connection (root node), Folder (connection folders). -->
  <StreamGeometry x:Key="Icon.Table">M5 3 H19 A2 2 0 0 1 21 5 V19 A2 2 0 0 1 19 21 H5 A2 2 0 0 1 3 19 V5 A2 2 0 0 1 5 3 Z M12 3 V21 M3 9 H21 M3 15 H21</StreamGeometry>
