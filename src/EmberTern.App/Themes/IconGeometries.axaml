  <StreamGeometry x:Key="Icon.Procedure">M5 3 H19 A2 2 0 0 1 21 5 V19 A2 2 0 0 1 19 21 H5 A2 2 0 0 1 3 19 V5 A2 2 0 0 1 5 3 Z M7 11 l2-2-2-2 M11 13 h4</StreamGeometry>
  <StreamGeometry x:Key="Icon.Trigger">M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Function">M5 3 H19 A2 2 0 0 1 21 5 V19 A2 2 0 0 1 19 21 H5 A2 2 0 0 1 3 19 V5 A2 2 0 0 1 5 3 Z M9 17c2 0 2.8-1 2.8-2.8V10c0-2 1-3.3 3.2-3 M9 11.2h5.7</StreamGeometry>
  <StreamGeometry x:Key="Icon.Generator">M4 9 H20 M4 15 H20 M10 3 L8 21 M16 3 L14 21</StreamGeometry>
  <StreamGeometry x:Key="Icon.Domain">M12 2 L22 12 L12 22 L2 12 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Package">M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z M12 22V12 M3.29 7 L12 12 L20.71 7 M7.5 4.27 l9 5.15</StreamGeometry>
  <StreamGeometry x:Key="Icon.Exception">M21.73 18 l-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3 M12 9 v4 M12 17 h.01</StreamGeometry>
  <StreamGeometry x:Key="Icon.Role">M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z</StreamGeometry>
  <StreamGeometry x:Key="Icon.User">M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2 M8 7 a4 4 0 1 0 8 0 a4 4 0 1 0-8 0</StreamGeometry>
  <StreamGeometry x:Key="Icon.Index">M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z M16 7.5 a.5 .5 0 1 0 1 0 a.5 .5 0 1 0-1 0</StreamGeometry>
  <StreamGeometry x:Key="Icon.SystemTable">M3 5 a9 3 0 1 0 18 0 a9 3 0 1 0-18 0 M3 5 V19 A9 3 0 0 0 21 19 V5 M3 12 A9 3 0 0 0 21 12</StreamGeometry>
  <StreamGeometry x:Key="Icon.Query">M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z M14 2v5a1 1 0 0 0 1 1h5 M10 12.5 8 15l2 2.5 M14 12.5 l2 2.5-2 2.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Connection">M4 2 H20 A2 2 0 0 1 22 4 V8 A2 2 0 0 1 20 10 H4 A2 2 0 0 1 2 8 V4 A2 2 0 0 1 4 2 Z M4 14 H20 A2 2 0 0 1 22 16 V20 A2 2 0 0 1 20 22 H4 A2 2 0 0 1 2 20 V16 A2 2 0 0 1 4 14 Z M6 6 h.01 M6 18 h.01</StreamGeometry>
  <StreamGeometry x:Key="Icon.Folder">M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z</StreamGeometry>

  <!-- ============================================================================
       SvgIcon ControlTheme — the single render path for every icon above.
       A fixed 24×24 Canvas inside a Uniform Viewbox guarantees a consistent
       coordinate space (and therefore consistent stroke weight) regardless of each
       icon's actual bounds. Stroke = Foreground so a theme token colors the icon
       and theme toggle re-evaluates live. Default size 16; override Width/Height
       per use (e.g. 14 for workspace tabs, 12 for the tab-strip close button).
       ============================================================================ -->
  <ControlTheme x:Key="{x:Type controls:SvgIcon}" TargetType="controls:SvgIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource NeutralIconBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Viewbox Stretch="Uniform">
          <Canvas Width="24" Height="24">
            <Path Data="{TemplateBinding Data}"
                  Stroke="{TemplateBinding Foreground}"
                  StrokeThickness="2"
                  StrokeLineCap="Round"
                  StrokeJoin="Round" />
          </Canvas>
        </Viewbox>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
