  <StreamGeometry x:Key="Icon.DomainPlus">M8 2 L14 8 L8 14 L2 8 Z M18.5 15 V22 M15 18.5 H22</StreamGeometry>
  <!-- New Package: a small isometric box (top-left, matching the metadata-tree Package
       glyph Icon.Package) + the SAME bottom-right "+" overlay as the other New-object icons. -->
  <StreamGeometry x:Key="Icon.PackagePlus">M2 5 L8 2 L14 5 L8 8 Z M2 5 V11 L8 14 M14 5 V11 L8 14 M8 8 V14 M18.5 15 V22 M15 18.5 H22</StreamGeometry>
  <!-- New Exception: a small warning triangle (top-left, matching the metadata-tree
