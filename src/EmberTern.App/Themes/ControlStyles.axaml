<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:EmberTern.App.Controls"
        xmlns:aecc="using:AvaloniaEdit.CodeCompletion">

  <!-- ============================================================================================
       ⭐ THE APPLICATION ICON — declared ONCE, for EVERY window.

       Avalonia has no application-level window icon: Window.Icon is per window and defaults to null,
       which the OS renders as a blank slot in the title bar and in Alt+Tab. Before this style only
       MainWindow set one (in its code-behind), so all 25 other windows — Settings Center, Keyboard
       Shortcuts, Third-party notices, the BLOB editor and every dialog — showed no icon at all.

       Window.Icon is a StyledProperty, so ONE setter here reaches every window, including windows
       that do not exist yet. That is the point: a per-window assignment is a rule someone has to
       remember 26 times, and the 27th window is the one that forgets. The code-behind assignment in
       MainWindow was removed with this change — a local value outranks a style setter, so leaving it
       would make MainWindow the one window whose icon comes from somewhere else.

       ⚠ THIS IS THE ONLY PLACE THE OS ICON PATH IS WRITTEN. The other two references to the branding
       folder have different jobs and are not substitutes: EmberTern.App.csproj's <ApplicationIcon>
       embeds the .ico in the executable (Explorer, and the taskbar before the app has a window), and
       AboutWindow.axaml shows the PNG mark inside the UI. Swapping the artwork is documented in
       Assets/Branding/BRANDING.md.

       ⚠ The .ico, not the PNG: it carries 16/24/32/48/64/256 renditions, so Windows picks the size it
       is about to draw instead of downscaling a 256px bitmap into a 16px title-bar slot.
       ============================================================================================ -->
  <Style Selector="Window">
    <Setter Property="Icon" Value="avares://EmberTern/Assets/Branding/EmberTern.ico" />
  </Style>

  <!-- ============================================================================================
       MessageBanner — the IDE's ONE message surface. Its chrome lives here, in exactly TWO variants,
       so no host can invent a third:
         · (default) STANDALONE — the banner sits inside content: a full border on all four sides.
         · .docked   — the banner is a full-width strip attached to a panel edge (under a toolbar, at
                       the foot of an editor): horizontal rules only, no side borders.
       Nothing else about the banner is per-host: padding, stripe, icon and typography are fixed in
       the control itself, and the message text carries the severity colour in full. Only outer
       Margin stays with the host, because that is placement inside a layout, not chrome.
       ============================================================================================ -->
  <Style Selector="controls|MessageBanner">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="controls|MessageBanner.docked">
    <Setter Property="BorderThickness" Value="0,1,0,1" />
  </Style>

  <!-- Autocomplete popup: give it an ELEVATED background + border so it reads as a floating panel
       ABOVE the editor. AvaloniaEdit's default leaves it the same colour as the editor surface, which
       in the Light theme made the popup indistinguishable from the code behind it.
       IMPORTANT: AvaloniaEdit's CompletionList control template is *only* the inner CompletionListBox
       (a Fluent ListBox via BasedOn) — the CompletionList itself never paints its own Background, so
       styling `aecc|CompletionList` Background is a visual no-op (the earlier attempt that "didn't
       work"). The visible surface is the CompletionListBox, which otherwise paints the Fluent default
       ListBox background (near-white in Light → blends with the editor). So style the LIST BOX.
       Elevated panel + border in both themes; item selection/hover colours come from the ListBoxItem
       overrides below. (Included after AvaloniaEdit's theme in App.axaml, so these setters win.) -->
  <Style Selector="aecc|CompletionListBox">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- Code-action menu (Stage Q). Deliberately the SAME visual language as the completion list above:
       it is another editor popup, not a component from a different application. Elevated surface, a
       1px border, 12px rows — the completion row's own RowFontSize — and tight item padding, because
       Fluent's default ListBoxItem padding is what made this read as a separate window. Chrome lives
       here rather than on the control so no future caller can invent a second look. -->
  <Style Selector="ListBox.code-action-menu">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.code-action-menu ListBoxItem">
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
  </Style>

  <!-- ================================================================================================
       ToolTip — M‑2 („bez stylu i bez standardu opóźnienia"), Product Polish M2b krok 4.

       ⭐ Pierwszy NOWY konsument `SurfaceRaisedBrush` (RB‑4) — i najczystszy przypadek tej roli, jaki
       jest w aplikacji: podpowiedź nie należy do żadnego kontenera, tylko unosi się nad wszystkim.
       Dzięki temu ten styl jest zarazem sprawdzianem, czy podział z kroku 2 jest użyteczny, a nie
       tylko poprawny.

       ⚠ OPÓŹNIENIA ZOSTAJĄ NA WARTOŚCIACH AVALONII I TO JEST DECYZJA, NIE POMINIĘCIE.
       Zmierzone: `ShowDelay` = 400 ms, `BetweenShowDelay` = 100 ms, `Placement` = Pointer.
       Audyt zarzucał „brak standardu", a nie złą wartość — i 400 ms jest dobrą wartością: krócej
       oznacza podpowiedzi wyskakujące, gdy kursor tylko PRZEJEŻDŻA przez pasek narzędzi, co przy
       ośmiogodzinnej pracy jest hałasem, nie pomocą. Drugie 100 ms sprawia, że przejście na sąsiedni
       przycisk pokazuje podpowiedź natychmiast — czyli seria przycisków czyta się płynnie.
       ⛔ Nie da się ich zresztą ustawić tutaj: to właściwości DOŁĄCZONE, ustawiane na WŁAŚCICIELU
       podpowiedzi, więc styl `ToolTip` ich nie widzi. Zmiana wymagałaby settera na selektorze
       uniwersalnym — kosztu nieproporcjonalnego do wartości, która i tak jest właściwa.

       ⚠ Rozmiar celowo nietknięty (`MaxWidth`, zawijanie). Zawartość podpowiedzi to zwykły tekst
       renderowany jako `TextBlock` bez zawijania — samo `MaxWidth` przycięłoby go, zamiast zawinąć.
       Długie podpowiedzi to osobny, mierzalny temat, nie efekt uboczny zmiany wyglądu.
       ================================================================================================ -->
  <!-- ================================================================================================
       TextBox — Compact Controls (RB‑3, decyzja D1), Product Polish M2b krok 5.2.

       ⭐ TU SĄ WYŁĄCZNIE METRYKI. Kolory tej kontrolki maluje wnętrze szablonu Fluenta
       (`PART_BorderElement`), więc setter `Background`/`BorderBrush` na `TextBox` nie ma dokąd
       trafić — one idą przez `Themes/FluentBridge.axaml`. Podział jest wymuszony pomiarem, nie
       upodobaniem: XAML nie potrafi zaaliasować zasobu skalarnego, więc gdyby metryki trafiły do
       Bridge'a, musiałby on wpisać liczby i przestałby być warstwą mapującą (§15.6.3).

       ⚠ Setter stylu aplikacji ma wyższy priorytet niż `ControlTheme` Fluenta — stąd `MinHeight`
       zadziała mimo `TextControlThemeMinHeight` = 32.

       ⚠ `VerticalContentAlignment=Center` jest konieczne, a nie kosmetyczne: `Pad.Control` ma pion
       ZEROWY, bo wysokość ma dawać `Size.Control`, a nie padding (jedna wielkość, jeden właściciel).
       Bez wyśrodkowania tekst przy `Stretch` osiadłby przy górnej krawędzi.
       ================================================================================================ -->
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="{DynamicResource Size.Control}" />
    <Setter Property="Padding" Value="{DynamicResource Pad.Control}" />
    <Setter Property="FontSize" Value="{DynamicResource Text.Application.Size}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Border.All}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- ⚠ Edytor w komórce siatki NIE jest kontrolką formularza i nie może narzucać wiersza.
       `Size.Row.Grid` (22) minus `Pad.Cell` (3+3) zostawia 16 px — pole o `MinHeight` 24 podniosłoby
       każdy edytowany wiersz o 8 px, czyli wprowadziłoby skok układu przy wejściu w edycję
       (§13.3 specyfikacji, Zero Layout Shift). §5 wprost przypisuje edytorom w komórce wysokość
       wiersza siatki, nie kontrolki. -->
  <Style Selector="DataGridCell TextBox">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="{DynamicResource Pad.CellCompact}" />
    <Setter Property="FontSize" Value="{DynamicResource Text.Grid.Size}" />
  </Style>

  <!-- ================================================================================================
       ComboBox — Compact Controls, Product Polish M2b krok 5.3. Metryki tutaj, kolory w Bridge'u.

       ⭐ Ta kontrolka jest sprawdzianem, czy most SKALUJE SIĘ na kolejne kontrolki — i skaluje:
       nie trzeba było ani jednego własnego szablonu, mimo że `ComboBox` ma ich znacznie więcej niż
       `TextBox` (Background, HighlightBackground, DropDownOverlay, DropDownGlyph, PART_Popup).

       ⚠ `ComboBoxItem` dostaje `Size.Row.Menu` (22) i `Pad.MenuItem`, a nie wysokość kontrolki.
       Pozycja listy rozwijanej jest wierszem MENU, nie polem formularza: czyta się ją w pionowej
       serii, wybiera jednym kliknięciem i nigdy nie edytuje. Rola dzielona z menu kontekstowym jest
       tu poprawna (§3.3), a nie oszczędnością na tokenie.
       ================================================================================================ -->
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="{DynamicResource Size.Control}" />
    <Setter Property="Padding" Value="{DynamicResource Pad.Control}" />
    <Setter Property="FontSize" Value="{DynamicResource Text.Application.Size}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Border.All}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="ComboBoxItem">
    <Setter Property="MinHeight" Value="{DynamicResource Size.Row.Menu}" />
    <Setter Property="Padding" Value="{DynamicResource Pad.MenuItem}" />
    <Setter Property="FontSize" Value="{DynamicResource Text.Application.Size}" />
  </Style>

  <!-- ================================================================================================
       Button — Compact Controls (RB‑3, D1) + H‑8, Product Polish M2b krok 5.4.

       ⭐ TA KONTROLKA MA JUŻ CZTERY ŚWIADOMIE ZAPROJEKTOWANE WARIANTY (`.icon`, `.flat`, `.primary`,
       `.caption`) i to jest różnica wobec kroków 5.2–5.3: nie stylujemy pustego miejsca, tylko
       DODAJEMY BRAKUJĄCĄ PODSTAWĘ pod istniejącą rodzinę. Audyt H‑8 zmierzył 25 przycisków bez
       `Classes` — czyli takich, które nie należą do żadnego wariantu i stoją na gołym Fluencie.

       ⚠ KOLEJNOŚĆ W PLIKU JEST ZNACZĄCA: styl bazowy musi stać PRZED wariantami, bo w Avalonii przy
       tej samej trafności wygrywa setter zadeklarowany PÓŹNIEJ. Wariant ma dopowiadać podstawę,
       a nie z nią przegrywać. ⛔ Nie przenosić tego bloku poniżej `Button.icon`.

       ⚠ `Size.Control` (24) jest MINIMUM, nie wysokością sztywną: `Button.primary` podnosi się do
       `Size.ControlPrimary` (28), a `Button.caption` ma własną wysokość paska tytułu. Trzy role
       wysokości dla jednej kontrolki nie są niekonsekwencją — hierarchia akcji to jedyny sygnał,
       który działa też wtedy, gdy kolor niesie już inne znaczenie (§5).

       Kolory: `FluentBridge.axaml`. Metryki: tutaj. Bez własnego szablonu — Fluent wystawia
       `ButtonBackground` / `ButtonBorderBrush` / `ButtonForeground` jako zasoby (§16.4 niespełnione).
       ================================================================================================ -->
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="{DynamicResource Size.Control}" />
    <Setter Property="Padding" Value="{DynamicResource Pad.Button}" />
    <Setter Property="FontSize" Value="{DynamicResource Text.Application.Size}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Border.All}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Surface}" />
    <!-- Ta sama konieczność co w `TextBoxie` (krok 5.2): `Pad.Button` ma pion ZEROWY, bo wysokość
         daje `MinHeight`. Bez wyśrodkowania treść osiadłaby przy górnej krawędzi. -->
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!-- ⚠ Przycisk w komórce siatki — ta sama reguła i ten sam powód co przy `TextBoxie` (§15.6.4):
       `Size.Row.Grid` (22) − `Pad.Cell` (3+3) = 16 px, więc `MinHeight` 24 podniósłby wiersz o 8 px.
       Kontrolka w komórce bierze wysokość WIERSZA, nie kontrolki. Zmierzone 182 kolumny szablonowe
       w widokach — to nie jest przypadek teoretyczny. -->
  <Style Selector="DataGridCell Button">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="{DynamicResource Pad.CellCompact}" />
    <Setter Property="FontSize" Value="{DynamicResource Text.Grid.Size}" />
  </Style>

  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Border.All}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Surface}" />
    <Setter Property="Padding" Value="{DynamicResource Pad.Panel}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <!-- Rola: Text.Application — podpowiedź jest treścią, którą użytkownik czyta świadomie,
         a nie chromą, którą omiata wzrokiem. -->
    <Setter Property="FontSize" Value="{DynamicResource Text.Application.Size}" />
  </Style>

  <!-- :is(TextBlock) so it also matches SelectableTextBlock (a TextBlock subclass) —
       error messages use Classes="subtle error" on a SelectableTextBlock so they can be
       selected/copied. -->
  <Style Selector=":is(TextBlock).subtle">
    <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}" />
  </Style>

  <!-- ================================================================================================
       ⭐ TYPOGRAFIA CZYTANA Z KATALOGU (Product Polish M2b, krok 0)

       Pięć poniższych stylów klasowych BYŁO rolami typograficznymi z §6 — tyle że z liczbami
       wpisanymi na sztywno. Teraz czytają je z Themes/Typography.axaml. Zmiana jest bajtowo
       neutralna (te same wartości) i to jest jej cel: pierwszy dowód, że warstwa skalarna
       rzeczywiście rozwija się w runtime — na pięciu setterach, a nie na czterdziestu.

       ⚠ `DynamicResource`, nie `StaticResource`, mimo że tokeny nie zależą od motywu. Powód jest
       architektoniczny, nie estetyczny: §3.4 wymaga, aby przyszłe ustawienie czcionki i skali
       podmieniało tokeny bazowe — a wartość rozwiązana statycznie nie zareagowałaby na podmianę
       w czasie działania aplikacji. Tego ustawienia ten etap NIE buduje (reguła #233); zostawia
       jedynie warstwę, która je udźwignie.

       ⚠ Marginesy zostają lokalne. Odstęp pod podpisem pola (4 px) nie ma dziś roli w §4.1, a
       `Margin.FieldGap` to inna rola („odstęp pod polem", 8 px). Dopisanie roli tylko po to, żeby
       nie było tu liczby, byłoby dokładnie tym, przed czym ostrzega §4.1 — katalog rośnie od
       potrzeby, nie od symetrii.
       ================================================================================================ -->

  <!-- Form field caption above an input. Centralized here (was duplicated verbatim
       in every dialog's local Window.Styles). Application-level styles apply inside
       dialog windows too, so each dialog just uses Classes="field-label".
       Rola: Text.Application (§6). -->
  <Style Selector="TextBlock.field-label">
    <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource Text.Application.Size}" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <!-- The keyboard-shortcut hint shown beside a command's label on an accent (primary) button — e.g.
       Execute F5, Start debugging F5. ONE presentation for every such chip across the app; the shortcut
       is carried in this chip, never baked into the label string with parentheses. -->
  <!-- Rola: Text.Caption (§6) — najmniejszy stopień pisma w aplikacji. -->
  <Style Selector="TextBlock.shortcut-chip">
    <Setter Property="Foreground" Value="{DynamicResource OnAccentSubtleBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource Text.Caption.Size}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Rola: Text.Title (§6) — nazwa połączenia, tytuł panelu. -->
  <Style Selector="TextBlock.title">
    <Setter Property="FontWeight" Value="{DynamicResource Text.Title.Weight}" />
    <Setter Property="FontSize" Value="{DynamicResource Text.Title.Size}" />
  </Style>

  <!-- Rola: Text.DialogHeader (§6). -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontWeight" Value="{DynamicResource Text.DialogHeader.Weight}" />
    <Setter Property="FontSize" Value="{DynamicResource Text.DialogHeader.Size}" />
  </Style>

  <!-- ── Settings group: a titled card around one coherent set of options ──────────────
       A form with two or three loose captions floating between control rows reads as
       captions, not as groups — the user has to infer where one subject ends and the next
       begins. The card states it instead: a recessed BackgroundBrush surface inside the
       PanelBrush chrome that hosts it, which is the same figure/ground pair the editor
       already uses against its own panels. No new colour token, and nothing here touches a
       control's own metrics — the app-wide density pass is its own sprint.

       Header is deliberately stronger than `field-label`: a field caption names one value,
       a group header names a subject, and at the same weight the two compete.

       (This replaces a `Border.panel` style that had NO consumers anywhere in the app —
       kept only as a near-identical sibling for someone to pick by mistake.) -->
  <!-- ⭐ Ten styl jest w kroku 0 świadomie: pięć stylów tekstowych powyżej dowodzi wyłącznie, że
       rozwijają się `x:Double` i `FontWeight`. Warstwa ZŁOŻONA (`Thickness`, `CornerRadius`) to
       osobny mechanizm i bez niego dowód byłby połowiczny — a to ona jest w §3.2 wskazana jako
       miejsce, w którym dług odrasta najłatwiej. Role: Border.All · Radius.Surface · Pad.Group. -->
  <Style Selector="Border.settings-group">
    <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Border.All}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Surface}" />
    <Setter Property="Padding" Value="{DynamicResource Pad.Group}" />
  </Style>

  <!-- Rola: Text.SectionHeader (§6) — mocniejsza od podpisu pola, bo nazywa temat, nie wartość. -->
  <Style Selector="TextBlock.group-header">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource Text.SectionHeader.Size}" />
    <Setter Property="FontWeight" Value="{DynamicResource Text.SectionHeader.Weight}" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <!-- ⚠ `Button.icon` znosi tło i krawędź podstawy CELOWO: ikona w pasku narzędzi ma być samą ikoną,
       a afordancję niesie dopiero najechanie. To jedyny wariant, w którym przycisk nie wygląda jak
       przycisk w stanie spoczynku — i dlatego ma własną, mocniejszą podświetlaną „pastylkę". -->
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="Padding" Value="{DynamicResource Pad.ButtonIcon}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Chip}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <!-- Hover: IconHoverBrush is a touch stronger than HoverOverlay so the rounded
       hover chip on a toolbar icon is clearly visible in both themes. -->
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource IconHoverBrush}" />
  </Style>

  <Style Selector="Button.icon:focus /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
  </Style>

  <!-- Disabled: dim the whole button (Opacity) so the icon reads as unavailable
       regardless of its semantic Foreground (which would otherwise stay vivid). -->
  <Style Selector="Button.icon:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>

  <!-- ToggleButton.icon mirrors Button.icon's defaults, but the FluentTheme's
       default :checked state paints the SystemAccent (orange/brown on Windows).
       Override with our blue SelectionBrush so it matches the rest of the
       app's selection / accent visuals. -->
  <Style Selector="ToggleButton.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="Padding" Value="{DynamicResource Pad.ButtonIcon}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Chip}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ToggleButton.icon:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource IconHoverBrush}" />
  </Style>
  <Style Selector="ToggleButton.icon:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="ToggleButton.icon:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ToggleButton.icon:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
  </Style>
  <Style Selector="ToggleButton.icon:focus /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
  </Style>

  <!-- "Filter active" marker: a small accent dot overlaid on the top-right of the
       filter icon (DataGrip / IBExpert convention). Shown (bound to IsFilterActive)
       whenever a non-empty filter is applied — INDEPENDENT of whether the panel is
       open (that's the ToggleButton :checked state). The 1px ring in the window
       background colour keeps the dot legible over both the plain and :checked states. -->
  <Style Selector="Border.filter-active-dot">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="CornerRadius" Value="3.5" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BackgroundBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,-2,-3,0" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <!-- Collapsed-sidebar grab rail: a thin full-height vertical strip pinned to the
       left edge (VS Code / DataGrip activity-bar style). A Border (not a Button) so
       it doesn't swallow PointerPressed in its own class handler — the strip is only
       12px wide and reliable hit-testing matters. PointerPressed re-expands. -->
  <Style Selector="Border.sidebar-rail">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="Width" Value="12" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Border.sidebar-rail:pointerover">
    <Setter Property="Background" Value="{DynamicResource ChromeStrongBrush}" />
  </Style>

  <!-- ⚠ `Button.flat` różni się od podstawy JEDNĄ rzeczą: przezroczystym tłem. Po kroku 5.4 nie jest
       to już „przycisk zaprojektowany" wobec „przycisku Fluenta", tylko wariant CHROMELESS wobec
       własnej podstawy — dlatego zostają tu wyłącznie te settery, które podstawę faktycznie zmieniają. -->
  <Style Selector="Button.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Border.All}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="Padding" Value="{DynamicResource Pad.Button}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Surface}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.flat:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
  </Style>

  <Style Selector="Button.flat:focus /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
  </Style>

  <Style Selector="Button.flat:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <!-- ⭐ `Size.ControlPrimary` (28) — jedyne miejsce w aplikacji, które konsumuje tę rolę, i powód,
       dla którego ona istnieje: wysokość jest jedynym sygnałem hierarchii działającym również tam,
       gdzie kolor niesie już inne znaczenie (§5). -->
  <Style Selector="Button.primary">
    <Setter Property="MinHeight" Value="{DynamicResource Size.ControlPrimary}" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="Padding" Value="{DynamicResource Pad.Button}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Surface}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <!-- Text inside a primary button reads on the accent fill (white), matching the icon glyph. The
       button's Foreground inheritance is otherwise overridden by the global TextBlock style (which
       sets the dark ForegroundBrush) — that made the Execute label too dark on the blue button in
       Light theme. A local Foreground on a child TextBlock (e.g. the subtle Execute hint) still wins. -->
  <Style Selector="Button.primary TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>

  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentMutedBrush}" />
  </Style>

  <Style Selector="Button.primary:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>

  <Style Selector="Button.primary:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <!-- ⚠ Przycisk paska tytułu ma wysokość PASKA, nie kontrolki — `Size.TitleBar` jest tu tym samym
       rodzajem decyzji co `Size.Row.Grid` dla edytora w komórce: element wypełnia swój kontener
       i nie ma prawa go rozpychać. Szerokość 46 zostaje lokalna — to konwencja przycisków okna
       Windows, a nie rola w katalogu (§4.2.4: rola powstaje z drugiego konsumenta). -->
  <Style Selector="Button.caption">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="{DynamicResource Size.TitleBar}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
  </Style>

  <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CloseButtonHoverBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>

  <Style Selector="TabControl">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <!-- ── Active-tab design language (shared by bottom-tab + sub-tab) ─────────
       Active tab = a raised, filled segment: ChromeStrong background + SemiBold +
       full-contrast foreground, rounded corners. NO accent fill / outline / underline
       (accent is reserved for connection name / DEV MODE / toolbar actions). Inactive
       tabs read subtle on a transparent background. Height is identical in every state
       (CornerRadius doesn't affect layout; no borders are added). bottom-tab and
       sub-tab differ only in size — they share this one active-state language. -->

  <!-- Bottom-panel + main editor tabs (Results / Messages / Output, Editor / Fields / …). -->
  <Style Selector="TabItem.bottom-tab">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}" />
  </Style>

  <Style Selector="TabItem.bottom-tab /template/ Border#PART_LayoutRoot">
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <Style Selector="TabItem.bottom-tab:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
  </Style>

  <Style Selector="TabItem.bottom-tab:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
  </Style>

  <Style Selector="TabItem.bottom-tab:selected">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Hide FluentTheme's selected-indicator pipe for bottom tabs. -->
  <Style Selector="TabItem.bottom-tab /template/ Border#PART_SelectedPipe">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- Sub-tabs (smaller, tighter than bottom-tab). Used for nested TabControls
       (Ograniczenia → PK / FK / Check / Unique; Procedure Easy → Input / Output / …).
       SAME active-state language as bottom-tab — elevated fill + SemiBold, no accent,
       no border, no underline. .empty greys an empty group's label. -->
  <Style Selector="TabItem.sub-tab">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Padding" Value="11,5" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}" />
  </Style>

  <Style Selector="TabItem.sub-tab /template/ Border#PART_LayoutRoot">
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <Style Selector="TabItem.sub-tab.empty">
    <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}" />
  </Style>

  <Style Selector="TabItem.sub-tab:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
  </Style>

  <Style Selector="TabItem.sub-tab:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
  </Style>

  <Style Selector="TabItem.sub-tab:selected">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Hide FluentTheme's selected-indicator pipe for sub-tabs. -->
  <Style Selector="TabItem.sub-tab /template/ Border#PART_SelectedPipe">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- DataGrid: selection / hover wired through SelectionBrush + HoverOverlayBrush
       so colors match the TreeView. FluentTheme's DataGridRow template names the
       background as Rectangle#BackgroundRectangle. -->
  <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource SelectionBrush}" />
  </Style>

  <Style Selector="DataGridRow:selected:pointerover /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource SelectionBrush}" />
  </Style>

  <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource HoverOverlayBrush}" />
  </Style>

  <!-- Compact rows: smaller font, tighter cell padding for dense result sets. -->
  <Style Selector="DataGridCell">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <Style Selector="DataGridRow">
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <!-- Zebra stripes: tint every other row. Avalonia 12's DataGrid doesn't expose
       AlternatingRowBackground as an attached/regular property in the version we
       pull, so we drive it via :nth-child on the row's BackgroundRectangle part. -->
  <Style Selector="DataGridRow:nth-child(2n) /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource RowAlternateBrush}" />
  </Style>

  <!-- Selection must win over zebra stripe regardless of row parity. Without these,
       the :nth-child(2n) rule above re-fills the BackgroundRectangle of every even
       selected row with RowAlternateBrush — and selection silently disappears on
       half the rows. Higher specificity (extra :selected token) wins the cascade. -->
  <Style Selector="DataGridRow:nth-child(2n):selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource SelectionBrush}" />
  </Style>

  <Style Selector="DataGridRow:nth-child(2n):selected:pointerover /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource SelectionBrush}" />
  </Style>

  <!-- Column headers consistent with the rest of the UI: elevated panel background,
       subtle border, themed foreground. Default FluentTheme picks SystemAccent for
       hover/press which clashes with the dark blue accent. -->
  <Style Selector="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource ChromeStrongBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="SeparatorBrush" Value="{DynamicResource BorderBrush}" />
  </Style>

  <Style Selector="DataGridColumnHeader:pointerover /template/ Grid#PART_ColumnHeaderRoot">
    <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
  </Style>

  <Style Selector="DataGridColumnHeader:pressed /template/ Grid#PART_ColumnHeaderRoot">
    <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
  </Style>

  <!-- DataGridCell focus visual. FluentTheme's template inserts a focus
       Rectangle inside the cell border with a small inset margin; on some
       systems the bottom edge gets clipped because the rectangle's bounds
       end exactly at the cell's bottom padding edge. Pulling the margin in
       by 1 px on every side and dropping stroke thickness to 1 keeps the
       full rectangle inside the cell at every zoom level. The stroke uses
       FocusBorderBrush (blue) — paired with the resource-key override on
       DataGridCellFocusVisualPrimaryBrush in Colors.axaml so any other
       FluentTheme code paths painting "focus visual" also pick our blue. -->
  <Style Selector="DataGridCell /template/ Rectangle#FocusVisual">
    <Setter Property="Margin" Value="1" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="Stroke" Value="{DynamicResource FocusBorderBrush}" />
  </Style>

  <!-- A TextBox whose visual frame is supplied by a wrapping Border (embedded search
       fields, inline editors). The container owns the border; this TextBox is pure
       text + caret. Suppresses the control's OWN chrome in every state — crucially
       including :focus, so FluentTheme's blue focus visual doesn't paint a ring
       inside (and overlapping the text of) the container. FocusAdorner is nulled to
       kill the keyboard focus rectangle too. Transparent is the only literal allowed
       (it's "no fill", not a theme color). -->
  <Style Selector="TextBox.frameless">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>
  <Style Selector="TextBox.frameless /template/ Border#PART_BorderElement">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="TextBox.frameless:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="TextBox.frameless:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <!-- ListBoxItem selection / hover — same overrides we did for DataGridRow and
       TreeViewItem so Saved Queries (and any other ListBox) inherits the unified
       SelectionBrush instead of FluentTheme's SystemAccent yellow. -->
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
  </Style>

  <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
  </Style>

  <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
  </Style>

  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
  </Style>

  <!-- :is(TextBlock) so it also matches SelectableTextBlock (a TextBlock subclass) — e.g. the Messages log. -->
  <Style Selector=":is(TextBlock).error">
    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
  </Style>

  <Style Selector="TextBlock.success">
    <Setter Property="Foreground" Value="{DynamicResource ConnectedBrush}" />
  </Style>

  <Style Selector="Border.list-item">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="Padding" Value="12,8" />
  </Style>

  <Style Selector="Border.list-item:pointerover">
    <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
  </Style>

  <Style Selector="Border.list-item.active">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
  </Style>

  <Style Selector="TreeViewItem">
    <!-- Tight rows à la IBExpert / DataGrip: minimal vertical padding so the
         metadata tree stays scannable when it grows to thousands of leaves. -->
    <Setter Property="Padding" Value="2,0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <!-- NOTE: a uniform-row-height experiment (fixed Height on the TreeViewItem header parts)
       was tried here to stabilise the VSP extent estimate and REVERTED — telemetry disproved
       it: the sidebar's scroll instability is not an average-height drift but a hard
       re-realization/reset (extent collapses to == viewport with ~4 realized rows, offset
       clamps to 0, then rebuilds). That's Avalonia's nested VirtualizingStackPanel
       derealizing the expanded subtree on a random-access thumb drag — not fixable from a
       style. The fix is a structural migration to TreeDataGrid (one flattened virtualized
       row stream). See gotcha #157. -->

  <!-- Hover/selection colors come from the TreeViewItemBackground* resource keys
       defined in Themes/Colors.axaml. Avalonia 12 FluentTheme's TreeViewItem template
       already routes :pointerover / :selected / etc. through those DynamicResource
       lookups — defining the keys in our theme dictionary wins over FluentTheme's
       defaults (which pull from SystemAccentColor and render as bright yellow on
       this user's Windows). See https://github.com/AvaloniaUI/Avalonia/blob/release/12.0.3/src/Avalonia.Themes.Fluent/Controls/TreeViewItem.xaml -->

  <!-- ============================================================================================
       CONTEXT MENUS — the app's ONE menu appearance (Keyboard Manager etap 5).
       ============================================================================================
       ⭐ This style set IS the "one shared context menu for the whole application". EmberTern does not
       build its own menu control, and that was a MEASURED decision, not a shortcut: a headless probe of
       FluentTheme's realized context-menu MenuItem template found it already provides every part the
       design needs —

         · ContentControl#PART_IconPresenter   → the icon column (left)
         · ContentPresenter#PART_HeaderPresenter → the label
         · TextBlock#PART_InputGestureText     → the gesture column (right)
         · Path#PART_ChevronPath               → the submenu arrow
         · ContentControl#PART_ToggleIconPresenter → the check mark

       …and, crucially, the icon column KEEPS ITS WIDTH when an item has no icon (measured: the header
       presenter starts at x=28 whether the item has an icon or not), so labels already align on one
       column. A custom control would have had to re-implement all of that — submenus, check marks,
       keyboard navigation, disabled states — to arrive at the same place, and would then need all 32
       menus converted to it, with a 33rd free to forget. A style needs no opt-in: every ContextMenu in
       the application is styled by construction, which is the stronger guarantee.

       What FluentTheme gets WRONG, and this fixes:
         · rows are far too tall — Padding was 11,4,11,7 (asymmetric! 4 top vs 7 bottom) at FontSize 14,
           measuring 27px per row;
         · hover/selection are painted from SystemAccentColor, i.e. the brown/orange the UI rules call
           out (styling rule #6). Overridden here on PART_LayoutRoot rather than by guessing FluentTheme's
           resource-key names — the part name is measured, a key name would be a guess.

       ⚠ Nothing here is per-menu. A host sets Header, Command, Icon (via {app:MenuIcon}) and
       InputGesture (via {app:CommandGesture}) — never Background, Padding, FontSize or Foreground. A
       local value outranks a style setter, which is exactly how the MessageBanner grew six per-host
       variants before Seam 4's QA round pulled its chrome into two shared variants. Same trap, same rule.
       ============================================================================================ -->

  <Style Selector="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <!-- A 4px band top and bottom so the first and last row do not touch the border. -->
    <Setter Property="Padding" Value="0,4" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="ContextMenu, MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
  </Style>

  <!-- The row. 12px type (down from 14) and a symmetric 3px vertical pad bring a row from 27px to ~22px
       without crowding the text; MinHeight keeps an icon-less row exactly as tall as one with an icon. -->
  <Style Selector="MenuItem">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="MinHeight" Value="22" />
  </Style>

  <Style Selector="MenuItem /template/ Border#PART_LayoutRoot">
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Margin" Value="3,0" />
  </Style>

  <!-- Hover / open-submenu / pressed. One calm wash from the app's palette; never SystemAccentColor. -->
  <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
  </Style>
  <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
  </Style>
  <Style Selector="MenuItem:pressed /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
  </Style>

  <!-- A disabled item still has to be READABLE — it is how a menu explains that an action exists but is
       not available right now (the grid menu's "Copy as UPDATE" carries a tooltip saying why). Fluent's
       default fades it close to invisible. -->
  <Style Selector="MenuItem:disabled /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="MenuItem:disabled">
    <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}" />
    <Setter Property="Opacity" Value="0.75" />
  </Style>

  <!-- The icon column: a fixed 14px box so every mark reads at one size regardless of its geometry's
       proportions, with breathing room before the label. -->
  <Style Selector="MenuItem /template/ ContentControl#PART_IconPresenter">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Margin" Value="0,0,4,0" />
  </Style>

  <!-- The gesture column: subordinate, never competing with the label it belongs to. Right-aligned by the
       template; the left margin guarantees a gap even when a label is long. -->
  <Style Selector="MenuItem /template/ TextBlock#PART_InputGestureText">
    <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Margin" Value="24,0,0,0" />
  </Style>

  <!-- Separator: a hairline that spans the menu, with equal air above and below. Scoped to menus so the
       Separator used elsewhere (toolbars) is untouched. -->
  <Style Selector="ContextMenu > Separator, MenuItem > Separator">
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="MinHeight" Value="1" />
    <Setter Property="Margin" Value="6,4" />
    <Setter Property="Opacity" Value="0.7" />
  </Style>

</Styles>
