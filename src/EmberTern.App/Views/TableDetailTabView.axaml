<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EmberTern.App.ViewModels"
             xmlns:app="using:EmberTern.App"
             xmlns:conv="using:EmberTern.App.Converters"
             xmlns:metadata="using:EmberTern.Core.Metadata"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="EmberTern.App.Views.TableDetailTabView"
             x:Name="RootControl"
             x:DataType="vm:TableDetailTabViewModel"
             Background="{DynamicResource BackgroundBrush}">

  <!-- Tighter row pitch than the results grid. Scoped to descendants of this
       UserControl so it doesn't bleed into the SQL Editor result grid. -->
  <UserControl.Resources>
    <!-- Inline icon geometries for the Pola grid PK / FK / UNQ columns.
         Each glyph is sized to roughly fit a 14×14 viewport; Path.Stretch=Uniform
         scales to whatever cell size the column uses. -->
    <StreamGeometry x:Key="PkIconGeometry">M 8,0 C 5,0 3,2 3,4 C 3,6 4,7 5,8 L 1,12 L 0,14 L 2,14 L 2,12 L 4,12 L 4,10 L 6,10 L 6,8 C 7,8.5 8,9 9,9 C 11,9 13,7 13,4 C 13,2 11,0 8,0 Z M 9,2 C 10,2 11,3 11,4 C 11,5 10,6 9,6 C 8,6 7,5 7,4 C 7,3 8,2 9,2 Z</StreamGeometry>
    <StreamGeometry x:Key="FkIconGeometry">M 0,4 L 4,4 L 4,2 L 8,5 L 4,8 L 4,6 L 0,6 Z M 10,1 L 10,9 C 12,9 14,7 14,5 C 14,3 12,1 10,1 Z</StreamGeometry>
    <StreamGeometry x:Key="UnqIconGeometry">M 7,0 L 14,5 L 7,10 L 0,5 Z</StreamGeometry>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="DataGridRow">
      <Setter Property="Height" Value="22" />
    </Style>
    <!-- Pola grid: in-row CheckBox (NotNull) needs more vertical room than 22 —
         the default-size CheckBox visual gets clipped otherwise. FluentTheme
         CheckBox is ~22 px tall with built-in padding, so 34 leaves clean
         breathing space on top and bottom. Selector targets the named grid
         only so the Indeksy / Ograniczenia grids stay tight. -->
    <Style Selector="DataGrid#FieldsGrid DataGridRow">
      <Setter Property="Height" Value="34" />
    </Style>
    <!-- Dane grid lives in always-editable mode; the in-cell TextBox needs more
         vertical space than the read-only Pola / Indeksy / Ograniczenia grids.
         Style ordering: this declaration follows the global DataGridRow rule,
         so for descendants of a DataGrid with class "data-edit" it wins. -->
    <Style Selector="DataGrid.data-edit DataGridRow">
      <Setter Property="Height" Value="32" />
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="Padding" Value="6 2" />
    </Style>
    <!-- Applied per-cell by PopulateDataGrid when the underlying value is null.
         DynamicResource handles theme switching automatically. -->
    <Style Selector="TextBlock.null-cell">
      <Setter Property="FontStyle" Value="Italic" />
      <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">

    <TabControl Grid.Row="0"
                SelectedIndex="{Binding ActiveSubTabIndex, Mode=TwoWay}"
                Padding="0">

      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.TableDetailTabFields}">
        <DataGrid x:Name="FieldsGrid"
                  ItemsSource="{Binding EditableFields}"
                  SelectedItem="{Binding SelectedFieldRow, Mode=TwoWay}"
                  IsReadOnly="{Binding IsFieldsReadOnly}"
                  FontSize="11"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  CanUserSortColumns="True"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="True"
                  ColumnWidth="Auto"
                  RowBackground="Transparent"
                  HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                  VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                  Background="{DynamicResource BackgroundBrush}">
          <DataGrid.Styles>
            <!-- Subtle background tint on rows with pending edits. Row-level Classes
                 can't bind to per-item state from XAML in Avalonia 12 — apply via the
                 cell rectangle template part triggered by the row VM's IsModified
                 flag using the DataTrigger pattern. -->
            <Style Selector="DataGridRow.pending /template/ Rectangle#BackgroundRectangle">
              <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
              <Setter Property="Opacity" Value="0.12" />
            </Style>
          </DataGrid.Styles>
          <DataGrid.Columns>
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailColumnPosition}"
                                Binding="{Binding DisplayPosition}"
                                SortMemberPath="DisplayPosition"
                                IsReadOnly="True" />

            <DataGridTemplateColumn Header="{x:Static app:UiStrings.TableDetailColumnPrimaryKey}"
                                    Width="Auto"
                                    MinWidth="60"
                                    SortMemberPath="IsPrimaryKey"
                                    IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:FieldRowViewModel">
                  <Path Data="{StaticResource PkIconGeometry}"
                        Fill="{DynamicResource AccentBrush}"
                        Width="14" Height="14"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsPrimaryKey}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{x:Static app:UiStrings.TableDetailColumnForeignKey}"
                                    Width="Auto"
                                    MinWidth="60"
                                    SortMemberPath="IsForeignKey"
                                    IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:FieldRowViewModel">
                  <Path Data="{StaticResource FkIconGeometry}"
                        Fill="{DynamicResource WarningBrush}"
                        Width="14" Height="14"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsForeignKey}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{x:Static app:UiStrings.TableDetailColumnUnique}"
                                    Width="Auto"
                                    MinWidth="60"
                                    SortMemberPath="IsUnique"
                                    IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:FieldRowViewModel">
                  <Path Data="{StaticResource UnqIconGeometry}"
                        Fill="{DynamicResource SubtleForegroundBrush}"
                        Width="14" Height="14"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsUnique}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Editable: Name (rename, gated by deps in EnqueueRowEdits). -->
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailColumnName}"
                                Binding="{Binding Name, Mode=TwoWay}"
                                SortMemberPath="Name" />
            <!-- Editable: full Type string. Always-visible ComboBox in CellTemplate
                 (no separate CellEditingTemplate) — Avalonia 12's CellEditingTemplate
                 path causes a focus race where the dropdown opens then immediately
                 closes, and the cell-edit cycle can hang on rapid clicks. The
                 IsEnabled binding gates interaction by the owner's edit-mode toggle. -->
            <DataGridTemplateColumn Header="{x:Static app:UiStrings.TableDetailColumnType}"
                                    SortMemberPath="TypeText"
                                    IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:FieldRowViewModel">
                  <ComboBox ItemsSource="{Binding BasicTypes}"
                            SelectedItem="{Binding TypeText, Mode=TwoWay}"
                            IsEnabled="{Binding IsCellEditable}"
                            BorderThickness="0"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailColumnSize}"
                                Binding="{Binding Size}"
                                SortMemberPath="Size"
                                IsReadOnly="True" />
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailColumnScale}"
                                Binding="{Binding Scale, Converter={x:Static conv:ZeroToEmptyConverter.Instance}}"
                                SortMemberPath="Scale"
                                IsReadOnly="True" />
            <!-- Editable: NotNull (CheckBox). -->
            <DataGridCheckBoxColumn Header="{x:Static app:UiStrings.TableDetailColumnNotNull}"
                                    Binding="{Binding NotNull, Mode=TwoWay}"
                                    SortMemberPath="NotNull" />
            <!-- Editable: Default. -->
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailColumnDefault}"
                                Binding="{Binding DefaultValue, Mode=TwoWay}"
                                SortMemberPath="DefaultValue" />
            <!-- Editable: Description (COMMENT ON COLUMN). -->
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailColumnDescription}"
                                Binding="{Binding Description, Mode=TwoWay}"
                                SortMemberPath="Description" />
            <!-- Editable: Domain. Always-visible ComboBox in CellTemplate (same
                 reasoning as the Type column — avoids the Avalonia 12 CellEditingTemplate
                 focus race). User picks a domain → ALTER COLUMN TYPE <DOMAIN_NAME>
                 queued (same dep gate as plain type). -->
            <DataGridTemplateColumn Header="{x:Static app:UiStrings.TableDetailColumnDomain}"
                                    SortMemberPath="DomainName"
                                    IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:FieldRowViewModel">
                  <ComboBox ItemsSource="{Binding AvailableDomains}"
                            SelectedItem="{Binding SelectedDomainSpec, Mode=TwoWay}"
                            IsEnabled="{Binding IsCellEditable}"
                            BorderThickness="0"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailColumnForeignKeyTable}"
                                Binding="{Binding ForeignKeyTable}"
                                SortMemberPath="ForeignKeyTable"
                                IsReadOnly="True" />
            <DataGridTemplateColumn Header="{x:Static app:UiStrings.TableDetailColumnComputed}"
                                    SortMemberPath="ComputedSource"
                                    IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:FieldRowViewModel">
                  <TextBlock Text="{Binding ComputedSource}"
                             FontStyle="Italic"
                             Foreground="{DynamicResource SubtleForegroundBrush}"
                             Margin="6,0"
                             VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailColumnCharset}"
                                Binding="{Binding Charset}"
                                SortMemberPath="Charset"
                                IsReadOnly="True" />
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailColumnAutoIncrement}"
                                Binding="{Binding IsAutoIncrement, Converter={x:Static conv:BoolToCheckmarkConverter.Instance}}"
                                SortMemberPath="IsAutoIncrement"
                                MinWidth="40"
                                IsReadOnly="True" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>

      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.TableDetailTabConstraints}">
        <TabControl Padding="0">

          <TabItem Classes="sub-tab"
                   Classes.empty="{Binding !HasPrimaryKeyConstraints}"
                   Header="{Binding PrimaryKeyTabHeader}">
            <DataGrid ItemsSource="{Binding PrimaryKeyConstraints}"
                      IsReadOnly="True"
                      FontSize="11"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      CanUserReorderColumns="True"
                      ColumnWidth="Auto"
                      RowBackground="Transparent"
                      HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                      VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                      Background="{DynamicResource BackgroundBrush}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailColumnName}"
                                    Binding="{Binding Name}"
                                    SortMemberPath="Name" />
                <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailConstraintFields}"
                                    Binding="{Binding Fields}"
                                    SortMemberPath="Fields" />
                <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailConstraintIndexName}"
                                    Binding="{Binding IndexName}"
                                    SortMemberPath="IndexName" />
                <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailConstraintSort}"
                                    Binding="{Binding IsDescending, Converter={x:Static conv:BoolToSortOrderConverter.Instance}}"
                                    SortMemberPath="IsDescending" />
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>

          <TabItem Classes="sub-tab"
                   Classes.empty="{Binding !HasForeignKeyConstraints}"
                   Header="{Binding ForeignKeyTabHeader}">
            <DataGrid ItemsSource="{Binding ForeignKeyConstraints}"
                      IsReadOnly="True"
                      FontSize="11"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      CanUserReorderColumns="True"
                      ColumnWidth="Auto"
                      RowBackground="Transparent"
                      HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                      VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                      Background="{DynamicResource BackgroundBrush}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailColumnName}"
                                    Binding="{Binding Name}"
                                    SortMemberPath="Name" />
                <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailConstraintFields}"
                                    Binding="{Binding Fields}"
                                    SortMemberPath="Fields" />
                <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailConstraintRefTable}"
                                    Binding="{Binding RefTable}"
                                    SortMemberPath="RefTable" />
                <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailConstraintRefFields}"
                                    Binding="{Binding RefFields}"
                                    SortMemberPath="RefFields" />
                <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailConstraintUpdateRule}"
                                    Binding="{Binding UpdateRule}"
                                    SortMemberPath="UpdateRule" />
                <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailConstraintDeleteRule}"
                                    Binding="{Binding DeleteRule}"
                                    SortMemberPath="DeleteRule" />
                <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailConstraintSort}"
                                    Binding="{Binding IsDescending, Converter={x:Static conv:BoolToSortOrderConverter.Instance}}"
                                    SortMemberPath="IsDescending" />
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>

          <TabItem Classes="sub-tab"
                   Classes.empty="{Binding !HasCheckConstraints}"
                   Header="{Binding CheckTabHeader}">
            <DataGrid ItemsSource="{Binding CheckConstraints}"
                      IsReadOnly="True"
                      FontSize="11"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      CanUserReorderColumns="True"
                      ColumnWidth="Auto"
                      RowBackground="Transparent"
                      HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                      VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                      Background="{DynamicResource BackgroundBrush}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailColumnName}"
                                    Binding="{Binding Name}"
                                    SortMemberPath="Name" />
                <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailConstraintSource}"
                                    Binding="{Binding CheckClause}"
                                    SortMemberPath="CheckClause"
                                    Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>

          <TabItem Classes="sub-tab"
                   Classes.empty="{Binding !HasUniqueConstraints}"
                   Header="{Binding UniqueTabHeader}">
            <DataGrid ItemsSource="{Binding UniqueConstraints}"
                      IsReadOnly="True"
                      FontSize="11"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      CanUserReorderColumns="True"
                      ColumnWidth="Auto"
                      RowBackground="Transparent"
                      HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                      VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                      Background="{DynamicResource BackgroundBrush}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailColumnName}"
                                    Binding="{Binding Name}"
                                    SortMemberPath="Name" />
                <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailConstraintFields}"
                                    Binding="{Binding Fields}"
                                    SortMemberPath="Fields" />
                <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailConstraintIndexName}"
                                    Binding="{Binding IndexName}"
                                    SortMemberPath="IndexName" />
                <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailConstraintSort}"
                                    Binding="{Binding IsDescending, Converter={x:Static conv:BoolToSortOrderConverter.Instance}}"
                                    SortMemberPath="IsDescending" />
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>

        </TabControl>
      </TabItem>

      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.TableDetailTabIndexes}">
        <DataGrid x:Name="IndexesGrid"
                  ItemsSource="{Binding Indexes}"
                  IsReadOnly="True"
                  FontSize="11"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  CanUserSortColumns="True"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="True"
                  ColumnWidth="Auto"
                  RowBackground="Transparent"
                  HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                  VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                  Background="{DynamicResource BackgroundBrush}">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="{x:Static app:UiStrings.TableDetailIndexType}"
                                    Width="30"
                                    SortMemberPath="IndexType">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="metadata:IndexInfo">
                  <Panel>
                    <Path Data="{StaticResource PkIconGeometry}"
                          Fill="{DynamicResource AccentBrush}"
                          Width="14" Height="14"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsVisible="{Binding IsPrimary}" />
                    <Path Data="{StaticResource FkIconGeometry}"
                          Fill="{DynamicResource WarningBrush}"
                          Width="14" Height="14"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsVisible="{Binding IsForeignKeyIndex}" />
                  </Panel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailColumnName}"
                                Binding="{Binding Name}"
                                SortMemberPath="Name"
                                Width="200" />
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailIndexFields}"
                                Binding="{Binding Fields}"
                                SortMemberPath="Fields"
                                Width="150" />
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailIndexExpression}"
                                Binding="{Binding Expression}"
                                SortMemberPath="Expression"
                                Width="120" />
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailIndexUnique}"
                                Binding="{Binding IsUnique, Converter={x:Static conv:BoolToCheckmarkConverter.Instance}}"
                                SortMemberPath="IsUnique"
                                Width="60" />
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailIndexDescending}"
                                Binding="{Binding IsDescending, Converter={x:Static conv:BoolToCheckmarkConverter.Instance}}"
                                SortMemberPath="IsDescending"
                                Width="70" />
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailIndexPrimary}"
                                Binding="{Binding IsPrimary, Converter={x:Static conv:BoolToCheckmarkConverter.Instance}}"
                                SortMemberPath="IsPrimary"
                                Width="40" />
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailIndexActive}"
                                Binding="{Binding IsActive, Converter={x:Static conv:BoolToCheckmarkConverter.Instance}}"
                                SortMemberPath="IsActive"
                                Width="60" />
            <DataGridTemplateColumn Header="{x:Static app:UiStrings.TableDetailIndexStatistics}"
                                    Width="80"
                                    SortMemberPath="Statistics">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="metadata:IndexInfo">
                  <TextBlock Text="{Binding Statistics, StringFormat={}{0:F6}}"
                             TextAlignment="Right"
                             VerticalAlignment="Center"
                             Margin="8,0" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>

      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.TableDetailTabDependencies}">
        <Grid ColumnDefinitions="*,4,*">
          <Grid Grid.Column="0" RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0"
                       Text="{x:Static app:UiStrings.TableDetailDependedOnByHeader}"
                       FontSize="11"
                       Foreground="{DynamicResource SubtleForegroundBrush}"
                       Margin="0,4,0,4" />
            <!-- "Used by" (left) — objects that depend on this table
                 (views, triggers, procedures, functions, etc.). IBExpert layout. -->
            <TreeView Grid.Row="1"
                      ItemsSource="{Binding DependedOnByTree}"
                      Background="{DynamicResource BackgroundBrush}">
              <TreeView.DataTemplates>
                <TreeDataTemplate DataType="vm:DependencyGroupNode"
                                  ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="{Binding Icon}"
                               FontSize="12"
                               Width="14"
                               TextAlignment="Center"
                               VerticalAlignment="Center">
                      <TextBlock.Foreground>
                        <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                          <Binding Path="IconResourceKey" />
                          <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                        </MultiBinding>
                      </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Text="{Binding Header}"
                               FontSize="11"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </TreeDataTemplate>
                <DataTemplate DataType="vm:DependencyLeafNode">
                  <Border HorizontalAlignment="Stretch"
                          Background="Transparent"
                          DoubleTapped="OnDependencyNodeDoubleTapped">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <TextBlock Text="{Binding Icon}"
                                 FontSize="12"
                                 Width="14"
                                 TextAlignment="Center"
                                 VerticalAlignment="Center">
                        <TextBlock.Foreground>
                          <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                            <Binding Path="IconResourceKey" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </TextBlock.Foreground>
                      </TextBlock>
                      <TextBlock Text="{Binding ObjectName}"
                                 FontSize="11"
                                 VerticalAlignment="Center" />
                      <TextBlock Text="{Binding FieldName}"
                                 FontSize="10"
                                 Foreground="{DynamicResource SubtleForegroundBrush}"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding FieldName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </TreeView.DataTemplates>
            </TreeView>
          </Grid>

          <GridSplitter Grid.Column="1"
                        Width="4"
                        Background="{DynamicResource BorderBrush}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />

          <Grid Grid.Column="2" RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0"
                       Text="{x:Static app:UiStrings.TableDetailDependsOnHeader}"
                       FontSize="11"
                       Foreground="{DynamicResource SubtleForegroundBrush}"
                       Margin="0,4,0,4" />
            <!-- "Depends on" (right) — what this table uses. Domains via field
                 types, plus RDB$DEPENDENCIES rows where the table is the
                 dependent (computed cols, defaults, check expressions). -->
            <TreeView Grid.Row="1"
                      ItemsSource="{Binding DependsOnTree}"
                      Background="{DynamicResource BackgroundBrush}">
              <TreeView.DataTemplates>
                <TreeDataTemplate DataType="vm:DependencyGroupNode"
                                  ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="{Binding Icon}"
                               FontSize="12"
                               Width="14"
                               TextAlignment="Center"
                               VerticalAlignment="Center">
                      <TextBlock.Foreground>
                        <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                          <Binding Path="IconResourceKey" />
                          <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                        </MultiBinding>
                      </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Text="{Binding Header}"
                               FontSize="11"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </TreeDataTemplate>
                <DataTemplate DataType="vm:DependencyLeafNode">
                  <Border HorizontalAlignment="Stretch"
                          Background="Transparent"
                          DoubleTapped="OnDependencyNodeDoubleTapped">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <TextBlock Text="{Binding Icon}"
                                 FontSize="12"
                                 Width="14"
                                 TextAlignment="Center"
                                 VerticalAlignment="Center">
                        <TextBlock.Foreground>
                          <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                            <Binding Path="IconResourceKey" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </TextBlock.Foreground>
                      </TextBlock>
                      <TextBlock Text="{Binding ObjectName}"
                                 FontSize="11"
                                 VerticalAlignment="Center" />
                      <TextBlock Text="{Binding FieldName}"
                                 FontSize="10"
                                 Foreground="{DynamicResource SubtleForegroundBrush}"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding FieldName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </TreeView.DataTemplates>
            </TreeView>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.TableDetailTabData}">
        <Grid RowDefinitions="Auto,Auto,Auto,*">
          <!-- Inline edit hint row. Add/Delete buttons + pagination controls
               live in the main app toolbar (MainWindow.axaml), gated on
               IsDataTabActive — keeping them in a single chrome row matches
               the existing Execute/Commit/Refresh affordances. -->
          <StackPanel Grid.Row="0"
                      Orientation="Horizontal"
                      Spacing="4"
                      Margin="8,4">
            <TextBlock Text="{Binding EditModeHint}"
                       Classes="subtle"
                       FontSize="11"
                       VerticalAlignment="Center"
                       IsVisible="{Binding EditModeHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <TextBlock Grid.Row="1"
                     Text="{Binding EditStatusMessage}"
                     Classes="subtle error"
                     FontSize="11"
                     Margin="8,0,8,4"
                     TextWrapping="Wrap"
                     IsVisible="{Binding HasEditStatusMessage}" />
          <TextBlock Grid.Row="2"
                     Text="{Binding DataPreviewHint}"
                     Classes="subtle"
                     FontSize="11"
                     Margin="8,4" />
          <TextBlock Grid.Row="3"
                     Text="{Binding DataError}"
                     Classes="subtle error"
                     FontSize="11"
                     Margin="8,4"
                     TextWrapping="Wrap"
                     IsVisible="{Binding ShowDataError}" />
          <DataGrid Grid.Row="3"
                    x:Name="DataPreviewGrid"
                    Classes="data-edit"
                    ItemsSource="{Binding EditableRows}"
                    SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                    IsReadOnly="{Binding IsDataReadOnly}"
                    FontSize="11"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    CanUserSortColumns="True"
                    CanUserResizeColumns="True"
                    CanUserReorderColumns="False"
                    ColumnWidth="Auto"
                    RowBackground="Transparent"
                    HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                    VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                    Background="{DynamicResource BackgroundBrush}"
                    IsVisible="{Binding HasDataResult}" />
        </Grid>
      </TabItem>

      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.TableDetailTabDescription}">
        <Grid Background="{DynamicResource BackgroundBrush}">
          <TextBlock Text="{x:Static app:UiStrings.TableDetailDescriptionEmpty}"
                     Classes="subtle"
                     FontSize="11"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsVisible="{Binding ShowDescriptionEmpty}" />
          <TextBox Text="{Binding Description, Mode=OneWay}"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   FontSize="11"
                   Margin="8"
                   BorderThickness="0"
                   Background="{DynamicResource BackgroundBrush}"
                   IsVisible="{Binding HasDescription}" />
        </Grid>
      </TabItem>

      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.TableDetailTabDdl}">
        <ae:TextEditor x:Name="TableDetailDdlEditor"
                       ShowLineNumbers="True"
                       IsReadOnly="True"
                       FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                       FontSize="13"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto"
                       Background="{DynamicResource BackgroundBrush}"
                       Foreground="{DynamicResource ForegroundBrush}" />
      </TabItem>

    </TabControl>

    <StackPanel Grid.Row="1" Orientation="Vertical">
      <TextBlock Text="{x:Static app:UiStrings.TableDetailLoadingHint}"
                 Classes="subtle"
                 Margin="10,4"
                 FontSize="11"
                 IsVisible="{Binding IsLoading}" />
      <!-- Surface load errors in the view directly — the Messages tab is
           hidden on TableDetail tabs (per the SQL-Editor-only bottom panel),
           so without this the user would see no feedback at all. -->
      <TextBlock Text="{Binding ErrorMessage}"
                 Classes="subtle error"
                 Margin="10,4"
                 FontSize="11"
                 TextWrapping="Wrap"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </Grid>

</UserControl>
