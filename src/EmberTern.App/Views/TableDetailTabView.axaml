<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EmberTern.App.ViewModels"
             xmlns:app="using:EmberTern.App"
             xmlns:controls="using:EmberTern.App.Controls"
             xmlns:behaviors="using:EmberTern.App.Behaviors"
             xmlns:views="using:EmberTern.App.Views"
             xmlns:conv="using:EmberTern.App.Converters"
             xmlns:metadata="using:EmberTern.Core.Metadata"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="EmberTern.App.Views.TableDetailTabView"
             x:Name="RootControl"
             x:DataType="vm:TableDetailTabViewModel"
             Background="{DynamicResource BackgroundBrush}">

  <!-- Tighter row pitch than the results grid. Scoped to descendants of this
       UserControl so it doesn't bleed into the SQL Editor result grid. -->
  <UserControl.Resources>
    <!-- Inline icon geometries for the Pola grid PK / FK / UNQ columns.
         Each glyph is sized to roughly fit a 14×14 viewport; Path.Stretch=Uniform
         scales to whatever cell size the column uses. -->
    <StreamGeometry x:Key="PkIconGeometry">M 8,0 C 5,0 3,2 3,4 C 3,6 4,7 5,8 L 1,12 L 0,14 L 2,14 L 2,12 L 4,12 L 4,10 L 6,10 L 6,8 C 7,8.5 8,9 9,9 C 11,9 13,7 13,4 C 13,2 11,0 8,0 Z M 9,2 C 10,2 11,3 11,4 C 11,5 10,6 9,6 C 8,6 7,5 7,4 C 7,3 8,2 9,2 Z</StreamGeometry>
    <StreamGeometry x:Key="FkIconGeometry">M 0,4 L 4,4 L 4,2 L 8,5 L 4,8 L 4,6 L 0,6 Z M 10,1 L 10,9 C 12,9 14,7 14,5 C 14,3 12,1 10,1 Z</StreamGeometry>
    <StreamGeometry x:Key="UnqIconGeometry">M 7,0 L 14,5 L 7,10 L 0,5 Z</StreamGeometry>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="DataGridRow">
      <Setter Property="Height" Value="22" />
    </Style>
    <!-- Pola grid: in-row CheckBox (NotNull) needs more vertical room than 22 —
         the default-size CheckBox visual gets clipped otherwise. FluentTheme
         CheckBox is ~22 px tall with built-in padding, so 34 leaves clean
         breathing space on top and bottom. Selector targets the named grid
         only so the Indeksy / Ograniczenia grids stay tight. -->
    <Style Selector="DataGrid#FieldsGrid DataGridRow">
      <Setter Property="Height" Value="34" />
    </Style>
    <!-- Dane grid lives in always-editable mode; the in-cell TextBox needs more
         vertical space than the read-only Pola / Indeksy / Ograniczenia grids.
         Style ordering: this declaration follows the global DataGridRow rule,
         so for descendants of a DataGrid with class "data-edit" it wins. -->
    <Style Selector="DataGrid.data-edit DataGridRow">
      <Setter Property="Height" Value="32" />
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="Padding" Value="6 2" />
    </Style>
    <!-- Applied per-cell by PopulateDataGrid when the underlying value is null.
         DynamicResource handles theme switching automatically. -->
    <Style Selector="TextBlock.null-cell">
      <Setter Property="FontStyle" Value="Italic" />
      <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}" />
    </Style>
    <!-- Buffered Table Designer pending-row tints. Apply to EVERY grid in this
         view (Pola / Ograniczenia / Indeksy): a pending-Added row gets a green
         wash, a pending-Dropped row a red wash, until Compile/Discard. The class
         is toggled in code-behind (FieldRowViewModel.PendingKind for Pola;
         ConstraintInfo/IndexInfo.PendingState for the others). A selected pending
         row keeps the normal selection colour (declared last → wins). -->
    <Style Selector="DataGridRow.pending-added /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="{DynamicResource RowAddedBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="DataGridRow.pending-dropped /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="{DynamicResource RowDroppedBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="DataGridRow.pending-added:selected /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="{DynamicResource SelectionBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="DataGridRow.pending-dropped:selected /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="{DynamicResource SelectionBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">

    <TabControl Grid.Row="0"
                SelectedIndex="{Binding ActiveSubTabIndex, Mode=TwoWay}"
                Padding="0">

      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.TableDetailTabFields}">
        <!-- Pola sub-tab: FieldsGrid up top, GridSplitter, then the
             field-dependencies panel. Default panel height is 180 px;
             GridSplitter lets the user resize. The panel binds to
             SelectedField on the VM — pick a row to see its deps. -->
        <Grid RowDefinitions="*,4,180">
        <DataGrid x:Name="FieldsGrid"
                  Grid.Row="0"
                  behaviors:GridLayoutBehavior.GridId="TableDetail.Fields"
                  ItemsSource="{Binding EditableFields}"
                  SelectedItem="{Binding SelectedFieldRow, Mode=TwoWay}"
                  PointerPressed="OnFieldsGridPointerPressed"
                  IsReadOnly="{Binding IsFieldsReadOnly}"
                  FontSize="11"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  CanUserSortColumns="True"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="True"
                  ColumnWidth="Auto"
                  RowBackground="Transparent"
                  HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                  VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                  Background="{DynamicResource BackgroundBrush}"
                  DoubleTapped="OnFieldsGridDoubleTapped">
          <!-- Context menu — right-click on a row or in the empty grid area
               opens a 4-item menu mirroring the spec. Bound to the host VM
               via the grid's DataContext (TableDetailTabViewModel). The Edit
               + Drop + FK items rely on SelectedField; the New item works
               with or without a selection. -->
          <DataGrid.ContextMenu>
            <!-- Every item is a structure-edit action, so the whole menu is gated on
                 CanAddField (the structure-edit capability = a DDL executor was wired).
                 Read-only system tables get neither, so the items hide rather than grey.
                 Item-level IsVisible guarantees the hide; the ContextMenu-level IsVisible
                 suppresses the (otherwise empty) popup where the framework honors it. -->
            <ContextMenu IsVisible="{Binding CanAddField}">
              <MenuItem Header="{x:Static app:UiStrings.FieldsContextMenuAdd}"
                        Command="{Binding AddFieldCommand}"
                        InputGesture="Insert"
                        IsVisible="{Binding CanAddField}" />
              <MenuItem Header="{x:Static app:UiStrings.FieldsContextMenuEdit}"
                        Command="{Binding EditFieldCommand}"
                        InputGesture="F2"
                        IsVisible="{Binding CanAddField}" />
              <MenuItem Header="{x:Static app:UiStrings.FieldsContextMenuDrop}"
                        Command="{Binding DropFieldCommand}"
                        InputGesture="Delete"
                        IsVisible="{Binding CanAddField}" />
              <Separator IsVisible="{Binding CanAddField}" />
              <MenuItem Header="{x:Static app:UiStrings.FieldsContextMenuCreateForeignKey}"
                        Command="{Binding CreateForeignKeyCommand}"
                        IsVisible="{Binding CanAddField}" />
              <MenuItem Header="{x:Static app:UiStrings.FieldsContextMenuDropForeignKey}"
                        Command="{Binding DropFieldForeignKeyCommand}"
                        IsVisible="{Binding CanAddField}" />
            </ContextMenu>
          </DataGrid.ContextMenu>
          <!-- Keyboard shortcuts scoped to the grid — fire only when the grid
               (or one of its rows) has focus. Insert / F2 / Delete map to the
               same commands as the context menu so behavior stays consistent
               across input modes. -->
          <DataGrid.KeyBindings>
            <KeyBinding Gesture="Insert" Command="{Binding AddFieldCommand}" />
            <KeyBinding Gesture="F2" Command="{Binding EditFieldCommand}" />
            <KeyBinding Gesture="Delete" Command="{Binding DropFieldCommand}" />
          </DataGrid.KeyBindings>
          <DataGrid.Styles>
            <!-- Subtle indigo/violet tint on rows with a pending (uncompiled) modify edit.
                 The "pending" class is toggled in code-behind off the row VM's IsModified
                 flag (LoadingRow + a live PropertyChanged hook so it clears the instant
                 the edit is reverted / compiled). RowModifiedBrush is a cool wash that
                 already carries the ~25% alpha — full Opacity here. Indigo keeps it
                 distinct from the green added-wash, the red dropped-wash, the blue
                 hover/selection, and the amber warning state (a warm wash here read as
                 brown/warning over the dark grid). -->
            <Style Selector="DataGridRow.pending /template/ Rectangle#BackgroundRectangle">
              <Setter Property="Fill" Value="{DynamicResource RowModifiedBrush}" />
              <Setter Property="Opacity" Value="1" />
            </Style>
            <!-- A selected pending row keeps the normal selection colour (selection
                 wins visually); declared after the .pending rule so it takes precedence. -->
            <Style Selector="DataGridRow.pending:selected /template/ Rectangle#BackgroundRectangle">
              <Setter Property="Fill" Value="{DynamicResource SelectionBrush}" />
              <Setter Property="Opacity" Value="1" />
            </Style>
          </DataGrid.Styles>
          <DataGrid.Columns>
            <!-- MinWidth ≈ header text × 7 px + padding so the header is never
                 truncated even when the column's content is empty (which would
                 otherwise let DataGridLength.Auto collapse the column to a
                 narrow content-only width on the first measure pass). -->
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailColumnPosition}"
                                Binding="{Binding DisplayPosition}"
                                SortMemberPath="DisplayPosition"
                                MinWidth="32"
                                IsReadOnly="True" />

            <DataGridTemplateColumn Header="{x:Static app:UiStrings.TableDetailColumnPrimaryKey}"
                                    Width="Auto"
                                    MinWidth="60"
                                    SortMemberPath="IsPrimaryKey"
                                    IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:FieldRowViewModel">
                  <Path Data="{StaticResource PkIconGeometry}"
                        Fill="{DynamicResource AccentBrush}"
                        Width="14" Height="14"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsPrimaryKey}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{x:Static app:UiStrings.TableDetailColumnForeignKey}"
                                    Width="Auto"
                                    MinWidth="60"
                                    SortMemberPath="IsForeignKey"
                                    IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:FieldRowViewModel">
                  <Path Data="{StaticResource FkIconGeometry}"
                        Fill="{DynamicResource WarningBrush}"
                        Width="14" Height="14"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsForeignKey}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{x:Static app:UiStrings.TableDetailColumnUnique}"
                                    Width="Auto"
                                    MinWidth="60"
                                    SortMemberPath="IsUnique"
                                    IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:FieldRowViewModel">
                  <Path Data="{StaticResource UnqIconGeometry}"
                        Fill="{DynamicResource SubtleForegroundBrush}"
                        Width="14" Height="14"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsUnique}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Editable: Name (rename, gated by deps in EnqueueRowEdits). -->
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailColumnName}"
                                Binding="{Binding Name, Mode=TwoWay}"
                                SortMemberPath="Name"
                                MinWidth="100" />
            <!-- Editable: full Type string. Always-visible ComboBox in CellTemplate
                 (no separate CellEditingTemplate) — Avalonia 12's CellEditingTemplate
                 path causes a focus race where the dropdown opens then immediately
                 closes, and the cell-edit cycle can hang on rapid clicks. The
                 IsEnabled binding gates interaction by the owner's edit-mode toggle. -->
            <DataGridTemplateColumn Header="{x:Static app:UiStrings.TableDetailColumnType}"
                                    SortMemberPath="TypeText"
                                    MinWidth="100"
                                    IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:FieldRowViewModel">
                  <ComboBox ItemsSource="{Binding BasicTypes}"
                            SelectedItem="{Binding SelectedTypeItem, Mode=TwoWay}"
                            IsEnabled="{Binding IsTypeCellEditable}"
                            IsTextSearchEnabled="True"
                            BorderThickness="0"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <!-- Editable: Size (length for CHAR/VARCHAR; precision for NUMERIC/DECIMAL)
                 and Scale (NUMERIC/DECIMAL). Gated by the grid-level edit-mode toggle
                 (IsReadOnly={IsFieldsReadOnly}). EnqueueRowEdits rebuilds the type via
                 the same DdlGenerator pipeline the Edit-Field dialog uses, so changing
                 these here generates the identical ALTER COLUMN TYPE statement. -->
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailColumnSize}"
                                Binding="{Binding Size, Mode=TwoWay}"
                                SortMemberPath="Size"
                                MinWidth="50" />
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailColumnScale}"
                                Binding="{Binding Scale, Mode=TwoWay}"
                                SortMemberPath="Scale"
                                MinWidth="50" />
            <!-- Editable: NotNull (CheckBox). -->
            <DataGridCheckBoxColumn Header="{x:Static app:UiStrings.TableDetailColumnNotNull}"
                                    Binding="{Binding NotNull, Mode=TwoWay}"
                                    SortMemberPath="NotNull"
                                    MinWidth="70" />
            <!-- Editable: Default. -->
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailColumnDefault}"
                                Binding="{Binding DefaultValue, Mode=TwoWay}"
                                SortMemberPath="DefaultValue"
                                MinWidth="80" />
            <!-- Editable: Description (COMMENT ON COLUMN). -->
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailColumnDescription}"
                                Binding="{Binding Description, Mode=TwoWay}"
                                SortMemberPath="Description"
                                MinWidth="100" />
            <!-- Editable: Domain. Always-visible ComboBox in CellTemplate (same
                 reasoning as the Type column — avoids the Avalonia 12 CellEditingTemplate
                 focus race). User picks a domain → ALTER COLUMN TYPE <DOMAIN_NAME>
                 queued (same dep gate as plain type). -->
            <DataGridTemplateColumn Header="{x:Static app:UiStrings.TableDetailColumnDomain}"
                                    SortMemberPath="DomainName"
                                    MinWidth="100"
                                    IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:FieldRowViewModel">
                  <controls:SearchableComboBox ItemsSource="{Binding AvailableDomains}"
                            SelectedItem="{Binding SelectedDomainSpec, Mode=TwoWay}"
                            IsEnabled="{Binding IsCellEditable}"
                            DisplayMemberPath="Name"
                            ItemTemplate="{StaticResource DomainRowTemplate}"
                            HeaderTemplate="{StaticResource DomainHeaderTemplate}"
                            Watermark=""
                            BorderThickness="0"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailColumnForeignKeyTable}"
                                Binding="{Binding ForeignKeyTable}"
                                SortMemberPath="ForeignKeyTable"
                                MinWidth="100"
                                IsReadOnly="True" />
            <DataGridTemplateColumn Header="{x:Static app:UiStrings.TableDetailColumnComputed}"
                                    SortMemberPath="ComputedSource"
                                    MinWidth="90"
                                    IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:FieldRowViewModel">
                  <TextBlock Text="{Binding ComputedSource}"
                             FontStyle="Italic"
                             Foreground="{DynamicResource SubtleForegroundBrush}"
                             Margin="6,0"
                             VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailColumnCharset}"
                                Binding="{Binding Charset}"
                                SortMemberPath="Charset"
                                MinWidth="70"
                                IsReadOnly="True" />
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailColumnAutoIncrement}"
                                Binding="{Binding IsAutoIncrement, Converter={x:Static conv:BoolToCheckmarkConverter.Instance}}"
                                SortMemberPath="IsAutoIncrement"
                                MinWidth="40"
                                IsReadOnly="True" />
          </DataGrid.Columns>
        </DataGrid>

        <!-- Vertical splitter — user drags to grow/shrink the dependencies
             panel. ResizeDirection=Rows because the parent Grid is
             row-oriented. -->
        <GridSplitter Grid.Row="1"
                      Height="4"
                      ResizeDirection="Rows"
                      Background="{DynamicResource BorderBrush}"
                      HorizontalAlignment="Stretch" />

        <!-- Bottom: per-field dependencies. Three mutually-exclusive
             children (DataGrid + two TextBlock hints) — the VM's flags
             toggle exactly one visible at a time. -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource PanelBrush}">
          <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0"
                    Padding="8,4"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
              <TextBlock Text="{x:Static app:UiStrings.FieldDependenciesHeader}"
                         FontSize="11"
                         FontWeight="SemiBold" />
            </Border>

            <!-- No-selection state. -->
            <TextBlock Grid.Row="1"
                       Text="{x:Static app:UiStrings.FieldDependenciesNoSelection}"
                       Classes="subtle"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsVisible="{Binding ShowFieldDependenciesNoSelection}" />

            <!-- Field selected, no dependencies. -->
            <TextBlock Grid.Row="1"
                       Text="{x:Static app:UiStrings.FieldDependenciesEmpty}"
                       Classes="subtle"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsVisible="{Binding ShowFieldDependenciesEmpty}" />

            <!-- Field selected with dependencies. Same compact styling as the
                 other TableDetail grids (Pola / Indeksy / Ograniczenia). Read-only.
                 DoubleTapped + Enter route through FieldDependencyItem.NavigateCommand
                 (existing RequestOpen path — same as the Zależności tree). -->
            <DataGrid Grid.Row="1"
                      x:Name="FieldDependenciesGrid"
                      ItemsSource="{Binding FieldDependencies}"
                      SelectedItem="{Binding SelectedFieldDependency, Mode=TwoWay}"
                      IsReadOnly="True"
                      FontSize="11"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      CanUserReorderColumns="True"
                      ColumnWidth="Auto"
                      RowBackground="Transparent"
                      HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                      VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                      Background="{DynamicResource BackgroundBrush}"
                      IsVisible="{Binding HasFieldDependencies}"
                      DoubleTapped="OnFieldDependencyDoubleTapped">
              <DataGrid.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding NavigateSelectedDependencyCommand}" />
              </DataGrid.KeyBindings>
              <DataGrid.Columns>
                <!-- Type column carries the same unicode glyph + per-kind
                     color as the metadata tree (via IconBrushConverter +
                     ActualThemeVariant). Glyph empty for non-openable kinds. -->
                <DataGridTemplateColumn Header="{x:Static app:UiStrings.FieldDependenciesColumnType}"
                                        SortMemberPath="ObjectType"
                                        MinWidth="110">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:FieldDependencyItem">
                      <StackPanel Orientation="Horizontal" Spacing="6" Margin="6,0">
                        <controls:SvgIcon Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}"
                                          Width="15" Height="15"
                                          VerticalAlignment="Center">
                          <controls:SvgIcon.Foreground>
                            <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                              <Binding Path="IconResourceKey" />
                              <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                            </MultiBinding>
                          </controls:SvgIcon.Foreground>
                        </controls:SvgIcon>
                        <TextBlock Text="{Binding ObjectType}"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{x:Static app:UiStrings.FieldDependenciesColumnName}"
                                    Binding="{Binding ObjectName}"
                                    SortMemberPath="ObjectName"
                                    MinWidth="160" />
                <!-- Insert / Update — ✓ for triggers that fire on that DML op,
                     blank for procedures / views / etc. (no per-field op
                     semantics in the catalog). -->
                <DataGridTextColumn Header="{x:Static app:UiStrings.FieldDependenciesColumnInsert}"
                                    Binding="{Binding InsertMark}"
                                    SortMemberPath="InsertMark"
                                    MinWidth="60" />
                <DataGridTextColumn Header="{x:Static app:UiStrings.FieldDependenciesColumnUpdate}"
                                    Binding="{Binding UpdateMark}"
                                    SortMemberPath="UpdateMark"
                                    MinWidth="60" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>
        </Grid>
      </TabItem>

      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.TableDetailTabConstraints}">
        <TabControl Padding="0"
                    SelectedIndex="{Binding ConstraintsActiveSubTabIndex, Mode=TwoWay}">

          <TabItem Classes="sub-tab"
                   Classes.empty="{Binding !HasPrimaryKeyConstraints}"
                   Header="{Binding PrimaryKeyTabHeader}">
            <DataGrid x:Name="PrimaryKeyGrid"
                      behaviors:GridLayoutBehavior.GridId="TableDetail.Constraints.PrimaryKey"
                      ItemsSource="{Binding PrimaryKeyConstraints}"
                      SelectedItem="{Binding SelectedPrimaryKey, Mode=TwoWay}"
                      PointerPressed="OnConstraintGridPointerPressed"
                      IsReadOnly="True"
                      FontSize="11"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      CanUserReorderColumns="True"
                      ColumnWidth="Auto"
                      RowBackground="Transparent"
                      HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                      VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                      Background="{DynamicResource BackgroundBrush}">
              <DataGrid.ContextMenu>
                <ContextMenu IsVisible="{Binding CanManageConstraints}">
                  <MenuItem Header="{x:Static app:UiStrings.ConstraintMenuAddPrimaryKey}"
                            Command="{Binding AddPrimaryKeyCommand}"
                            IsVisible="{Binding CanManageConstraints}" />
                  <MenuItem Header="{x:Static app:UiStrings.ConstraintMenuDropPrimaryKey}"
                            Command="{Binding DropConstraintCommand}"
                            IsVisible="{Binding CanManageConstraints}" />
                </ContextMenu>
              </DataGrid.ContextMenu>
              <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailColumnName}"
                                    Binding="{Binding Name}"
                                    SortMemberPath="Name" />
                <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailConstraintFields}"
                                    Binding="{Binding Fields}"
                                    SortMemberPath="Fields" />
                <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailConstraintIndexName}"
                                    Binding="{Binding IndexName}"
                                    SortMemberPath="IndexName" />
                <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailConstraintSort}"
                                    Binding="{Binding IsDescending, Converter={x:Static conv:BoolToSortOrderConverter.Instance}}"
                                    SortMemberPath="IsDescending" />
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>

          <TabItem Classes="sub-tab"
                   Classes.empty="{Binding !HasForeignKeyConstraints}"
                   Header="{Binding ForeignKeyTabHeader}">
            <DataGrid x:Name="ForeignKeyGrid"
                      behaviors:GridLayoutBehavior.GridId="TableDetail.Constraints.ForeignKey"
                      ItemsSource="{Binding ForeignKeyConstraints}"
                      SelectedItem="{Binding SelectedForeignKey, Mode=TwoWay}"
                      PointerPressed="OnConstraintGridPointerPressed"
                      IsReadOnly="True"
                      FontSize="11"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      CanUserReorderColumns="True"
                      ColumnWidth="Auto"
                      RowBackground="Transparent"
                      HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                      VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                      Background="{DynamicResource BackgroundBrush}">
              <DataGrid.ContextMenu>
                <ContextMenu IsVisible="{Binding CanManageConstraints}">
                  <MenuItem Header="{x:Static app:UiStrings.ConstraintMenuAddForeignKey}"
                            Command="{Binding CreateForeignKeyCommand}"
                            IsVisible="{Binding CanManageConstraints}" />
                  <MenuItem Header="{x:Static app:UiStrings.ConstraintMenuDropForeignKey}"
                            Command="{Binding DropConstraintCommand}"
                            IsVisible="{Binding CanManageConstraints}" />
                </ContextMenu>
              </DataGrid.ContextMenu>
              <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailColumnName}"
                                    Binding="{Binding Name}"
                                    SortMemberPath="Name" />
                <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailConstraintFields}"
                                    Binding="{Binding Fields}"
                                    SortMemberPath="Fields" />
                <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailConstraintRefTable}"
                                    Binding="{Binding RefTable}"
                                    SortMemberPath="RefTable" />
                <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailConstraintRefFields}"
                                    Binding="{Binding RefFields}"
                                    SortMemberPath="RefFields" />
                <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailConstraintUpdateRule}"
                                    Binding="{Binding UpdateRule}"
                                    SortMemberPath="UpdateRule" />
                <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailConstraintDeleteRule}"
                                    Binding="{Binding DeleteRule}"
                                    SortMemberPath="DeleteRule" />
                <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailConstraintSort}"
                                    Binding="{Binding IsDescending, Converter={x:Static conv:BoolToSortOrderConverter.Instance}}"
                                    SortMemberPath="IsDescending" />
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>

          <TabItem Classes="sub-tab"
                   Classes.empty="{Binding !HasCheckConstraints}"
                   Header="{Binding CheckTabHeader}">
            <DataGrid x:Name="CheckGrid"
                      behaviors:GridLayoutBehavior.GridId="TableDetail.Constraints.Check"
                      ItemsSource="{Binding CheckConstraints}"
                      SelectedItem="{Binding SelectedCheck, Mode=TwoWay}"
                      PointerPressed="OnConstraintGridPointerPressed"
                      IsReadOnly="True"
                      FontSize="11"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      CanUserReorderColumns="True"
                      ColumnWidth="Auto"
                      RowBackground="Transparent"
                      HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                      VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                      Background="{DynamicResource BackgroundBrush}">
              <DataGrid.ContextMenu>
                <ContextMenu IsVisible="{Binding CanManageConstraints}">
                  <MenuItem Header="{x:Static app:UiStrings.ConstraintMenuAddCheck}"
                            Command="{Binding AddCheckCommand}"
                            IsVisible="{Binding CanManageConstraints}" />
                  <MenuItem Header="{x:Static app:UiStrings.ConstraintMenuDropCheck}"
                            Command="{Binding DropConstraintCommand}"
                            IsVisible="{Binding CanManageConstraints}" />
                </ContextMenu>
              </DataGrid.ContextMenu>
              <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailColumnName}"
                                    Binding="{Binding Name}"
                                    SortMemberPath="Name" />
                <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailConstraintSource}"
                                    Binding="{Binding CheckClause}"
                                    SortMemberPath="CheckClause"
                                    Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>

          <TabItem Classes="sub-tab"
                   Classes.empty="{Binding !HasUniqueConstraints}"
                   Header="{Binding UniqueTabHeader}">
            <DataGrid x:Name="UniqueGrid"
                      behaviors:GridLayoutBehavior.GridId="TableDetail.Constraints.Unique"
                      ItemsSource="{Binding UniqueConstraints}"
                      SelectedItem="{Binding SelectedUnique, Mode=TwoWay}"
                      PointerPressed="OnConstraintGridPointerPressed"
                      IsReadOnly="True"
                      FontSize="11"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      CanUserReorderColumns="True"
                      ColumnWidth="Auto"
                      RowBackground="Transparent"
                      HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                      VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                      Background="{DynamicResource BackgroundBrush}">
              <DataGrid.ContextMenu>
                <ContextMenu IsVisible="{Binding CanManageConstraints}">
                  <MenuItem Header="{x:Static app:UiStrings.ConstraintMenuAddUnique}"
                            Command="{Binding AddUniqueCommand}"
                            IsVisible="{Binding CanManageConstraints}" />
                  <MenuItem Header="{x:Static app:UiStrings.ConstraintMenuDropUnique}"
                            Command="{Binding DropConstraintCommand}"
                            IsVisible="{Binding CanManageConstraints}" />
                </ContextMenu>
              </DataGrid.ContextMenu>
              <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailColumnName}"
                                    Binding="{Binding Name}"
                                    SortMemberPath="Name" />
                <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailConstraintFields}"
                                    Binding="{Binding Fields}"
                                    SortMemberPath="Fields" />
                <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailConstraintIndexName}"
                                    Binding="{Binding IndexName}"
                                    SortMemberPath="IndexName" />
                <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailConstraintSort}"
                                    Binding="{Binding IsDescending, Converter={x:Static conv:BoolToSortOrderConverter.Instance}}"
                                    SortMemberPath="IsDescending" />
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>

        </TabControl>
      </TabItem>

      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.TableDetailTabIndexes}">
        <DataGrid x:Name="IndexesGrid"
                  behaviors:GridLayoutBehavior.GridId="TableDetail.Indexes"
                  ItemsSource="{Binding Indexes}"
                  SelectedItem="{Binding SelectedIndex, Mode=TwoWay}"
                  PointerPressed="OnIndexGridPointerPressed"
                  IsReadOnly="True"
                  FontSize="11"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  CanUserSortColumns="True"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="True"
                  ColumnWidth="Auto"
                  RowBackground="Transparent"
                  HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                  VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                  Background="{DynamicResource BackgroundBrush}">
          <DataGrid.ContextMenu>
            <ContextMenu IsVisible="{Binding CanManageIndexes}">
              <MenuItem Header="{x:Static app:UiStrings.IndexMenuAdd}"
                        Command="{Binding AddIndexCommand}"
                        IsVisible="{Binding CanManageIndexes}" />
              <MenuItem Header="{x:Static app:UiStrings.IndexMenuDrop}"
                        Command="{Binding DropIndexCommand}"
                        IsVisible="{Binding CanManageIndexes}" />
              <Separator IsVisible="{Binding CanManageIndexes}" />
              <MenuItem Header="{x:Static app:UiStrings.IndexMenuRecomputeStatistics}"
                        Command="{Binding RecomputeIndexStatisticsCommand}"
                        IsVisible="{Binding CanManageIndexes}" />
              <MenuItem Header="{x:Static app:UiStrings.IndexMenuRecomputeAllStatistics}"
                        Command="{Binding RecomputeAllIndexStatisticsCommand}"
                        IsVisible="{Binding CanManageIndexes}" />
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="{x:Static app:UiStrings.TableDetailIndexType}"
                                    Width="30"
                                    SortMemberPath="IndexType">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="metadata:IndexInfo">
                  <Panel>
                    <Path Data="{StaticResource PkIconGeometry}"
                          Fill="{DynamicResource AccentBrush}"
                          Width="14" Height="14"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsVisible="{Binding IsPrimary}" />
                    <Path Data="{StaticResource FkIconGeometry}"
                          Fill="{DynamicResource WarningBrush}"
                          Width="14" Height="14"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsVisible="{Binding IsForeignKeyIndex}" />
                  </Panel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <!-- Replaced fixed Width with MinWidth so the grid-level
                 ColumnWidth="Auto" can grow each column to fit the larger of
                 header / content text without truncating either. -->
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailColumnName}"
                                Binding="{Binding Name}"
                                SortMemberPath="Name"
                                MinWidth="160" />
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailIndexFields}"
                                Binding="{Binding Fields}"
                                SortMemberPath="Fields"
                                MinWidth="120" />
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailIndexExpression}"
                                Binding="{Binding Expression}"
                                SortMemberPath="Expression"
                                MinWidth="100" />
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailIndexUnique}"
                                Binding="{Binding IsUnique, Converter={x:Static conv:BoolToCheckmarkConverter.Instance}}"
                                SortMemberPath="IsUnique"
                                MinWidth="70" />
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailIndexDescending}"
                                Binding="{Binding IsDescending, Converter={x:Static conv:BoolToCheckmarkConverter.Instance}}"
                                SortMemberPath="IsDescending"
                                MinWidth="90" />
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailIndexPrimary}"
                                Binding="{Binding IsPrimary, Converter={x:Static conv:BoolToCheckmarkConverter.Instance}}"
                                SortMemberPath="IsPrimary"
                                MinWidth="60" />
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailIndexActive}"
                                Binding="{Binding IsActive, Converter={x:Static conv:BoolToCheckmarkConverter.Instance}}"
                                SortMemberPath="IsActive"
                                MinWidth="60" />
            <DataGridTemplateColumn Header="{x:Static app:UiStrings.TableDetailIndexStatistics}"
                                    MinWidth="90"
                                    SortMemberPath="Statistics">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="metadata:IndexInfo">
                  <TextBlock Text="{Binding Statistics, StringFormat={}{0:F6}}"
                             TextAlignment="Right"
                             VerticalAlignment="Center"
                             Margin="8,0" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>

      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.TableDetailTabDependencies}">
        <Grid ColumnDefinitions="*,4,*">
          <Grid Grid.Column="0" RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0"
                       Text="{x:Static app:UiStrings.TableDetailDependedOnByHeader}"
                       FontSize="11"
                       Foreground="{DynamicResource SubtleForegroundBrush}"
                       Margin="0,4,0,4" />
            <!-- "Used by" (left) — objects that depend on this table
                 (views, triggers, procedures, functions, etc.). IBExpert layout. -->
            <TreeView Grid.Row="1"
                      ItemsSource="{Binding DependedOnByTree}"
                      Background="{DynamicResource BackgroundBrush}">
              <TreeView.DataTemplates>
                <TreeDataTemplate DataType="vm:DependencyGroupNode"
                                  ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <controls:SvgIcon Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}"
                                      Width="15" Height="15"
                                      VerticalAlignment="Center">
                      <controls:SvgIcon.Foreground>
                        <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                          <Binding Path="IconResourceKey" />
                          <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                        </MultiBinding>
                      </controls:SvgIcon.Foreground>
                    </controls:SvgIcon>
                    <TextBlock Text="{Binding Header}"
                               FontSize="11"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </TreeDataTemplate>
                <DataTemplate DataType="vm:DependencyLeafNode">
                  <Border HorizontalAlignment="Stretch"
                          Background="Transparent"
                          DoubleTapped="OnDependencyNodeDoubleTapped">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <controls:SvgIcon Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}"
                                        Width="15" Height="15"
                                        VerticalAlignment="Center">
                        <controls:SvgIcon.Foreground>
                          <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                            <Binding Path="IconResourceKey" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </controls:SvgIcon.Foreground>
                      </controls:SvgIcon>
                      <TextBlock Text="{Binding ObjectName}"
                                 FontSize="11"
                                 VerticalAlignment="Center" />
                      <TextBlock Text="{Binding FieldName}"
                                 FontSize="10"
                                 Foreground="{DynamicResource SubtleForegroundBrush}"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding FieldName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </TreeView.DataTemplates>
            </TreeView>
          </Grid>

          <GridSplitter Grid.Column="1"
                        Width="4"
                        Background="{DynamicResource BorderBrush}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />

          <Grid Grid.Column="2" RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0"
                       Text="{x:Static app:UiStrings.TableDetailDependsOnHeader}"
                       FontSize="11"
                       Foreground="{DynamicResource SubtleForegroundBrush}"
                       Margin="0,4,0,4" />
            <!-- "Depends on" (right) — what this table uses. Domains via field
                 types, plus RDB$DEPENDENCIES rows where the table is the
                 dependent (computed cols, defaults, check expressions). -->
            <TreeView Grid.Row="1"
                      ItemsSource="{Binding DependsOnTree}"
                      Background="{DynamicResource BackgroundBrush}">
              <TreeView.DataTemplates>
                <TreeDataTemplate DataType="vm:DependencyGroupNode"
                                  ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <controls:SvgIcon Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}"
                                      Width="15" Height="15"
                                      VerticalAlignment="Center">
                      <controls:SvgIcon.Foreground>
                        <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                          <Binding Path="IconResourceKey" />
                          <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                        </MultiBinding>
                      </controls:SvgIcon.Foreground>
                    </controls:SvgIcon>
                    <TextBlock Text="{Binding Header}"
                               FontSize="11"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </TreeDataTemplate>
                <DataTemplate DataType="vm:DependencyLeafNode">
                  <Border HorizontalAlignment="Stretch"
                          Background="Transparent"
                          DoubleTapped="OnDependencyNodeDoubleTapped">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <controls:SvgIcon Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}"
                                        Width="15" Height="15"
                                        VerticalAlignment="Center">
                        <controls:SvgIcon.Foreground>
                          <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                            <Binding Path="IconResourceKey" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </controls:SvgIcon.Foreground>
                      </controls:SvgIcon>
                      <TextBlock Text="{Binding ObjectName}"
                                 FontSize="11"
                                 VerticalAlignment="Center" />
                      <TextBlock Text="{Binding FieldName}"
                                 FontSize="10"
                                 Foreground="{DynamicResource SubtleForegroundBrush}"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding FieldName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </TreeView.DataTemplates>
            </TreeView>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.TableDetailTabData}">
        <!-- Rows: hint+filter/agg toggles · edit status · pagination-hint+record ·
             filter panel · aggregation bar · error+grid. -->
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
          <!-- Unified grid toolbar (identical across all 5 data grids): refresh +
               pagination · hint · Record N of M · filter/aggregation toggles.
               Add/Delete rows live in the main toolbar's shared collection section. -->
          <StackPanel Grid.Row="0"
                      Orientation="Horizontal"
                      Spacing="4"
                      Margin="8,4">
            <Button Classes="icon"
                    ToolTip.Tip="{x:Static app:UiStrings.TableDetailPaginationFirstTooltip}"
                    Command="{Binding GoToFirstPageCommand}">
              <controls:SvgIcon Data="{StaticResource Icon.ChevronFirst}" Width="14" Height="14" />
            </Button>
            <Button Classes="icon"
                    ToolTip.Tip="{x:Static app:UiStrings.TableDetailPaginationPreviousTooltip}"
                    Command="{Binding GoToPreviousPageCommand}">
              <controls:SvgIcon Data="{StaticResource Icon.ChevronLeft}" Width="14" Height="14" />
            </Button>
            <Button Classes="icon"
                    ToolTip.Tip="{x:Static app:UiStrings.TableDetailPaginationNextTooltip}"
                    Command="{Binding GoToNextPageCommand}">
              <controls:SvgIcon Data="{StaticResource Icon.ChevronRight}" Width="14" Height="14" />
            </Button>
            <Button Classes="icon"
                    ToolTip.Tip="{x:Static app:UiStrings.TableDetailPaginationLastTooltip}"
                    Command="{Binding GoToLastPageCommand}">
              <controls:SvgIcon Data="{StaticResource Icon.ChevronLast}" Width="14" Height="14" />
            </Button>
            <TextBlock Text="{Binding DataPreviewHint}" Classes="subtle" FontSize="11"
                       VerticalAlignment="Center" Margin="6,0,0,0" />
            <TextBlock Text="{Binding DataRecordInfo}" Classes="subtle" FontSize="11"
                       VerticalAlignment="Center" Margin="12,0,0,0" />
            <ToggleButton Classes="icon" Margin="12,0,0,0"
                          ToolTip.Tip="{x:Static app:UiStrings.FilterToggleTooltip}"
                          IsChecked="{Binding DataFilterPanel.IsPanelOpen, Mode=TwoWay}">
              <Panel>
                <controls:SvgIcon Data="{StaticResource Icon.Filter}" Width="14" Height="14" />
                <Border Classes="filter-active-dot" IsVisible="{Binding DataFilterPanel.IsFilterActive}" />
              </Panel>
            </ToggleButton>
            <ToggleButton Classes="icon"
                          ToolTip.Tip="{x:Static app:UiStrings.AggregationToggleTooltip}"
                          IsChecked="{Binding DataAggregationBar.IsBarOpen, Mode=TwoWay}">
              <controls:SvgIcon Data="{StaticResource Icon.Sigma}" Width="14" Height="14" />
            </ToggleButton>
            <!-- Refresh is a data-reload action, not navigation → at the end of the row,
                 flush with the filter/aggregation toggles (same icon group). -->
            <Button Classes="icon"
                    ToolTip.Tip="{x:Static app:UiStrings.ToolbarRefreshDataTooltip}"
                    Command="{Binding RefreshDataPreviewCommand}">
              <controls:SvgIcon Data="{StaticResource Icon.RefreshCw}" Foreground="{DynamicResource InfoIconBrush}" Width="14" Height="14" />
            </Button>
            <!-- Export the table data via the shared Export Framework (default = the whole table). -->
            <Button Classes="icon" Click="OnDataExportClick" IsEnabled="{Binding CanExportData}"
                    ToolTip.Tip="{x:Static app:UiStrings.ExportResultsTooltip}">
              <controls:SvgIcon Data="{StaticResource Icon.Download}" Width="14" Height="14" />
            </Button>
          </StackPanel>
          <TextBlock Grid.Row="1"
                     Text="{Binding EditModeHint}"
                     Classes="subtle"
                     FontSize="11"
                     Margin="8,0,8,4"
                     VerticalAlignment="Center"
                     IsVisible="{Binding EditModeHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Grid.Row="2"
                     Text="{Binding EditStatusMessage}"
                     Classes="subtle error"
                     FontSize="11"
                     Margin="8,0,8,4"
                     TextWrapping="Wrap"
                     IsVisible="{Binding HasEditStatusMessage}" />
          <views:FilterPanelView Grid.Row="3" DataContext="{Binding DataFilterPanel}" />
          <views:AggregationBarView Grid.Row="4" DataContext="{Binding DataAggregationBar}" />
          <TextBlock Grid.Row="5"
                     Text="{Binding DataError}"
                     Classes="subtle error"
                     FontSize="11"
                     Margin="8,4"
                     TextWrapping="Wrap"
                     IsVisible="{Binding ShowDataError}" />
          <DataGrid Grid.Row="5"
                    x:Name="DataPreviewGrid"
                    behaviors:GridLayoutBehavior.GridId="TableDetail.Data"
                    Classes="data-edit"
                    ItemsSource="{Binding EditableRows}"
                    SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                    SelectionChanged="OnDataSelectionChanged"
                    IsReadOnly="{Binding IsDataReadOnly}"
                    FontSize="11"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    CanUserSortColumns="True"
                    CanUserResizeColumns="True"
                    CanUserReorderColumns="False"
                    ColumnWidth="Auto"
                    RowBackground="Transparent"
                    HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                    VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                    Background="{DynamicResource BackgroundBrush}"
                    IsVisible="{Binding HasDataResult}">
            <DataGrid.ContextMenu>
              <!-- Per-cell "Set NULL" (edit-only) + filter-from-cell (always). The
                   right-clicked row/column are resolved in OnDataCellPointerPressed;
                   Set NULL enables by nullability, Contains by text category. -->
              <ContextMenu>
                <MenuItem x:Name="SetNullMenuItem"
                          Header="{x:Static app:UiStrings.DataEditSetNull}"
                          Click="OnSetCellNullClick"
                          IsVisible="{Binding CanEditData}" />
                <Separator IsVisible="{Binding CanEditData}" />
                <MenuItem Header="{x:Static app:UiStrings.FilterByValue}" Click="OnDataFilterByValueClick" />
                <MenuItem Header="{x:Static app:UiStrings.FilterExcludeValue}" Click="OnDataExcludeValueClick" />
                <MenuItem x:Name="DataFilterContainsItem"
                          Header="{x:Static app:UiStrings.FilterContainsValue}" Click="OnDataFilterContainsClick" />
                <Separator />
                <MenuItem Header="{x:Static app:UiStrings.ExportResultsMenuItem}" Click="OnDataExportClick" />
              </ContextMenu>
            </DataGrid.ContextMenu>
          </DataGrid>
        </Grid>
      </TabItem>

      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.TableDetailTabDescription}">
        <!-- Editable table description (COMMENT ON TABLE). Save/Clear run in the
             working transaction via the same RefreshStructureAsync path as other
             structural edits. Buttons disabled when no DDL executor is wired. -->
        <Grid RowDefinitions="Auto,*" Background="{DynamicResource BackgroundBrush}">
          <!-- Edit controls (label + Save + Clear) hide entirely without a DDL executor
               (read-only system tables) — the description TextBox below stays for viewing. -->
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="8,6,8,4"
                      IsVisible="{Binding CanEditDescription}">
            <TextBlock Text="{x:Static app:UiStrings.TableDescriptionEditLabel}"
                       Classes="subtle"
                       FontSize="11"
                       VerticalAlignment="Center" />
            <Button Classes="icon"
                    ToolTip.Tip="{x:Static app:UiStrings.TableDescriptionSave}"
                    Command="{Binding SaveDescriptionCommand}">
              <controls:SvgIcon Data="{StaticResource Icon.Save}" />
            </Button>
            <Button Classes="flat"
                    Padding="8,2"
                    Content="{x:Static app:UiStrings.TableDescriptionClear}"
                    Command="{Binding ClearDescriptionCommand}" />
          </StackPanel>
          <TextBox Grid.Row="1"
                   Text="{Binding EditableDescription, Mode=TwoWay}"
                   IsEnabled="{Binding CanEditDescription}"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   FontSize="11"
                   Margin="8,0,8,8"
                   Background="{DynamicResource BackgroundBrush}" />
        </Grid>
      </TabItem>

      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.TableDetailTabDdl}">
        <ae:TextEditor x:Name="TableDetailDdlEditor"
                       ShowLineNumbers="True"
                       IsReadOnly="True"
                       FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                       FontSize="13"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto"
                       Background="{DynamicResource BackgroundBrush}"
                       Foreground="{DynamicResource ForegroundBrush}" />
      </TabItem>

    </TabControl>

    <StackPanel Grid.Row="1" Orientation="Vertical">
      <TextBlock Text="{x:Static app:UiStrings.TableDetailLoadingHint}"
                 Classes="subtle"
                 Margin="10,4"
                 FontSize="11"
                 IsVisible="{Binding IsLoading}" />
      <!-- Surface load errors in the view directly — the Messages tab is
           hidden on TableDetail tabs (per the SQL-Editor-only bottom panel),
           so without this the user would see no feedback at all. -->
      <SelectableTextBlock Text="{Binding ErrorMessage}"
                 Classes="subtle error"
                 Margin="10,4"
                 FontSize="11"
                 TextWrapping="Wrap"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <!-- Non-error completion info (e.g. "Recomputed statistics for N of M indexes"). -->
      <TextBlock Text="{Binding StatusMessage}"
                 Classes="subtle"
                 Margin="10,4"
                 FontSize="11"
                 TextWrapping="Wrap"
                 IsVisible="{Binding HasStatusMessage}" />
    </StackPanel>
  </Grid>

</UserControl>
