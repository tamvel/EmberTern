<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EmberTern.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="EmberTern.App.Views.ConfirmDialog"
        x:DataType="vm:ConfirmDialogViewModel"
        Title="{Binding Title}"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">

  <Grid RowDefinitions="Auto,*,Auto">

    <Border Grid.Row="0"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="20,16">
      <TextBlock Text="{Binding Title}" Classes="h1" />
    </Border>

    <!-- ⭐ M4.4: treść komunikatu na rolę Text.Application — ta sama decyzja co w ChoiceDialog, i z tego
         samego powodu: przy 13 katalog ma wyłącznie rolę kodu, a komunikat potwierdzenia jest prozą.
         ⚠ Oba dialogi są konstrukcyjnie identyczne w tym miejscu (ten sam wiersz, to samo zawijanie, ten
         sam margines), więc to JEDNA decyzja na dwa okna, nie dwie — kształt Q3 z M4.3.
         ⚠ Sam rozmiar, bez interlinii: patrz uzasadnienie w ChoiceDialog. -->
    <TextBlock Grid.Row="1"
               Text="{Binding Message}"
               TextWrapping="Wrap"
               FontSize="{DynamicResource Text.Application.Size}"
               Margin="20,18,20,18" />

    <Border Grid.Row="2"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="20,12">
      <Grid RowDefinitions="Auto,Auto">
        <!-- ⭐ The optional "do not ask again" box lives in the footer — it is a decision about the dialog, not
             part of what the dialog says — on its OWN ROW, with a WRAPPING label.
             ⚠⚠ Both halves are load-bearing, and measurement is what says so. It first shared a row with the
             buttons and the label was cut to "Nie pokazuj tego ostrzeż…". Giving it a full row is still not
             enough: measured at the shared Width=420 (≈380 px of content), the label wants 358 px in English
             but 435 px in Polish. A CheckBox neither wraps nor ellipsizes by itself, so the only way to render
             every shipped language in full — and any future one — is to let the label wrap.
             ⛔ Do not "fix" a future clip by shrinking the font, widening this window (420 is the shared dialog
             width, TextPromptDialog included, so it moves every confirmation in the app) or trimming the
             sentence. TheSuppressCheckbox_IsFullyReadable_InEveryShippedLanguage measures this with the engine
             the product lays out with.
             ⚠ Hidden, the CheckBox has no desired size, so its Auto row collapses to zero and its margin with
             it — a dialog without a suppress option renders exactly as it always did. -->
        <CheckBox Grid.Row="0"
                  IsChecked="{Binding SuppressChecked, Mode=TwoWay}"
                  IsVisible="{Binding HasSuppress}"
                  Margin="{DynamicResource Margin.FieldGap}">
          <TextBlock Text="{Binding SuppressLabel}"
                     TextWrapping="Wrap"
                     FontSize="{DynamicResource Text.Compact.Size}" />
        </CheckBox>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
          <!-- ⭐ An ACKNOWLEDGEMENT has nothing to cancel. Hiding the button on an empty CancelLabel turns the
               one shared dialog into an info dialog too, instead of adding a second dialog that would then be
               free to drift from this one's chrome. -->
          <Button Classes="flat"
                  Content="{Binding CancelLabel}"
                  IsVisible="{Binding HasCancel}"
                  Command="{Binding CancelCommand}" />
          <Button Classes="primary"
                  Content="{Binding ConfirmLabel}"
                  Command="{Binding ConfirmCommand}"
                  IsDefault="True" />
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</Window>
