<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EmberTern.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="EmberTern.App.Views.ConfirmDialog"
        x:DataType="vm:ConfirmDialogViewModel"
        Title="{Binding Title}"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">

  <Grid RowDefinitions="Auto,*,Auto">

    <Border Grid.Row="0"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="20,16">
      <TextBlock Text="{Binding Title}" Classes="h1" />
    </Border>

    <!-- ⭐ M4.4: treść komunikatu na rolę Text.Application — ta sama decyzja co w ChoiceDialog, i z tego
         samego powodu: przy 13 katalog ma wyłącznie rolę kodu, a komunikat potwierdzenia jest prozą.
         ⚠ Oba dialogi są konstrukcyjnie identyczne w tym miejscu (ten sam wiersz, to samo zawijanie, ten
         sam margines), więc to JEDNA decyzja na dwa okna, nie dwie — kształt Q3 z M4.3.
         ⚠ Sam rozmiar, bez interlinii: patrz uzasadnienie w ChoiceDialog. -->
    <TextBlock Grid.Row="1"
               Text="{Binding Message}"
               TextWrapping="Wrap"
               FontSize="{DynamicResource Text.Application.Size}"
               Margin="20,18,20,18" />

    <Border Grid.Row="2"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="20,12">
      <Grid ColumnDefinitions="*,Auto">
        <!-- ⭐ The optional "do not ask again" box shares the footer with the buttons rather than sitting in the
             message area: it is a decision about the dialog, not part of what the dialog says. Absent unless
             the caller supplies a label, so every existing consumer renders exactly as before. -->
        <CheckBox Grid.Column="0"
                  Content="{Binding SuppressLabel}"
                  IsChecked="{Binding SuppressChecked, Mode=TwoWay}"
                  IsVisible="{Binding HasSuppress}"
                  VerticalAlignment="Center"
                  FontSize="{DynamicResource Text.Compact.Size}" />

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
          <!-- ⭐ An ACKNOWLEDGEMENT has nothing to cancel. Hiding the button on an empty CancelLabel turns the
               one shared dialog into an info dialog too, instead of adding a second dialog that would then be
               free to drift from this one's chrome. -->
          <Button Classes="flat"
                  Content="{Binding CancelLabel}"
                  IsVisible="{Binding HasCancel}"
                  Command="{Binding CancelCommand}" />
          <Button Classes="primary"
                  Content="{Binding ConfirmLabel}"
                  Command="{Binding ConfirmCommand}"
                  IsDefault="True" />
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</Window>
