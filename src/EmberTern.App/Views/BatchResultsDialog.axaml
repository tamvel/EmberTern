<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EmberTern.App.ViewModels"
        xmlns:app="using:EmberTern.App"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="EmberTern.App.Views.BatchResultsDialog"
        x:DataType="vm:BatchResultsViewModel"
        Title="{Binding Title}"
        Width="780"
        Height="520"
        MinWidth="560"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <Border Grid.Row="0"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="20,14">
      <TextBlock Text="{Binding Title}" Classes="h1" />
    </Border>

    <!-- Toolbar: filter + clipboard export. -->
    <Border Grid.Row="1"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="20,8">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="{x:Static app:UiStrings.BatchResultsFilterLabel}"
                   VerticalAlignment="Center" Foreground="{DynamicResource SubtleForegroundBrush}" />
        <ComboBox SelectedIndex="{Binding SelectedFilterIndex, Mode=TwoWay}" MinWidth="120">
          <ComboBoxItem Content="{x:Static app:UiStrings.BatchResultsFilterAll}" />
          <ComboBoxItem Content="{x:Static app:UiStrings.BatchResultsFilterSuccess}" />
          <ComboBoxItem Content="{x:Static app:UiStrings.BatchResultsFilterFailed}" />
        </ComboBox>
        <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="4,2" />
        <Button Classes="flat" Content="{x:Static app:UiStrings.BatchResultsCopyAll}"
                Command="{Binding CopyAllCommand}" />
        <Button Classes="flat" Content="{x:Static app:UiStrings.BatchResultsCopyFailed}"
                Command="{Binding CopyFailedCommand}" />
      </StackPanel>
    </Border>

    <DataGrid Grid.Row="2"
              ItemsSource="{Binding VisibleRows}"
              IsReadOnly="True"
              CanUserSortColumns="True"
              CanUserResizeColumns="True"
              GridLinesVisibility="Horizontal"
              Margin="0">
      <DataGrid.Styles>
        <Style Selector="TextBlock.result-ok">
          <Setter Property="Foreground" Value="{DynamicResource SuccessIconBrush}" />
        </Style>
        <Style Selector="TextBlock.result-failed">
          <Setter Property="Foreground" Value="{DynamicResource DangerIconBrush}" />
        </Style>
      </DataGrid.Styles>
      <DataGrid.Columns>
        <DataGridTextColumn Header="{x:Static app:UiStrings.BatchResultsColumnObject}"
                            Binding="{Binding Object}" SortMemberPath="Object" Width="220" />
        <DataGridTextColumn Header="{x:Static app:UiStrings.BatchResultsColumnOperation}"
                            Binding="{Binding Operation}" SortMemberPath="Operation" Width="140" />
        <DataGridTemplateColumn Header="{x:Static app:UiStrings.BatchResultsColumnResult}"
                                SortMemberPath="Result" Width="90">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:BatchResultRowViewModel">
              <TextBlock Text="{Binding Result}"
                         VerticalAlignment="Center"
                         Margin="8,0"
                         Classes.result-failed="{Binding IsFailed}"
                         Classes.result-ok="{Binding !IsFailed}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="{x:Static app:UiStrings.BatchResultsColumnError}"
                            Binding="{Binding Error}" SortMemberPath="Error" Width="*" />
      </DataGrid.Columns>
    </DataGrid>

    <Border Grid.Row="3"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="20,12">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Grid.Column="0" Text="{Binding StatusSummary}" FontSize="12" VerticalAlignment="Center" />
        <Button Grid.Column="1"
                Classes="flat"
                Content="{x:Static app:UiStrings.BatchResultsCancel}"
                Command="{Binding CancelCommand}"
                IsVisible="{Binding IsRunning}"
                Margin="0,0,8,0" />
        <Button Grid.Column="2"
                Classes="primary"
                Content="{x:Static app:UiStrings.BatchResultsClose}"
                IsDefault="True"
                Click="OnCloseClick" />
      </Grid>
    </Border>

  </Grid>
</Window>
