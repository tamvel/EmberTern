<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EmberTern.App.ViewModels"
        xmlns:app="using:EmberTern.App"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="EmberTern.App.Views.BatchResultsDialog"
        x:DataType="vm:BatchResultsViewModel"
        Title="{Binding Title}"
        Width="780"
        Height="520"
        MinWidth="560"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <Border Grid.Row="0"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="20,14">
      <TextBlock Text="{Binding Title}" Classes="h1" />
    </Border>

    <!-- Toolbar: filter + clipboard export. Hidden while preparing (no results yet). -->
    <Border Grid.Row="1"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="20,8"
            IsVisible="{Binding !IsPreparing}">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="{x:Static app:UiStrings.BatchResultsFilterLabel}"
                   VerticalAlignment="Center" Foreground="{DynamicResource SubtleForegroundBrush}" />
        <ComboBox SelectedIndex="{Binding SelectedFilterIndex, Mode=TwoWay}" MinWidth="120">
          <ComboBoxItem Content="{x:Static app:UiStrings.BatchResultsFilterAll}" />
          <ComboBoxItem Content="{x:Static app:UiStrings.BatchResultsFilterSuccess}" />
          <ComboBoxItem Content="{x:Static app:UiStrings.BatchResultsFilterFailed}" />
        </ComboBox>
        <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="4,2" />
        <Button Classes="flat" Content="{x:Static app:UiStrings.BatchResultsCopyAll}"
                Command="{Binding CopyAllCommand}" />
        <Button Classes="flat" Content="{x:Static app:UiStrings.BatchResultsCopyFailed}"
                Command="{Binding CopyFailedCommand}" />
      </StackPanel>
    </Border>

    <!-- Preparing panel: shown immediately on open while the operation list is built,
         then hidden when the VM calls Begin() and the results grid takes over. -->
    <Border Grid.Row="2" Padding="40" IsVisible="{Binding IsPreparing}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                  Spacing="16" MaxWidth="420">
        <TextBlock Text="{Binding PreparationStatus}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   FontSize="14"
                   Classes.error="{Binding PreparationFailed}" />
        <!-- UX Polish Seam 4 — the local DangerIconBrush override is gone: an error message reads in
             ErrorBrush everywhere in the IDE (DangerIconBrush is for destructive-action ICONS), and the
             shared ":is(TextBlock).error" style now supplies it. The local Foreground had to go with it:
             a local value outranks any style setter, so the "failed" tint could never have applied while
             it was set — the dialog inherits the same ForegroundBrush anyway. -->
        <ProgressBar Width="320"
                     IsVisible="{Binding !PreparationFailed}"
                     IsIndeterminate="{Binding PreparationIsIndeterminate}"
                     Minimum="0"
                     Maximum="{Binding PreparationTotal}"
                     Value="{Binding PreparationValue}" />
      </StackPanel>
    </Border>

    <DataGrid Grid.Row="2"
              IsVisible="{Binding !IsPreparing}"
              ItemsSource="{Binding VisibleRows}"
              IsReadOnly="True"
              CanUserSortColumns="True"
              CanUserResizeColumns="True"
              GridLinesVisibility="Horizontal"
              Margin="0">
      <DataGrid.Styles>
        <Style Selector="TextBlock.result-ok">
          <Setter Property="Foreground" Value="{DynamicResource SuccessIconBrush}" />
        </Style>
        <Style Selector="TextBlock.result-failed">
          <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
        </Style>
      </DataGrid.Styles>
      <DataGrid.Columns>
        <DataGridTextColumn Header="{x:Static app:UiStrings.BatchResultsColumnObject}"
                            Binding="{Binding Object}" SortMemberPath="Object" Width="220" />
        <DataGridTextColumn Header="{x:Static app:UiStrings.BatchResultsColumnOperation}"
                            Binding="{Binding Operation}" SortMemberPath="Operation" Width="140" />
        <DataGridTemplateColumn Header="{x:Static app:UiStrings.BatchResultsColumnResult}"
                                SortMemberPath="Result" Width="90">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:BatchResultRowViewModel">
              <TextBlock Text="{Binding Result}"
                         VerticalAlignment="Center"
                         Margin="8,0"
                         Classes.result-failed="{Binding IsFailed}"
                         Classes.result-ok="{Binding !IsFailed}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <!-- The message reads in ErrorBrush like every other error in the IDE (UX Polish Seam 4's one visual
             language). A template column because a DataGridTextColumn cannot carry the class; it reuses the
             result-failed style already defined above rather than introducing a second error tint. -->
        <DataGridTemplateColumn Header="{x:Static app:UiStrings.BatchResultsColumnError}"
                                SortMemberPath="Error" Width="*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:BatchResultRowViewModel">
              <TextBlock Text="{Binding Error}"
                         VerticalAlignment="Center"
                         Margin="8,0"
                         TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding Error}"
                         Classes.result-failed="{Binding IsFailed}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <Border Grid.Row="3"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="20,12">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Grid.Column="0" Text="{Binding StatusSummary}" FontSize="12"
                   VerticalAlignment="Center" IsVisible="{Binding !IsPreparing}" />
        <Button Grid.Column="1"
                Classes="flat"
                Content="{x:Static app:UiStrings.BatchResultsCancel}"
                Command="{Binding CancelCommand}"
                IsVisible="{Binding CanCancel}"
                Margin="0,0,8,0" />
        <Button Grid.Column="2"
                Classes="primary"
                Content="{x:Static app:UiStrings.BatchResultsClose}"
                IsDefault="True"
                Click="OnCloseClick" />
      </Grid>
    </Border>

  </Grid>
</Window>
