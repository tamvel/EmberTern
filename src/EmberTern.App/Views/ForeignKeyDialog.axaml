<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:EmberTern.App"
        xmlns:vm="using:EmberTern.App.ViewModels"
        xmlns:ae="using:AvaloniaEdit"
        xmlns:controls="using:EmberTern.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="EmberTern.App.Views.ForeignKeyDialog"
        x:DataType="vm:ForeignKeyDialogViewModel"
        Title="{app:Loc ForeignKeyDialogTitle}"
        Width="780"
        Height="640"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">

  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">

    <!-- Header -->
    <Border Grid.Row="0"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="20,16">
      <TextBlock Text="{app:Loc ForeignKeyDialogHeader}" Classes="h1" />
    </Border>

    <!-- Constraint name + source table label -->
    <Border Grid.Row="1" Padding="20,14,20,10">
      <Grid ColumnDefinitions="*,20,Auto" RowDefinitions="Auto,Auto">
        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
          <TextBlock Text="{app:Loc ForeignKeyConstraintNameLabel}" Classes="field-label" />
          <TextBox Text="{Binding ConstraintName, Mode=TwoWay}" />
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4" MinWidth="220">
          <TextBlock Text="{app:Loc ForeignKeySourceTableLabel}" Classes="field-label" />
          <!-- ⭐⭐ M4.4 — trzeci element grupy „TextBlock 13 px", i JEDYNY, w którym odziedziczony komentarz
               był nieprawdziwy: to nie jest „treść komunikatu", tylko nazwa obiektu bazy pisana monospace.
               Nasuwało to rolę Text.Code (niesie 13, wygląd bez zmiany) — i pomiar rodziny to ODRZUCIŁ.
               ⭐ Zmierzone: wszystkie 25 konsumentów Text.Code to pełnowymiarowe edytory kodu, a spośród
               ~48 elementów monospace SPOZA edytora ten był JEDYNYM z literałem — pozostałe czytają role
               tekstu interfejsu. Najbliższy sąsiad jest w dialogu obok: AddFieldDialog pokazuje nazwę typu
               bazy, monospace, na tej samej roli Text.Application.
               ⭐ Więc to nie jest wprowadzenie reguły, tylko dokończenie tej, którą produkt już ma:
               Text.Code opisuje EDYTOR, a monospace poza edytorem bierze rolę tekstu.
               ⚠ Widoczny skutek: nazwa tabeli maleje o 1 px i zrównuje się z podpisem pola nad nią. -->
          <TextBlock Text="{Binding SourceTableName}"
                     FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                     FontSize="{DynamicResource Text.Application.Size}"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Source + Target dual ListBox -->
    <Grid Grid.Row="2" Margin="20,4,20,8" ColumnDefinitions="*,20,*">

      <!-- Left: source fields. The source table is fixed (the table we're
           editing); user just multi-selects fields via per-row checkboxes. -->
      <Border Grid.Column="0"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="{DynamicResource Radius.Surface}">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0"
                  Background="{DynamicResource PanelBrush}"
                  Padding="8,4">
            <TextBlock Text="{app:Loc ForeignKeySourceFieldsLabel}"
                       FontSize="{DynamicResource Text.Compact.Size}"
                       FontWeight="SemiBold" />
          </Border>
          <ListBox Grid.Row="1"
                   ItemsSource="{Binding SourceFields}"
                   Background="{DynamicResource BackgroundBrush}"
                   BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SelectableFieldViewModel">
                <!-- TextBlock child (not string Content) so the CheckBox's
                     ContentPresenter doesn't treat "_" in the field name as an
                     access-key mnemonic (ID_NAGL → IDNAGL). See gotcha #76. -->
                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                  <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Text.Compact.Size}" />
                </CheckBox>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- Right: referenced table picker + referenced fields list. The
           ComboBox drives an async load of the table's columns into the
           list below. Auto-mapping runs after the load — if all selected
           source fields match referenced ones by name OR the referenced
           PK matches the source-field count, those refs are pre-selected. -->
      <Border Grid.Column="2"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="{DynamicResource Radius.Surface}">
        <Grid RowDefinitions="Auto,Auto,*">
          <Border Grid.Row="0"
                  Background="{DynamicResource PanelBrush}"
                  Padding="8,4">
            <TextBlock Text="{app:Loc ForeignKeyReferencedFieldsLabel}"
                       FontSize="{DynamicResource Text.Compact.Size}"
                       FontWeight="SemiBold" />
          </Border>
          <StackPanel Grid.Row="1" Margin="8,6,8,4" Spacing="4">
            <TextBlock Text="{app:Loc ForeignKeyReferencedTableLabel}" Classes="field-label" />
            <controls:SearchableComboBox ItemsSource="{Binding AvailableTables}"
                      SelectedItem="{Binding SelectedReferencedTable, Mode=TwoWay}"
                      Watermark=""
                      HorizontalAlignment="Stretch" />
            <TextBlock Text="{app:Loc ForeignKeyReferencedFieldsHint}"
                       FontSize="{DynamicResource Text.Caption.Size}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SubtleForegroundBrush}"
                       Margin="0,4,0,0" />
          </StackPanel>
          <ListBox Grid.Row="2"
                   ItemsSource="{Binding ReferencedFields}"
                   Background="{DynamicResource BackgroundBrush}"
                   BorderThickness="0,1,0,0"
                   BorderBrush="{DynamicResource BorderBrush}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SelectableFieldViewModel">
                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                  <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Text.Compact.Size}" />
                </CheckBox>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>

    <!-- ON UPDATE / ON DELETE rules. ComboBoxes over NamedForeignKeyAction
         (Action + Label record) so display strings come from UiStrings
         instead of an IValueConverter on the raw enum. -->
    <Grid Grid.Row="3" Margin="20,4,20,8" ColumnDefinitions="*,20,*">
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Text="{app:Loc ForeignKeyOnUpdateLabel}" Classes="field-label" />
        <ComboBox ItemsSource="{Binding AvailableActions}"
                  SelectedItem="{Binding OnUpdateAction, Mode=TwoWay}"
                  HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NamedForeignKeyAction">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="4">
        <TextBlock Text="{app:Loc ForeignKeyOnDeleteLabel}" Classes="field-label" />
        <ComboBox ItemsSource="{Binding AvailableActions}"
                  SelectedItem="{Binding OnDeleteAction, Mode=TwoWay}"
                  HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NamedForeignKeyAction">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
    </Grid>

    <!-- Live DDL preview -->
    <StackPanel Grid.Row="4" Margin="20,4,20,4" Spacing="4">
      <TextBlock Text="{app:Loc ForeignKeyDdlPreviewLabel}" Classes="field-label" />
      <Border BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="{DynamicResource Radius.Surface}">
        <ae:TextEditor x:Name="DdlEditor"
                       ShowLineNumbers="False"
                       IsReadOnly="True"
                       FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                       FontSize="{DynamicResource Text.Compact.Size}"
                       Padding="8,6"
                       MinHeight="80"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto"
                       Background="{DynamicResource BackgroundBrush}"
                       Foreground="{DynamicResource ForegroundBrush}" />
      </Border>
    </StackPanel>

    <!-- Validation row -->
    <Border Grid.Row="5"
            Padding="20,4,20,4"
            IsVisible="{Binding HasValidationMessage}">
      <TextBlock Text="{Binding ValidationMessage}"
                 Classes="error"
                 FontSize="{DynamicResource Text.Application.Size}"
                 TextWrapping="Wrap" />
    </Border>

    <!-- Footer -->
    <Border Grid.Row="6"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="20,12">
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="8">
        <Button Classes="flat"
                Content="{app:Loc DialogCancel}"
                Command="{Binding CancelCommand}" />
        <Button Classes="primary"
                Content="{app:Loc ForeignKeyDialogCreate}"
                Command="{Binding AcceptCommand}"
                IsDefault="True" />
      </StackPanel>
    </Border>

  </Grid>
</Window>
