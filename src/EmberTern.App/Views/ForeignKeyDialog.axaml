<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:EmberTern.App"
        xmlns:vm="using:EmberTern.App.ViewModels"
        xmlns:controls="using:EmberTern.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="EmberTern.App.Views.ForeignKeyDialog"
        x:DataType="vm:ForeignKeyDialogViewModel"
        Title="{x:Static app:UiStrings.ForeignKeyDialogTitle}"
        Width="780"
        Height="640"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">

  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">

    <!-- Header -->
    <Border Grid.Row="0"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="20,16">
      <TextBlock Text="{x:Static app:UiStrings.ForeignKeyDialogHeader}" Classes="h1" />
    </Border>

    <!-- Constraint name + source table label -->
    <Border Grid.Row="1" Padding="20,14,20,10">
      <Grid ColumnDefinitions="*,20,Auto" RowDefinitions="Auto,Auto">
        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
          <TextBlock Text="{x:Static app:UiStrings.ForeignKeyConstraintNameLabel}" Classes="field-label" />
          <TextBox Text="{Binding ConstraintName, Mode=TwoWay}" />
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4" MinWidth="220">
          <TextBlock Text="{x:Static app:UiStrings.ForeignKeySourceTableLabel}" Classes="field-label" />
          <TextBlock Text="{Binding SourceTableName}"
                     FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                     FontSize="13"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Source + Target dual ListBox -->
    <Grid Grid.Row="2" Margin="20,4,20,8" ColumnDefinitions="*,20,*">

      <!-- Left: source fields. The source table is fixed (the table we're
           editing); user just multi-selects fields via per-row checkboxes. -->
      <Border Grid.Column="0"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="3">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0"
                  Background="{DynamicResource PanelBrush}"
                  Padding="8,4">
            <TextBlock Text="{x:Static app:UiStrings.ForeignKeySourceFieldsLabel}"
                       FontSize="11"
                       FontWeight="SemiBold" />
          </Border>
          <ListBox Grid.Row="1"
                   ItemsSource="{Binding SourceFields}"
                   Background="{DynamicResource BackgroundBrush}"
                   BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SelectableFieldViewModel">
                <!-- TextBlock child (not string Content) so the CheckBox's
                     ContentPresenter doesn't treat "_" in the field name as an
                     access-key mnemonic (ID_NAGL → IDNAGL). See gotcha #76. -->
                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                  <TextBlock Text="{Binding Name}" FontSize="11" />
                </CheckBox>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- Right: referenced table picker + referenced fields list. The
           ComboBox drives an async load of the table's columns into the
           list below. Auto-mapping runs after the load — if all selected
           source fields match referenced ones by name OR the referenced
           PK matches the source-field count, those refs are pre-selected. -->
      <Border Grid.Column="2"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="3">
        <Grid RowDefinitions="Auto,Auto,*">
          <Border Grid.Row="0"
                  Background="{DynamicResource PanelBrush}"
                  Padding="8,4">
            <TextBlock Text="{x:Static app:UiStrings.ForeignKeyReferencedFieldsLabel}"
                       FontSize="11"
                       FontWeight="SemiBold" />
          </Border>
          <StackPanel Grid.Row="1" Margin="8,6,8,4" Spacing="4">
            <TextBlock Text="{x:Static app:UiStrings.ForeignKeyReferencedTableLabel}" Classes="field-label" />
            <controls:SearchablePicker ItemsSource="{Binding AvailableTables}"
                      SelectedItem="{Binding SelectedReferencedTable, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" />
            <TextBlock Text="{x:Static app:UiStrings.ForeignKeyReferencedFieldsHint}"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SubtleForegroundBrush}"
                       Margin="0,4,0,0" />
          </StackPanel>
          <ListBox Grid.Row="2"
                   ItemsSource="{Binding ReferencedFields}"
                   Background="{DynamicResource BackgroundBrush}"
                   BorderThickness="0,1,0,0"
                   BorderBrush="{DynamicResource BorderBrush}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SelectableFieldViewModel">
                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                  <TextBlock Text="{Binding Name}" FontSize="11" />
                </CheckBox>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>

    <!-- ON UPDATE / ON DELETE rules. ComboBoxes over NamedForeignKeyAction
         (Action + Label record) so display strings come from UiStrings
         instead of an IValueConverter on the raw enum. -->
    <Grid Grid.Row="3" Margin="20,4,20,8" ColumnDefinitions="*,20,*">
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Text="{x:Static app:UiStrings.ForeignKeyOnUpdateLabel}" Classes="field-label" />
        <ComboBox ItemsSource="{Binding AvailableActions}"
                  SelectedItem="{Binding OnUpdateAction, Mode=TwoWay}"
                  HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NamedForeignKeyAction">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="4">
        <TextBlock Text="{x:Static app:UiStrings.ForeignKeyOnDeleteLabel}" Classes="field-label" />
        <ComboBox ItemsSource="{Binding AvailableActions}"
                  SelectedItem="{Binding OnDeleteAction, Mode=TwoWay}"
                  HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NamedForeignKeyAction">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
    </Grid>

    <!-- Live DDL preview -->
    <StackPanel Grid.Row="4" Margin="20,4,20,4" Spacing="4">
      <TextBlock Text="{x:Static app:UiStrings.ForeignKeyDdlPreviewLabel}" Classes="field-label" />
      <Border BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="3">
        <TextBox Text="{Binding DdlPreview, Mode=OneWay}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                 FontSize="11"
                 BorderThickness="0"
                 Padding="8,6"
                 MinHeight="80"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
      </Border>
    </StackPanel>

    <!-- Validation row -->
    <Border Grid.Row="5"
            Padding="20,4,20,4"
            IsVisible="{Binding HasValidationMessage}">
      <TextBlock Text="{Binding ValidationMessage}"
                 Classes="error"
                 FontSize="12"
                 TextWrapping="Wrap" />
    </Border>

    <!-- Footer -->
    <Border Grid.Row="6"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="20,12">
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="8">
        <Button Classes="flat"
                Content="{x:Static app:UiStrings.DialogCancel}"
                Command="{Binding CancelCommand}" />
        <Button Classes="primary"
                Content="{x:Static app:UiStrings.ForeignKeyDialogCreate}"
                Command="{Binding AcceptCommand}"
                IsDefault="True" />
      </StackPanel>
    </Border>

  </Grid>
</Window>
