<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:EmberTern.App"
        xmlns:vm="using:EmberTern.App.ViewModels"
        xmlns:ae="using:AvaloniaEdit"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="EmberTern.App.Views.IndexDialog"
        x:DataType="vm:IndexDialogViewModel"
        Title="{app:Loc IndexDialogTitle}"
        Width="460"
        Height="580"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto">

    <Border Grid.Row="0"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="20,16">
      <TextBlock Text="{app:Loc IndexDialogHeader}" Classes="h1" />
    </Border>

    <!-- Index name -->
    <StackPanel Grid.Row="1" Margin="20,14,20,4" Spacing="4">
      <TextBlock Text="{app:Loc IndexNameLabel}" Classes="field-label" />
      <TextBox Text="{Binding ConstraintName, Mode=TwoWay}" />
    </StackPanel>

    <!-- Unique + Descending -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="20,4,20,8" Spacing="20">
      <CheckBox IsChecked="{Binding Unique, Mode=TwoWay}">
        <TextBlock Text="{app:Loc IndexUniqueLabel}" />
      </CheckBox>
      <CheckBox IsChecked="{Binding Descending, Mode=TwoWay}">
        <TextBlock Text="{app:Loc IndexDescendingLabel}" />
      </CheckBox>
    </StackPanel>

    <!-- Field multi-select (disabled when a COMPUTED BY expression is set) -->
    <Border Grid.Row="3"
            Margin="20,4,20,8"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.Surface}"
            IsEnabled="{Binding IsFieldPickerEnabled}">
      <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Background="{DynamicResource PanelBrush}"
                Padding="8,4">
          <TextBlock Text="{app:Loc IndexFieldsLabel}"
                     FontSize="{DynamicResource Text.Compact.Size}"
                     FontWeight="SemiBold" />
        </Border>
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Fields}"
                 Background="{DynamicResource BackgroundBrush}"
                 BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SelectableFieldViewModel">
              <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Text.Compact.Size}" />
              </CheckBox>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <!-- Optional COMPUTED BY expression -->
    <StackPanel Grid.Row="4" Margin="20,0,20,8" Spacing="4">
      <TextBlock Text="{app:Loc IndexComputedLabel}" Classes="field-label" />
      <TextBox Text="{Binding ComputedExpression, Mode=TwoWay}"
               FontFamily="Cascadia Code,Consolas,Menlo,monospace"
 />
    </StackPanel>

    <!-- Live DDL preview -->
    <StackPanel Grid.Row="5" Margin="20,4,20,4" Spacing="4">
      <TextBlock Text="{app:Loc IndexDdlPreviewLabel}" Classes="field-label" />
      <Border BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="{DynamicResource Radius.Surface}">
        <ae:TextEditor x:Name="DdlEditor"
                       ShowLineNumbers="False"
                       IsReadOnly="True"
                       FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                       FontSize="{DynamicResource Text.Compact.Size}"
                       Padding="8,6"
                       MinHeight="56"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto"
                       Background="{DynamicResource BackgroundBrush}"
                       Foreground="{DynamicResource ForegroundBrush}" />
      </Border>
    </StackPanel>

    <!-- Validation -->
    <Border Grid.Row="6"
            Padding="20,4,20,4"
            IsVisible="{Binding HasValidationMessage}">
      <TextBlock Text="{Binding ValidationMessage}"
                 Classes="error"
                 FontSize="{DynamicResource Text.Application.Size}"
                 TextWrapping="Wrap" />
    </Border>

    <!-- Footer -->
    <Border Grid.Row="7"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="20,12">
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="8">
        <Button Classes="flat"
                Content="{app:Loc DialogCancel}"
                Command="{Binding CancelCommand}" />
        <Button Classes="primary"
                Content="{app:Loc IndexDialogCreate}"
                Command="{Binding AcceptCommand}"
                IsDefault="True" />
      </StackPanel>
    </Border>

  </Grid>
</Window>
