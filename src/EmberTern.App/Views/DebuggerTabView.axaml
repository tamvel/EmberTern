<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:EmberTern.App"
             xmlns:vm="using:EmberTern.App.ViewModels"
             xmlns:dbg="using:EmberTern.App.Debugging"
             xmlns:controls="using:EmberTern.App.Controls"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
             x:Class="EmberTern.App.Views.DebuggerTabView"
             x:Name="RootControl"
             x:DataType="vm:DebuggerTabViewModel"
             Background="{DynamicResource BackgroundBrush}"
             Foreground="{DynamicResource ForegroundBrush}">

  <UserControl.Styles>
    <Style Selector="TextBox.time-error">
      <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- Variables panel: a variable the last step changed gets a subtle themed wash (change-highlight). -->
    <Style Selector="Border.var-changed">
      <Setter Property="Background" Value="{DynamicResource DebugVariableChangedBrush}" />
    </Style>
    <!-- A null/unset value renders distinctly (subtle + italic), themed. -->
    <Style Selector="TextBlock.var-null">
      <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}" />
      <Setter Property="FontStyle" Value="Italic" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <!-- One Smart-Parameters value row, shared by the procedure/function launch grid AND the trigger NEW/OLD
         context grids (D10) — reuse, not a second parameter UI. -->
    <!-- Compact parameter row (D15.3 Seam A): name PRIMARY + type SUBORDINATE (smaller, greyed) on one line,
         value beside, NULL an inline toggle at the value's right edge (no standing checkbox column). Tighter
         rows (MinHeight 26, Margin 0,2) than the old ERP-scale layout. Shared by the proc/func launch grid AND
         the trigger NEW/OLD grids (D10) — reuse, one parameter row everywhere. -->
    <DataTemplate x:Key="ParamRowTemplate" x:DataType="vm:ExecuteProcedureParamRowViewModel">
      <Grid ColumnDefinitions="200,*" Margin="0,2" MinHeight="26">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                    VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Text.Application.Size}" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding TypeText}" FontSize="{DynamicResource Text.Caption.Size}" VerticalAlignment="Center"
                     Foreground="{DynamicResource SubtleForegroundBrush}" TextTrimming="CharacterEllipsis" />
          <!-- The one auto-fill marker: this value was supplied by the app, not typed here. Every automatic
               mechanism (history, carry-over across a rebuilt panel) reports through the same Origin, so there
               is one convention to learn; it clears on the first edit. ONE marker, two weights: a Restored
               value is the expected case and stays in the subtle reading colour, while an Assumed one — the
               single inference the panel makes — takes the accent and loses the italic, so it is recognisable
               without reading the tooltip. The brush arrives as a KEY through IconBrushConverter (with the
               theme variant, gotcha #250), never as a brush on the VM. -->
          <!-- ⭐ Q3/B ZAMKNIĘTE (M4.3, decyzja użytkownika): znacznik pochodzenia bierze `Text.Caption`
               (9 → 10). M2c postawiło pytanie dokładnie w tych słowach („decyzja «9 → 10»") i oddało je
               bramie §13.3, która go nie podjęła. ⚠ Rozstrzygnęło rozdzielenie: to jest TEKST (słowo
               „odtworzone" / „założone"), a nie znak strojony do kontenera — więc trafia na najbliższą
               rolę tekstową, zamiast zostawać przy wartości, której katalog nie zna. -->
          <!-- ⛔ To rozstrzygnięcie NIE dotyczy znaków 9 px stojących niżej w tym pliku (marker ▶ w kolumnie
               14 px) ani ★/☆ przy 12 — tam rozmiar jest strojony do KONTENERA, czyli reguła #10, i zostaje. -->
          <TextBlock Text="{Binding OriginLabel}"
                     IsVisible="{Binding IsAutoFilled}" ToolTip.Tip="{Binding OriginTooltip}"
                     FontSize="{DynamicResource Text.Caption.Size}" VerticalAlignment="Center"
                     Classes.assumed-value="{Binding IsAssumed}">
            <TextBlock.Styles>
              <Style Selector="TextBlock">
                <Setter Property="FontStyle" Value="Italic" />
              </Style>
              <Style Selector="TextBlock.assumed-value">
                <Setter Property="FontStyle" Value="Normal" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Style>
            </TextBlock.Styles>
            <TextBlock.Foreground>
              <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                <Binding Path="OriginBrushKey" />
                <Binding ElementName="RootControl" Path="ActualThemeVariant" />
              </MultiBinding>
            </TextBlock.Foreground>
          </TextBlock>
        </StackPanel>
        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
          <Panel Grid.Column="0" VerticalAlignment="Center">
            <TextBox IsVisible="{Binding IsSingleLineTextKind}" IsEnabled="{Binding IsValueEnabled}"
                     Text="{Binding TextValue, Mode=TwoWay}" FontSize="{DynamicResource Text.Compact.Size}" />
            <TextBox IsVisible="{Binding IsMultilineKind}" IsEnabled="{Binding IsValueEnabled}"
                     Text="{Binding TextValue, Mode=TwoWay}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" FontSize="{DynamicResource Text.Compact.Size}" />
            <NumericUpDown IsVisible="{Binding IsNumericKind}" IsEnabled="{Binding IsValueEnabled}"
                           Value="{Binding NumericValue, Mode=TwoWay}" FontSize="{DynamicResource Text.Compact.Size}" />
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsDateTimeKind}">
              <CalendarDatePicker IsVisible="{Binding IsDateKind}"
                                  SelectedDate="{Binding DateValue, Mode=TwoWay}"
                                  IsEnabled="{Binding IsValueEnabled}" />
              <TextBox IsVisible="{Binding IsTimeKind}" IsEnabled="{Binding IsValueEnabled}"
                       Text="{Binding TimeText, Mode=TwoWay}"
                       Classes.time-error="{Binding HasTimeError}"
                       Width="92" FontSize="{DynamicResource Text.Compact.Size}" />
            </StackPanel>
            <CheckBox IsVisible="{Binding IsBooleanKind}" IsEnabled="{Binding IsValueEnabled}"
                      IsChecked="{Binding BoolValue, Mode=TwoWay}" />
          </Panel>
          <CheckBox Grid.Column="1" IsChecked="{Binding IsNull, Mode=TwoWay}"
                    Margin="10,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource Text.Caption.Size}"
                    Content="{app:Loc DebuggerParamNullLabel}"
                    ToolTip.Tip="{app:Loc DebuggerParamNullTooltip}"
                    Foreground="{DynamicResource SubtleForegroundBrush}" />
        </Grid>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,Auto,*">

    <!-- Toolbar. Shown only while a session is live (debug view) — the gate is on the whole Border, so the
         launch/parameter screen gets no empty command strip. The session status line moved to the app status
         bar (UX Polish Seam 6a); the room it freed here is deliberately left empty for the Draft-model
         actions to come. -->
    <Border Classes="chrome" Grid.Row="0"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="8,5"
            IsVisible="{Binding IsDebugViewVisible}">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="4">
          <!-- D15.2 Seam A — the toolbar on the EmberTern icon system (SvgIcon), colour as HIERARCHY, not
               decoration: Continue = the single accent (primary); Into/Over/Out + Run-to = neutral (inherit
               NeutralIconBrush, no Foreground); Next Iteration / Loop Exit share the teal "loop operations"
               accent; Stop = danger; Restart = neutral; Break on exception = a warning-toned toggle (a mode,
               not a destructive action). Labels stay neutral text so only the icon carries the category. -->
          <Button Classes="flat" FontSize="{DynamicResource Text.Compact.Size}"
                  ToolTip.Tip="{app:Loc DebuggerContinueTooltip}"
                  Command="{Binding ContinueCommand}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <!-- ⭐⭐ Rola R‑1 „Uruchom" (domknięcie K‑final, dawne O‑1). Wyglądało to na kolizję
                   dwóch ratyfikacji — D15.2 Seam A wybrało akcent jako „jedyną akcję pierwszorzędną
                   debuggera", a R‑1 mówi zielony. ⭐ Kolizja znika, gdy się zauważy, CZEGO chciało
                   D15.2: **wyróżnienia**, a nie akurat niebieskiego. Niebieski wybrano wtedy, gdy
                   token roli „Uruchom" jeszcze nie istniał. Continue nadal jest jedynym wyróżnionym
                   przyciskiem tego paska (kroki są neutralne, operacje pętli mają własny teal, Stop
                   jest czerwony) — zmienia się tylko to, że nosi ten sam znak co Execute w reszcie
                   produktu, a wznowienie wykonania jest dokładnie tym samym rodzajem akcji.
                   ⚠ Dodatkowo: niebieski jest tu kolorem TOŻSAMOŚCI debuggera (chip stanu w pasku
                   statusu), a §4/W6 zabrania malować nim PRZYCISK AKCJI. -->
              <controls:SvgIcon Data="{StaticResource Icon.Play}" Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}"
                                Foreground="{DynamicResource ActionRunBrush}" />
              <TextBlock Text="{app:Loc DebuggerContinueLabel}" FontSize="{DynamicResource Text.Compact.Size}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="flat" FontSize="{DynamicResource Text.Compact.Size}"
                  ToolTip.Tip="{app:Loc DebuggerStepIntoTooltip}"
                  Command="{Binding StepIntoCommand}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <controls:SvgIcon Data="{StaticResource Icon.StepInto}" Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}" />
              <TextBlock Text="{app:Loc DebuggerStepIntoLabel}" FontSize="{DynamicResource Text.Compact.Size}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="flat" FontSize="{DynamicResource Text.Compact.Size}"
                  ToolTip.Tip="{app:Loc DebuggerStepOverTooltip}"
                  Command="{Binding StepOverCommand}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <controls:SvgIcon Data="{StaticResource Icon.StepOver}" Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}" />
              <TextBlock Text="{app:Loc DebuggerStepOverLabel}" FontSize="{DynamicResource Text.Compact.Size}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="flat" FontSize="{DynamicResource Text.Compact.Size}"
                  ToolTip.Tip="{app:Loc DebuggerStepOutTooltip}"
                  Command="{Binding StepOutCommand}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <controls:SvgIcon Data="{StaticResource Icon.StepOut}" Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}" />
              <TextBlock Text="{app:Loc DebuggerStepOutLabel}" FontSize="{DynamicResource Text.Compact.Size}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="flat" FontSize="{DynamicResource Text.Compact.Size}"
                  IsEnabled="{Binding IsPaused}"
                  ToolTip.Tip="{app:Loc DebuggerRunToCursorTooltip}"
                  Click="OnRunToCursorClick">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <controls:SvgIcon Data="{StaticResource Icon.RunToCursor}" Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}" />
              <TextBlock Text="{app:Loc DebuggerRunToCursorLabel}" FontSize="{DynamicResource Text.Compact.Size}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <!-- Run to next SUSPEND (D12, §9.8) — a selectable procedure's "give me the next row"; rows collect
               in the Results tab. A run mode delegated straight to the engine (DebugSession.RunToSuspend). -->
          <Button Classes="flat" FontSize="{DynamicResource Text.Compact.Size}"
                  ToolTip.Tip="{app:Loc DebuggerRunToSuspendTooltip}"
                  Command="{Binding RunToSuspendCommand}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <controls:SvgIcon Data="{StaticResource Icon.RunToSuspend}" Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}" />
              <TextBlock Text="{app:Loc DebuggerRunToSuspendLabel}" FontSize="{DynamicResource Text.Compact.Size}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <!-- Loop fast-forward (D13) — run modes delegated straight to the engine (DebugSession.RunToNextIteration
               / RunToLoopExit); the commands' CanExecute uses DebugSession.IsInsideLoop, so the buttons enable
               only while paused inside a WHILE / FOR loop. Both share the teal "loop operations" accent. -->
          <Button Classes="flat" FontSize="{DynamicResource Text.Compact.Size}"
                  ToolTip.Tip="{app:Loc DebuggerRunToNextIterationTooltip}"
                  Command="{Binding RunToNextIterationCommand}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <controls:SvgIcon Data="{StaticResource Icon.NextIteration}" Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}"
                                Foreground="{DynamicResource DebugLoopIconBrush}" />
              <TextBlock Text="{app:Loc DebuggerNextIterationLabel}" FontSize="{DynamicResource Text.Compact.Size}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="flat" FontSize="{DynamicResource Text.Compact.Size}"
                  ToolTip.Tip="{app:Loc DebuggerRunToLoopExitTooltip}"
                  Command="{Binding RunToLoopExitCommand}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <controls:SvgIcon Data="{StaticResource Icon.LoopExit}" Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}"
                                Foreground="{DynamicResource DebugLoopIconBrush}" />
              <TextBlock Text="{app:Loc DebuggerLoopExitLabel}" FontSize="{DynamicResource Text.Compact.Size}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Border Width="1" Margin="4,2" Background="{DynamicResource BorderBrush}" />
          <Button Classes="flat" FontSize="{DynamicResource Text.Compact.Size}"
                  ToolTip.Tip="{app:Loc DebuggerStopTooltip}"
                  Command="{Binding StopCommand}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <controls:SvgIcon Data="{StaticResource Icon.Stop}" Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}"
                                Foreground="{DynamicResource DangerIconBrush}" />
              <TextBlock Text="{app:Loc DebuggerStopLabel}" FontSize="{DynamicResource Text.Compact.Size}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="flat" FontSize="{DynamicResource Text.Compact.Size}"
                  ToolTip.Tip="{app:Loc DebuggerRestartTooltip}"
                  Command="{Binding RestartCommand}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <controls:SvgIcon Data="{StaticResource Icon.Restart}" Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}" />
              <TextBlock Text="{app:Loc DebuggerRestartLabel}" FontSize="{DynamicResource Text.Compact.Size}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Border Width="1" Margin="4,2" Background="{DynamicResource BorderBrush}" />
          <!-- Save + compile (Seam 5b). Enabled only when there is unsaved work; saving a live session warns
               first, then ends it. Neutral icon: saving is not a debugger run command. -->
          <Button Classes="flat" FontSize="{DynamicResource Text.Compact.Size}"
                  ToolTip.Tip="{app:Loc DebuggerSaveTooltip}"
                  Command="{Binding SaveSourceCommand}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <controls:SvgIcon Data="{StaticResource Icon.Save}" Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}" />
              <TextBlock Text="{app:Loc DebuggerSave}" FontSize="{DynamicResource Text.Compact.Size}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Border Width="1" Margin="4,2" Background="{DynamicResource BorderBrush}" />
          <!-- Break on exception (D12, §9.8.1) — a pure toggle of DebugSession.BreakOnException; all pause +
               routing logic is in Core. A behaviour MODE, so a warning tone, not the destructive danger. -->
          <CheckBox IsChecked="{Binding BreakOnException, Mode=TwoWay}"
                    ToolTip.Tip="{app:Loc DebuggerBreakOnExceptionTooltip}"
                    VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <controls:SvgIcon Data="{StaticResource Icon.BreakException}" Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}"
                                Foreground="{DynamicResource WarningIconBrush}" />
              <TextBlock Text="{app:Loc DebuggerBreakOnException}" FontSize="{DynamicResource Text.Compact.Size}"
                         VerticalAlignment="Center" />
            </StackPanel>
          </CheckBox>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ── Error Bar (D15.2 Seam C; on the shared MessageBanner since UX Polish Seam 4) ──────────────
         Its OWN thin row (Grid.Row=1), shown only on a fault / Break-on-Exception pause (ShowErrorBar).
         When hidden it collapses to zero height, so the toolbar above never moves. The banner supplies the
         whole visual language (PanelBrush chrome + a thin severity stripe + a severity icon, calm, no loud
         fill; full message by default, capped + scrolled, with Copy / Expand / Dismiss) — this row now only
         says WHEN it shows and WHAT it says. Expand state stays on the VM so a fresh fault re-expands. -->
    <controls:MessageBanner Grid.Row="1" Classes="docked"
                            IsVisible="{Binding ShowErrorBar}"
                            Severity="Error"
                            Message="{Binding ErrorDetail}"
                            IsExpanded="{Binding IsErrorExpanded, Mode=TwoWay}"
                            ShowExpand="True" ShowDismiss="True"
                            DismissCommand="{Binding DismissErrorCommand}" />

    <Panel Grid.Row="2">

      <!-- ── Launch panel ─────────────────────────────────────────────────── -->
      <!-- D15.3 Seam C — keyboard-first launch: a tunnelled KeyDown handler (code-behind) makes F5 =
           Start Debugging, and Enter = Launch only from the last parameter field or the Launch button. -->
      <ScrollViewer x:Name="LaunchPanel" IsVisible="{Binding IsLaunchPanelVisible}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,14" Spacing="10" MaxWidth="720" HorizontalAlignment="Left">

          <TextBlock Text="{app:Loc DebuggerLaunchHeader}" Classes="h1" />

          <!-- Parameters (procedure / function) — hidden in trigger mode. -->
          <StackPanel IsVisible="{Binding !IsTriggerMode}">
            <StackPanel Spacing="6" DataContext="{Binding Parameters}">
              <TextBlock Text="{app:Loc DebuggerLaunchParametersHeader}" Classes="field-label" />
              <TextBlock Text="{app:Loc DebuggerLaunchNoParameters}"
                         Classes="subtle" FontSize="{DynamicResource Text.Compact.Size}"
                         IsVisible="{Binding !Params.Count}" />

              <!-- History dropdown (only when there is a saved set for this routine). -->
              <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasHistory}" Margin="0,2">
                <TextBlock Grid.Column="0" Text="{app:Loc ProcedureExecuteDialogHistoryLabel}"
                           Classes="field-label" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding History}"
                          SelectedItem="{Binding SelectedHistory, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" FontSize="{DynamicResource Text.Compact.Size}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ParameterHistorySnapshotViewModel">
                      <StackPanel Spacing="1" Margin="0,2">
                        <TextBlock Text="{Binding TimestampText}" FontSize="{DynamicResource Text.Compact.Size}"
                                   Foreground="{DynamicResource SubtleForegroundBrush}" />
                        <TextBlock Text="{Binding PreviewText}" FontSize="{DynamicResource Text.Compact.Size}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>

              <ItemsControl x:Name="ParamsList" ItemsSource="{Binding Params}" IsVisible="{Binding Params.Count}"
                            ItemTemplate="{StaticResource ParamRowTemplate}" />
            </StackPanel>
          </StackPanel>

          <!-- Trigger context (NEW/OLD) — shown for a debugged trigger (Stage X / D10). The action selector +
               NEW/OLD availability come from the (dumb) editor VM over Core TriggerContext; the grids show only
               the referenced columns and reuse the shared ParamRowTemplate. -->
          <StackPanel IsVisible="{Binding IsTriggerMode}">
            <StackPanel Spacing="10" DataContext="{Binding TriggerEditor}">
              <!-- Action selector — only when the trigger declares more than one action. -->
              <StackPanel Spacing="6" IsVisible="{Binding HasMultipleActions}">
                <TextBlock Text="{app:Loc DebuggerTriggerActionLabel}" Classes="field-label" />
                <ComboBox ItemsSource="{Binding Actions}"
                          SelectedIndex="{Binding SelectedActionIndex, Mode=TwoWay}"
                          Width="200" HorizontalAlignment="Left" FontSize="{DynamicResource Text.Compact.Size}" />
              </StackPanel>

              <!-- NEW values (available for INSERT / UPDATE). -->
              <StackPanel Spacing="6" IsVisible="{Binding NewAvailable}">
                <TextBlock Text="{app:Loc DebuggerTriggerNewHeader}" Classes="field-label" />
                <TextBlock Text="{app:Loc DebuggerTriggerNoColumns}"
                           Classes="subtle" FontSize="{DynamicResource Text.Compact.Size}"
                           IsVisible="{Binding !NewParameters.Params.Count}" />
                <ItemsControl ItemsSource="{Binding NewParameters.Params}"
                              ItemTemplate="{StaticResource ParamRowTemplate}" />
              </StackPanel>

              <!-- OLD values (available for UPDATE / DELETE). -->
              <StackPanel Spacing="6" IsVisible="{Binding OldAvailable}">
                <TextBlock Text="{app:Loc DebuggerTriggerOldHeader}" Classes="field-label" />
                <TextBlock Text="{app:Loc DebuggerTriggerNoColumns}"
                           Classes="subtle" FontSize="{DynamicResource Text.Compact.Size}"
                           IsVisible="{Binding !OldParameters.Params.Count}" />
                <ItemsControl ItemsSource="{Binding OldParameters.Params}"
                              ItemTemplate="{StaticResource ParamRowTemplate}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <!-- Advanced (D15.3 Seam B) — transaction isolation, collapsed by default so it stays out of the
               main Launch flow (most users never change it). A flat disclosure (chevron + "Advanced") toggles
               a VM view-state flag, mirroring the bottom-panel collapse. Inside: the note leads with WHAT the
               option changes, then the level selector shows the current choice. -->
          <StackPanel Spacing="6">
            <!-- D15.3 polish — a larger, clearer disclosure: bigger hitbox (Padding) + bigger chevron +
                 "Advanced options", while staying calm (flat, subtle foreground, no fill). -->
            <Button Classes="flat" Padding="6,6" HorizontalAlignment="Left"
                    Command="{Binding ToggleAdvancedCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:SvgIcon Data="{StaticResource Icon.ChevronRight}" Width="{DynamicResource Size.Icon.Toolbar}" Height="{DynamicResource Size.Icon.Toolbar}"
                                  VerticalAlignment="Center" IsVisible="{Binding !IsAdvancedExpanded}" />
                <controls:SvgIcon Data="{StaticResource Icon.ChevronDown}" Width="{DynamicResource Size.Icon.Toolbar}" Height="{DynamicResource Size.Icon.Toolbar}"
                                  VerticalAlignment="Center" IsVisible="{Binding IsAdvancedExpanded}" />
                <TextBlock Text="{app:Loc DebuggerAdvancedSection}" FontSize="{DynamicResource Text.Application.Size}"
                           Foreground="{DynamicResource SubtleForegroundBrush}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <StackPanel Spacing="6" Margin="18,0,0,0" IsVisible="{Binding IsAdvancedExpanded}">
              <TextBlock Text="{app:Loc DebuggerLaunchIsolationLabel}" Classes="field-label" />
              <TextBlock Text="{app:Loc DebuggerIsolationNote}"
                         Classes="subtle" FontSize="{DynamicResource Text.Compact.Size}" TextWrapping="Wrap" MaxWidth="600" />
              <ComboBox ItemsSource="{Binding IsolationOptions}"
                        SelectedIndex="{Binding SelectedIsolationIndex, Mode=TwoWay}"
                        Width="220" HorizontalAlignment="Left" FontSize="{DynamicResource Text.Compact.Size}" />
            </StackPanel>
          </StackPanel>

          <!-- Pre-flight (D15.3 polish) — shown ONLY when there is something to say (no header, no "all clear"
               line): a clean launch form stays quiet. Each surfaced item is one shared MessageBanner, so a
               pre-flight row and a debugger error read as the same kind of message. Blocking (§F unsteppable
               etc.) = Error; everything else = Warning ("you can continue, but you should know") — the split
               comes from the item's own BannerSeverity, so no brush leaks into data. -->
          <ItemsControl ItemsSource="{Binding Preflight}" IsVisible="{Binding Preflight.Count}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="dbg:DebugPreflightItem">
                <controls:MessageBanner Severity="{Binding BannerSeverity}"
                                        Message="{Binding Message}"
                                        Margin="0,0,0,4" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button x:Name="LaunchButton" Classes="primary" HorizontalAlignment="Left"
                  Command="{Binding LaunchCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{app:Loc DebuggerLaunchButton}" VerticalAlignment="Center" />
              <TextBlock Classes="shortcut-chip" Text="{app:Loc DebuggerLaunchShortcut}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </ScrollViewer>

      <!-- ── Debug view — editor + Variables (right), collapsible tabbed bottom panel ─── -->
      <Grid x:Name="DebugLayout" IsVisible="{Binding IsDebugViewVisible}" RowDefinitions="*,4,220,Auto">

        <!-- Top: source editor | splitter | Variables (right, tall — the primary inspection surface) -->
        <Grid Grid.Row="0" ColumnDefinitions="*,4,300">
          <!-- Editor column: a breadcrumb path over the source. The breadcrumb mirrors the call stack
               (outermost→innermost) and clicking a crumb selects that frame (spec §5.2), exactly like the
               Call Stack panel — both drive the one SelectedBreadcrumbIndex / SelectedFrameRow selection. -->
          <Grid Grid.Column="0" RowDefinitions="Auto,*">
            <Border Grid.Row="0" IsVisible="{Binding HasCallStack}"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1" Padding="6,2">
              <controls:BreadcrumbBar ItemsSource="{Binding Breadcrumbs}"
                                      SelectedIndex="{Binding SelectedBreadcrumbIndex, Mode=TwoWay}" />
            </Border>
            <!-- A NORMAL editor: editable at every phase, including a live/paused session (UX Polish Seam 5a).
                 Read-only is driven from the VM (IsSourceEditable) and means only "you are looking at another
                 routine's frame", never "the debugger is running". -->
            <ae:TextEditor x:Name="SourceEditor"
                           Grid.Row="1"
                           ShowLineNumbers="True"
                           FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                           FontSize="{DynamicResource Text.Code.Size}"
                           HorizontalScrollBarVisibility="Auto"
                           VerticalScrollBarVisibility="Auto"
                           Background="{DynamicResource BackgroundBrush}"
                           Foreground="{DynamicResource ForegroundBrush}">
              <ae:TextEditor.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{app:Loc DebuggerRunToCursorMenu}" Icon="{app:MenuIcon Icon.RunToCursor}" InputGesture="{app:CommandGesture DebuggerRunToCursor}"
                            IsEnabled="{Binding IsPaused}"
                            Click="OnRunToCursorClick" />
                </ContextMenu>
              </ae:TextEditor.ContextMenu>
            </ae:TextEditor>
          </Grid>

          <GridSplitter Grid.Column="1" Background="{DynamicResource BorderBrush}" />

          <Border Grid.Column="2"
                  Background="{DynamicResource PanelBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1,0,0,0">
            <Grid RowDefinitions="Auto,Auto,*">
              <Border Grid.Row="0" Padding="8,6"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <TextBlock Text="{app:Loc DebuggerVariablesHeader}"
                           FontWeight="SemiBold" FontSize="{DynamicResource Text.SectionHeader.Size}" />
              </Border>

              <!-- Type-to-filter (by name; mirrors the sidebar). Shown only when there are variables. -->
              <TextBox Grid.Row="1" Margin="6,6,6,2" FontSize="{DynamicResource Text.Compact.Size}"
                       Text="{Binding VariableFilter, Mode=TwoWay}"
                       PlaceholderText="{app:Loc DebuggerVariableFilterWatermark}"
                       IsVisible="{Binding HasVariables}" />

              <TextBlock Grid.Row="2" Margin="10,8"
                         Text="{app:Loc DebuggerVariablesEmpty}"
                         Classes="subtle" FontSize="{DynamicResource Text.Compact.Size}" TextWrapping="Wrap"
                         IsVisible="{Binding !HasVariables}" />

              <!-- Grouped variables (Pinned / Parameters / Locals). Each group header toggles its own
                   expansion (code-behind flips the group VM's IsExpanded — theme-safe, no ToggleButton). -->
              <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                            IsVisible="{Binding HasVariables}">
                <ItemsControl ItemsSource="{Binding VariableGroups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DebugVariableGroupViewModel">
                      <StackPanel Margin="0,2,0,0">
                        <Border Background="Transparent" Padding="8,4"
                                Tapped="OnVariableGroupHeaderTapped">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock FontSize="{DynamicResource Text.Caption.Size}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SubtleForegroundBrush}"
                                       Text="▾" IsVisible="{Binding IsExpanded}" />
                            <TextBlock FontSize="{DynamicResource Text.Caption.Size}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SubtleForegroundBrush}"
                                       Text="▸" IsVisible="{Binding !IsExpanded}" />
                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="{DynamicResource Text.SectionHeader.Size}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Rows.Count}" FontSize="{DynamicResource Text.Caption.Size}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SubtleForegroundBrush}" />
                          </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding IsExpanded}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DebugVariableRowViewModel">
                              <Border Classes.var-changed="{Binding IsChanged}" Padding="8,3,12,3" Margin="0,0,0,1">
                                <!-- Right-click → add a data breakpoint on this variable (D12, §9.8.4). The
                                     change detection lives entirely in Core; this only registers the watch.
                                     Routed via code-behind (an ElementName binding can't cross into a
                                     ContextMenu's popup namescope) to the VM's AddDataBreakpointCommand. -->
                                <Border.ContextMenu>
                                  <ContextMenu>
                                    <MenuItem Header="{app:Loc DebuggerDataBreakpointMenu}" Icon="{app:MenuIcon Icon.BreakException}"
                                              Click="OnBreakWhenChangesClick" />
                                  </ContextMenu>
                                </Border.ContextMenu>
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0">
                                  <!-- Pin-to-top toggle — gold ★ pinned / faint ☆ not, so it never blends into
                                       the kind glyph beside it. Not a Watch (§9.5). -->
                                  <Button Grid.Column="0" Classes="icon" Width="18" Height="18" Padding="0"
                                          VerticalAlignment="Center" Margin="0,0,4,0"
                                          ToolTip.Tip="{app:Loc DebuggerVariablePinTooltip}"
                                          Command="{Binding #RootControl.((vm:DebuggerTabViewModel)DataContext).TogglePinCommand}"
                                          CommandParameter="{Binding}">
                                    <!-- ⚠ 12 px lokalnie, ŚWIADOMIE (M2c iteracja 1, §18.1). Te dwa znaki są
                                         ELEMENTEM UKŁADU, nie tekstem: rozmiar dobrano do przycisku 18×18
                                         (Padding=0), a nie do sąsiedniej etykiety. Podpięcie ich pod rolę
                                         treści (`Text.Application`, dziś też 12) sprawiłoby, że pierwsza
                                         zmiana skali pisma przycięłaby gwiazdkę w przycisku. To ta sama
                                         zasada, którą użytkownik ratyfikował dla geometrii `CornerRadius`
                                         (§18.0.5/2): token opisuje rolę projektową, nie zbieżną liczbę.
                                         Rozstrzyga przegląd §13.3. -->
                                    <Panel>
                                      <TextBlock Text="★" FontSize="12" Foreground="{DynamicResource DebugPinBrush}"
                                                 IsVisible="{Binding IsPinned}" />
                                      <TextBlock Text="☆" FontSize="12" Foreground="{DynamicResource SubtleForegroundBrush}"
                                                 Opacity="0.6" IsVisible="{Binding !IsPinned}" />
                                    </Panel>
                                  </Button>

                                  <!-- Kind glyph — distinct shape + colour per kind (spec §9.4). -->
                                  <TextBlock Grid.Column="1" Text="{Binding KindGlyph}" FontSize="{DynamicResource Text.Caption.Size}"
                                             VerticalAlignment="Center" Margin="2,0,8,0"
                                             ToolTip.Tip="{Binding KindLabel}">
                                    <TextBlock.Foreground>
                                      <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                                        <Binding Path="KindBrushKey" />
                                        <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                                      </MultiBinding>
                                    </TextBlock.Foreground>
                                  </TextBlock>

                                  <StackPanel Grid.Column="2" Spacing="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Text.Compact.Size}" />
                                    <TextBlock Text="{Binding TypeText}" FontSize="{DynamicResource Text.Caption.Size}"
                                               Foreground="{DynamicResource SubtleForegroundBrush}"
                                               IsVisible="{Binding HasType}" />
                                  </StackPanel>

                                  <!-- Value: label normally; double-click swaps in a text box for inline
                                       edit (Enter commits, Escape cancels; a red border flags a parse error —
                                       the real domain CHECK still surfaces on the next injection, §3.4). -->
                                  <Panel Grid.Column="3" Margin="6,0,0,0" VerticalAlignment="Center"
                                         DoubleTapped="OnVariableValueDoubleTapped">
                                    <TextBlock Text="{Binding ValueText}" FontSize="{DynamicResource Text.Compact.Size}"
                                               IsVisible="{Binding !IsEditing}"
                                               Classes.var-null="{Binding IsNull}"
                                               ToolTip.Tip="{app:Loc DebuggerVariableEditTooltip}"
                                               FontFamily="Cascadia Code,Consolas,Menlo,monospace" />
                                    <TextBox Text="{Binding EditText, Mode=TwoWay}" FontSize="{DynamicResource Text.Compact.Size}"
                                             IsVisible="{Binding IsEditing}" MinWidth="80"
                                             Classes.time-error="{Binding HasEditError}"
                                             FontFamily="Cascadia Code,Consolas,Menlo,monospace">
                                      <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter"
                                                    Command="{Binding #RootControl.((vm:DebuggerTabViewModel)DataContext).CommitEditCommand}"
                                                    CommandParameter="{Binding}" />
                                        <KeyBinding Gesture="Escape"
                                                    Command="{Binding #RootControl.((vm:DebuggerTabViewModel)DataContext).CancelEditCommand}"
                                                    CommandParameter="{Binding}" />
                                      </TextBox.KeyBindings>
                                    </TextBox>
                                  </Panel>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>

        <!-- Resize handle. ALWAYS visible while the debug view is shown — exactly like the SQL editor's
             results splitter (IsVisible=IsQueryTabActive), whose visibility is independent of what its
             double-click does. Binding it to !IsBottomPanelCollapsed (the state its OWN double-click toggles)
             made the splitter hide itself mid-action; double-click then always re-expands from the still-
             present handle. Same pattern as MainWindow's ResultsSplitter. -->
        <GridSplitter Grid.Row="1" x:Name="BottomSplitter" Height="4"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource BorderBrush}"
                      DoubleTapped="OnBottomSplitterDoubleTapped" />

        <!-- ── Bottom tabbed panel (full width, collapsible) ──────────────────────────
             Immediate / Executed SQL / Watches now; Call Stack / Breakpoints / Output
             join later as more TabItems. Collapse chevron overlays the tab strip (mirrors
             the SQL results panel); collapsed → only the strip shows, editor + Variables
             reclaim the height (the bottom row is toggled to Auto in code-behind). -->
        <Border Grid.Row="2" ClipToBounds="True"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                DoubleTapped="OnBottomPanelDoubleTapped">
          <Grid>
            <Button Classes="icon" ZIndex="1"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,6,0"
                    ToolTip.Tip="{app:Loc DebuggerBottomPanelCollapseTooltip}"
                    Command="{Binding ToggleBottomPanelCommand}">
              <Panel>
                <controls:SvgIcon Data="{StaticResource Icon.ChevronsDown}" Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}"
                                  IsVisible="{Binding !IsBottomPanelCollapsed}" />
                <controls:SvgIcon Data="{StaticResource Icon.ChevronsUp}" Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}"
                                  IsVisible="{Binding IsBottomPanelCollapsed}" />
              </Panel>
            </Button>

            <TabControl x:Name="BottomTabs" Padding="0">

              <!-- Immediate — the interactive REPL: input + the latest result inline. -->
              <TabItem Classes="bottom-tab" Header="{app:Loc DebuggerBottomTabImmediate}">
                <Grid IsVisible="{Binding !IsBottomPanelCollapsed}" RowDefinitions="Auto,*" Margin="0,2,0,0">
                  <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="8,6">
                    <Panel Grid.Column="0">
                      <TextBox Text="{Binding ImmediateInput, Mode=TwoWay}"
                               PlaceholderText="{app:Loc DebuggerImmediateWatermark}"
                               Padding="6,4,26,4"
                               FontSize="{DynamicResource Text.Compact.Size}" FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                               VerticalContentAlignment="Center">
                        <TextBox.KeyBindings>
                          <KeyBinding Gesture="Enter" Command="{Binding EvaluateImmediateCommand}" />
                        </TextBox.KeyBindings>
                      </TextBox>
                      <Button Classes="icon" Width="18" Height="18" Padding="0" Margin="0,0,4,0"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              IsVisible="{Binding HasImmediateInput}"
                              ToolTip.Tip="{app:Loc DebuggerImmediateClearTooltip}"
                              Command="{Binding ClearImmediateCommand}">
                        <!-- ⭐ Q2 (M4.3): inline ✕ na `Size.Icon.Sm`. Wartość 12 → 12, wygląd bez zmiany —
                             to ten sam element użytkowy co trzy ✕ niżej, które niosły 11 w TYM SAMYM pliku. -->
                        <controls:SvgIcon Data="{StaticResource Icon.X}"
                                          Width="{DynamicResource Size.Icon.Sm}" Height="{DynamicResource Size.Icon.Sm}" />
                      </Button>
                    </Panel>
                    <CheckBox Grid.Column="1" Margin="8,0"
                              IsChecked="{Binding ImmediateAsStatement, Mode=TwoWay}"
                              Content="{app:Loc DebuggerImmediateAsStatement}"
                              ToolTip.Tip="{app:Loc DebuggerImmediateAsStatementTooltip}"
                              FontSize="{DynamicResource Text.Compact.Size}" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Classes="flat" FontSize="{DynamicResource Text.Compact.Size}"
                            Content="{app:Loc DebuggerImmediateEvaluateButton}"
                            Command="{Binding EvaluateImmediateCommand}" />
                  </Grid>

                  <StackPanel Grid.Row="1" Margin="10,4" Spacing="4"
                              IsVisible="{Binding !HasLatestEvaluation}">
                    <TextBlock Text="{app:Loc DebuggerImmediateEmpty}"
                               Classes="subtle" FontSize="{DynamicResource Text.Compact.Size}" TextWrapping="Wrap" />
                    <TextBlock Text="{app:Loc DebuggerExpressionExamples}"
                               Classes="subtle" FontSize="{DynamicResource Text.Caption.Size}" TextWrapping="Wrap"
                               FontFamily="Cascadia Code,Consolas,Menlo,monospace" />
                  </StackPanel>
                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                IsVisible="{Binding HasLatestEvaluation}">
                    <StackPanel Margin="10,4" Spacing="2">
                      <TextBlock Text="{Binding LatestEvaluation.Fragment}" FontSize="{DynamicResource Text.Compact.Size}"
                                 FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                                 TextWrapping="Wrap" />
                      <TextBlock Text="{Binding LatestEvaluation.ResultText}" FontSize="{DynamicResource Text.Compact.Size}"
                                 FontFamily="Cascadia Code,Consolas,Menlo,monospace" TextWrapping="Wrap"
                                 IsVisible="{Binding LatestEvaluation.IsError}" Foreground="{DynamicResource ErrorBrush}"
                                 ToolTip.Tip="{Binding LatestEvaluation.RawError}" />
                      <TextBlock Text="{Binding LatestEvaluation.ResultText}" FontSize="{DynamicResource Text.Compact.Size}"
                                 FontFamily="Cascadia Code,Consolas,Menlo,monospace" TextWrapping="Wrap"
                                 IsVisible="{Binding !LatestEvaluation.IsError}" Foreground="{DynamicResource ForegroundBrush}" />
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </TabItem>

              <!-- Harness Log — the generated EXECUTE BLOCK audit (§10.3/§F). This is an internal DIAGNOSTIC
                   surface for developing/diagnosing the debugger itself, NOT a production feature: it is built
                   and inserted here in code-behind only under #if DEBUG (DebuggerTabView.axaml.cs →
                   BuildHarnessLogTab), so in RELEASE builds the tab does not exist at all. The audit log itself
                   (DebuggerTabViewModel.ExecutedSql) keeps collecting in every build — it also feeds the
                   Immediate tab's inline result — only the UI that exposes the harnesses is DEBUG-only. -->

              <!-- Watches — expressions re-evaluated after every step (D5, §9.5). -->
              <TabItem Classes="bottom-tab" Header="{app:Loc DebuggerBottomTabWatches}">
                <Grid IsVisible="{Binding !IsBottomPanelCollapsed}" RowDefinitions="Auto,*" Margin="0,2,0,0">
                  <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="8,6">
                    <TextBox Grid.Column="0"
                             Text="{Binding WatchInput, Mode=TwoWay}"
                             PlaceholderText="{app:Loc DebuggerWatchWatermark}"
                             FontSize="{DynamicResource Text.Compact.Size}" FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                             VerticalContentAlignment="Center">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding AddWatchCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>
                    <Button Grid.Column="1" Classes="flat" Margin="6,0,0,0" FontSize="{DynamicResource Text.Compact.Size}"
                            Content="{app:Loc DebuggerWatchAddButton}"
                            ToolTip.Tip="{app:Loc DebuggerWatchAddTooltip}"
                            Command="{Binding AddWatchCommand}" />
                  </Grid>

                  <StackPanel Grid.Row="1" Margin="10,6" Spacing="4"
                              IsVisible="{Binding !HasWatches}">
                    <TextBlock Text="{app:Loc DebuggerWatchesEmpty}"
                               Classes="subtle" FontSize="{DynamicResource Text.Compact.Size}" TextWrapping="Wrap" />
                    <TextBlock Text="{app:Loc DebuggerExpressionExamples}"
                               Classes="subtle" FontSize="{DynamicResource Text.Caption.Size}" TextWrapping="Wrap"
                               FontFamily="Cascadia Code,Consolas,Menlo,monospace" />
                  </StackPanel>
                  <ListBox Grid.Row="1" ItemsSource="{Binding Watches}"
                           Background="Transparent" BorderThickness="0"
                           IsVisible="{Binding HasWatches}">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:WatchRowViewModel">
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,1">
                          <TextBlock Grid.Column="0" Text="{Binding SideEffectGlyph}" FontSize="{DynamicResource Text.Compact.Size}"
                                     Foreground="{DynamicResource WarningBrush}"
                                     ToolTip.Tip="{app:Loc DebuggerWatchSideEffectTooltip}"
                                     Margin="0,0,4,0" VerticalAlignment="Center" />
                          <StackPanel Grid.Column="1" Spacing="0">
                            <TextBlock Text="{Binding Expression}" FontSize="{DynamicResource Text.Compact.Size}"
                                       FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                                       TextTrimming="CharacterEllipsis" />
                            <Panel>
                              <TextBlock Text="{Binding ValueText}" FontSize="{DynamicResource Text.Caption.Size}"
                                         FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                                         TextTrimming="CharacterEllipsis"
                                         IsVisible="{Binding IsError}"
                                         Foreground="{DynamicResource ErrorBrush}"
                                         ToolTip.Tip="{Binding RawError}" />
                              <TextBlock Text="{Binding ValueText}" FontSize="{DynamicResource Text.Caption.Size}"
                                         FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                                         TextTrimming="CharacterEllipsis"
                                         IsVisible="{Binding !IsError}"
                                         Foreground="{DynamicResource SubtleForegroundBrush}" />
                            </Panel>
                          </StackPanel>
                          <Button Grid.Column="2" Classes="icon" Width="18" Height="18" Padding="0"
                                  VerticalAlignment="Center"
                                  ToolTip.Tip="{app:Loc DebuggerWatchRemoveTooltip}"
                                  Command="{Binding $parent[ListBox].((vm:DebuggerTabViewModel)DataContext).RemoveWatchCommand}"
                                  CommandParameter="{Binding}">
                            <controls:SvgIcon Data="{StaticResource Icon.X}"
                                                    Width="{DynamicResource Size.Icon.Sm}" Height="{DynamicResource Size.Icon.Sm}" />
                          </Button>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </TabItem>

              <!-- Call Stack (D8, spec §5) — frames innermost-first; the current frame is marked, a
                   Step-Into (simulated) frame carries the △ indicator (§5.3). Selecting a row repoints the
                   editor + Variables to that frame; double-click peeks its source inline (Peek Frame). -->
              <TabItem Classes="bottom-tab" Header="{app:Loc DebuggerBottomTabCallStack}">
                <Grid IsVisible="{Binding !IsBottomPanelCollapsed}" Margin="0,2,0,0">
                  <TextBlock Margin="10,6"
                             Text="{app:Loc DebuggerCallStackEmpty}"
                             Classes="subtle" FontSize="{DynamicResource Text.Compact.Size}" TextWrapping="Wrap"
                             IsVisible="{Binding !HasCallStack}" />
                  <ListBox ItemsSource="{Binding CallStack}"
                           SelectedItem="{Binding SelectedFrameRow, Mode=TwoWay}"
                           Background="Transparent" BorderThickness="0"
                           IsVisible="{Binding HasCallStack}"
                           DoubleTapped="OnCallStackDoubleTapped">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:DebugFrameRowViewModel">
                        <Grid ColumnDefinitions="14,*,Auto,Auto" Margin="0,1">
                          <!-- current-frame marker.
                               ⚠ 9 px lokalnie, ŚWIADOMIE (M2c iteracja 1, §18.1) — z dwóch niezależnych
                               powodów: katalog nie ma roli o tej wartości, a znak jest ELEMENTEM UKŁADU
                               (kolumna o stałej szerokości 14 px), nie częścią tekstu. Rozstrzyga §13.3. -->
                          <TextBlock Grid.Column="0" Text="▶" FontSize="9"
                                     Foreground="{DynamicResource AccentBrush}"
                                     VerticalAlignment="Center"
                                     IsVisible="{Binding IsCurrent}" />
                          <TextBlock Grid.Column="1" Text="{Binding RoutineName}" FontSize="{DynamicResource Text.Compact.Size}"
                                     FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Text="{Binding LineText}" FontSize="{DynamicResource Text.Caption.Size}"
                                     Foreground="{DynamicResource SubtleForegroundBrush}"
                                     Margin="8,0,0,0" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="3" Text="{app:Loc DebuggerCallStackSimulatedGlyph}"
                                     FontSize="{DynamicResource Text.Caption.Size}" Foreground="{DynamicResource SubtleForegroundBrush}"
                                     Margin="8,0,2,0" VerticalAlignment="Center"
                                     ToolTip.Tip="{app:Loc DebuggerCallStackSimulatedTooltip}"
                                     IsVisible="{Binding IsSimulated}" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </TabItem>

              <!-- Breakpoints (D12 Seam E, spec §9.8) — a pure VIEW of the Core Breakpoint / DataBreakpoint
                   objects. Line breakpoints: edit the condition + hit-count policy (forwarded straight to the
                   Core object; the engine evaluates + counts). Data breakpoints: added via the Variables
                   "Break when changes" gesture, removed here. No breakpoint logic lives in the view/VM. -->
              <TabItem Classes="bottom-tab" Header="{app:Loc DebuggerBottomTabBreakpoints}">
                <Grid IsVisible="{Binding !IsBottomPanelCollapsed}" Margin="0,2,0,0">
                  <TextBlock Margin="10,6"
                             Text="{app:Loc DebuggerBreakpointsEmpty}"
                             Classes="subtle" FontSize="{DynamicResource Text.Compact.Size}" TextWrapping="Wrap"
                             IsVisible="{Binding !HasAnyBreakpoints}" />
                  <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasAnyBreakpoints}">
                    <StackPanel Margin="8,4" Spacing="8">

                      <!-- Line breakpoints -->
                      <StackPanel Spacing="2" IsVisible="{Binding HasBreakpoints}">
                        <TextBlock Text="{app:Loc DebuggerBreakpointsLineHeader}" Classes="field-label" />
                        <ItemsControl ItemsSource="{Binding BreakpointRows}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BreakpointRowViewModel">
                              <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,2">
                                <TextBlock Grid.Column="0" Text="{Binding LineText}" FontSize="{DynamicResource Text.Compact.Size}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="56"
                                           FontFamily="Cascadia Code,Consolas,Menlo,monospace" />
                                <TextBox Grid.Column="1" Text="{Binding Condition, Mode=TwoWay}"
                                         PlaceholderText="{app:Loc DebuggerBreakpointConditionWatermark}"
                                         FontSize="{DynamicResource Text.Compact.Size}" FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                                         VerticalContentAlignment="Center" />
                                <ComboBox Grid.Column="2" ItemsSource="{Binding HitCountKinds}"
                                          SelectedIndex="{Binding HitCountKindIndex, Mode=TwoWay}"
                                          FontSize="{DynamicResource Text.Compact.Size}" Width="96" Margin="6,0,0,0"
                                          ToolTip.Tip="{app:Loc DebuggerBreakpointHitsLabel}" />
                                <NumericUpDown Grid.Column="3" Value="{Binding HitCountValue, Mode=TwoWay}"
                                               IsEnabled="{Binding IsHitCountValueEnabled}"
                                               Minimum="1" FormatString="0" Width="96" FontSize="{DynamicResource Text.Compact.Size}" Margin="4,0,0,0" />
                                <Button Grid.Column="4" Classes="icon" Width="18" Height="18" Padding="0"
                                        VerticalAlignment="Center" Margin="4,0,0,0"
                                        ToolTip.Tip="{app:Loc DebuggerBreakpointRemoveTooltip}"
                                        Command="{Binding #RootControl.((vm:DebuggerTabViewModel)DataContext).RemoveBreakpointCommand}"
                                        CommandParameter="{Binding}">
                                  <controls:SvgIcon Data="{StaticResource Icon.X}"
                                                    Width="{DynamicResource Size.Icon.Sm}" Height="{DynamicResource Size.Icon.Sm}" />
                                </Button>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>

                      <!-- Data breakpoints -->
                      <StackPanel Spacing="2" IsVisible="{Binding HasDataBreakpoints}">
                        <TextBlock Text="{app:Loc DebuggerBreakpointsDataHeader}" Classes="field-label" />
                        <ItemsControl ItemsSource="{Binding DataBreakpointRows}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DataBreakpointRowViewModel">
                              <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="{DynamicResource Text.Compact.Size}"
                                           VerticalAlignment="Center"
                                           FontFamily="Cascadia Code,Consolas,Menlo,monospace" />
                                <Button Grid.Column="1" Classes="icon" Width="18" Height="18" Padding="0"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="{app:Loc DebuggerBreakpointRemoveTooltip}"
                                        Command="{Binding #RootControl.((vm:DebuggerTabViewModel)DataContext).RemoveDataBreakpointCommand}"
                                        CommandParameter="{Binding}">
                                  <controls:SvgIcon Data="{StaticResource Icon.X}"
                                                    Width="{DynamicResource Size.Icon.Sm}" Height="{DynamicResource Size.Icon.Sm}" />
                                </Button>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>

                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </TabItem>

              <!-- Results (D12 Seam E2, spec §9.8) — the rows a selectable procedure emits via SUSPEND
                   (collected by Run to next SUSPEND, or any run that passes a SUSPEND). A pure view of
                   DebugSession.EmittedRows; columns are built in code-behind from SuspendColumns (dynamic,
                   like the SQL editor's result grid), rows bind to SuspendRows. -->
              <TabItem Classes="bottom-tab" Header="{app:Loc DebuggerBottomTabResults}">
                <Grid IsVisible="{Binding !IsBottomPanelCollapsed}" Margin="0,2,0,0">
                  <TextBlock Margin="10,6"
                             Text="{app:Loc DebuggerResultsEmpty}"
                             Classes="subtle" FontSize="{DynamicResource Text.Compact.Size}" TextWrapping="Wrap"
                             IsVisible="{Binding !HasSuspendRows}" />
                  <DataGrid x:Name="SuspendGrid"
                            ItemsSource="{Binding SuspendRows}"
                            IsVisible="{Binding HasSuspendRows}"
                            IsReadOnly="True"
                            AutoGenerateColumns="False"
                            HeadersVisibility="Column"
                            GridLinesVisibility="Horizontal"
                            CanUserSortColumns="False"
                            CanUserReorderColumns="False"
                            ColumnWidth="Auto"
                            RowBackground="Transparent"
                            HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                            VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                            FontSize="{DynamicResource Text.Grid.Size}" />
                </Grid>
              </TabItem>
            </TabControl>
          </Grid>
        </Border>

        <!-- ⚠ The §4.6 warning, in the place the launch panel cannot reach: the launch panel disappears the
             moment a session starts, so until now the user was told about irreversible effects only on the
             screen they had already left. This bar lives at the foot of the RUNNING view.
             ⭐ The shared MessageBanner, docked, with its own ✕ (ShowDismiss + DismissCommand) — no new control
             and no new chrome. Its Auto row costs nothing while hidden.
             ⚠ Dismissal is per-run: BuildPreflight re-arms it on every Launch and Restart, so still-risky code
             says so again rather than staying quiet because it was silenced once. -->
        <controls:MessageBanner Grid.Row="3"
                                Classes="docked"
                                Severity="Warning"
                                Message="{app:Loc DebuggerIrreversibleBar}"
                                IsVisible="{Binding IsIrreversibleAlertVisible}"
                                ShowDismiss="True"
                                DismissCommand="{Binding DismissIrreversibleAlertCommand}" />
      </Grid>
    </Panel>
  </Grid>
</UserControl>
