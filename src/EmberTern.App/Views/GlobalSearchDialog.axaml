<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:EmberTern.App"
        xmlns:vm="using:EmberTern.App.ViewModels"
        x:Class="EmberTern.App.Views.GlobalSearchDialog"
        x:DataType="vm:GlobalSearchDialogViewModel"
        Title="{app:Loc GlobalSearchDialogTitle}"
        Width="460"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">

  <Grid RowDefinitions="Auto,Auto,Auto">
    <Border Grid.Row="0"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="20,14">
      <TextBlock Text="{app:Loc GlobalSearchDialogTitle}" Classes="h1" />
    </Border>

    <StackPanel Grid.Row="1" Margin="20,18" Spacing="10">
      <!-- ⚠ Podpis i jego pole są JEDNYM dzieckiem kontenera — inaczej `Spacing` rodzica wchodzi
           MIĘDZY nie i odstęp podpis→pole staje się większy niż pole→pole (zgłoszenie QA). -->
      <StackPanel>
        <TextBlock Text="{app:Loc GlobalSearchTermLabel}" Classes="field-label" />
        <TextBox x:Name="TermBox" Classes="search" Text="{Binding Term}"
                 PlaceholderText="{app:Loc GlobalSearchTermWatermark}"
                 KeyDown="OnTermKeyDown" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="18">
        <CheckBox Content="{app:Loc GlobalSearchMatchNames}" IsChecked="{Binding MatchNames}" />
        <CheckBox Content="{app:Loc GlobalSearchMatchSource}" IsChecked="{Binding MatchSource}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="18">
        <CheckBox Content="{app:Loc GlobalSearchCaseSensitive}" IsChecked="{Binding CaseSensitive}" />
        <CheckBox Content="{app:Loc GlobalSearchWholeWord}" IsChecked="{Binding WholeWord}" />
      </StackPanel>

      <TextBlock Text="{app:Loc GlobalSearchScopeHint}"
                 Foreground="{DynamicResource SubtleForegroundBrush}"
                 FontSize="{DynamicResource Text.Compact.Size}" TextWrapping="Wrap" />
    </StackPanel>

    <Border Grid.Row="2"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="20,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Classes="flat" Content="{app:Loc GlobalSearchDialogCancel}"
                Command="{Binding CancelCommand}" />
        <Button Classes="primary" Content="{app:Loc GlobalSearchDialogFind}"
                Command="{Binding AcceptCommand}" IsDefault="True" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
