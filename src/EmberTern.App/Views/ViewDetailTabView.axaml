<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EmberTern.App.ViewModels"
             xmlns:app="using:EmberTern.App"
             xmlns:controls="using:EmberTern.App.Controls"
             xmlns:behaviors="using:EmberTern.App.Behaviors"
             xmlns:views="using:EmberTern.App.Views"
             xmlns:conv="using:EmberTern.App.Converters"
             xmlns:metadata="using:EmberTern.Core.Metadata"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="EmberTern.App.Views.ViewDetailTabView"
             x:Name="RootControl"
             x:DataType="vm:ViewDetailTabViewModel"
             Background="{DynamicResource BackgroundBrush}">

  <UserControl.Styles>
    <Style Selector="DataGridRow">
      <Setter Property="Height" Value="22" />
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="Padding" Value="6 2" />
    </Style>
    <Style Selector="TextBlock.null-cell">
      <Setter Property="FontStyle" Value="Italic" />
      <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">

    <TabControl Grid.Row="0"
                SelectedIndex="{Binding ActiveSubTabIndex, Mode=TwoWay}"
                Padding="0">

      <!-- SQL — Source mode (full CREATE OR ALTER VIEW) OR Easy mode (editable column
           list ABOVE a body-only AS SELECT editor; the CREATE VIEW header is hidden
           and regenerated on Compile). Compile / Format / the Source⇄Easy toggle live
           in the main app toolbar (gated on IsViewDetailTabActive). -->
      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.ViewDetailTabSql}">
        <Grid>
          <!-- Source mode -->
          <ae:TextEditor x:Name="ViewSqlEditor"
                         IsVisible="{Binding IsSourceMode}"
                         ShowLineNumbers="True"
                         FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                         FontSize="13"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource BackgroundBrush}"
                         Foreground="{DynamicResource ForegroundBrush}" />

          <!-- Easy mode: editable name + column list (top) over the AS SELECT body editor. -->
          <Grid IsVisible="{Binding EasyMode}" RowDefinitions="Auto,180,4,*">

            <!-- View name. Editable in the New View flow (supplies the object name on
                 Compile); read-only display for an existing view (a view isn't renamed
                 via the editor). In Source mode the name lives in the CREATE VIEW header. -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="8,6,8,2">
              <TextBlock Grid.Column="0" Classes="field-label" VerticalAlignment="Center"
                         Margin="0,0,8,0" Text="{x:Static app:UiStrings.ViewNameHeader}" />
              <TextBox Grid.Column="1" Text="{Binding EditableViewName, Mode=TwoWay}"
                       IsReadOnly="{Binding !IsNew}" FontSize="12" />
            </Grid>

            <!-- Column list. Add / Remove / Move live in the main toolbar (Collection
                 section), routed to this view — no in-content toolbar row. -->
            <Grid Grid.Row="1" RowDefinitions="Auto,*">
              <TextBlock Grid.Row="0" Classes="field-label" Margin="8,4,8,2"
                         Text="{x:Static app:UiStrings.ViewColumnsHeader}" />
              <DataGrid Grid.Row="1" x:Name="ViewColumnsGrid"
                        ItemsSource="{Binding Columns}"
                        SelectedItem="{Binding SelectedColumn, Mode=TwoWay}"
                        IsReadOnly="False" AutoGenerateColumns="False"
                        CanUserSortColumns="False" CanUserResizeColumns="False"
                        CanUserReorderColumns="False" FontSize="11"
                        GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                        HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                        VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                        Background="{DynamicResource BackgroundBrush}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="{x:Static app:UiStrings.ViewColumnName}"
                                      Binding="{Binding Name, Mode=TwoWay}"
                                      Width="*" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>

            <GridSplitter Grid.Row="2" ResizeDirection="Rows"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}" />

            <Grid Grid.Row="3" RowDefinitions="Auto,*">
              <TextBlock Grid.Row="0" Classes="field-label" Margin="8,4,8,2"
                         Text="{x:Static app:UiStrings.ViewBodyHeader}" />
              <ae:TextEditor Grid.Row="1" x:Name="ViewBodyEditor"
                             ShowLineNumbers="True"
                             FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                             FontSize="13"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             Background="{DynamicResource BackgroundBrush}"
                             Foreground="{DynamicResource ForegroundBrush}" />
            </Grid>
          </Grid>
        </Grid>
      </TabItem>

      <!-- Fields — read-only view columns. Views expose name / type / nullability /
           charset; PK/FK/constraint metadata doesn't apply, so those columns are
           omitted (don't invent metadata Firebird doesn't provide for views). -->
      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.ViewDetailTabFields}">
        <DataGrid x:Name="FieldsGrid"
                  behaviors:GridLayoutBehavior.GridId="ViewDetail.Fields"
                  ItemsSource="{Binding Fields}"
                  IsReadOnly="True"
                  FontSize="11"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  CanUserSortColumns="True"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="True"
                  ColumnWidth="Auto"
                  RowBackground="Transparent"
                  HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                  VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                  Background="{DynamicResource BackgroundBrush}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailColumnPosition}"
                                Binding="{Binding DisplayPosition}"
                                SortMemberPath="DisplayPosition"
                                MinWidth="32" />
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailColumnName}"
                                Binding="{Binding Name}"
                                SortMemberPath="Name"
                                MinWidth="120" />
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailColumnType}"
                                Binding="{Binding Type}"
                                SortMemberPath="Type"
                                MinWidth="120" />
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailColumnNotNull}"
                                Binding="{Binding NotNull, Converter={x:Static conv:BoolToCheckmarkConverter.Instance}}"
                                SortMemberPath="NotNull"
                                MinWidth="70" />
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailColumnCharset}"
                                Binding="{Binding Charset}"
                                SortMemberPath="Charset"
                                MinWidth="70" />
            <DataGridTextColumn Header="{x:Static app:UiStrings.TableDetailColumnDescription}"
                                Binding="{Binding Description}"
                                SortMemberPath="Description"
                                MinWidth="120" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>

      <!-- Dependencies — reuses the same dual-tree layout + templates as
           TableDetail (Used by / Depends on). -->
      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.ViewDetailTabDependencies}">
        <Grid ColumnDefinitions="*,4,*">
          <Grid Grid.Column="0" RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0"
                       Text="{x:Static app:UiStrings.TableDetailDependedOnByHeader}"
                       FontSize="11"
                       Foreground="{DynamicResource SubtleForegroundBrush}"
                       Margin="0,4,0,4" />
            <TreeView Grid.Row="1"
                      ItemsSource="{Binding DependedOnByTree}"
                      Background="{DynamicResource BackgroundBrush}">
              <TreeView.DataTemplates>
                <TreeDataTemplate DataType="vm:DependencyGroupNode"
                                  ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <controls:SvgIcon Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}"
                                      Width="15" Height="15"
                                      VerticalAlignment="Center">
                      <controls:SvgIcon.Foreground>
                        <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                          <Binding Path="IconResourceKey" />
                          <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                        </MultiBinding>
                      </controls:SvgIcon.Foreground>
                    </controls:SvgIcon>
                    <TextBlock Text="{Binding Header}" FontSize="11" VerticalAlignment="Center" />
                  </StackPanel>
                </TreeDataTemplate>
                <DataTemplate DataType="vm:DependencyLeafNode">
                  <Border HorizontalAlignment="Stretch"
                          Background="Transparent"
                          DoubleTapped="OnDependencyNodeDoubleTapped">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <controls:SvgIcon Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}"
                                        Width="15" Height="15"
                                        VerticalAlignment="Center">
                        <controls:SvgIcon.Foreground>
                          <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                            <Binding Path="IconResourceKey" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </controls:SvgIcon.Foreground>
                      </controls:SvgIcon>
                      <TextBlock Text="{Binding ObjectName}" FontSize="11" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding FieldName}"
                                 FontSize="10"
                                 Foreground="{DynamicResource SubtleForegroundBrush}"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding FieldName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </TreeView.DataTemplates>
            </TreeView>
          </Grid>

          <GridSplitter Grid.Column="1"
                        Width="4"
                        Background="{DynamicResource BorderBrush}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />

          <Grid Grid.Column="2" RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0"
                       Text="{x:Static app:UiStrings.TableDetailDependsOnHeader}"
                       FontSize="11"
                       Foreground="{DynamicResource SubtleForegroundBrush}"
                       Margin="0,4,0,4" />
            <TreeView Grid.Row="1"
                      ItemsSource="{Binding DependsOnTree}"
                      Background="{DynamicResource BackgroundBrush}">
              <TreeView.DataTemplates>
                <TreeDataTemplate DataType="vm:DependencyGroupNode"
                                  ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <controls:SvgIcon Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}"
                                      Width="15" Height="15"
                                      VerticalAlignment="Center">
                      <controls:SvgIcon.Foreground>
                        <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                          <Binding Path="IconResourceKey" />
                          <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                        </MultiBinding>
                      </controls:SvgIcon.Foreground>
                    </controls:SvgIcon>
                    <TextBlock Text="{Binding Header}" FontSize="11" VerticalAlignment="Center" />
                  </StackPanel>
                </TreeDataTemplate>
                <DataTemplate DataType="vm:DependencyLeafNode">
                  <Border HorizontalAlignment="Stretch"
                          Background="Transparent"
                          DoubleTapped="OnDependencyNodeDoubleTapped">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <controls:SvgIcon Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}"
                                        Width="15" Height="15"
                                        VerticalAlignment="Center">
                        <controls:SvgIcon.Foreground>
                          <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                            <Binding Path="IconResourceKey" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </controls:SvgIcon.Foreground>
                      </controls:SvgIcon>
                      <TextBlock Text="{Binding ObjectName}" FontSize="11" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding FieldName}"
                                 FontSize="10"
                                 Foreground="{DynamicResource SubtleForegroundBrush}"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding FieldName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </TreeView.DataTemplates>
            </TreeView>
          </Grid>
        </Grid>
      </TabItem>

      <!-- Data — read-only SELECT * preview, same paged infrastructure as
           TableDetail. Pagination controls are self-contained here (no inline
           data editing on a view). -->
      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.ViewDetailTabData}">
        <!-- Rows: pagination+record+filter/agg toggles · filter panel · aggregation bar · error+grid. -->
        <Grid RowDefinitions="Auto,Auto,Auto,*">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="8,4">
            <Button Classes="icon"
                    ToolTip.Tip="{x:Static app:UiStrings.TableDetailPaginationFirstTooltip}"
                    Command="{Binding GoToFirstPageCommand}">
              <controls:SvgIcon Data="{StaticResource Icon.ChevronFirst}" />
            </Button>
            <Button Classes="icon"
                    ToolTip.Tip="{x:Static app:UiStrings.TableDetailPaginationPreviousTooltip}"
                    Command="{Binding GoToPreviousPageCommand}">
              <controls:SvgIcon Data="{StaticResource Icon.ChevronLeft}" />
            </Button>
            <Button Classes="icon"
                    ToolTip.Tip="{x:Static app:UiStrings.TableDetailPaginationNextTooltip}"
                    Command="{Binding GoToNextPageCommand}">
              <controls:SvgIcon Data="{StaticResource Icon.ChevronRight}" />
            </Button>
            <Button Classes="icon"
                    ToolTip.Tip="{x:Static app:UiStrings.TableDetailPaginationLastTooltip}"
                    Command="{Binding GoToLastPageCommand}">
              <controls:SvgIcon Data="{StaticResource Icon.ChevronLast}" />
            </Button>
            <TextBlock Text="{Binding DataPreviewHint}"
                       Classes="subtle"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="6,0,0,0" />
            <TextBlock Text="{Binding DataRecordInfo}"
                       Classes="subtle"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0" />
            <ToggleButton Classes="icon" Margin="12,0,0,0"
                    ToolTip.Tip="{x:Static app:UiStrings.FilterToggleTooltip}"
                    IsChecked="{Binding DataFilterPanel.IsPanelOpen, Mode=TwoWay}">
              <Panel>
                <controls:SvgIcon Data="{StaticResource Icon.Filter}" Width="14" Height="14" />
                <Border Classes="filter-active-dot" IsVisible="{Binding DataFilterPanel.IsFilterActive}" />
              </Panel>
            </ToggleButton>
            <ToggleButton Classes="icon"
                    ToolTip.Tip="{x:Static app:UiStrings.AggregationToggleTooltip}"
                    IsChecked="{Binding DataAggregationBar.IsBarOpen, Mode=TwoWay}">
              <controls:SvgIcon Data="{StaticResource Icon.Sigma}" Width="14" Height="14" />
            </ToggleButton>
            <!-- Export the view data via the shared Export Framework (default = all rows). -->
            <Button Classes="icon" Click="OnViewDataExportClick" IsEnabled="{Binding CanExportData}"
                    ToolTip.Tip="{x:Static app:UiStrings.ExportResultsTooltip}">
              <controls:SvgIcon Data="{StaticResource Icon.Download}" Width="14" Height="14" />
            </Button>
          </StackPanel>

          <views:FilterPanelView Grid.Row="1" DataContext="{Binding DataFilterPanel}" />
          <views:AggregationBarView Grid.Row="2" DataContext="{Binding DataAggregationBar}" />

          <controls:MessageBanner Grid.Row="3"
                                  Severity="Error"
                                  Message="{Binding DataError}"
                                  Margin="8,0,8,4"
                                  VerticalAlignment="Top"
                                  IsVisible="{Binding ShowDataError}" />
          <DataGrid Grid.Row="3"
                    x:Name="DataPreviewGrid"
                    behaviors:GridLayoutBehavior.GridId="ViewDetail.Data"
                    SelectionChanged="OnViewDataSelectionChanged"
                    IsReadOnly="True"
                    FontSize="11"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    CanUserSortColumns="True"
                    CanUserResizeColumns="True"
                    CanUserReorderColumns="False"
                    ColumnWidth="Auto"
                    RowBackground="Transparent"
                    HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                    VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                    Background="{DynamicResource BackgroundBrush}"
                    IsVisible="{Binding HasDataResult}">
            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{x:Static app:UiStrings.FilterByValue}" Click="OnViewDataFilterByValueClick" />
                <MenuItem Header="{x:Static app:UiStrings.FilterExcludeValue}" Click="OnViewDataExcludeValueClick" />
                <MenuItem x:Name="ViewDataFilterContainsItem"
                          Header="{x:Static app:UiStrings.FilterContainsValue}" Click="OnViewDataFilterContainsClick" />
                <Separator />
                <MenuItem Header="{x:Static app:UiStrings.ExportResultsMenuItem}" Click="OnViewDataExportClick" />
              </ContextMenu>
            </DataGrid.ContextMenu>
          </DataGrid>
        </Grid>
      </TabItem>

      <!-- Description — editable COMMENT ON VIEW. Save/Clear run in the working
           (metadata) transaction via the same workflow as table descriptions;
           Commit/Rollback finalize. Reuses the table-description strings. -->
      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.ViewDetailTabDescription}">
        <Grid RowDefinitions="Auto,*" Background="{DynamicResource BackgroundBrush}">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="8,6,8,4"
                      IsVisible="{Binding CanEditDescription}">
            <TextBlock Text="{x:Static app:UiStrings.ViewDescriptionEditLabel}"
                       Classes="subtle"
                       FontSize="11"
                       VerticalAlignment="Center" />
            <Button Classes="icon"
                    ToolTip.Tip="{x:Static app:UiStrings.TableDescriptionSave}"
                    Command="{Binding SaveDescriptionCommand}">
              <controls:SvgIcon Data="{StaticResource Icon.Save}" />
            </Button>
            <Button Classes="flat"
                    Padding="8,2"
                    Content="{x:Static app:UiStrings.TableDescriptionClear}"
                    Command="{Binding ClearDescriptionCommand}" />
          </StackPanel>
          <TextBox Grid.Row="1"
                   Text="{Binding EditableDescription, Mode=TwoWay}"
                   IsEnabled="{Binding CanEditDescription}"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   FontSize="11"
                   Margin="8,0,8,8"
                   Background="{DynamicResource BackgroundBrush}" />
        </Grid>
      </TabItem>

      <!-- DDL — read-only reconstructed CREATE VIEW. -->
      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.ViewDetailTabDdl}">
        <ae:TextEditor x:Name="ViewDdlEditor"
                       ShowLineNumbers="True"
                       IsReadOnly="True"
                       FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                       FontSize="13"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto"
                       Background="{DynamicResource BackgroundBrush}"
                       Foreground="{DynamicResource ForegroundBrush}" />
      </TabItem>

      <!-- Diagnostics (Stage 7 / S4) — the SAME view + VM the SQL Editor's Diagnostics tab uses,
           hosted per object. Shows the ACTIVE SQL document's findings (the LastFocusedSqlDocument
           rule — see DiagnosticsPanelHost). Appended LAST so the persisted ActiveSubTabIndex and the
           SqlSubTabIndex / DataSubTabIndex constants never shift. -->
      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.BottomTabDiagnostics}">
        <views:DiagnosticsPanelView x:Name="ViewDiagnosticsPanel"
                                    DataContext="{Binding DiagnosticsPanel}" />
      </TabItem>

    </TabControl>

    <StackPanel Grid.Row="1" Orientation="Vertical">
      <TextBlock Text="{x:Static app:UiStrings.ViewDetailLoadingHint}"
                 Classes="subtle"
                 Margin="10,4"
                 FontSize="11"
                 IsVisible="{Binding IsLoading}" />
      <!-- Compile / load errors go through the IDE's ONE message surface (UX Polish Seam 4) —
           same severity stripe, icon, wrapping and Copy affordance on every editor. -->
      <controls:MessageBanner Classes="docked" Severity="Error"
                              Message="{Binding ErrorMessage}"
                              IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </Grid>

</UserControl>
