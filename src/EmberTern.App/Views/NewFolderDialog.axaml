<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:EmberTern.App"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="EmberTern.App.Views.NewFolderDialog"
        Title="{app:Loc FolderDialogTitle}"
        Width="400"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">

  <Grid RowDefinitions="Auto,Auto,Auto">

    <Border Grid.Row="0"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="20,16">
      <TextBlock Text="{app:Loc FolderDialogTitle}" Classes="h1" />
    </Border>

    <StackPanel Grid.Row="1" Margin="20,18,20,18" Spacing="6">
      <TextBlock Text="{app:Loc FolderDialogNameLabel}"
                 Foreground="{DynamicResource SubtleForegroundBrush}"
                 FontSize="{DynamicResource Text.Application.Size}" />
      <TextBox x:Name="NameBox"
               Text=""
               KeyDown="OnNameBoxKeyDown" />
    </StackPanel>

    <Border Grid.Row="2"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="20,12">
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="8">
        <Button Classes="flat"
                Content="{app:Loc DialogCancel}"
                Click="OnCancelClick" />
        <Button Classes="primary"
                Content="{app:Loc FolderDialogCreate}"
                Click="OnCreateClick"
                IsDefault="True" />
      </StackPanel>
    </Border>

  </Grid>
</Window>
