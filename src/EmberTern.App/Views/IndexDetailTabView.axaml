<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EmberTern.App.ViewModels"
             xmlns:app="using:EmberTern.App"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="EmberTern.App.Views.IndexDetailTabView"
             x:Name="RootControl"
             x:DataType="vm:IndexDetailTabViewModel"
             Background="{DynamicResource BackgroundBrush}">

  <Grid RowDefinitions="*,Auto">

    <TabControl Grid.Row="0"
                SelectedIndex="{Binding ActiveSubTabIndex, Mode=TwoWay}"
                Padding="0">

      <!-- Index — the properties form. Only Active (plain indexes) and Description are
           editable; everything structural is read-only (Firebird has no ALTER for it).
           Compile / Revert / Recompute / Delete live in the main app toolbar. -->
      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.IndexDetailTabIndex}">
        <ScrollViewer>
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*"
                Margin="12" VerticalAlignment="Top">

            <TextBlock Grid.Row="0" Grid.Column="0" Classes="field-label" VerticalAlignment="Center"
                       Margin="0,0,12,8" Text="{x:Static app:UiStrings.IndexNameHeader}" />
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                     Text="{Binding IndexName}" IsReadOnly="True" FontSize="12" />

            <TextBlock Grid.Row="1" Grid.Column="0" Classes="field-label" VerticalAlignment="Center"
                       Margin="0,0,12,8" Text="{x:Static app:UiStrings.IndexTableHeader}" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                     Text="{Binding Table}" IsReadOnly="True" FontSize="12" />

            <TextBlock Grid.Row="2" Grid.Column="0" Classes="field-label" VerticalAlignment="Center"
                       Margin="0,0,12,8" Text="{x:Static app:UiStrings.IndexConstraintTypeHeader}" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Vertical" Spacing="2" Margin="0,0,0,8">
              <TextBox Text="{Binding ConstraintType}" IsReadOnly="True" FontSize="12"
                       PlaceholderText="{x:Static app:UiStrings.IndexConstraintTypeNoneWatermark}" />
              <!-- Constraint-backed note: makes it immediately obvious WHY Active / Drop
                   are disabled (Firebird manages the index through its constraint). -->
              <TextBlock Text="{Binding ConstraintBackedNote}"
                         FontSize="11"
                         Foreground="{DynamicResource WarningBrush}"
                         TextWrapping="Wrap"
                         IsVisible="{Binding IsConstraintBacked}" />
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Classes="field-label" VerticalAlignment="Center"
                       Margin="0,0,12,8" Text="{x:Static app:UiStrings.IndexFieldsHeader}" />
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"
                     Text="{Binding Fields}" IsReadOnly="True" FontSize="12"
                     IsVisible="{Binding Expression, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"
                     Text="{Binding Expression}" IsReadOnly="True" FontSize="12"
                     IsVisible="{Binding Expression, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <TextBlock Grid.Row="4" Grid.Column="0" Classes="field-label" VerticalAlignment="Center"
                       Margin="0,0,12,8" Text="{x:Static app:UiStrings.IndexUniqueHeader}" />
            <CheckBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,8"
                      IsChecked="{Binding IsUnique}" IsEnabled="False" IsHitTestVisible="False" />

            <TextBlock Grid.Row="5" Grid.Column="0" Classes="field-label" VerticalAlignment="Center"
                       Margin="0,0,12,8" Text="{x:Static app:UiStrings.IndexSortDirectionHeader}" />
            <TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,8"
                     Text="{Binding SortDirectionText}" IsReadOnly="True" FontSize="12" />

            <TextBlock Grid.Row="6" Grid.Column="0" Classes="field-label" VerticalAlignment="Center"
                       Margin="0,0,12,8" Text="{x:Static app:UiStrings.IndexStatisticsHeader}" />
            <TextBox Grid.Row="6" Grid.Column="1" Margin="0,0,0,8"
                     Text="{Binding Statistics, StringFormat=F6}" IsReadOnly="True" FontSize="12"
                     PlaceholderText="{x:Static app:UiStrings.IndexStatisticsNoneWatermark}" />

            <TextBlock Grid.Row="7" Grid.Column="0" Classes="field-label" VerticalAlignment="Center"
                       Margin="0,0,12,8" Text="{x:Static app:UiStrings.IndexActiveHeader}" />
            <CheckBox Grid.Row="7" Grid.Column="1" Margin="0,0,0,8"
                      IsChecked="{Binding IsActive, Mode=TwoWay}"
                      IsEnabled="{Binding IsActiveEditable}" />

            <TextBlock Grid.Row="8" Grid.Column="0" Classes="field-label"
                       Margin="0,0,12,0" Text="{x:Static app:UiStrings.IndexDescriptionHeader}" />
            <TextBox Grid.Row="8" Grid.Column="1"
                     Text="{Binding EditableDescription, Mode=TwoWay}"
                     AcceptsReturn="True" TextWrapping="Wrap" FontSize="12"
                     MinHeight="80"
                     Background="{DynamicResource BackgroundBrush}" />
          </Grid>
        </ScrollViewer>
      </TabItem>

      <!-- DDL — read-only reconstructed CREATE INDEX (reflects pending edits). -->
      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.IndexDetailTabDdl}">
        <ae:TextEditor x:Name="IndexDdlEditor"
                       ShowLineNumbers="True"
                       IsReadOnly="True"
                       FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                       FontSize="13"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto"
                       Background="{DynamicResource BackgroundBrush}"
                       Foreground="{DynamicResource ForegroundBrush}" />
      </TabItem>

    </TabControl>

    <StackPanel Grid.Row="1" Orientation="Vertical">
      <TextBlock Text="{x:Static app:UiStrings.IndexLoadingHint}"
                 Classes="subtle"
                 Margin="10,4"
                 FontSize="11"
                 IsVisible="{Binding IsLoading}" />
      <SelectableTextBlock Text="{Binding ErrorMessage}"
                 Classes="subtle error"
                 Margin="10,4"
                 FontSize="11"
                 TextWrapping="Wrap"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </Grid>

</UserControl>
