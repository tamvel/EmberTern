<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EmberTern.App.ViewModels"
             xmlns:app="using:EmberTern.App"
             xmlns:controls="using:EmberTern.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="120"
             x:Class="EmberTern.App.Views.AggregationBarView"
             x:DataType="vm:AggregationBarViewModel"
             IsVisible="{Binding IsBarOpen}">

  <!-- Shared aggregation bar, reused by every data grid. Self-hides via IsBarOpen.
       Add-row (column + type-aware function + "＋ Add") produces chips that wrap
       below; several aggregates coexist. Each chip computes through the
       host-supplied delegate (client-side or SQL) and refreshes on filter change. -->
  <Border Background="{DynamicResource PanelBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="0,1,0,1"
          Padding="8,6">
    <StackPanel Spacing="6">

      <!-- Add-row: title · column · function. Picking a function auto-creates a chip
           (no separate Add button); the function picker then resets to its placeholder. -->
      <StackPanel Orientation="Horizontal" Spacing="4">
        <TextBlock Classes="field-label" VerticalAlignment="Center"
                   Margin="0,0,8,0"
                   Text="{x:Static app:UiStrings.AggregationBarTitle}" />
        <ComboBox Width="150" VerticalAlignment="Center"
                  IsEnabled="{Binding HasColumns}"
                  ItemsSource="{Binding Columns}"
                  SelectedItem="{Binding SelectedMenuColumn, Mode=TwoWay}" />
        <ComboBox Width="170" VerticalAlignment="Center"
                  IsEnabled="{Binding HasColumns}"
                  PlaceholderText="{x:Static app:UiStrings.AggregationFunctionPlaceholder}"
                  ItemsSource="{Binding MenuFunctions}"
                  SelectedItem="{Binding SelectedMenuFunction, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:AggregateOption">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>

      <!-- Aggregate chips (wrap onto multiple lines) -->
      <ItemsControl ItemsSource="{Binding Lines}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AggregationLineViewModel">
            <Border CornerRadius="{DynamicResource Radius.Chip}" Padding="8,2" Margin="0,0,6,6"
                    Background="{DynamicResource ChromeStrongBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />
                <TextBlock Text="=" VerticalAlignment="Center"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />
                <TextBlock Text="{Binding ResultText}" VerticalAlignment="Center"
                           FontWeight="SemiBold" />
                <Button Classes="icon" Padding="2" VerticalAlignment="Center"
                        Command="{Binding RemoveCommand}"
                        ToolTip.Tip="{x:Static app:UiStrings.AggregationRemoveLineTooltip}">
                  <controls:SvgIcon Data="{StaticResource Icon.X}" Width="10" Height="10" />
                </Button>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Empty hint -->
      <TextBlock IsVisible="{Binding ShowEmptyHint}"
                 Foreground="{DynamicResource SubtleForegroundBrush}"
                 FontStyle="Italic"
                 Text="{x:Static app:UiStrings.AggregationEmptyHint}" />

    </StackPanel>
  </Border>
</UserControl>
