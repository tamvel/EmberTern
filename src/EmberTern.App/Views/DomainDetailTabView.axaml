<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EmberTern.App.ViewModels"
             xmlns:app="using:EmberTern.App"
             xmlns:controls="using:EmberTern.App.Controls"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="EmberTern.App.Views.DomainDetailTabView"
             x:Name="RootControl"
             x:DataType="vm:DomainDetailTabViewModel"
             Background="{DynamicResource BackgroundBrush}">

  <Grid RowDefinitions="*,Auto">

    <TabControl Grid.Row="0"
                SelectedIndex="{Binding ActiveSubTabIndex, Mode=TwoWay}"
                Padding="0">

      <!-- Domain — the definition form. On an existing domain Firebird's ALTER DOMAIN
           lets us change the type/length/precision/scale/sub-type (TYPE), the charset
           for char types (TYPE … CHARACTER SET), NOT NULL, Default, Check, and the name
           (rename). ONLY the collation is read-only after create (no ALTER syntax —
           editable only in the New flow). Compile / Revert / Delete live in the main
           app toolbar; Compile assembles the minimum-set of ALTER statements. -->
      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.DomainDetailTabDomain}">
        <ScrollViewer>
          <Grid ColumnDefinitions="Auto,*" Margin="12" VerticalAlignment="Top"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

            <TextBlock Grid.Row="0" Grid.Column="0" Classes="field-label" VerticalAlignment="Center"
                       Margin="0,0,12,8" Text="{x:Static app:UiStrings.DomainNameHeader}" />
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                     Text="{Binding EditableName, Mode=TwoWay}"
 HorizontalAlignment="Left" Width="280" />

            <TextBlock Grid.Row="1" Grid.Column="0" Classes="field-label" VerticalAlignment="Center"
                       Margin="0,0,12,8" Text="{x:Static app:UiStrings.DomainDataTypeHeader}" />
            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Width="280" HorizontalAlignment="Left"
                      ItemsSource="{x:Static vm:DomainDetailTabViewModel.AvailableDataTypes}"
                      SelectedItem="{Binding DataType, Mode=TwoWay}"
                      IsEnabled="{Binding IsTypeEditable}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Classes="field-label" VerticalAlignment="Center"
                       Margin="0,0,12,8" Text="{x:Static app:UiStrings.DomainLengthHeader}" />
            <NumericUpDown Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Width="280" HorizontalAlignment="Left"
                           Value="{Binding Length, Mode=TwoWay}" IsEnabled="{Binding IsTypeEditable}"
                           Minimum="0" Maximum="32767" Increment="1" FormatString="0" />

            <TextBlock Grid.Row="3" Grid.Column="0" Classes="field-label" VerticalAlignment="Center"
                       Margin="0,0,12,8" Text="{x:Static app:UiStrings.DomainPrecisionHeader}" />
            <NumericUpDown Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Width="280" HorizontalAlignment="Left"
                           Value="{Binding Precision, Mode=TwoWay}" IsEnabled="{Binding IsTypeEditable}"
                           Minimum="0" Maximum="38" Increment="1" FormatString="0" />

            <TextBlock Grid.Row="4" Grid.Column="0" Classes="field-label" VerticalAlignment="Center"
                       Margin="0,0,12,8" Text="{x:Static app:UiStrings.DomainScaleHeader}" />
            <NumericUpDown Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" Width="280" HorizontalAlignment="Left"
                           Value="{Binding Scale, Mode=TwoWay}" IsEnabled="{Binding IsTypeEditable}"
                           Minimum="0" Maximum="38" Increment="1" FormatString="0" />

            <TextBlock Grid.Row="5" Grid.Column="0" Classes="field-label" VerticalAlignment="Center"
                       Margin="0,0,12,8" Text="{x:Static app:UiStrings.DomainSubTypeHeader}" />
            <NumericUpDown Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" Width="280" HorizontalAlignment="Left"
                           Value="{Binding SubType, Mode=TwoWay}" IsEnabled="{Binding IsTypeEditable}"
                           Minimum="0" Maximum="32767" Increment="1" FormatString="0" />

            <TextBlock Grid.Row="6" Grid.Column="0" Classes="field-label" VerticalAlignment="Center"
                       Margin="0,0,12,8" Text="{x:Static app:UiStrings.DomainCharacterSetHeader}" />
            <ComboBox Grid.Row="6" Grid.Column="1" Margin="0,0,0,8" Width="280" HorizontalAlignment="Left"
                      ItemsSource="{x:Static vm:DomainDetailTabViewModel.AvailableCharsets}"
                      SelectedItem="{Binding CharacterSet, Mode=TwoWay}"
                      IsEnabled="{Binding IsCharsetEditable}" />

            <TextBlock Grid.Row="7" Grid.Column="0" Classes="field-label" VerticalAlignment="Center"
                       Margin="0,0,12,8" Text="{x:Static app:UiStrings.DomainCollationHeader}" />
            <TextBox Grid.Row="7" Grid.Column="1" Margin="0,0,0,8" Width="280" HorizontalAlignment="Left"
                     Text="{Binding Collation, Mode=TwoWay}"
                     IsReadOnly="{Binding !IsCollationEditable}" />

            <CheckBox Grid.Row="8" Grid.Column="1" Margin="0,0,0,8"
                      IsChecked="{Binding NotNull, Mode=TwoWay}"
                      Content="{x:Static app:UiStrings.DomainNotNullHeader}" />

            <!-- Default + Check are editable on both new and existing domains -->
            <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Vertical" Spacing="8" Margin="0,4,0,0">
              <TextBlock Classes="field-label" Text="{x:Static app:UiStrings.DomainDefaultHeader}" />
              <TextBox Text="{Binding DefaultValue, Mode=TwoWay}" Width="280" HorizontalAlignment="Left" />
              <TextBlock Classes="field-label" Text="{x:Static app:UiStrings.DomainCheckHeader}" />
              <TextBox Text="{Binding CheckConstraint, Mode=TwoWay}"
                       AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                       Background="{DynamicResource BackgroundBrush}" />
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <!-- Description — editable COMMENT ON DOMAIN (same mechanism as the other
           Detail views' description tab; persisted on Save). -->
      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.DomainDetailTabDescription}">
        <Grid Margin="12">
          <TextBox Text="{Binding EditableDescription, Mode=TwoWay}"
                   AcceptsReturn="True" TextWrapping="Wrap"
                   VerticalAlignment="Stretch"
                   Background="{DynamicResource BackgroundBrush}" />
        </Grid>
      </TabItem>

      <!-- Used By — a SINGLE dependency tree (NOT the dual Depends-on/Used-by
           panel): the table/view columns + PSQL objects that use the domain,
           grouped by object type. Reuses BuildDependencyTree + the dep-tree
           templates; double-click navigates via the shared OpenObjectRequested. -->
      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.DomainDetailTabUsedBy}">
        <controls:DependencyTreeView ItemsSource="{Binding UsedByTree}" />
      </TabItem>

      <!-- DDL — read-only reconstructed CREATE DOMAIN. -->
      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.DomainDetailTabDdl}">
        <ae:TextEditor x:Name="DomainDdlEditor"
                       ShowLineNumbers="True"
                       IsReadOnly="True"
                       FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                       FontSize="{DynamicResource Text.Code.Size}"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto"
                       Background="{DynamicResource BackgroundBrush}"
                       Foreground="{DynamicResource ForegroundBrush}" />
      </TabItem>

    </TabControl>

    <StackPanel Grid.Row="1" Orientation="Vertical">
      <TextBlock Text="{x:Static app:UiStrings.DomainLoadingHint}"
                 Classes="subtle"
                 Margin="10,4"
                 FontSize="{DynamicResource Text.Compact.Size}"
                 IsVisible="{Binding IsLoading}" />
      <!-- Compile / load errors go through the IDE's ONE message surface (UX Polish Seam 4) —
           same severity stripe, icon, wrapping and Copy affordance on every editor. -->
      <controls:MessageBanner Classes="docked" Severity="Error"
                              Message="{Binding ErrorMessage}"
                              IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </Grid>

</UserControl>
