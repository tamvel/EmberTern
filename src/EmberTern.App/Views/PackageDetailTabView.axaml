<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EmberTern.App.ViewModels"
             xmlns:app="using:EmberTern.App"
             xmlns:controls="using:EmberTern.App.Controls"
             xmlns:views="using:EmberTern.App.Views"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="EmberTern.App.Views.PackageDetailTabView"
             x:Name="RootControl"
             x:DataType="vm:PackageDetailTabViewModel"
             Background="{DynamicResource BackgroundBrush}">

  <Grid RowDefinitions="*,Auto">

    <TabControl Grid.Row="0"
                SelectedIndex="{Binding ActiveSubTabIndex, Mode=TwoWay}"
                Padding="0">

      <!-- Package — editable CREATE OR ALTER PACKAGE header (declarations). Compile /
           Revert / Format / Comment live in the main app toolbar (gated on
           IsPackageDetailTabActive). -->
      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.PackageDetailTabPackage}">
        <ae:TextEditor x:Name="PackageHeaderEditor"
                       ShowLineNumbers="True"
                       FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                       FontSize="13"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto"
                       Background="{DynamicResource BackgroundBrush}"
                       Foreground="{DynamicResource ForegroundBrush}" />
      </TabItem>

      <!-- Body — editable RECREATE PACKAGE BODY (implementation). -->
      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.PackageDetailTabBody}">
        <ae:TextEditor x:Name="PackageBodyEditor"
                       ShowLineNumbers="True"
                       FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                       FontSize="13"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto"
                       Background="{DynamicResource BackgroundBrush}"
                       Foreground="{DynamicResource ForegroundBrush}" />
      </TabItem>

      <!-- Members — read-only grouped tree (Functions / Procedures), built from the
           catalog. Double-click a member to jump to it in the Package or Body editor. -->
      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.PackageDetailTabMembers}">
        <Grid>
          <TextBlock Text="{x:Static app:UiStrings.PackageDetailMembersEmpty}"
                     Classes="subtle"
                     Margin="10,8"
                     FontSize="11"
                     IsVisible="{Binding ShowMembersEmpty}" />
          <!-- The tree is navigation only; the Debug ACTION for the selected member lives on the editor
               toolbar (D15.3 Seam E), so SelectedItem drives that toolbar button's enabled state + tooltip. -->
          <TreeView ItemsSource="{Binding MemberGroups}"
                    SelectedItem="{Binding SelectedMemberNode, Mode=TwoWay}"
                    IsVisible="{Binding HasMembers}"
                    Background="{DynamicResource BackgroundBrush}">
            <TreeView.DataTemplates>
              <TreeDataTemplate DataType="vm:PackageMemberGroupNode"
                                ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <controls:SvgIcon Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}"
                                    Width="15" Height="15"
                                    VerticalAlignment="Center">
                    <controls:SvgIcon.Foreground>
                      <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                        <Binding Path="IconResourceKey" />
                        <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                      </MultiBinding>
                    </controls:SvgIcon.Foreground>
                  </controls:SvgIcon>
                  <TextBlock Text="{Binding Header}" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
              </TreeDataTemplate>
              <DataTemplate DataType="vm:PackageMemberItemNode">
                <Border HorizontalAlignment="Stretch"
                        Background="Transparent"
                        DoubleTapped="OnMemberNodeDoubleTapped">
                  <!-- Debug entry point (Stage X / D11 seam C — procedures; Seam D — functions) — launch a
                       package member as a debug root. Reuses the sidebar's labels + the ONE launch path
                       (OnMemberDebugClick → RequestDebugMember, kind-aware); one item per debuggable kind. -->
                  <Border.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="{x:Static app:UiStrings.MetadataContextDebugProcedure}"
                                Click="OnMemberDebugClick"
                                IsVisible="{Binding IsProcedure}" />
                      <MenuItem Header="{x:Static app:UiStrings.MetadataContextDebugFunction}"
                                Click="OnMemberDebugClick"
                                IsVisible="{Binding IsFunction}" />
                    </ContextMenu>
                  </Border.ContextMenu>
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <controls:SvgIcon Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}"
                                      Width="15" Height="15"
                                      VerticalAlignment="Center">
                      <controls:SvgIcon.Foreground>
                        <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                          <Binding Path="IconResourceKey" />
                          <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                        </MultiBinding>
                      </controls:SvgIcon.Foreground>
                    </controls:SvgIcon>
                    <TextBlock Text="{Binding DisplayName}" FontSize="11" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </TreeView.DataTemplates>
          </TreeView>
        </Grid>
      </TabItem>

      <!-- Description — editable COMMENT ON PACKAGE (same workflow as table/view). -->
      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.PackageDetailTabDescription}">
        <Grid RowDefinitions="Auto,*" Background="{DynamicResource BackgroundBrush}">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="8,6,8,4"
                      IsVisible="{Binding CanEditDescription}">
            <TextBlock Text="{x:Static app:UiStrings.PackageDescriptionEditLabel}"
                       Classes="subtle"
                       FontSize="11"
                       VerticalAlignment="Center" />
            <Button Classes="icon"
                    ToolTip.Tip="{x:Static app:UiStrings.TableDescriptionSave}"
                    Command="{Binding SaveDescriptionCommand}">
              <controls:SvgIcon Data="{StaticResource Icon.Save}" />
            </Button>
            <Button Classes="flat"
                    Padding="8,2"
                    Content="{x:Static app:UiStrings.TableDescriptionClear}"
                    Command="{Binding ClearDescriptionCommand}" />
          </StackPanel>
          <TextBox Grid.Row="1"
                   Text="{Binding EditableDescription, Mode=TwoWay}"
                   IsEnabled="{Binding CanEditDescription}"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   FontSize="11"
                   Margin="8,0,8,8"
                   Background="{DynamicResource BackgroundBrush}" />
        </Grid>
      </TabItem>

      <!-- Dependencies — same dual-tree layout + templates as TableDetail/ViewDetail. -->
      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.PackageDetailTabDependencies}">
        <Grid ColumnDefinitions="*,4,*">
          <Grid Grid.Column="0" RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0"
                       Text="{x:Static app:UiStrings.PackageDetailDependedOnByHeader}"
                       FontSize="11"
                       Foreground="{DynamicResource SubtleForegroundBrush}"
                       Margin="0,4,0,4" />
            <TreeView Grid.Row="1"
                      ItemsSource="{Binding DependedOnByTree}"
                      Background="{DynamicResource BackgroundBrush}">
              <TreeView.DataTemplates>
                <TreeDataTemplate DataType="vm:DependencyGroupNode"
                                  ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <controls:SvgIcon Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}"
                                      Width="15" Height="15"
                                      VerticalAlignment="Center">
                      <controls:SvgIcon.Foreground>
                        <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                          <Binding Path="IconResourceKey" />
                          <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                        </MultiBinding>
                      </controls:SvgIcon.Foreground>
                    </controls:SvgIcon>
                    <TextBlock Text="{Binding Header}" FontSize="11" VerticalAlignment="Center" />
                  </StackPanel>
                </TreeDataTemplate>
                <DataTemplate DataType="vm:DependencyLeafNode">
                  <Border HorizontalAlignment="Stretch"
                          Background="Transparent"
                          DoubleTapped="OnDependencyNodeDoubleTapped">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <controls:SvgIcon Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}"
                                        Width="15" Height="15"
                                        VerticalAlignment="Center">
                        <controls:SvgIcon.Foreground>
                          <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                            <Binding Path="IconResourceKey" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </controls:SvgIcon.Foreground>
                      </controls:SvgIcon>
                      <TextBlock Text="{Binding ObjectName}" FontSize="11" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding FieldName}"
                                 FontSize="10"
                                 Foreground="{DynamicResource SubtleForegroundBrush}"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding FieldName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </TreeView.DataTemplates>
            </TreeView>
          </Grid>

          <GridSplitter Grid.Column="1"
                        Width="4"
                        Background="{DynamicResource BorderBrush}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />

          <Grid Grid.Column="2" RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0"
                       Text="{x:Static app:UiStrings.PackageDetailDependsOnHeader}"
                       FontSize="11"
                       Foreground="{DynamicResource SubtleForegroundBrush}"
                       Margin="0,4,0,4" />
            <TreeView Grid.Row="1"
                      ItemsSource="{Binding DependsOnTree}"
                      Background="{DynamicResource BackgroundBrush}">
              <TreeView.DataTemplates>
                <TreeDataTemplate DataType="vm:DependencyGroupNode"
                                  ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <controls:SvgIcon Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}"
                                      Width="15" Height="15"
                                      VerticalAlignment="Center">
                      <controls:SvgIcon.Foreground>
                        <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                          <Binding Path="IconResourceKey" />
                          <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                        </MultiBinding>
                      </controls:SvgIcon.Foreground>
                    </controls:SvgIcon>
                    <TextBlock Text="{Binding Header}" FontSize="11" VerticalAlignment="Center" />
                  </StackPanel>
                </TreeDataTemplate>
                <DataTemplate DataType="vm:DependencyLeafNode">
                  <Border HorizontalAlignment="Stretch"
                          Background="Transparent"
                          DoubleTapped="OnDependencyNodeDoubleTapped">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <controls:SvgIcon Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}"
                                        Width="15" Height="15"
                                        VerticalAlignment="Center">
                        <controls:SvgIcon.Foreground>
                          <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                            <Binding Path="IconResourceKey" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </controls:SvgIcon.Foreground>
                      </controls:SvgIcon>
                      <TextBlock Text="{Binding ObjectName}" FontSize="11" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding FieldName}"
                                 FontSize="10"
                                 Foreground="{DynamicResource SubtleForegroundBrush}"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding FieldName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </TreeView.DataTemplates>
            </TreeView>
          </Grid>
        </Grid>
      </TabItem>

      <!-- DDL — read-only reconstructed CREATE PACKAGE + RECREATE PACKAGE BODY. -->
      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.PackageDetailTabDdl}">
        <ae:TextEditor x:Name="PackageDdlEditor"
                       ShowLineNumbers="True"
                       IsReadOnly="True"
                       FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                       FontSize="13"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto"
                       Background="{DynamicResource BackgroundBrush}"
                       Foreground="{DynamicResource ForegroundBrush}" />
      </TabItem>

      <!-- Diagnostics (Stage 7 / S4) — the SAME view + VM the SQL Editor's Diagnostics tab uses,
           hosted per object. Shows the ACTIVE SQL document's findings (the LastFocusedSqlDocument
           rule — see DiagnosticsPanelHost): the header or body editor, whichever was last edited.
           Appended LAST so the persisted ActiveSubTabIndex and the PackageSubTabIndex /
           BodySubTabIndex constants never shift. -->
      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.BottomTabDiagnostics}">
        <views:DiagnosticsPanelView x:Name="PackageDiagnosticsPanel"
                                    DataContext="{Binding DiagnosticsPanel}" />
      </TabItem>

    </TabControl>

    <StackPanel Grid.Row="1" Orientation="Vertical">
      <TextBlock Text="{x:Static app:UiStrings.PackageDetailLoadingHint}"
                 Classes="subtle"
                 Margin="10,4"
                 FontSize="11"
                 IsVisible="{Binding IsLoading}" />
      <!-- Compile / load errors go through the IDE's ONE message surface (UX Polish Seam 4) —
           same severity stripe, icon, wrapping and Copy affordance on every editor. -->
      <controls:MessageBanner Severity="Error"
                              Message="{Binding ErrorMessage}"
                              ShowCopy="True"
                              BorderThickness="0,1,0,0"
                              IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </Grid>

</UserControl>
