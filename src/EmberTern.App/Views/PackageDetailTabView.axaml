<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EmberTern.App.ViewModels"
             xmlns:app="using:EmberTern.App"
             xmlns:controls="using:EmberTern.App.Controls"
             xmlns:views="using:EmberTern.App.Views"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="EmberTern.App.Views.PackageDetailTabView"
             x:Name="RootControl"
             x:DataType="vm:PackageDetailTabViewModel"
             Background="{DynamicResource BackgroundBrush}">

  <Grid RowDefinitions="*,Auto">

    <TabControl Grid.Row="0"
                SelectedIndex="{Binding ActiveSubTabIndex, Mode=TwoWay}"
                Padding="0">

      <!-- Package — editable CREATE OR ALTER PACKAGE header (declarations). Compile /
           Revert / Format / Comment live in the main app toolbar (gated on
           IsPackageDetailTabActive). -->
      <TabItem Classes="bottom-tab" Header="{app:Loc PackageDetailTabPackage}">
        <ae:TextEditor x:Name="PackageHeaderEditor"
                       ShowLineNumbers="True"
                       FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                       FontSize="{DynamicResource Text.Code.Size}"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto"
                       Background="{DynamicResource BackgroundBrush}"
                       Foreground="{DynamicResource ForegroundBrush}" />
      </TabItem>

      <!-- Body — editable RECREATE PACKAGE BODY (implementation). -->
      <TabItem Classes="bottom-tab" Header="{app:Loc PackageDetailTabBody}">
        <ae:TextEditor x:Name="PackageBodyEditor"
                       ShowLineNumbers="True"
                       FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                       FontSize="{DynamicResource Text.Code.Size}"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto"
                       Background="{DynamicResource BackgroundBrush}"
                       Foreground="{DynamicResource ForegroundBrush}" />
      </TabItem>

      <!-- Members — read-only grouped tree (Functions / Procedures), built from the
           catalog. Double-click a member to jump to it in the Package or Body editor. -->
      <TabItem Classes="bottom-tab" Header="{app:Loc PackageDetailTabMembers}">
        <Grid>
          <TextBlock Text="{app:Loc PackageDetailMembersEmpty}"
                     Classes="subtle"
                     Margin="10,8"
                     FontSize="{DynamicResource Text.Compact.Size}"
                     IsVisible="{Binding ShowMembersEmpty}" />
          <!-- The tree is navigation only; the Debug ACTION for the selected member lives on the editor
               toolbar (D15.3 Seam E), so SelectedItem drives that toolbar button's enabled state + tooltip. -->
          <TreeView ItemsSource="{Binding MemberGroups}"
                    SelectedItem="{Binding SelectedMemberNode, Mode=TwoWay}"
                    IsVisible="{Binding HasMembers}"
                    Background="{DynamicResource BackgroundBrush}">
            <TreeView.DataTemplates>
              <TreeDataTemplate DataType="vm:PackageMemberGroupNode"
                                ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.Xs}">
                  <controls:SvgIcon Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}"
                                    Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}"
                                    VerticalAlignment="Center">
                    <controls:SvgIcon.Foreground>
                      <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                        <Binding Path="IconResourceKey" />
                        <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                      </MultiBinding>
                    </controls:SvgIcon.Foreground>
                  </controls:SvgIcon>
                  <TextBlock Text="{Binding Header}" FontSize="{DynamicResource Text.Compact.Size}" VerticalAlignment="Center" />
                </StackPanel>
              </TreeDataTemplate>
              <DataTemplate DataType="vm:PackageMemberItemNode">
                <Border HorizontalAlignment="Stretch"
                        Background="Transparent"
                        DoubleTapped="OnMemberNodeDoubleTapped">
                  <!-- Debug entry point (Stage X / D11 seam C — procedures; Seam D — functions) — launch a
                       package member as a debug root. Reuses the sidebar's labels + the ONE launch path
                       (OnMemberDebugClick → RequestDebugMember, kind-aware); one item per debuggable kind. -->
                  <Border.ContextMenu>
                    <ContextMenu>
                      <!-- The debugger's own identity mark, the same composite the sidebar's Debug items and
                           the editors' Debug buttons use. It briefly had Icon.Crosshair here, which made one
                           operation carry two different icons depending on where the user found it. -->
                      <MenuItem Header="{app:Loc MetadataContextDebugProcedure}"
                                Click="OnMemberDebugClick"
                                IsVisible="{Binding IsProcedure}">
                        <MenuItem.Icon>
                          <controls:DebuggerIcon Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="{app:Loc MetadataContextDebugFunction}"
                                Click="OnMemberDebugClick"
                                IsVisible="{Binding IsFunction}">
                        <MenuItem.Icon>
                          <controls:DebuggerIcon Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}" />
                        </MenuItem.Icon>
                      </MenuItem>
                    </ContextMenu>
                  </Border.ContextMenu>
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.Xs}">
                    <controls:SvgIcon Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}"
                                      Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}"
                                      VerticalAlignment="Center">
                      <controls:SvgIcon.Foreground>
                        <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                          <Binding Path="IconResourceKey" />
                          <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                        </MultiBinding>
                      </controls:SvgIcon.Foreground>
                    </controls:SvgIcon>
                    <TextBlock Text="{Binding DisplayName}" FontSize="{DynamicResource Text.Compact.Size}" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </TreeView.DataTemplates>
          </TreeView>
        </Grid>
      </TabItem>

      <!-- Description — editable COMMENT ON PACKAGE (same workflow as table/view). -->
      <TabItem Classes="bottom-tab" Header="{app:Loc PackageDetailTabDescription}">
        <Grid RowDefinitions="Auto,*" Background="{DynamicResource BackgroundBrush}">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="8,6,8,4"
                      IsVisible="{Binding CanEditDescription}">
            <TextBlock Text="{app:Loc PackageDescriptionEditLabel}"
                       Classes="subtle"
                       FontSize="{DynamicResource Text.Compact.Size}"
                       VerticalAlignment="Center" />
            <Button Classes="icon"
                    ToolTip.Tip="{app:Loc TableDescriptionSave}"
                    Command="{Binding SaveDescriptionCommand}">
              <controls:SvgIcon Data="{StaticResource Icon.Save}" />
            </Button>
            <Button Classes="flat"
                    Padding="8,2"
                    Content="{app:Loc TableDescriptionClear}"
                    Command="{Binding ClearDescriptionCommand}" />
          </StackPanel>
          <TextBox Grid.Row="1"
                   Text="{Binding EditableDescription, Mode=TwoWay}"
                   IsEnabled="{Binding CanEditDescription}"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource Text.Compact.Size}"
                   Margin="8,0,8,8"
                   Background="{DynamicResource BackgroundBrush}" />
        </Grid>
      </TabItem>

      <!-- Dependencies — same dual-tree layout + templates as TableDetail/ViewDetail. -->
      <TabItem Classes="bottom-tab" Header="{app:Loc PackageDetailTabDependencies}">
        <Grid ColumnDefinitions="*,4,*">
          <Grid Grid.Column="0" RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0"
                       Text="{app:Loc PackageDetailDependedOnByHeader}"
                       FontSize="{DynamicResource Text.Compact.Size}"
                       Foreground="{DynamicResource SubtleForegroundBrush}"
                       Margin="{DynamicResource Margin.PanelCaption}" />
            <controls:DependencyTreeView Grid.Row="1" ItemsSource="{Binding DependedOnByTree}" />
          </Grid>

          <GridSplitter Grid.Column="1"
                        Width="4"
                        Background="{DynamicResource BorderBrush}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />

          <Grid Grid.Column="2" RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0"
                       Text="{app:Loc PackageDetailDependsOnHeader}"
                       FontSize="{DynamicResource Text.Compact.Size}"
                       Foreground="{DynamicResource SubtleForegroundBrush}"
                       Margin="{DynamicResource Margin.PanelCaption}" />
            <controls:DependencyTreeView Grid.Row="1" ItemsSource="{Binding DependsOnTree}" />
          </Grid>
        </Grid>
      </TabItem>

      <!-- DDL — read-only reconstructed CREATE PACKAGE + RECREATE PACKAGE BODY. -->
      <TabItem Classes="bottom-tab" Header="{app:Loc PackageDetailTabDdl}">
        <ae:TextEditor x:Name="PackageDdlEditor"
                       ShowLineNumbers="True"
                       IsReadOnly="True"
                       FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                       FontSize="{DynamicResource Text.Code.Size}"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto"
                       Background="{DynamicResource BackgroundBrush}"
                       Foreground="{DynamicResource ForegroundBrush}" />
      </TabItem>

      <!-- Diagnostics (Stage 7 / S4) — the SAME view + VM the SQL Editor's Diagnostics tab uses,
           hosted per object. Shows the ACTIVE SQL document's findings (the LastFocusedSqlDocument
           rule — see DiagnosticsPanelHost): the header or body editor, whichever was last edited.
           Appended LAST so the persisted ActiveSubTabIndex and the PackageSubTabIndex /
           BodySubTabIndex constants never shift. -->
      <TabItem Classes="bottom-tab" Header="{app:Loc BottomTabDiagnostics}">
        <views:DiagnosticsPanelView x:Name="PackageDiagnosticsPanel"
                                    DataContext="{Binding DiagnosticsPanel}" />
      </TabItem>

    </TabControl>

    <StackPanel Grid.Row="1" Orientation="Vertical">
      <TextBlock Text="{app:Loc PackageDetailLoadingHint}"
                 Classes="subtle"
                 Margin="10,4"
                 FontSize="{DynamicResource Text.Compact.Size}"
                 IsVisible="{Binding IsLoading}" />
      <!-- Compile / load errors go through the IDE's ONE message surface (UX Polish Seam 4) —
           same severity stripe, icon, wrapping and Copy affordance on every editor. -->
      <controls:MessageBanner Classes="docked" Severity="Error"
                              Message="{Binding ErrorMessage}"
                              IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </Grid>

</UserControl>
