<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EmberTern.App.ViewModels"
        xmlns:app="using:EmberTern.App"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="EmberTern.App.Views.NewConnectionDialog"
        x:DataType="vm:NewConnectionDialogViewModel"
        Title="{Binding DialogTitle}"
        Width="460"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">

  <Grid RowDefinitions="Auto,*,Auto,Auto">

    <Border Grid.Row="0"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="20,16">
      <TextBlock Text="{Binding DialogTitle}" Classes="h1" />
    </Border>

    <ScrollViewer Grid.Row="1" MaxHeight="520">
      <StackPanel Margin="20,18" Spacing="14">

        <StackPanel Spacing="4">
          <TextBlock Text="{Binding NameLabel}" Classes="field-label" />
          <TextBox Text="{Binding Name, Mode=TwoWay}"
                   MaxLength="{app:Loc ConnectionNameMaxLength}"
                   PlaceholderText="{app:Loc NewConnectionNamePlaceholder}" />
        </StackPanel>

        <Grid ColumnDefinitions="*,12,110" RowDefinitions="Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding HostLabel}" Classes="field-label" />
          <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding PortLabel}" Classes="field-label" />
          <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Host, Mode=TwoWay}" />
          <NumericUpDown Grid.Row="1" Grid.Column="2"
                         Value="{Binding Port, Mode=TwoWay}"
                         Minimum="1" Maximum="65535"
                         FormatString="0"
                         ShowButtonSpinner="False" />
        </Grid>

        <StackPanel Spacing="4">
          <TextBlock Text="{Binding DatabasePathLabel}" Classes="field-label" />
          <Grid ColumnDefinitions="*,8,Auto">
            <TextBox Grid.Column="0"
                     Text="{Binding DatabasePath, Mode=TwoWay}"
                     PlaceholderText="{app:Loc NewConnectionPathPlaceholder}" />
            <Button Grid.Column="2"
                    Classes="flat"
                    Content="{Binding BrowseLabel}"
                    Click="OnBrowseClick" />
          </Grid>
        </StackPanel>

        <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding UsernameLabel}" Classes="field-label" />
          <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding PasswordLabel}" Classes="field-label" />
          <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Username, Mode=TwoWay}" />
          <TextBox Grid.Row="1" Grid.Column="2"
                   Text="{Binding Password, Mode=TwoWay}"
                   PasswordChar="•" />
        </Grid>

        <StackPanel Spacing="4">
          <TextBlock Text="{Binding CharsetLabel}" Classes="field-label" />
          <ComboBox ItemsSource="{Binding Charsets}"
                    SelectedItem="{Binding Charset, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" />
        </StackPanel>

        <!-- Developer Mode: the single switch that replaces the old TPB profile
             pickers. No transaction terminology is shown to the user. -->
        <StackPanel Spacing="4">
          <CheckBox IsChecked="{Binding DeveloperMode, Mode=TwoWay}"
                    Content="{app:Loc DialogFieldDeveloperMode}" />
          <TextBlock Text="{app:Loc DeveloperModeDescription}"
                     Classes="subtle"
                     FontSize="{DynamicResource Text.Compact.Size}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <!-- ⛔⛔ THE "ADVANCED" EXPANDER IS GONE WITH ITS ONLY CONTENT (S-5, 2026-08-05).
             It held exactly one field — the client library (fbclient.dll) — and that field could never do
             anything: EmberTern connects with FbServerType.Default, the pure managed wire protocol, where no
             fbclient.dll is loaded, and the driver reads its ClientLibrary only in Embedded mode, which this
             application never selects. The user found it by pointing the setting at a completely invalid DLL
             and connecting successfully.
             ⚠ The expander went too rather than being left empty: a disclosure control that reveals nothing is
             worse than no control. If Embedded mode is ever offered, this section comes back WITH it. -->

      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2"
            Padding="20,4,20,4"
            IsVisible="{Binding HasTestMessage}">
      <TextBlock Text="{Binding TestMessage}"
                 TextWrapping="Wrap"
                 FontSize="{DynamicResource Text.Application.Size}"
                 Classes.success="{Binding IsTestSuccess}"
                 Classes.error="{Binding IsTestFailure}"
                 Classes.subtle="{Binding IsTesting}" />
    </Border>

    <Border Grid.Row="3"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="20,12">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
        <Button Grid.Column="0"
                Classes="flat"
                Content="{Binding TestConnectionLabel}"
                Command="{Binding TestConnectionCommand}" />
        <TextBlock Grid.Column="1"
                   Text="{Binding ValidationMessage}"
                   Classes="error"
                   FontSize="{DynamicResource Text.Application.Size}"
                   VerticalAlignment="Center"
                   Margin="6,0,0,0"
                   IsVisible="{Binding HasValidationMessage}" />
        <Button Grid.Column="3"
                Classes="flat"
                Content="{Binding CancelLabel}"
                Command="{Binding CancelCommand}" />
        <Button Grid.Column="4"
                Classes="primary"
                Content="{Binding SaveLabel}"
                Command="{Binding SaveCommand}"
                IsDefault="True" />
      </Grid>
    </Border>

  </Grid>
</Window>
