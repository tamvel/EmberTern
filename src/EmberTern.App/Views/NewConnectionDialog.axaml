<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EmberTern.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="EmberTern.App.Views.NewConnectionDialog"
        x:DataType="vm:NewConnectionDialogViewModel"
        Title="{Binding DialogTitle}"
        Width="460"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">

  <Window.Styles>
    <Style Selector="TextBlock.field-label">
      <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto,Auto">

    <Border Grid.Row="0"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="20,16">
      <TextBlock Text="{Binding DialogTitle}" Classes="h1" />
    </Border>

    <ScrollViewer Grid.Row="1" MaxHeight="520">
      <StackPanel Margin="20,18" Spacing="14">

        <StackPanel Spacing="4">
          <TextBlock Text="{Binding NameLabel}" Classes="field-label" />
          <TextBox Text="{Binding Name, Mode=TwoWay}" PlaceholderText="Local development" />
        </StackPanel>

        <Grid ColumnDefinitions="*,12,110" RowDefinitions="Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding HostLabel}" Classes="field-label" />
          <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding PortLabel}" Classes="field-label" />
          <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Host, Mode=TwoWay}" />
          <NumericUpDown Grid.Row="1" Grid.Column="2"
                         Value="{Binding Port, Mode=TwoWay}"
                         Minimum="1" Maximum="65535"
                         FormatString="0"
                         ShowButtonSpinner="False" />
        </Grid>

        <StackPanel Spacing="4">
          <TextBlock Text="{Binding DatabasePathLabel}" Classes="field-label" />
          <Grid ColumnDefinitions="*,8,Auto">
            <TextBox Grid.Column="0"
                     Text="{Binding DatabasePath, Mode=TwoWay}"
                     PlaceholderText="C:\data\example.fdb" />
            <Button Grid.Column="2"
                    Classes="flat"
                    Content="{Binding BrowseLabel}"
                    Click="OnBrowseClick" />
          </Grid>
        </StackPanel>

        <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding UsernameLabel}" Classes="field-label" />
          <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding PasswordLabel}" Classes="field-label" />
          <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Username, Mode=TwoWay}" />
          <TextBox Grid.Row="1" Grid.Column="2"
                   Text="{Binding Password, Mode=TwoWay}"
                   PasswordChar="•" />
        </Grid>

        <StackPanel Spacing="4">
          <TextBlock Text="{Binding CharsetLabel}" Classes="field-label" />
          <ComboBox ItemsSource="{Binding Charsets}"
                    SelectedItem="{Binding Charset, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" />
        </StackPanel>

        <Expander Header="{Binding AdvancedSectionLabel}" IsExpanded="False">
          <StackPanel Spacing="14" Margin="0,10,0,0">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding DialectLabel}" Classes="field-label" />
              <ComboBox ItemsSource="{Binding Dialects}"
                        SelectedItem="{Binding Dialect, Mode=TwoWay}"
                        HorizontalAlignment="Left"
                        Width="120" />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="{Binding ClientLibraryLabel}" Classes="field-label" />
              <Grid ColumnDefinitions="*,8,Auto">
                <TextBox Grid.Column="0"
                         Text="{Binding ClientLibraryPath, Mode=TwoWay}"
                         PlaceholderText="C:\Program Files\Firebird\Firebird_3_0\fbclient.dll" />
                <Button Grid.Column="2"
                        Classes="flat"
                        Content="{Binding BrowseLabel}"
                        Click="OnBrowseClientLibraryClick" />
              </Grid>
              <TextBlock Text="{Binding ClientLibraryHint}"
                         Classes="subtle"
                         FontSize="11"
                         TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Expander>

      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2"
            Padding="20,4,20,4"
            IsVisible="{Binding HasTestMessage}">
      <TextBlock Text="{Binding TestMessage}"
                 TextWrapping="Wrap"
                 FontSize="12"
                 Classes.success="{Binding IsTestSuccess}"
                 Classes.error="{Binding IsTestFailure}"
                 Classes.subtle="{Binding IsTesting}" />
    </Border>

    <Border Grid.Row="3"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="20,12">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
        <Button Grid.Column="0"
                Classes="flat"
                Content="{Binding TestConnectionLabel}"
                Command="{Binding TestConnectionCommand}" />
        <TextBlock Grid.Column="1"
                   Text="{Binding ValidationMessage}"
                   Classes="error"
                   FontSize="12"
                   VerticalAlignment="Center"
                   Margin="6,0,0,0"
                   IsVisible="{Binding HasValidationMessage}" />
        <Button Grid.Column="3"
                Classes="flat"
                Content="{Binding CancelLabel}"
                Command="{Binding CancelCommand}" />
        <Button Grid.Column="4"
                Classes="primary"
                Content="{Binding SaveLabel}"
                Command="{Binding SaveCommand}"
                IsDefault="True" />
      </Grid>
    </Border>

  </Grid>
</Window>
