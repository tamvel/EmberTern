<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EmberTern.App.ViewModels"
        xmlns:app="using:EmberTern.App"
        xmlns:views="using:EmberTern.App.Views"
        xmlns:controls="using:EmberTern.App.Controls"
        xmlns:behaviors="using:EmberTern.App.Behaviors"
        xmlns:ae="using:AvaloniaEdit"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="EmberTern.App.Views.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="EmberTern"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowDecorations="BorderOnly"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">

  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <!-- ⛔ No Window.KeyBindings block, on purpose. Every application gesture is declared ONCE in
       Commands.CommandCatalog and dispatched by Commands.CommandRouter (wired in the code-behind), so a
       shortcut's meaning follows from its declared scope instead of from which handler happened to run
       first. Adding a KeyBinding here would re-create the second mechanism this sprint removed: the block
       that used to live at this spot bound F5 to a command that ended "anything else → Execute Query",
       which ran the editor's text — in the user's working transaction — from tabs that have nothing to
       execute. Register the gesture in the catalog instead. -->

  <!-- Rows: titlebar | settings-health banner (Auto ⇒ zero height when healthy) | body | status bar.
       The banner row exists because a settings.dat this build cannot read makes EVERY store silently stop
       persisting (ApplicationSettingsStore.Save refuses rather than destroy data it cannot see — audit A-03),
       and a user who is not told that would reasonably assume their work is being saved. It is deliberately
       NOT the status bar: that line is rewritten on the next connection change, and this must not scroll away. -->
  <!-- ⚠ Wysokości chromy stoją na `Height` BORDERÓW, a nie w tym ciągu — `RowDefinition.Height` to
       `GridLength`, a tokeny są `x:Double`, więc `{DynamicResource}` nie ma się na co skonwertować
       (§3.2 — katalog ma dwie warstwy, ale `GridLength` nie jest żadną z nich). Wiersze 0 i 3 są
       `Auto` i mierzą to, co zadeklarował ich Border. ⛔ Nie wracać do literałów „36" i „28": do M3.1a
       stały tu obie liczby, żaden licznik M2c ich nie widział, a `Size.StatusBar` był konsumowany
       wyłącznie przez belkę Data Importu — czyli wszędzie poza swoim własnym miejscem (§19.0.1). -->
  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- Custom titlebar: brand + active connection + connection toolbar + theme + window controls -->
    <Border Grid.Row="0"
            x:Name="Titlebar"
            Height="{DynamicResource Size.TitleBar}"
            Background="{DynamicResource ChromeStrongBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            PointerPressed="OnTitleBarPointerPressed"
            DoubleTapped="OnTitleBarDoubleTapped">
      <!-- ⭐⭐ KOLUMNA 0 ZNIKNĘŁA W M3.1b — i to nie jest pominięcie, tylko rozstrzygnięcie (§19.3).
           Stał tu blok aktywnego połączenia: nazwa bazy (Bold 14 z zielonym podkreśleniem) + badge DEV MODE.
           Cała ta informacja przeniosła się do SEKCJI 1 PASKA STATUSU, która jest od teraz jedynym miejscem
           odpowiadającym na pytanie „gdzie jestem podłączony?".

           Decyzja użytkownika (2026-08-02): *„jedna informacja powinna mieć jednego właściciela… pasek tytułu
           będzie odpowiadał wyłącznie za nawigację i polecenia"*. §8.4.3 przypisuje tożsamość połączenia
           paskowi statusu, a §0.1.2 mówi, że Application Chrome to JEDNA powierzchnia — trzymanie tej samej
           nazwy w dwóch miejscach naraz czytałoby się jako defekt, nie jako redundancja.

           ⭐ Efekt uboczny, który był jednym z powodów: zwolniło się do ~300 px w najbardziej zatłoczonym
           wierszu okna, a z trzech przyczyn H‑3 (przesuwanie się paska narzędzi przy zmianie stanu) zniknęły
           dwie — blok połączenia i badge DEV MODE. Zostaje `CanExportDdl`, którym zajmie się M3.2a.

           ⛔ Nie przywracać tu ani nazwy połączenia, ani badge'a DEV MODE. ⛔ Nie ma tu też logo — mark
           został usunięty osobną decyzją (2026-08-01) i mieszka w About. -->
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">

        <!-- Connection toolbar (moved from sidebar) -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2"
                    VerticalAlignment="Center" Margin="4,0,0,0">
          <!-- ⛔ Wiodący separator USUNIĘTY razem z blokiem połączenia (M3.1b): oddzielał go od paska
               narzędzi, a bez niczego po lewej byłby kreską opartą o krawędź okna — dokładnie ten rodzaj
               chromy po nieistniejącym elemencie, który sprzątał sprint brandingowy. -->
          <!-- ☰ Application Menu — the FIRST button of the action zone, and deliberately NOT fenced off
               with a separator of its own: ChatGPT and its peers do not, and it reads better (design §6).
               The rows are application-level only; anything belonging to the active document stays on the
               toolbars and context menus.

               It hosts a plain ContextMenu, opened from code on left-click, because that inherits the app's
               ONE menu appearance (the ContextMenu + MenuItem style set) with nothing added. A MenuFlyout
               would have needed a second chrome variant for MenuFlyoutPresenter — the trap that grew the
               MessageBanner six per-host variants. See docs/design/hamburger-navigation.md §2.2. -->
          <Button Classes="icon"
                  x:Name="AppMenuButton"
                  ToolTip.Tip="{x:Static app:UiStrings.AppMenuTooltip}"
                  Click="OnAppMenuClick">
            <controls:SvgIcon Data="{StaticResource Icon.Menu}" />
            <Button.ContextMenu>
              <!-- Under the button, left edges aligned — a menu button's menu belongs below it, not at the
                   pointer where a right-click menu belongs. -->
              <ContextMenu x:Name="AppMenu" Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="{x:Static app:UiStrings.AppMenuSettings}"
                          Icon="{app:MenuIcon Icon.Settings}"
                          Click="OnAppMenuSettingsClick" />
                <Separator />
                <MenuItem Header="{x:Static app:UiStrings.AppMenuKeyboardShortcuts}"
                          Icon="{app:MenuIcon Icon.Keyboard}"
                          Click="OnAppMenuKeyboardShortcutsClick" />
                <MenuItem Header="{x:Static app:UiStrings.AppMenuAbout}"
                          Icon="{app:MenuIcon Icon.Info}"
                          Click="OnAppMenuAboutClick" />
                <Separator />
                <MenuItem Header="{x:Static app:UiStrings.AppMenuExit}"
                          Icon="{app:MenuIcon Icon.Exit}"
                          ToolTip.Tip="{x:Static app:UiStrings.AppMenuExitTooltip}"
                          Click="OnAppMenuExitClick" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <!-- Sidebar collapse / restore toggle — immediately after the hamburger, no separator between. -->
          <Button Classes="icon"
                  ToolTip.Tip="{x:Static app:UiStrings.SidebarToggleTooltip}"
                  Click="OnToggleSidebarClick">
            <controls:SvgIcon Data="{StaticResource Icon.PanelLeft}" />
          </Button>
          <Button Classes="icon"
                  ToolTip.Tip="New Connection"
                  Click="OnNewConnectionClick">
            <controls:SvgIcon Data="{StaticResource Icon.Plus}" />
          </Button>
          <Button Classes="icon"
                  ToolTip.Tip="{x:Static app:UiStrings.FolderNewTooltip}"
                  Click="OnNewFolderClick">
            <controls:SvgIcon Data="{StaticResource Icon.FolderPlus}" />
          </Button>
          <Button Classes="icon"
                  ToolTip.Tip="Edit Connection"
                  Command="{Binding Metadata.EditSelectedCommand}">
            <controls:SvgIcon Data="{StaticResource Icon.Pencil}" />
          </Button>
          <Button Classes="icon"
                  ToolTip.Tip="Copy Connection"
                  Command="{Binding Metadata.CopySelectedCommand}">
            <controls:SvgIcon Data="{StaticResource Icon.Copy}" />
          </Button>
          <Button Classes="icon"
                  ToolTip.Tip="Delete Connection"
                  Command="{Binding Metadata.DeleteSelectedCommand}">
            <controls:SvgIcon Data="{StaticResource Icon.Trash}"
                              Foreground="{DynamicResource WarningIconBrush}" />
          </Button>
          <Border Width="1" Margin="4,6" Background="{DynamicResource BorderBrush}" />
          <Button Classes="icon"
                  ToolTip.Tip="Connect"
                  Command="{Binding Metadata.ConnectSelectedCommand}">
            <controls:SvgIcon Data="{StaticResource Icon.PlugZap}"
                              Foreground="{DynamicResource AccentIconBrush}" />
          </Button>
          <Button Classes="icon"
                  ToolTip.Tip="Disconnect"
                  Command="{Binding Metadata.DisconnectSelectedCommand}">
            <controls:SvgIcon Data="{StaticResource Icon.Unplug}" />
          </Button>
          <Button Classes="icon"
                  ToolTip.Tip="Reconnect"
                  Command="{Binding Metadata.ReconnectSelectedCommand}">
            <controls:SvgIcon Data="{StaticResource Icon.RotateCw}" />
          </Button>
          <Button Classes="icon"
                  ToolTip.Tip="{Binding Metadata.RefreshTooltip}"
                  Command="{Binding Metadata.RefreshCommand}">
            <controls:SvgIcon Data="{StaticResource Icon.RefreshCw}"
                              Foreground="{DynamicResource InfoIconBrush}" />
          </Button>
          <!-- Security Manager — sits between the Connection/Database section and the
               Create-Object section, separated on both sides (it's a tool, not a
               "new object" creator). -->
          <Border Width="1" Margin="4,6" Background="{DynamicResource BorderBrush}" />
          <Button Classes="icon"
                  ToolTip.Tip="{x:Static app:UiStrings.ToolbarSecurityManagerTooltip}"
                  Command="{Binding OpenSecurityManagerCommand}">
            <controls:SvgIcon Data="{StaticResource Icon.Role}"
                              Foreground="{DynamicResource IconColor_Role}" />
          </Button>
          <!-- Monitoring section: live database Activity Monitor (trace) + Session Manager. -->
          <Button Classes="icon"
                  ToolTip.Tip="{x:Static app:UiStrings.ToolbarActivityMonitorTooltip}"
                  Command="{Binding OpenTraceMonitorCommand}">
            <controls:SvgIcon Data="{StaticResource Icon.Activity}"
                              Foreground="{DynamicResource AccentBrush}" />
          </Button>
          <Button Classes="icon"
                  ToolTip.Tip="{x:Static app:UiStrings.ToolbarSessionManagerTooltip}"
                  Command="{Binding OpenSessionManagerCommand}">
            <controls:SvgIcon Data="{StaticResource Icon.Connection}"
                              Foreground="{DynamicResource AccentBrush}" />
          </Button>
          <!-- Global Search (metadata names + source bodies) — Ctrl+Shift+F. -->
          <Button Classes="icon"
                  ToolTip.Tip="{x:Static app:UiStrings.ToolbarGlobalSearchTooltip}"
                  Command="{Binding OpenGlobalSearchCommand}">
            <controls:SvgIcon Data="{StaticResource Icon.Search}"
                              Foreground="{DynamicResource AccentBrush}" />
          </Button>
          <!-- Script Executor: run a multi-statement / migration script in one transaction. -->
          <Button Classes="icon"
                  ToolTip.Tip="{x:Static app:UiStrings.ToolbarScriptExecutorTooltip}"
                  Command="{Binding OpenScriptExecutorCommand}">
            <controls:SvgIcon Data="{StaticResource Icon.FileText}"
                              Foreground="{DynamicResource AccentBrush}" />
          </Button>
          <!-- Data Import: clipboard / TXT / CSV / XLSX into a table. Sits beside the Script Executor
               because it is its peer — a tools tab, near-singleton, active only while connected (D6). -->
          <Button Classes="icon"
                  ToolTip.Tip="{x:Static app:UiStrings.ToolbarDataImportTooltip}"
                  Command="{Binding OpenDataImportCommand}">
            <controls:SvgIcon Data="{StaticResource Icon.Import}"
                              Foreground="{DynamicResource AccentBrush}" />
          </Button>
          <!-- Export DDL of the active object to a portable .sql file. Contextual: the
               separator + button hide together unless a DDL-bearing object tab is active. -->
          <Border Width="1" Margin="4,6" Background="{DynamicResource BorderBrush}"
                  IsVisible="{Binding CanExportDdl}" />
          <Button Classes="icon"
                  IsVisible="{Binding CanExportDdl}"
                  ToolTip.Tip="{x:Static app:UiStrings.ToolbarExportDdlTooltip}"
                  Command="{Binding ExportDdlCommand}">
            <controls:SvgIcon Data="{StaticResource Icon.Save}"
                              Foreground="{DynamicResource AccentBrush}" />
          </Button>
          <!-- Table-creation section sits AFTER all connection-related buttons.
               Icon ▦＋ mirrors the metadata tree's Table glyph with a plus —
               visually rhymes with the sidebar where new tables will appear. -->
          <Border Width="1" Margin="4,6" Background="{DynamicResource BorderBrush}" />
          <Button Classes="icon"
                  ToolTip.Tip="{x:Static app:UiStrings.ToolbarNewTableTooltip}"
                  Command="{Binding NewTableCommand}">
            <controls:SvgIcon Data="{StaticResource Icon.TablePlus}"
                              Foreground="{DynamicResource IconColor_Table}" />
          </Button>
          <Button Classes="icon"
                  ToolTip.Tip="{x:Static app:UiStrings.ToolbarNewViewTooltip}"
                  Command="{Binding NewViewCommand}">
            <controls:SvgIcon Data="{StaticResource Icon.ViewPlus}"
                              Foreground="{DynamicResource IconColor_View}" />
          </Button>
          <Button Classes="icon"
                  ToolTip.Tip="{x:Static app:UiStrings.ToolbarNewProcedureTooltip}"
                  Command="{Binding NewProcedureCommand}">
            <controls:SvgIcon Data="{StaticResource Icon.ProcedurePlus}"
                              Foreground="{DynamicResource IconColor_Procedure}" />
          </Button>
          <Button Classes="icon"
                  ToolTip.Tip="{x:Static app:UiStrings.ToolbarNewTriggerTooltip}"
                  Command="{Binding NewTriggerCommand}">
            <controls:SvgIcon Data="{StaticResource Icon.TriggerPlus}"
                              Foreground="{DynamicResource IconColor_Trigger}" />
          </Button>
          <Button Classes="icon"
                  ToolTip.Tip="{x:Static app:UiStrings.ToolbarNewFunctionTooltip}"
                  Command="{Binding NewFunctionCommand}">
            <controls:SvgIcon Data="{StaticResource Icon.FunctionPlus}"
                              Foreground="{DynamicResource IconColor_Function}" />
          </Button>
          <Button Classes="icon"
                  ToolTip.Tip="{x:Static app:UiStrings.ToolbarNewGeneratorTooltip}"
                  Command="{Binding NewGeneratorCommand}">
            <controls:SvgIcon Data="{StaticResource Icon.GeneratorPlus}"
                              Foreground="{DynamicResource IconColor_Generator}" />
          </Button>
          <Button Classes="icon"
                  ToolTip.Tip="{x:Static app:UiStrings.ToolbarNewDomainTooltip}"
                  Command="{Binding NewDomainCommand}">
            <controls:SvgIcon Data="{StaticResource Icon.DomainPlus}"
                              Foreground="{DynamicResource IconColor_Domain}" />
          </Button>
          <Button Classes="icon"
                  ToolTip.Tip="{x:Static app:UiStrings.ToolbarNewPackageTooltip}"
                  Command="{Binding NewPackageCommand}">
            <controls:SvgIcon Data="{StaticResource Icon.PackagePlus}"
                              Foreground="{DynamicResource IconColor_Package}" />
          </Button>
          <Button Classes="icon"
                  ToolTip.Tip="{x:Static app:UiStrings.ToolbarNewExceptionTooltip}"
                  Command="{Binding NewExceptionCommand}">
            <controls:SvgIcon Data="{StaticResource Icon.ExceptionPlus}"
                              Foreground="{DynamicResource IconColor_Exception}" />
          </Button>
        </StackPanel>

        <!-- Drag spacer (kolumna 1 = *) -->

        <!-- Theme toggle -->
        <Button Grid.Column="2" Classes="icon"
                ToolTip.Tip="{Binding ThemeToggleTooltip}"
                Click="OnThemeToggleClick"
                VerticalAlignment="Center"
                Margin="0,0,6,0">
          <!-- Icon shows the ACTION: Sun in Dark (→ switch to Light), Moon in Light (→ switch to
               Dark). Bound to ActualThemeVariant so it updates the moment the theme changes. -->
          <controls:SvgIcon Data="{Binding ActualThemeVariant, ElementName=RootWindow,
                                   Converter={x:Static app:ThemeToggleIconConverter.Instance}}" />
        </Button>

        <!-- Window controls -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Stretch">
          <Button Classes="caption" Click="OnMinimizeClick" ToolTip.Tip="Minimize">
            <controls:SvgIcon Data="{StaticResource Icon.WindowMinimize}" Width="16" Height="16" />
          </Button>
          <Button Classes="caption" Click="OnMaxRestoreClick" ToolTip.Tip="Maximize / Restore"
                  x:Name="MaxRestoreButton">
            <controls:SvgIcon x:Name="MaxRestoreGlyph"
                              Data="{StaticResource Icon.WindowMaximize}"
                              Width="16" Height="16" />
          </Button>
          <Button Classes="caption close" Click="OnCloseClick" ToolTip.Tip="Close">
            <controls:SvgIcon Data="{StaticResource Icon.WindowClose}" Width="16" Height="16" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Settings health (audit A-03). The shared MessageBanner, docked, per the reuse rule: a host sets only
         Severity / Message / IsVisible / Classes — never its own Background, BorderBrush or BorderThickness,
         which would outrank the shared style. Dismissible, because a user who has read it and chosen to work
         on unsaved settings should not be nagged for the rest of the session. -->
    <controls:MessageBanner Grid.Row="1"
                            Classes="docked"
                            Severity="Warning"
                            Message="{Binding SettingsHealthMessage}"
                            IsVisible="{Binding ShowSettingsHealthWarning}"
                            ShowDismiss="True"
                            DismissCommand="{Binding DismissSettingsHealthWarningCommand}" />

    <!-- Main 3-zone body: sidebar | splitter | workspace+bottom.
         SidebarColumn width + the collapsed state persist in WorkspaceState; the
         native GridSplitter drives live resize within MinWidth/MaxWidth (220..600). -->
    <Grid Grid.Row="2" x:Name="MainBodyGrid">
      <Grid.ColumnDefinitions>
        <!-- SidebarColumn: reached in code-behind via MainBodyGrid.ColumnDefinitions[0]
             (x:Name isn't supported on Grid definitions in Avalonia). -->
        <ColumnDefinition Width="280" MinWidth="220" MaxWidth="600" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Sidebar — IBExpert-style connection tree -->
      <Border Grid.Column="0" x:Name="SidebarPanel" Background="{DynamicResource PanelBrush}">
        <DockPanel LastChildFill="True" DataContext="{Binding Metadata}">

          <!-- Filter -->
          <Border DockPanel.Dock="Top" Margin="8,6,8,4">
            <TextBox x:Name="SidebarFilterBox" Classes="search"
                     Text="{Binding FilterText, Mode=TwoWay}"
                     PlaceholderText="{Binding FilterPlaceholder}"
                     Padding="6,4" />
          </Border>

          <!-- Metadata sidebar — flat single-VirtualizingStackPanel ListBox. Replaces the
               nested-VSP TreeView (whose per-item virtualization made the scroll extent
               collapse/re-estimate on a random-access thumb drag). The hierarchy is
               flattened into SidebarRows by SidebarFlatController; each row = indent + a
               chevron + the SAME per-type node template as before (icons, colours, context
               menus, double-click handlers — verbatim), so it looks identical to the tree
               but scrolls on one stable-extent VSP. -->
          <ListBox ItemsSource="{Binding SidebarRows}"
                   x:Name="SidebarList"
                   Classes="sidebar-list"
                   Background="Transparent"
                   BorderThickness="0"
                   SelectionMode="Multiple"
                   SelectionChanged="OnSidebarListSelectionChanged">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.Styles>
              <!-- Dense, uniform sidebar rows (scoped to this ListBox so the Saved-Queries
                   ListBox is unaffected). Uniform height keeps the single VSP's extent exact. -->
              <Style Selector="ListBox.sidebar-list ListBoxItem">
                <Setter Property="Padding" Value="2,0" />
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              </Style>
              <!-- Expander chevron: subtle, borderless, generous 20px hit area (modern
                   explorer feel) with a 12px glyph. -->
              <Style Selector="Button.sidebar-chevron">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="20" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}" />
              </Style>
              <Style Selector="Button.sidebar-chevron:pointerover">
                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
              </Style>
              <!-- Drag-and-drop drop-target overlay (base Transparent + Boolean class flip),
                   preserved from the tree for Phase 3. -->
              <Style Selector="Border.row-target">
                <Setter Property="Background" Value="Transparent" />
              </Style>
              <Style Selector="Border.row-target.drop-target">
                <Setter Property="Background" Value="{DynamicResource DropTargetBrush}" />
              </Style>
              <!-- Inactive triggers/indexes render dimmed (+ a "(inactive)" suffix). -->
              <Style Selector="TextBlock.inactive">
                <Setter Property="Opacity" Value="0.5" />
              </Style>
            </ListBox.Styles>

            <ListBox.DataTemplates>
              <!-- The flattened row: indentation spacer + chevron + the per-type node
                   content (hosted via ContentControl, which resolves the DataTemplates
                   below by node type). -->
              <DataTemplate DataType="vm:SidebarRow">
                <Grid ColumnDefinitions="Auto,Auto,*">
                  <Border Grid.Column="0" Width="{Binding IndentWidth}" />
                  <Panel Grid.Column="1" Width="20" VerticalAlignment="Center">
                    <Button Classes="sidebar-chevron"
                            IsVisible="{Binding IsExpandable}"
                            Click="OnSidebarChevronClick">
                      <Panel>
                        <controls:SvgIcon Data="{StaticResource Icon.ChevronRight}"
                                          Width="12" Height="12"
                                          IsVisible="{Binding !IsExpanded}" />
                        <controls:SvgIcon Data="{StaticResource Icon.ChevronDown}"
                                          Width="12" Height="12"
                                          IsVisible="{Binding IsExpanded}" />
                      </Panel>
                    </Button>
                  </Panel>
                  <ContentControl Grid.Column="2"
                                  Content="{Binding Node}"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>

              <DataTemplate DataType="vm:FolderNodeViewModel">
                <Border HorizontalAlignment="Stretch"
                        Classes="row-target"
                        Classes.drop-target="{Binding IsDropTarget}">
                  <Border.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="{x:Static app:UiStrings.FolderContextAddConnection}"
                                Icon="{app:MenuIcon Icon.Plus}"
                                Command="{Binding AddConnectionCommand}" />
                      <Separator />
                      <MenuItem Header="{x:Static app:UiStrings.FolderContextRename}"
                                Icon="{app:MenuIcon Icon.Pencil}"
                                Command="{Binding BeginRenameCommand}" />
                      <MenuItem Header="{x:Static app:UiStrings.FolderContextDelete}"
                                Icon="{app:MenuIcon Icon.Trash, Brush=DangerIconBrush}"
                                Command="{Binding DeleteCommand}" />
                    </ContextMenu>
                  </Border.ContextMenu>
                  <Panel>
                    <StackPanel Orientation="Horizontal" Spacing="5"
                                IsVisible="{Binding IsNotRenaming}">
                      <controls:SvgIcon Data="{StaticResource Icon.Folder}"
                                        Width="15" Height="15"
                                        VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Name}"
                                 FontWeight="SemiBold"
                                 FontSize="{DynamicResource Text.Compact.Size}"
                                 VerticalAlignment="Center"
                                 DoubleTapped="OnFolderNameDoubleTapped" />
                    </StackPanel>
                    <TextBox Text="{Binding EditingName, Mode=TwoWay}"
                             FontSize="{DynamicResource Text.Compact.Size}"
                             Padding="2,1"
                             IsVisible="{Binding IsRenaming}"
                             behaviors:FocusBehavior.FocusOnVisible="True"
                             LostFocus="OnFolderRenameLostFocus"
                             KeyDown="OnFolderRenameKeyDown" />
                  </Panel>
                </Border>
              </DataTemplate>

              <DataTemplate DataType="vm:ConnectionNodeViewModel">
                <Border HorizontalAlignment="Stretch"
                        Classes="row-target"
                        Classes.drop-target="{Binding IsDropTarget}"
                        DoubleTapped="OnConnectionNodeDoubleTapped">
                  <Border.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Connect"
                                Icon="{app:MenuIcon Icon.PlugZap}"
                                Command="{Binding ConnectCommand}"
                                IsVisible="{Binding !IsConnected}" />
                      <MenuItem Header="Disconnect"
                                Icon="{app:MenuIcon Icon.Unplug}"
                                Command="{Binding DisconnectCommand}"
                                IsVisible="{Binding IsConnected}" />
                      <MenuItem Header="{x:Static app:UiStrings.ConnectionContextRefresh}"
                                Icon="{app:MenuIcon Icon.RefreshCw}"
                                InputGesture="{app:CommandGesture RefreshMetadata}"
                                Command="{Binding RefreshMetadataCommand}"
                                IsVisible="{Binding IsConnected}" />
                      <Separator />
                      <MenuItem Header="Edit" Icon="{app:MenuIcon Icon.Pencil}" Command="{Binding EditCommand}" />
                      <MenuItem Header="Copy" Icon="{app:MenuIcon Icon.Copy}" Command="{Binding CopyCommand}" />
                      <MenuItem Header="Delete" Icon="{app:MenuIcon Icon.Trash, Brush=DangerIconBrush}"
                                Command="{Binding DeleteCommand}" />
                      <Separator IsVisible="{Binding IsConnected}" />
                      <MenuItem Header="{x:Static app:UiStrings.ConnectionContextRecomputeStats}"
                                Icon="{app:MenuIcon Icon.Sigma}"
                                Command="{Binding RecomputeAllStatisticsCommand}"
                                IsVisible="{Binding IsConnected}" />
                      <MenuItem Header="{x:Static app:UiStrings.ConnectionContextRecompile}"
                                Icon="{app:MenuIcon Icon.Hammer}"
                                Command="{Binding RecompileAllObjectsCommand}"
                                IsVisible="{Binding IsConnected}" />
                      <Separator />
                      <MenuItem Header="{x:Static app:UiStrings.ConnectionContextSort}"
                                Icon="{app:MenuIcon Icon.ListFilter}">
                        <MenuItem Header="{x:Static app:UiStrings.ConnectionContextSortAscending}"
                                  Icon="{app:MenuIcon Icon.ArrowUp}"
                                  Command="{Binding SortAscendingCommand}" />
                        <MenuItem Header="{x:Static app:UiStrings.ConnectionContextSortDescending}"
                                  Icon="{app:MenuIcon Icon.ArrowDown}"
                                  Command="{Binding SortDescendingCommand}" />
                      </MenuItem>
                    </ContextMenu>
                  </Border.ContextMenu>
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <controls:SvgIcon Data="{StaticResource Icon.Connection}"
                                      Width="15" Height="15"
                                      VerticalAlignment="Center">
                      <controls:SvgIcon.Foreground>
                        <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                          <Binding Path="StatusBrushKey" />
                          <Binding ElementName="RootWindow" Path="ActualThemeVariant" />
                        </MultiBinding>
                      </controls:SvgIcon.Foreground>
                    </controls:SvgIcon>
                    <TextBlock Text="{Binding DisplayName}"
                               FontWeight="SemiBold"
                               FontSize="{DynamicResource Text.Compact.Size}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding DisplayName}"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </DataTemplate>

              <DataTemplate DataType="vm:MetadataNodeViewModel">
                <Border HorizontalAlignment="Stretch"
                        Background="Transparent"
                        DoubleTapped="OnMetadataNodeDoubleTapped">
                  <Border.ContextMenu>
                    <ContextMenu>
                      <!-- Icons come from the existing geometry dictionary through {app:MenuIcon}; gestures
                           from CommandCatalog through {app:CommandGesture}, so a re-bind reaches this menu
                           without anyone editing it. New / Delete / Refresh are the Tree-scope gestures —
                           this is where they were always meant to be surfaced (etap 4 §14.4 deliberately
                           kept them off the toolbar, where they do not fire). -->
                      <MenuItem Header="{Binding ContextNewLabel}"
                                Icon="{app:MenuIcon Icon.Plus}"
                                InputGesture="{app:CommandGesture NewObject}"
                                Command="{Binding NewCommand}"
                                IsVisible="{Binding SupportsNew}" />
                      <MenuItem Header="{Binding ContextRecompileAllLabel}"
                                Icon="{app:MenuIcon Icon.Hammer}"
                                Command="{Binding RecompileAllCommand}"
                                IsVisible="{Binding IsRecompilableGroup}" />
                      <Separator IsVisible="{Binding IsTriggerGroup}" />
                      <!-- Trigger-GROUP bulk ops: Visible (current filter set) or All. The "Selected"
                           scope moved onto the selected trigger leaves (see below) so the user doesn't
                           scroll back to this header to act on a multi-selection. -->
                      <MenuItem Header="{x:Static app:UiStrings.MetadataContextActivate}"
                                Icon="{app:MenuIcon Icon.Check}"
                                IsVisible="{Binding IsTriggerGroup}">
                        <MenuItem Header="{x:Static app:UiStrings.MetadataContextScopeVisible}"
                                  Command="{Binding ActivateVisibleCommand}" />
                        <MenuItem Header="{x:Static app:UiStrings.MetadataContextScopeAll}"
                                  Command="{Binding ActivateAllCommand}" />
                      </MenuItem>
                      <MenuItem Header="{x:Static app:UiStrings.MetadataContextDeactivate}"
                                Icon="{app:MenuIcon Icon.Pause}"
                                IsVisible="{Binding IsTriggerGroup}">
                        <MenuItem Header="{x:Static app:UiStrings.MetadataContextScopeVisible}"
                                  Command="{Binding DeactivateVisibleCommand}" />
                        <MenuItem Header="{x:Static app:UiStrings.MetadataContextScopeAll}"
                                  Command="{Binding DeactivateAllCommand}" />
                      </MenuItem>
                      <!-- Trigger-LEAF multi-select bulk ops — visible only when >1 trigger is
                           selected (Ctrl/Shift-click). Commands are forwarded from the explorer VM
                           (which owns the selection) via the node VM so they resolve inside the
                           ContextMenu's popup namescope (gotcha #180). -->
                      <MenuItem Header="{Binding ActivateSelectedTriggersLabel}"
                                Icon="{app:MenuIcon Icon.Check}"
                                Command="{Binding ActivateSelectedTriggersCommand}"
                                IsVisible="{Binding ShowSelectedTriggerOps}" />
                      <MenuItem Header="{Binding DeactivateSelectedTriggersLabel}"
                                Icon="{app:MenuIcon Icon.Pause}"
                                Command="{Binding DeactivateSelectedTriggersCommand}"
                                IsVisible="{Binding ShowSelectedTriggerOps}" />
                      <MenuItem Header="{Binding ContextEditLabel}"
                                Icon="{app:MenuIcon Icon.Pencil}"
                                Command="{Binding OpenDdlCommand}"
                                IsVisible="{Binding CanEditLeaf}" />
                      <MenuItem Header="{x:Static app:UiStrings.MetadataContextExecuteProcedure}"
                                Icon="{app:MenuIcon Icon.Play}"
                                Command="{Binding ExecuteProcedureCommand}"
                                IsVisible="{Binding IsProcedureLeaf}" />
                      <!-- The debugger's identity mark is a two-colour composite control, not a single
                           stroked geometry, so it cannot come through {app:MenuIcon}. Set inline — reusing
                           the one existing mark rather than drawing a second, flatter debugger icon. -->
                      <MenuItem Header="{x:Static app:UiStrings.MetadataContextDebugProcedure}"
                                Command="{Binding DebugProcedureCommand}"
                                IsVisible="{Binding IsProcedureLeaf}">
                        <MenuItem.Icon>
                          <controls:DebuggerIcon Width="14" Height="14" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="{x:Static app:UiStrings.MetadataContextDebugTrigger}"
                                Command="{Binding DebugTriggerCommand}"
                                IsVisible="{Binding IsTriggerLeaf}">
                        <MenuItem.Icon>
                          <controls:DebuggerIcon Width="14" Height="14" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="{x:Static app:UiStrings.MetadataContextDebugFunction}"
                                Command="{Binding DebugFunctionCommand}"
                                IsVisible="{Binding IsFunctionLeaf}">
                        <MenuItem.Icon>
                          <controls:DebuggerIcon Width="14" Height="14" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="{x:Static app:UiStrings.MetadataContextActivate}"
                                Icon="{app:MenuIcon Icon.Check}"
                                Command="{Binding ActivateCommand}"
                                IsVisible="{Binding ShowActivate}" />
                      <MenuItem Header="{x:Static app:UiStrings.MetadataContextDeactivate}"
                                Icon="{app:MenuIcon Icon.Pause}"
                                Command="{Binding DeactivateCommand}"
                                IsVisible="{Binding ShowDeactivate}" />
                      <Separator IsVisible="{Binding CanDeleteLeaf}" />
                      <MenuItem Header="{x:Static app:UiStrings.MetadataContextDelete}"
                                Icon="{app:MenuIcon Icon.Trash, Brush=DangerIconBrush}"
                                InputGesture="{app:CommandGesture DeleteObject}"
                                Command="{Binding DeleteCommand}"
                                IsVisible="{Binding CanDeleteLeaf}" />
                      <Separator IsVisible="{Binding ShowCopyNameLeaf}" />
                      <MenuItem Header="{Binding ContextCopyNameLabel}"
                                Icon="{app:MenuIcon Icon.Copy}"
                                Command="{Binding CopyNameCommand}"
                                IsVisible="{Binding ShowCopyNameLeaf}" />
                    </ContextMenu>
                  </Border.ContextMenu>
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <controls:SvgIcon Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}"
                                      Width="15" Height="15"
                                      VerticalAlignment="Center"
                                      IsVisible="{Binding !IsPlaceholder}">
                      <controls:SvgIcon.Foreground>
                        <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                          <Binding Path="IconResourceKey" />
                          <Binding ElementName="RootWindow" Path="ActualThemeVariant" />
                        </MultiBinding>
                      </controls:SvgIcon.Foreground>
                    </controls:SvgIcon>
                    <TextBlock Text="{Binding DisplayLabel}"
                               VerticalAlignment="Center"
                               Classes.subtle="{Binding IsPlaceholder}"
                               Classes.inactive="{Binding IsInactive}"
                               FontSize="{DynamicResource Text.Compact.Size}" />
                    <TextBlock Text="…"
                               Classes="subtle"
                               FontSize="{DynamicResource Text.Caption.Size}"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsLoading}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.DataTemplates>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Resize handle between sidebar and workspace (visible when expanded).
           Double-click collapses the sidebar; the seam is wider than 1px for a
           comfortable grab. When collapsed it hides and the rail below takes over
           the same Auto column. -->
      <GridSplitter Grid.Column="1"
                    x:Name="SidebarSplitter"
                    Width="4"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"
                    Background="{DynamicResource BorderBrush}"
                    DoubleTapped="OnSidebarSplitterDoubleTapped" />

      <!-- Left-edge grab rail, shown only while collapsed (sidebar column = 0px,
           so this sits flush against the window's left edge). One click re-expands
           the sidebar to its last width. Shares column 1 with the splitter; only
           one of the two is visible at a time so the Auto column sizes to it. -->
      <!-- A Border, not a Button: a Button swallows PointerPressed in its class
           handler (so the press never reaches our handler) and its Click needs
           press+release on the same 12px strip (drift cancels it → "works on the
           Nth try"). The Border reacts on PointerPressed and re-expands reliably. -->
      <Border Grid.Column="1"
              x:Name="SidebarRail"
              Classes="sidebar-rail"
              IsVisible="False"
              ToolTip.Tip="{x:Static app:UiStrings.SidebarExpandTooltip}"
              PointerPressed="OnSidebarRailPointerPressed">
        <TextBlock Text="›"
                   FontSize="{DynamicResource Text.Compact.Size}"
                   Foreground="{DynamicResource SubtleForegroundBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
      </Border>

      <!-- Workspace + bottom panel. The results row is resizable via a native
           GridSplitter; ResultsRow.Height persists in WorkspaceState. On DDL /
           TableDetail tabs the splitter + results hide and ResultsRow collapses
           to 0 (managed in code-behind off IsQueryTabActive) so the editor fills. -->
      <Grid Grid.Column="2" x:Name="WorkspaceGrid">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <!-- ResultsRow: reached via WorkspaceGrid.RowDefinitions[2] in code-behind. -->
          <RowDefinition Height="280" MinHeight="120" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" RowDefinitions="Auto,Auto,*,Auto">

          <!-- Tab strip — WrapPanel so overflow flows to a second row (IBExpert style)
               instead of horizontal scrolling. Auto-height (Grid row was 36; we replaced
               it with Auto on the parent below). -->
          <!-- `Classes="tab-strip"` NIE jest kosmetyką — to deklaracja kontenera (§17.2/2). Reguła
               `Border.tab-strip Button` w ControlStyles.axaml zdejmuje z przycisków zakładki geometrię
               akcji dialogowej, którą dziedziczyły po `Button.flat`. Powód i pomiar stoją przy tej regule. -->
          <Border Grid.Row="0"
                  Classes="tab-strip"
                  Background="{DynamicResource PanelBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="0,0,0,1">
            <ItemsControl ItemsSource="{Binding WorkspaceTabs}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:WorkspaceTabViewModel">
                  <Border BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="0,0,1,0"
                          MinHeight="{DynamicResource Size.Row.Tab}"
                          Background="{DynamicResource PanelBrush}"
                          Classes.active-tab="{Binding IsSelected}">
                    <Border.Styles>
                      <Style Selector="Border.active-tab">
                        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
                      </Style>
                      <!-- ⛔ Wskaźnik aktywnej zakładki NIE jest stylowany tutaj — oba jego stany
                           (spoczynkowy i akcent) mieszkają w `ControlStyles.axaml`, razem z powodem.
                           Krótko: stały tu z lokalnym `Background="Transparent"`, które biło setter stylu,
                           więc akcent nie malował się nigdy (§19.2). ⛔ Nie przywracać ani stylu, ani —
                           tym bardziej — atrybutu `Background` na samym wskaźniku. -->
                      <!-- Active tab title: SemiBold + full-contrast (only the selected
                           tab; inactive tabs untouched). Pairs with the 2px accent top
                           line for a clear Rider/DataGrip active-tab read. -->
                      <Style Selector="Border.active-tab TextBlock">
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                      </Style>
                    </Border.Styles>
                    <!-- Rider/DataGrip-style active-tab indicator: a 2px accent line at
                         the top of the SELECTED tab. The 2px row is always reserved so
                         active/inactive tabs keep identical height + content baseline;
                         only the selected tab paints the accent (over the existing
                         background swap, which alone read too subtly). -->
                    <Grid RowDefinitions="Auto,*">
                      <Border Grid.Row="0"
                              Classes="tab-indicator"
                              Height="{DynamicResource Size.TabIndicator}" />
                      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="0">
                      <Button Classes="flat"
                              Padding="8,4"
                              Background="Transparent"
                              BorderThickness="0"
                              Command="{Binding ActivateCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <!-- The debugger tab wears the two-colour debugger identity mark
                               (D15.2 Seam B); every other tab uses its single-colour SvgIcon. -->
                          <controls:DebuggerIcon Width="14" Height="14" VerticalAlignment="Center"
                                                 IsVisible="{Binding IsDebuggerTab}" />
                          <controls:SvgIcon Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}"
                                            Width="14" Height="14"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding !IsDebuggerTab}">
                            <controls:SvgIcon.Foreground>
                              <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                                <Binding Path="IconResourceKey" />
                                <Binding ElementName="RootWindow" Path="ActualThemeVariant" />
                              </MultiBinding>
                            </controls:SvgIcon.Foreground>
                          </controls:SvgIcon>
                          <TextBlock Text="{Binding DisplayTitle}"
                                     FontSize="{DynamicResource Text.Compact.Size}"
                                     VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Button Classes="icon"
                              Padding="4,2"
                              Margin="0,0,3,0"
                              Background="Transparent"
                              BorderThickness="0"
                              ToolTip.Tip="Close tab"
                              IsVisible="{Binding IsClosable}"
                              Command="{Binding CloseCommand}">
                        <controls:SvgIcon Data="{StaticResource Icon.X}" Width="12" Height="12" />
                      </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>

          <!-- Unified editor toolbar — fixed 5-section model, identical for every object
               editor (Table / New Table / View / Procedure + future Trigger / Function /
               Package):  [Mode] | [Main] | [Collection: + −  |  ↑ ↓] | [Helper] | [Close].
               Each section + its leading separator collapse when empty for the active
               editor (Toolbar*Visible flags). The Collection section binds the unified
               router (AddCollectionItem…) routed to the active editor's active collection,
               so there are NO per-editor collection bars and no special-case layouts. -->
          <Border Grid.Row="1"
                  Classes="chrome"
                  Background="{DynamicResource PanelBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="0,0,0,1"
                  IsVisible="{Binding ShowEditorToolbar}">
            <DockPanel LastChildFill="True">
              <!-- Live elapsed timer — a RIGHT-ALIGNED status element (docked right, outside the
                   button StackPanel) so appearing/updating never shifts the toolbar icons. One
                   cohesive "Elapsed: mm:ss.f" while any SQL Editor / Execute Procedure / Execute
                   Function run is in progress; the final "N ms" is shown by the metrics display. -->
              <TextBlock DockPanel.Dock="Right" Text="{Binding ExecutionTimer.ElapsedDisplay}"
                         FontSize="{DynamicResource Text.Compact.Size}" FontFamily="Consolas,Menlo,monospace" Margin="8,0,14,0"
                         VerticalAlignment="Center" Foreground="{DynamicResource SubtleForegroundBrush}"
                         IsVisible="{Binding ExecutionTimer.IsRunning}" />
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="10,4" VerticalAlignment="Center">

              <!-- ── SECTION 1 · Mode toggle (Table Grid-Edit / View+Procedure Easy) ── -->
              <ToggleButton Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.ToolbarToggleFieldEditTooltip}"
                            IsChecked="{Binding ActiveTableDetail.IsFieldEditMode, Mode=TwoWay}"
                            IsVisible="{Binding ShowFieldEditTools}">
                <controls:SvgIcon Data="{StaticResource Icon.PencilRuler}" />
              </ToggleButton>
              <ToggleButton Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.ViewModeToggleTooltip}"
                            IsChecked="{Binding ActiveViewDetail.EasyMode, Mode=TwoWay}"
                            IsEnabled="{Binding ActiveViewDetail.CanUseEasyMode}"
                            IsVisible="{Binding IsViewDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.PencilRuler}" />
              </ToggleButton>
              <ToggleButton Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.ProcedureModeToggleTooltip}"
                            IsChecked="{Binding ActiveProcedureDetail.EasyMode, Mode=TwoWay}"
                            IsEnabled="{Binding ActiveProcedureDetail.CanUseEasyMode}"
                            IsVisible="{Binding IsProcedureDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.PencilRuler}" />
              </ToggleButton>
              <ToggleButton Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.TriggerModeToggleTooltip}"
                            IsChecked="{Binding ActiveTriggerDetail.EasyMode, Mode=TwoWay}"
                            IsEnabled="{Binding ActiveTriggerDetail.CanUseEasyMode}"
                            IsVisible="{Binding IsTriggerDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.PencilRuler}" />
              </ToggleButton>
              <ToggleButton Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.ProcedureModeToggleTooltip}"
                            IsChecked="{Binding ActiveFunctionDetail.EasyMode, Mode=TwoWay}"
                            IsEnabled="{Binding ActiveFunctionDetail.CanUseEasyMode}"
                            IsVisible="{Binding IsFunctionDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.PencilRuler}" />
              </ToggleButton>
              <Border Width="1" Margin="4,4" Background="{DynamicResource BorderBrush}"
                      IsVisible="{Binding ToolbarSep1Visible}" />

              <!-- ── SECTION 2 · Main actions (Execute / Compile / Commit / Rollback) ── -->
              <Button Classes="primary"
                      ToolTip.Tip="{x:Static app:UiStrings.ToolbarExecuteTooltip}"
                      Command="{Binding ExecuteQueryCommand}" IsVisible="{Binding ShowExecuteButton}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <controls:SvgIcon Data="{StaticResource Icon.Play}" Foreground="{DynamicResource OnAccentBrush}"
                                    Width="14" Height="14" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding ExecuteLabel}" VerticalAlignment="Center" />
                  <TextBlock Classes="shortcut-chip" Text="{Binding ExecuteHint}" />
                </StackPanel>
              </Button>
              <Button Classes="flat" Padding="10,4"
                      Command="{Binding CancelQueryCommand}" IsVisible="{Binding ShowCancelButton}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <controls:SvgIcon Data="{StaticResource Icon.Stop}" Foreground="{DynamicResource DangerIconBrush}"
                                    Width="14" Height="14" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding CancelLabel}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="primary" ToolTip.Tip="{x:Static app:UiStrings.FieldEditCompileTooltip}"
                      Command="{Binding ActiveTableDetail.CompileCommand}" IsVisible="{Binding ShowStructureCompileTools}">
                <controls:SvgIcon Data="{StaticResource Icon.Hammer}" Foreground="{DynamicResource OnAccentBrush}" Width="16" Height="16" />
              </Button>
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.FieldEditDiscardTooltip}"
                      Command="{Binding ActiveTableDetail.DiscardPendingChangesCommand}" IsVisible="{Binding ShowStructureCompileTools}">
                <controls:SvgIcon Data="{StaticResource Icon.Undo}" />
              </Button>
              <Button Classes="primary" ToolTip.Tip="{x:Static app:UiStrings.NewTableDialogCompile}"
                      Command="{Binding ActiveNewTable.CompileCommand}" IsVisible="{Binding IsNewTableTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Hammer}" Foreground="{DynamicResource OnAccentBrush}" Width="16" Height="16" />
              </Button>
              <Button Classes="primary" ToolTip.Tip="{x:Static app:UiStrings.ViewCompileTooltip}"
                      Command="{Binding ActiveViewDetail.CompileCommand}" IsVisible="{Binding IsViewDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Hammer}" Foreground="{DynamicResource OnAccentBrush}" Width="16" Height="16" />
              </Button>
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.RevertChangesTooltip}"
                      Command="{Binding ActiveViewDetail.RevertChangesCommand}" IsVisible="{Binding IsViewDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Undo}" />
              </Button>
              <Button Classes="primary" ToolTip.Tip="{x:Static app:UiStrings.ProcedureCompileTooltip}"
                      Command="{Binding ActiveProcedureDetail.CompileCommand}" IsVisible="{Binding IsProcedureDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Hammer}" Foreground="{DynamicResource OnAccentBrush}" Width="16" Height="16" />
              </Button>
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.RevertChangesTooltip}"
                      Command="{Binding ActiveProcedureDetail.RevertChangesCommand}" IsVisible="{Binding IsProcedureDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Undo}" />
              </Button>
              <Button Classes="primary" ToolTip.Tip="{x:Static app:UiStrings.TriggerCompileTooltip}"
                      Command="{Binding ActiveTriggerDetail.CompileCommand}" IsVisible="{Binding IsTriggerDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Hammer}" Foreground="{DynamicResource OnAccentBrush}" Width="16" Height="16" />
              </Button>
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.RevertChangesTooltip}"
                      Command="{Binding ActiveTriggerDetail.RevertChangesCommand}" IsVisible="{Binding IsTriggerDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Undo}" />
              </Button>
              <Button Classes="primary" ToolTip.Tip="{x:Static app:UiStrings.FunctionCompileTooltip}"
                      Command="{Binding ActiveFunctionDetail.CompileCommand}" IsVisible="{Binding IsFunctionDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Hammer}" Foreground="{DynamicResource OnAccentBrush}" Width="16" Height="16" />
              </Button>
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.RevertChangesTooltip}"
                      Command="{Binding ActiveFunctionDetail.RevertChangesCommand}" IsVisible="{Binding IsFunctionDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Undo}" />
              </Button>
              <!-- Generator: Compile / Revert / Delete (Compile auto-commits via the
                   autonomous DDL path, so no Commit/Rollback pair is shown for a generator tab). -->
              <Button Classes="primary" ToolTip.Tip="{x:Static app:UiStrings.GeneratorCompileTooltip}"
                      Command="{Binding ActiveGeneratorDetail.CompileCommand}" IsVisible="{Binding IsGeneratorDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Hammer}" Foreground="{DynamicResource OnAccentBrush}" Width="16" Height="16" />
              </Button>
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.RevertChangesTooltip}"
                      Command="{Binding ActiveGeneratorDetail.RevertChangesCommand}" IsVisible="{Binding IsGeneratorDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Undo}" />
              </Button>
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.GeneratorDeleteTooltip}"
                      Command="{Binding ActiveGeneratorDetail.DeleteCommand}" IsVisible="{Binding IsGeneratorDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Trash}" Foreground="{DynamicResource DangerIconBrush}" />
              </Button>
              <!-- Domain: Compile / Revert / Delete (Compile auto-commits via the
                   autonomous DDL path, so no Commit/Rollback pair is shown for a domain tab). -->
              <Button Classes="primary" ToolTip.Tip="{x:Static app:UiStrings.DomainCompileTooltip}"
                      Command="{Binding ActiveDomainDetail.CompileCommand}" IsVisible="{Binding IsDomainDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Hammer}" Foreground="{DynamicResource OnAccentBrush}" Width="16" Height="16" />
              </Button>
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.RevertChangesTooltip}"
                      Command="{Binding ActiveDomainDetail.RevertChangesCommand}" IsVisible="{Binding IsDomainDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Undo}" />
              </Button>
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.DomainDeleteTooltip}"
                      Command="{Binding ActiveDomainDetail.DeleteCommand}" IsVisible="{Binding IsDomainDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Trash}" Foreground="{DynamicResource DangerIconBrush}" />
              </Button>
              <!-- Package: Compile (header then body) / Revert / Delete. Compile
                   auto-commits via the autonomous DDL path, so no Commit/Rollback pair. -->
              <Button Classes="primary" ToolTip.Tip="{x:Static app:UiStrings.PackageCompileTooltip}"
                      Command="{Binding ActivePackageDetail.CompileCommand}" IsVisible="{Binding IsPackageDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Hammer}" Foreground="{DynamicResource OnAccentBrush}" Width="16" Height="16" />
              </Button>
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.RevertChangesTooltip}"
                      Command="{Binding ActivePackageDetail.RevertChangesCommand}" IsVisible="{Binding IsPackageDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Undo}" />
              </Button>
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.PackageDeleteConfirmYes}"
                      Command="{Binding ActivePackageDetail.DeleteCommand}" IsVisible="{Binding IsPackageDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Trash}" Foreground="{DynamicResource DangerIconBrush}" />
              </Button>
              <!-- Exception: Compile / Revert / Delete (Compile auto-commits via the
                   autonomous DDL path, so no Commit/Rollback pair is shown for an exception tab). -->
              <Button Classes="primary" ToolTip.Tip="{x:Static app:UiStrings.ExceptionCompileTooltip}"
                      Command="{Binding ActiveExceptionDetail.CompileCommand}" IsVisible="{Binding IsExceptionDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Hammer}" Foreground="{DynamicResource OnAccentBrush}" Width="16" Height="16" />
              </Button>
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.RevertChangesTooltip}"
                      Command="{Binding ActiveExceptionDetail.RevertChangesCommand}" IsVisible="{Binding IsExceptionDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Undo}" />
              </Button>
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.ExceptionDeleteTooltip}"
                      Command="{Binding ActiveExceptionDetail.DeleteCommand}" IsVisible="{Binding IsExceptionDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Trash}" Foreground="{DynamicResource DangerIconBrush}" />
              </Button>
              <!-- Index: Compile / Revert / Recompute statistics / Delete. Compile auto-commits
                   via the autonomous DDL path, so no Commit/Rollback pair. Delete greys out for
                   constraint-backed indexes (CanDelete = !IsConstraintBacked). -->
              <Button Classes="primary" ToolTip.Tip="{x:Static app:UiStrings.IndexCompileTooltip}"
                      Command="{Binding ActiveIndexDetail.CompileCommand}" IsVisible="{Binding IsIndexDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Hammer}" Foreground="{DynamicResource OnAccentBrush}" Width="16" Height="16" />
              </Button>
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.RevertChangesTooltip}"
                      Command="{Binding ActiveIndexDetail.RevertChangesCommand}" IsVisible="{Binding IsIndexDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Undo}" />
              </Button>
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.IndexRecomputeStatisticsTooltip}"
                      Command="{Binding ActiveIndexDetail.RecomputeStatisticsCommand}" IsVisible="{Binding IsIndexDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.RefreshCw}" />
              </Button>
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.IndexDeleteTooltip}"
                      Command="{Binding ActiveIndexDetail.DeleteCommand}" IsVisible="{Binding IsIndexDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Trash}" Foreground="{DynamicResource DangerIconBrush}" />
              </Button>
              <!-- Single unified Commit / Rollback pair (auto-routed to the open lane(s)). -->
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.TransactionCommitTooltip}"
                      Command="{Binding CommitAllCommand}" IsVisible="{Binding ShowTransactionButtons}">
                <controls:SvgIcon Data="{StaticResource Icon.Check}" Foreground="{DynamicResource SuccessIconBrush}" />
              </Button>
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.TransactionRollbackTooltip}"
                      Command="{Binding RollbackAllCommand}" IsVisible="{Binding ShowTransactionButtons}">
                <controls:SvgIcon Data="{StaticResource Icon.Undo}" Foreground="{DynamicResource DangerIconBrush}" />
              </Button>
              <Border Width="1" Margin="4,4" Background="{DynamicResource BorderBrush}"
                      IsVisible="{Binding ToolbarSep2Visible}" />

              <!-- ── SECTION 3 · Collection (unified router: New · Edit · Delete  |  ↑ ↓) ────────────
                   Tooltips are BOUND, not static: they name the active collection's own noun and carry the
                   gesture from CommandCatalog ("New field · F3" on a table's fields, "New parameter · F3" on
                   a procedure's arguments). They used to be the constants "Add item" / "Remove item", so the
                   toolbar and the context menu beside it described the same commands differently. -->
              <Button Classes="icon" ToolTip.Tip="{Binding CollectionAddTooltip}"
                      Command="{Binding AddCollectionItemCommand}" IsVisible="{Binding ShowCollectionTools}">
                <controls:SvgIcon Data="{StaticResource Icon.Plus}" />
              </Button>
              <!-- Edit was missing from the toolbar entirely while the fields context menu offered it. Shown
                   only where the active collection HAS an edit action (ShowCollectionEdit) — a grid edited in
                   place has none, and a permanently-greyed button teaches nothing. -->
              <Button Classes="icon" ToolTip.Tip="{Binding CollectionEditTooltip}"
                      Command="{Binding EditCollectionItemCommand}" IsVisible="{Binding ShowCollectionEdit}">
                <controls:SvgIcon Data="{StaticResource Icon.Pencil}" />
              </Button>
              <Button Classes="icon" ToolTip.Tip="{Binding CollectionRemoveTooltip}"
                      Command="{Binding RemoveCollectionItemCommand}" IsVisible="{Binding ShowCollectionTools}">
                <controls:SvgIcon Data="{StaticResource Icon.Minus}" />
              </Button>
              <Border Width="1" Margin="2,5" Opacity="0.45" Background="{DynamicResource BorderBrush}"
                      IsVisible="{Binding ShowCollectionReorder}" />
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.CollectionMoveUpTooltip}"
                      Command="{Binding MoveCollectionItemUpCommand}" IsVisible="{Binding ShowCollectionReorder}">
                <controls:SvgIcon Data="{StaticResource Icon.ArrowUp}" />
              </Button>
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.CollectionMoveDownTooltip}"
                      Command="{Binding MoveCollectionItemDownCommand}" IsVisible="{Binding ShowCollectionReorder}">
                <controls:SvgIcon Data="{StaticResource Icon.ArrowDown}" />
              </Button>
              <Border Width="1" Margin="4,4" Background="{DynamicResource BorderBrush}"
                      IsVisible="{Binding ToolbarSep3Visible}" />

              <!-- ── SECTION 4 · Helper actions ─────────────────────────────────────── -->
              <!-- SQL editor -->
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.ToolbarNewQueryTooltip}"
                      Command="{Binding NewQueryCommand}" IsVisible="{Binding IsQueryTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Plus}" />
              </Button>
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.ToolbarToggleQueryPanelTooltip}"
                      Command="{Binding ToggleQueryPanelCommand}" IsVisible="{Binding IsQueryTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.PanelRight}" />
              </Button>
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.ToolbarClearEditorTooltip}"
                      Command="{Binding ClearActiveEditorCommand}" IsVisible="{Binding IsQueryTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Eraser}" />
              </Button>
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.ToolbarFormatSqlTooltip}"
                      Command="{Binding FormatSqlCommand}" IsVisible="{Binding IsQueryTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Braces}" />
              </Button>
              <!-- Table Dane refresh + pagination live in the Dane sub-tab's own grid
                   toolbar (unified layout across all 5 data grids), not here. -->
              <!-- View: format -->
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.ToolbarFormatSqlTooltip}"
                      Command="{Binding ActiveViewDetail.FormatSqlCommand}" IsVisible="{Binding IsViewDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Braces}" />
              </Button>
              <!-- Procedure: execute / debug / format / comment / uncomment -->
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.ProcedureExecuteTooltip}"
                      Command="{Binding ActiveProcedureDetail.ExecuteProcedureCommand}" IsVisible="{Binding IsProcedureDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Play}" Foreground="{DynamicResource SuccessIconBrush}" />
              </Button>
              <!-- Debugger entry point (Stage X / D5) — same launch as the sidebar "Debug procedure…". -->
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.ProcedureDebugTooltip}"
                      Command="{Binding ActiveProcedureDetail.DebugProcedureCommand}" IsVisible="{Binding IsProcedureDetailTabActive}">
                <controls:DebuggerIcon />
              </Button>
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.ToolbarFormatSqlTooltip}"
                      Command="{Binding ActiveProcedureDetail.FormatSqlCommand}" IsVisible="{Binding IsProcedureDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Braces}" />
              </Button>
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.ProcedureCommentTooltip}"
                      Command="{Binding ActiveProcedureDetail.CommentBodyCommand}" IsVisible="{Binding IsProcedureDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Comment}" Foreground="{DynamicResource InfoIconBrush}" />
              </Button>
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.ProcedureUncommentTooltip}"
                      Command="{Binding ActiveProcedureDetail.UncommentBodyCommand}" IsVisible="{Binding IsProcedureDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Uncomment}" Foreground="{DynamicResource DangerIconBrush}" />
              </Button>
              <!-- Trigger: debug / format / comment / uncomment -->
              <!-- Debugger entry point (Stage X / D10) — same launch as the sidebar "Debug trigger…". -->
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.TriggerDebugTooltip}"
                      Command="{Binding ActiveTriggerDetail.DebugTriggerCommand}" IsVisible="{Binding IsTriggerDetailTabActive}">
                <controls:DebuggerIcon />
              </Button>
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.ToolbarFormatSqlTooltip}"
                      Command="{Binding ActiveTriggerDetail.FormatSqlCommand}" IsVisible="{Binding IsTriggerDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Braces}" />
              </Button>
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.ProcedureCommentTooltip}"
                      Command="{Binding ActiveTriggerDetail.CommentBodyCommand}" IsVisible="{Binding IsTriggerDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Comment}" Foreground="{DynamicResource InfoIconBrush}" />
              </Button>
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.ProcedureUncommentTooltip}"
                      Command="{Binding ActiveTriggerDetail.UncommentBodyCommand}" IsVisible="{Binding IsTriggerDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Uncomment}" Foreground="{DynamicResource DangerIconBrush}" />
              </Button>
              <!-- Function: execute / debug / format / comment / uncomment -->
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.FunctionExecuteTooltip}"
                      Command="{Binding ActiveFunctionDetail.ExecuteFunctionCommand}" IsVisible="{Binding IsFunctionDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Play}" Foreground="{DynamicResource SuccessIconBrush}" />
              </Button>
              <!-- Debugger entry point (D-function) — same launch as the sidebar "Debug function…"; the
                   function runs as the debug root (Return group in Variables). -->
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.FunctionDebugTooltip}"
                      Command="{Binding ActiveFunctionDetail.DebugFunctionCommand}" IsVisible="{Binding IsFunctionDetailTabActive}">
                <controls:DebuggerIcon />
              </Button>
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.ToolbarFormatSqlTooltip}"
                      Command="{Binding ActiveFunctionDetail.FormatSqlCommand}" IsVisible="{Binding IsFunctionDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Braces}" />
              </Button>
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.ProcedureCommentTooltip}"
                      Command="{Binding ActiveFunctionDetail.CommentBodyCommand}" IsVisible="{Binding IsFunctionDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Comment}" Foreground="{DynamicResource InfoIconBrush}" />
              </Button>
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.ProcedureUncommentTooltip}"
                      Command="{Binding ActiveFunctionDetail.UncommentBodyCommand}" IsVisible="{Binding IsFunctionDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Uncomment}" Foreground="{DynamicResource DangerIconBrush}" />
              </Button>
              <!-- Package: debug the selected Members-tab member (D15.3 Seam E) — the action lives on the
                   editor toolbar, like the procedure/trigger Debug buttons, rather than as a row inside the
                   Members tab. Reuses the ONE launch path (DebugSelectedMemberCommand); enabled only for a
                   debuggable selection; the contextual tooltip explains a disabled state. Wrapped in a
                   hit-testable Border so the tooltip shows even while the button is disabled (a disabled button
                   raises no pointer events). Pure presentation — no VM change (selection is tracked by the
                   Members TreeView's SelectedItem binding). -->
              <Border Background="Transparent" IsVisible="{Binding IsPackageDetailTabActive}"
                      ToolTip.Tip="{Binding ActivePackageDetail.DebugMemberTooltip}">
                <Button Classes="icon"
                        Command="{Binding ActivePackageDetail.DebugSelectedMemberCommand}"
                        ToolTip.Tip="{Binding ActivePackageDetail.DebugMemberTooltip}">
                  <controls:DebuggerIcon />
                </Button>
              </Border>
              <!-- Package: format / comment / uncomment (act on the active Package/Body editor) -->
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.ToolbarFormatSqlTooltip}"
                      Command="{Binding ActivePackageDetail.FormatSqlCommand}" IsVisible="{Binding IsPackageDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Braces}" />
              </Button>
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.ProcedureCommentTooltip}"
                      Command="{Binding ActivePackageDetail.CommentBodyCommand}" IsVisible="{Binding IsPackageDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Comment}" Foreground="{DynamicResource InfoIconBrush}" />
              </Button>
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.ProcedureUncommentTooltip}"
                      Command="{Binding ActivePackageDetail.UncommentBodyCommand}" IsVisible="{Binding IsPackageDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Uncomment}" Foreground="{DynamicResource DangerIconBrush}" />
              </Button>
              <Border Width="1" Margin="4,4" Background="{DynamicResource BorderBrush}"
                      IsVisible="{Binding ToolbarSep4Visible}" />

              <!-- ── SECTION 5 · Close tab (always last) ────────────────────────────── -->
              <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.ToolbarCloseTabTooltip}"
                      Command="{Binding CloseActiveTabCommand}" IsVisible="{Binding IsClosableTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.X}" />
              </Button>
            </StackPanel>
            </DockPanel>
          </Border>

          <!-- Editor area: SQL editor for Query tabs, DDL editor for DDL tabs.
               Right-side saved-queries panel collapses to zero width when toggled off. -->
          <Grid Grid.Row="2" Background="{DynamicResource BackgroundBrush}"
                ColumnDefinitions="*,Auto">
            <Grid Grid.Column="0">
              <ae:TextEditor x:Name="SqlEditor"
                             ShowLineNumbers="True"
                             FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                             FontSize="{DynamicResource Text.Code.Size}"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             Background="{DynamicResource BackgroundBrush}"
                             Foreground="{DynamicResource ForegroundBrush}"
                             IsVisible="{Binding IsQueryTabActive}" />
              <ae:TextEditor x:Name="DdlEditor"
                             ShowLineNumbers="True"
                             IsReadOnly="True"
                             FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                             FontSize="{DynamicResource Text.Code.Size}"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             Background="{DynamicResource BackgroundBrush}"
                             Foreground="{DynamicResource ForegroundBrush}"
                             IsVisible="{Binding IsDdlTabActive}" />
              <views:TableDetailTabView x:Name="TableDetailView"
                                        DataContext="{Binding ActiveTableDetail}"
                                        IsVisible="{Binding DataContext.IsTableDetailTabActive, ElementName=RootWindow}" />
              <views:NewTableTabView x:Name="NewTableView"
                                     DataContext="{Binding ActiveNewTable}"
                                     IsVisible="{Binding DataContext.IsNewTableTabActive, ElementName=RootWindow}" />
              <views:ViewDetailTabView x:Name="ViewDetailView"
                                       DataContext="{Binding ActiveViewDetail}"
                                       IsVisible="{Binding DataContext.IsViewDetailTabActive, ElementName=RootWindow}" />
              <views:ProcedureDetailTabView x:Name="ProcedureDetailView"
                                            DataContext="{Binding ActiveProcedureDetail}"
                                            IsVisible="{Binding DataContext.IsProcedureDetailTabActive, ElementName=RootWindow}" />
              <views:TriggerDetailTabView x:Name="TriggerDetailView"
                                          DataContext="{Binding ActiveTriggerDetail}"
                                          IsVisible="{Binding DataContext.IsTriggerDetailTabActive, ElementName=RootWindow}" />
              <views:FunctionDetailTabView x:Name="FunctionDetailView"
                                           DataContext="{Binding ActiveFunctionDetail}"
                                           IsVisible="{Binding DataContext.IsFunctionDetailTabActive, ElementName=RootWindow}" />
              <views:GeneratorDetailTabView x:Name="GeneratorDetailView"
                                            DataContext="{Binding ActiveGeneratorDetail}"
                                            IsVisible="{Binding DataContext.IsGeneratorDetailTabActive, ElementName=RootWindow}" />
              <views:DomainDetailTabView x:Name="DomainDetailView"
                                         DataContext="{Binding ActiveDomainDetail}"
                                         IsVisible="{Binding DataContext.IsDomainDetailTabActive, ElementName=RootWindow}" />
              <views:PackageDetailTabView x:Name="PackageDetailView"
                                          DataContext="{Binding ActivePackageDetail}"
                                          IsVisible="{Binding DataContext.IsPackageDetailTabActive, ElementName=RootWindow}" />
              <views:ExceptionDetailTabView x:Name="ExceptionDetailView"
                                            DataContext="{Binding ActiveExceptionDetail}"
                                            IsVisible="{Binding DataContext.IsExceptionDetailTabActive, ElementName=RootWindow}" />
              <views:IndexDetailTabView x:Name="IndexDetailView"
                                        DataContext="{Binding ActiveIndexDetail}"
                                        IsVisible="{Binding DataContext.IsIndexDetailTabActive, ElementName=RootWindow}" />
              <views:SecurityManagerTabView x:Name="SecurityManagerView"
                                            DataContext="{Binding ActiveSecurityManager}"
                                            IsVisible="{Binding DataContext.IsSecurityManagerTabActive, ElementName=RootWindow}" />
              <views:TraceMonitorTabView x:Name="TraceMonitorView"
                                         DataContext="{Binding ActiveTraceMonitor}"
                                         IsVisible="{Binding DataContext.IsTraceMonitorTabActive, ElementName=RootWindow}" />
              <views:SessionManagerTabView x:Name="SessionManagerView"
                                           DataContext="{Binding ActiveSessionManager}"
                                           IsVisible="{Binding DataContext.IsSessionManagerTabActive, ElementName=RootWindow}" />
              <views:GlobalSearchTabView x:Name="GlobalSearchView"
                                         DataContext="{Binding ActiveGlobalSearch}"
                                         IsVisible="{Binding DataContext.IsGlobalSearchTabActive, ElementName=RootWindow}" />
              <views:ScriptExecutorTabView x:Name="ScriptExecutorView"
                                           DataContext="{Binding ActiveScriptExecutor}"
                                           IsVisible="{Binding DataContext.IsScriptExecutorTabActive, ElementName=RootWindow}" />
              <views:DataImportTabView x:Name="DataImportView"
                                       DataContext="{Binding ActiveDataImport}"
                                       IsVisible="{Binding DataContext.IsDataImportTabActive, ElementName=RootWindow}" />
              <views:DebuggerTabView x:Name="DebuggerView"
                                     DataContext="{Binding ActiveDebugger}"
                                     IsVisible="{Binding DataContext.IsDebuggerTabActive, ElementName=RootWindow}" />
            </Grid>

            <!-- Saved queries panel (IBExpert-style) — visible only when the Query
                 tab is active AND the user hasn't toggled it off. ShowQueryPanel
                 combines both gates so DDL / TableDetail tabs hide the panel. -->
            <Border Grid.Column="1"
                    Width="200"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,0,0"
                    IsVisible="{Binding ShowQueryPanel}">
              <Grid RowDefinitions="Auto,Auto,*">
                <Border Grid.Row="0"
                        Padding="8,6"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{x:Static app:UiStrings.QueryPanelHeader}"
                               FontWeight="SemiBold"
                               FontSize="{DynamicResource Text.Compact.Size}"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                      <Button Classes="icon"
                              ToolTip.Tip="{x:Static app:UiStrings.ToolbarNewQueryTooltip}"
                              Command="{Binding NewQueryCommand}">
                        <controls:SvgIcon Data="{StaticResource Icon.Plus}" />
                      </Button>
                      <Button Classes="icon"
                              ToolTip.Tip="{x:Static app:UiStrings.QueryDeleteTooltip}"
                              Command="{Binding DeleteSelectedQueryCommand}">
                        <controls:SvgIcon Data="{StaticResource Icon.Trash}"
                                          Foreground="{DynamicResource WarningIconBrush}" />
                      </Button>
                      <Button Classes="icon"
                              ToolTip.Tip="{x:Static app:UiStrings.QueryClearAllTooltip}"
                              Command="{Binding ClearAllQueriesCommand}">
                        <controls:SvgIcon Data="{StaticResource Icon.ListX}"
                                          Foreground="{DynamicResource WarningIconBrush}" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>

                <TextBlock Grid.Row="1"
                           Text="{x:Static app:UiStrings.QueryPanelEmptyHint}"
                           Classes="subtle"
                           FontSize="{DynamicResource Text.Compact.Size}"
                           Margin="10,8"
                           TextWrapping="Wrap"
                           IsVisible="{Binding ShowQueryPanelEmptyHint}" />

                <ListBox Grid.Row="2"
                         ItemsSource="{Binding SavedQueries}"
                         SelectedItem="{Binding SelectedSavedQuery, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         IsVisible="{Binding HasSavedQueries}">
                  <ListBox.Styles>
                    <!-- Hover-visible rename icon: hidden by default, fades in when
                         the ListBoxItem under the cursor is hovered. Same convention
                         as IBExpert / DataGrip row-action affordances. -->
                    <Style Selector="Button.row-hover-icon">
                      <Setter Property="Opacity" Value="0" />
                    </Style>
                    <Style Selector="ListBoxItem:pointerover Button.row-hover-icon">
                      <Setter Property="Opacity" Value="1" />
                    </Style>
                  </ListBox.Styles>
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:SavedQueryViewModel">
                      <!-- Full-row hit target: Border with Stretch + transparent
                           background captures DoubleTapped + right-click ContextMenu
                           anywhere on the row, not just on the text glyphs. -->
                      <Border HorizontalAlignment="Stretch"
                              Background="Transparent"
                              DoubleTapped="OnSavedQueryNameDoubleTapped">
                        <Border.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="{x:Static app:UiStrings.QueryContextRename}"
                                      Icon="{app:MenuIcon Icon.Pencil}"
                                      Command="{Binding BeginRenameCommand}" />
                            <MenuItem Header="{x:Static app:UiStrings.QueryContextDelete}"
                                      Icon="{app:MenuIcon Icon.Trash, Brush=DangerIconBrush}"
                                      Command="{Binding DeleteCommand}" />
                          </ContextMenu>
                        </Border.ContextMenu>
                        <Panel>
                          <Grid ColumnDefinitions="*,Auto"
                                IsVisible="{Binding IsNotRenaming}">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Name}"
                                       FontSize="{DynamicResource Text.Compact.Size}"
                                       Padding="2,1"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Classes="icon row-hover-icon"
                                    ToolTip.Tip="{x:Static app:UiStrings.QueryRenameTooltip}"
                                    Padding="3,1"
                                    Command="{Binding BeginRenameCommand}">
                              <controls:SvgIcon Data="{StaticResource Icon.Pencil}"
                                                Width="13" Height="13" />
                            </Button>
                          </Grid>
                          <TextBox Text="{Binding EditingName, Mode=TwoWay}"
                                   FontSize="{DynamicResource Text.Compact.Size}"
                                   Padding="2,1"
                                   IsVisible="{Binding IsRenaming}"
                                   behaviors:FocusBehavior.FocusOnVisible="True"
                                   LostFocus="OnRenameTextBoxLostFocus"
                                   KeyDown="OnRenameTextBoxKeyDown" />
                        </Panel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
          </Grid>

          <!-- Transaction bar — status only. Commit/Rollback live on the editor toolbar. -->
          <Border Grid.Row="3"
                  Background="{DynamicResource PanelBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="0,1,0,0"
                  IsVisible="{Binding IsQueryTabActive}">
            <!-- ⭐ KONTEKST LOKALNY EDYTORA SQL — liczba instrukcji wykonanych w transakcji.
                 FAKT „transakcja jest otwarta" przejął w M3.1d chip w pasku statusu (§8.4.5), bo to
                 stan CAŁEJ aplikacji: ma być widoczny także w debuggerze i w edytorze obiektu, a ten
                 pasek jest bramkowany `IsQueryTabActive`. Licznik zostaje tutaj, bo ma sens dokładnie
                 tam, gdzie instrukcje są wykonywane.
                 ⛔ Nie przywracać kropek stanu ani etykiety „Active Transaction" — drugi właściciel
                 tego samego faktu (§0.1.2). -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="14,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding TransactionBarText}"
                         Classes="subtle"
                         Classes.error="{Binding IsTransactionError}"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- Resize handle between editor and results. Double-click resets to the
             default height. Hidden (with the results panel) on non-Query tabs. -->
        <GridSplitter Grid.Row="1"
                      x:Name="ResultsSplitter"
                      Height="4"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource BorderBrush}"
                      DoubleTapped="OnResultsSplitterDoubleTapped"
                      IsVisible="{Binding IsQueryTabActive}" />

        <!-- Bottom panel: Results / Messages tabs -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}"
                IsVisible="{Binding IsQueryTabActive}">
          <Grid>
          <!-- Maximize / restore the results panel — same action as double-clicking
               the splitter. Overlaid at the top-right of the tab strip. ChevronsUp
               = maximize (grow upward), ChevronsDown = restore. -->
          <Button Classes="icon"
                  ZIndex="1"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="0,2,6,0"
                  ToolTip.Tip="{x:Static app:UiStrings.ResultsPanelMaximizeTooltip}"
                  Click="OnToggleResultsMaximizeClick">
            <Panel>
              <controls:SvgIcon Data="{StaticResource Icon.ChevronsUp}" Width="14" Height="14"
                                IsVisible="{Binding !IsResultsMaximized}" />
              <controls:SvgIcon Data="{StaticResource Icon.ChevronsDown}" Width="14" Height="14"
                                IsVisible="{Binding IsResultsMaximized}" />
            </Panel>
          </Button>
          <TabControl SelectedIndex="{Binding SelectedBottomTabIndex, Mode=TwoWay}"
                      Padding="0">
            <TabItem Classes="bottom-tab" Header="{Binding ResultsLabel}">
              <!-- Rows: truncated banner · pagination+filter/agg toggles · filter panel ·
                   aggregation bar · grid(+empty hint). -->
              <Grid Background="{DynamicResource BackgroundBrush}" RowDefinitions="Auto,Auto,Auto,Auto,*">
                <!-- Truncated-Preview / ceiling notice bar (A.6): loud + actionable. Warning
                     accent, plain-language message, and a working [Load all rows] for a
                     truncated preview (hidden for a ceiling-hit Full — nothing more to load). -->
                <Border Grid.Row="0"
                        Background="{DynamicResource ChromeStrongBrush}"
                        BorderBrush="{DynamicResource WarningBrush}"
                        BorderThickness="0,0,0,2"
                        Padding="12,6"
                        IsVisible="{Binding ShowResultsNotice}">
                  <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Button Classes="flat" Padding="10,3"
                              Command="{Binding LoadAllRowsCommand}"
                              IsVisible="{Binding ShowLoadAllButton}"
                              Content="{x:Static app:UiStrings.ToolbarLoadAllRows}" />
                      <!-- Export all… — opens the shared Export dialog (Scope pre-selected to All rows).
                           Shown for both the truncated-preview and ceiling-hit bars (A.6). -->
                      <Button Classes="flat" Padding="10,3"
                              Command="{Binding ExportResultsCommand}"
                              Content="{x:Static app:UiStrings.ExportAllRowsButton}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <controls:SvgIcon Data="{StaticResource Icon.Exception}"
                                        Foreground="{DynamicResource WarningBrush}"
                                        Width="15" Height="15" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding ResultsNoticeText}"
                                 FontSize="{DynamicResource Text.Application.Size}" VerticalAlignment="Center"
                                 Foreground="{DynamicResource ForegroundBrush}" />
                    </StackPanel>
                  </DockPanel>
                </Border>
                <!-- Pagination bar — reuses the same first/prev/next/last icon
                     strings as the Table Data View. Client-side paging over the
                     materialized result set; the hint shows page + row counts. -->
                <Border Grid.Row="1"
                        Background="{DynamicResource ChromeStrongBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="6,2"
                        IsVisible="{Binding HasCurrentResult}">
                  <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Classes="icon"
                            ToolTip.Tip="{x:Static app:UiStrings.TableDetailPaginationFirstTooltip}"
                            Command="{Binding ResultFirstPageCommand}">
                      <controls:SvgIcon Data="{StaticResource Icon.ChevronFirst}" Width="14" Height="14" />
                    </Button>
                    <Button Classes="icon"
                            ToolTip.Tip="{x:Static app:UiStrings.TableDetailPaginationPreviousTooltip}"
                            Command="{Binding ResultPreviousPageCommand}">
                      <controls:SvgIcon Data="{StaticResource Icon.ChevronLeft}" Width="14" Height="14" />
                    </Button>
                    <Button Classes="icon"
                            ToolTip.Tip="{x:Static app:UiStrings.TableDetailPaginationNextTooltip}"
                            Command="{Binding ResultNextPageCommand}">
                      <controls:SvgIcon Data="{StaticResource Icon.ChevronRight}" Width="14" Height="14" />
                    </Button>
                    <Button Classes="icon"
                            ToolTip.Tip="{x:Static app:UiStrings.TableDetailPaginationLastTooltip}"
                            Command="{Binding ResultLastPageCommand}">
                      <controls:SvgIcon Data="{StaticResource Icon.ChevronLast}" Width="14" Height="14" />
                    </Button>
                    <TextBlock Text="{Binding ResultPaginationHint}"
                               Classes="subtle"
                               FontSize="{DynamicResource Text.Compact.Size}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ResultRecordInfo}"
                               Classes="subtle"
                               FontSize="{DynamicResource Text.Compact.Size}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                    <!-- Filter + aggregation toggles (right side of the pagination bar).
                         ToggleButtons so the "on" look tracks panel visibility, not focus. -->
                    <ToggleButton Classes="icon" Margin="12,0,0,0"
                            ToolTip.Tip="{x:Static app:UiStrings.FilterToggleTooltip}"
                            IsChecked="{Binding ResultFilterPanel.IsPanelOpen, Mode=TwoWay}">
                      <Panel>
                        <controls:SvgIcon Data="{StaticResource Icon.Filter}" Width="14" Height="14" />
                        <Border Classes="filter-active-dot" IsVisible="{Binding ResultFilterPanel.IsFilterActive}" />
                      </Panel>
                    </ToggleButton>
                    <ToggleButton Classes="icon"
                            ToolTip.Tip="{x:Static app:UiStrings.AggregationToggleTooltip}"
                            IsChecked="{Binding ResultAggregationBar.IsBarOpen, Mode=TwoWay}">
                      <controls:SvgIcon Data="{StaticResource Icon.Sigma}" Width="14" Height="14" />
                    </ToggleButton>
                    <!-- Export the results (opens the shared Export dialog, default Scope = All rows). -->
                    <Button Classes="icon"
                            ToolTip.Tip="{x:Static app:UiStrings.ExportResultsTooltip}"
                            Command="{Binding ExportResultsCommand}">
                      <controls:SvgIcon Data="{StaticResource Icon.Download}" Width="14" Height="14" />
                    </Button>
                  </StackPanel>
                </Border>
                <views:FilterPanelView Grid.Row="2" DataContext="{Binding ResultFilterPanel}" />
                <views:AggregationBarView Grid.Row="3" DataContext="{Binding ResultAggregationBar}" />
                <TextBlock Grid.Row="4"
                           Text="{Binding ResultsEmptyHint}"
                           Classes="subtle"
                           Margin="14,14,0,0"
                           IsVisible="{Binding ShowResultsEmptyHint}" />
                <DataGrid x:Name="ResultGrid"
                          Grid.Row="4"
                          behaviors:GridLayoutBehavior.GridId="QueryResults"
                          SelectionChanged="OnResultGridSelectionChanged"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          CanUserSortColumns="False"
                          CanUserResizeColumns="True"
                          CanUserReorderColumns="False"
                          ColumnWidth="Auto"
                          RowBackground="Transparent"
                          HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                          VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                          IsVisible="{Binding HasCurrentResult}">
                  <DataGrid.ContextMenu>
                    <ContextMenu Opening="OnResultContextMenuOpening">
                      <MenuItem Header="{x:Static app:UiStrings.GridCopyCell}"
                                Icon="{app:MenuIcon Icon.Copy}"
                                Click="OnCopyCellClick" />
                      <MenuItem Header="{x:Static app:UiStrings.GridCopyRow}"
                                Icon="{app:MenuIcon Icon.Copy}"
                                Click="OnCopyRowClick" />
                      <MenuItem Header="{x:Static app:UiStrings.GridCopyRowWithHeaders}"
                                Icon="{app:MenuIcon Icon.Copy}"
                                Click="OnCopyRowWithHeadersClick" />
                      <Separator />
                      <!-- Disabled-with-a-reason: the tooltip is bound unconditionally and is empty when
                           the action is available, so a greyed item always says WHY. (The shared menu style
                           keeps a disabled row READABLE rather than fading it out — that reason has to be
                           legible for the affordance to work.) -->
                      <MenuItem Header="{x:Static app:UiStrings.GridCopyAsInsert}"
                                Icon="{app:MenuIcon Icon.Query}"
                                Click="OnCopyAsInsertClick"
                                IsEnabled="{Binding SqlCopy.CanCopyAsInsert}"
                                ToolTip.Tip="{Binding SqlCopy.CopyAsInsertTooltip}" />
                      <MenuItem Header="{x:Static app:UiStrings.GridCopyAsUpdate}"
                                Icon="{app:MenuIcon Icon.Query}"
                                Click="OnCopyAsUpdateClick"
                                IsEnabled="{Binding SqlCopy.CanCopyAsUpdate}"
                                ToolTip.Tip="{Binding SqlCopy.CopyAsUpdateTooltip}" />
                      <Separator />
                      <MenuItem Header="{x:Static app:UiStrings.GridCopyAllWithHeaders}"
                                Icon="{app:MenuIcon Icon.Copy}"
                                Click="OnCopyAllWithHeadersClick" />
                      <MenuItem Header="{x:Static app:UiStrings.ExportResultsMenuItem}"
                                Icon="{app:MenuIcon Icon.Download}"
                                Command="{Binding ExportResultsCommand}" />
                      <Separator />
                      <MenuItem Header="{x:Static app:UiStrings.FilterByValue}"
                                Icon="{app:MenuIcon Icon.Filter}"
                                Click="OnResultFilterByValueClick" />
                      <MenuItem Header="{x:Static app:UiStrings.FilterExcludeValue}"
                                Icon="{app:MenuIcon Icon.ListX}"
                                Click="OnResultExcludeValueClick" />
                      <MenuItem x:Name="ResultFilterContainsItem"
                                Header="{x:Static app:UiStrings.FilterContainsValue}"
                                Icon="{app:MenuIcon Icon.Search}"
                                Click="OnResultFilterContainsClick" />
                    </ContextMenu>
                  </DataGrid.ContextMenu>
                </DataGrid>
              </Grid>
            </TabItem>
            <TabItem Classes="bottom-tab" Header="{Binding MessagesLabel}">
              <Grid Background="{DynamicResource BackgroundBrush}">
                <Grid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="{x:Static app:UiStrings.MessagesCopyAll}"
                              Icon="{app:MenuIcon Icon.Copy}"
                              Command="{Binding CopyAllMessagesCommand}" />
                    <MenuItem Header="{x:Static app:UiStrings.MessagesClear}"
                              Icon="{app:MenuIcon Icon.Eraser}"
                              Command="{Binding ClearMessagesCommand}" />
                  </ContextMenu>
                </Grid.ContextMenu>
                <TextBlock Text="{Binding MessagesEmptyHint}"
                           Classes="subtle"
                           Margin="14,14,0,0"
                           IsVisible="{Binding ShowMessagesEmptyHint}" />
                <ScrollViewer IsVisible="{Binding HasMessages}">
                  <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                      <!-- The Messages panel stays a LOG (timestamp column + scrolling rows) — deliberately
                           not a stack of MessageBanners. A problem entry borrows just enough of the IDE's
                           message language to be spotted instantly: the severity stripe and the severity
                           colour, both from the SAME MessageBanner.BrushKeyFor mapping (via the row VM), so
                           log and banner cannot drift. NO severity icon here: an icon column widens only the
                           rows that have one, so the timestamps stop lining up — and in a log, a column you
                           scan down matters more than a glyph. The stripe alone carries the signal. -->
                      <DataTemplate DataType="vm:QueryMessageViewModel">
                        <Border Padding="0,6,14,6"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                          <Grid ColumnDefinitions="3,80,*">
                            <Border Grid.Column="0" IsVisible="{Binding ShowSeverityMarker}">
                              <Border.Background>
                                <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                                  <Binding Path="SeverityBrushKey" />
                                  <Binding ElementName="RootWindow" Path="ActualThemeVariant" />
                                </MultiBinding>
                              </Border.Background>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding TimestampLabel}"
                                       Classes="subtle"
                                       FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                                       FontSize="{DynamicResource Text.Compact.Size}"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Top" />
                            <SelectableTextBlock Grid.Column="2"
                                       Text="{Binding Text}"
                                       FontSize="{DynamicResource Text.Application.Size}"
                                       LineHeight="18"
                                       TextWrapping="Wrap">
                              <SelectableTextBlock.Foreground>
                                <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                                  <Binding Path="MessageBrushKey" />
                                  <Binding ElementName="RootWindow" Path="ActualThemeVariant" />
                                </MultiBinding>
                              </SelectableTextBlock.Foreground>
                            </SelectableTextBlock>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </TabItem>
            <TabItem Classes="bottom-tab" Header="{Binding OutputLabel}">
              <Grid Background="{DynamicResource BackgroundBrush}" />
            </TabItem>
            <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.PerformanceTabHeader}">
              <views:PerformancePanelView DataContext="{Binding Performance}" />
            </TabItem>
            <!-- Diagnostics (Stage 7 / S4). Appended LAST on purpose: the bottom-tab index is
                 persisted in WorkspaceState and referenced by PerformanceBottomTabIndex, so
                 Results=0 / Messages=1 / Output=2 / Performance=3 must keep their positions. -->
            <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.BottomTabDiagnostics}">
              <views:DiagnosticsPanelView x:Name="SqlDiagnosticsPanel"
                                          DataContext="{Binding DiagnosticsPanel}" />
            </TabItem>
          </TabControl>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- Status bar -->
    <!-- ⚠ Wysokość z katalogu (`Size.StatusBar` = 24), nie literał. Do M3.1a stało tu 28, a token 24 nie
         miał w pasku statusu ani jednego konsumenta. Decyzja DA (użytkownik, 2026-08-02): stosujemy katalog —
         §8.5 specyfikacji zabrania WZROSTU paska, zmniejszenie jest dozwolone, a 36/26/24 to ratyfikowany
         rytm pionowy Application Chrome (§0.1.2). ⛔ Nie zwiększać. -->
    <!-- ⭐⭐ RAIL (§8.4.1) — to jest GÓRNA KRAWĘDŹ tego paska, nie nowy element. Linia była tu zawsze
         jako separator obszaru roboczego; rail nadaje jej PRACĘ: w spoczynku maluje się `BorderBrush`
         i pozostaje separatorem, a gdy coś się dzieje, przyjmuje kolor stanu o najwyższym priorytecie.
         Zero nowych pikseli, jeden element więcej znaczy (§3.3 specyfikacji — *every pixel has a purpose*).

         ⚠ Grubość jest STAŁA w każdym stanie (`Border.Rail`), więc zmiana stanu nie może przesunąć
         układu. ⛔ Nie zmieniać koloru CAŁEGO paska — użytkownik odrzucił model Visual Studio.
         ⚠ Kolor nie jest jedynym nośnikiem (§10): każdy stan ma też tekst albo ikonę w sekcji 2.
         Priorytet i uzasadnienie kolejności stoją przy `RailBrushKey`. -->
    <Border Grid.Row="3"
            Height="{DynamicResource Size.StatusBar}"
            Background="{DynamicResource PanelBrush}"
            BorderThickness="{DynamicResource Border.Rail}">
      <Border.BorderBrush>
        <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
          <Binding Path="RailBrushKey" />
          <Binding ElementName="RootWindow" Path="ActualThemeVariant" />
        </MultiBinding>
      </Border.BorderBrush>
      <!-- ⭐⭐ CZTERY SEKCJE (§8.4.3). Kolejność kolumn `Auto,*,Auto,Auto` jest WYMOGIEM STRUKTURALNYM,
           nie estetycznym: §8.5 specyfikacji żąda, żeby komunikaty nie zasłaniały informacji o połączeniu,
           a przy tym układzie rosnący komunikat zjada WYŁĄCZNIE elastyczną kolumnę 1. Wymóg jest spełniony
           przez układ, a nie przez ostrożność autora kolejnej zmiany.
           ⚠ Sekcje 3 (chipy stanu) i 4 (postęp) powstają w M3.1d–M3.1f; ich kolumny już tu są, żeby
           dołożenie zawartości nie przesuwało niczego, co użytkownik zdążył zapamiętać. -->
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="14,0">

        <!-- ── 1. POŁĄCZENIE — jedyne miejsce odpowiadające na „gdzie jestem podłączony?" ───────────── -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Ellipse Width="7" Height="7" Fill="{DynamicResource ConnectedBrush}" IsVisible="{Binding IsConnected}" />
          <Ellipse Width="7" Height="7" Fill="{DynamicResource SubtleForegroundBrush}" IsVisible="{Binding !IsConnected}" />
          <!-- ⭐⭐ NAZWA I ENDPOINT TO DWA RUNY W JEDNYM `TextBlocku`, A NIE DWA `TextBlocki` — i to jest
               naprawa przyczyny, nie kosmetyka (§19.3.1).

               Nazwa = element główny (§8.4.4): pełny kontrast + SemiBold. Endpoint = informacja podrzędna,
               mniejsza i wyciszona. Rozróżnienie wagi jest CAŁYM sensem tej sekcji — wcześniej stan
               połączenia i komunikat miały identyczną wagę, co audyt nazwał „Status Bar jest tylko
               miejscem na tekst".

               ⚠⚠ Ale dwa napisy o RÓŻNYCH ROZMIARACH, każdy we własnym `TextBlocku` z
               `VerticalAlignment="Center"`, wyrównują się PUDEŁKAMI, a nie liniami bazowymi. Zmierzone:
               linie bazowe rozjeżdżały się o 0,16 px w DIP — samo w sobie niewidoczne, ale pudełka miały
               różne wysokości (12 vs 11) i różne pozycje (6 vs 7), a `UseLayoutRounding` przycina KAŻDY
               ELEMENT OSOBNO do piksela urządzenia. Przy 125% te dwa topy lądują po różnych stronach
               zaokrąglenia i tekst widocznie „siada wyżej" — dokładnie to zgłosił użytkownik.

               ⭐ Run-y w jednym `TextBlocku` układa silnik tekstu na WSPÓLNEJ linii bazowej z konstrukcji:
               jedno pudełko, jedno zaokrąglenie, jedna linia. Zmierzone po zmianie: jeden baseline zamiast
               dwóch. ⛔ Nie rozdzielać tego z powrotem na dwa `TextBlocki` i nie „naprawiać" marginesem —
               nudge naprawiłby jedno DPI i zepsuł pozostałe.

               ⚠ `Classes="subtle"` nie działa na `Run`, więc kolor idzie `{DynamicResource}` wprost —
               nadal w pełni motywowalny. Odstęp niesie separator w `ConnectionEndpointLabel`, bo między
               runami nie ma `Spacing` kontenera. -->
          <TextBlock VerticalAlignment="Center">
            <Run Text="{Binding ConnectionDisplayName}"
                 FontSize="{DynamicResource Text.Status.Size}"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource ForegroundBrush}" />
            <!-- ⛔⛔ NIE PRÓBUJ WYŚRODKOWAĆ TEGO RUNU W PIONIE. Zmierzone w rundzie po M3.1f (§19.8),
                 bo użytkownik zgłosił, że endpoint „opada" — sprawdzone TRZY mechanizmy:

                   środek nazwy (11 px SemiBold)      8,54
                   środek endpointu — dziś (baseline) 8,83   → +0,30 px
                   środek endpointu — InlineUIContainer 7,50 → −1,04 px

                 ⚠⚠ `BaselineAlignment="Center"` na `Run` jest w Avalonii **IGNOROWANE** — per-run
                 baseline wychodzi identyczny (8,45) z nim i bez niego. Właściwość istnieje w API i nie
                 robi nic; wstawienie jej byłoby martwym kodem udającym poprawkę.
                 ⚠ `InlineUIContainer` DZIAŁA, ale przestrzeliwuje ponad trzykrotnie w drugą stronę.
                 ⚠ Dwa osobne `TextBlocki` z `VerticalAlignment="Center"` przywracają defekt DPI
                 z §19.3.3 (osobne zaokrąglenie na element; przy 125% cały piksel).

                 ⭐ Wniosek: obecne wyrównanie do linii bazowej jest NAJBLIŻSZE optycznego środka ze
                 wszystkiego, co jest dostępne. Wrażenie osiadania bierze się z tego, że nazwy połączeń
                 bywają WERSALIKAMI („GAL"), a endpoint jest minuskułą — to różnica wysokości wersalika
                 i x-height przy wspólnej linii bazowej, nie błąd wyrównania pudełek. -->
            <Run Text="{Binding ConnectionEndpointLabel}"
                 FontSize="{DynamicResource Text.Caption.Size}"
                 Foreground="{DynamicResource SubtleForegroundBrush}" />
          </TextBlock>
          <!-- DEV MODE — badge PRZY NAZWIE POŁĄCZENIA, bo jest własnością tego połączenia, a nie okna.
               Przeniesiony z paska tytułu w M3.1b (§19.3).

               ⚠ `Padding="4,1"` LOKALNIE I ŚWIADOMIE. Katalog nie ma roli dla paddingu chipa, a jedyny
               drugi element tego rodzaju (`AggregationBarView`, `8,2`) niesie inną wartość — nowa rola
               albo zmieniłaby tamten wygląd, albo powstałaby z JEDNEGO konsumenta wbrew R3. Wyjątek jest
               lepszy od błędnej roli (R12). Rozstrzygnięcie „czy chipy zasługują na wspólną rolę" należy
               do przeglądu §13.3, który zobaczy je wszystkie naraz.
               ⚠ Pion (1) jest nietykalny — wysokość badge'a i rozmiar fontu były w QA ocenione jako dobre;
               poziom zszedł 6 → 4, bo przy tekście 10 px Bold proporcja 6:1 czytała się jako zbyt szeroka
               (zgłoszenie użytkownika, QA M3.1b). -->
          <Border Background="{DynamicResource ConnectedBrush}"
                  CornerRadius="{DynamicResource Radius.Surface}" Padding="4,1"
                  VerticalAlignment="Center"
                  IsVisible="{Binding IsDeveloperModeActive}"
                  ToolTip.Tip="{x:Static app:UiStrings.DeveloperModeBadgeTooltip}">
            <TextBlock Text="{x:Static app:UiStrings.DeveloperModeBadge}"
                       FontSize="{DynamicResource Text.Caption.Size}" FontWeight="Bold"
                       Foreground="{DynamicResource DevModeBadgeForegroundBrush}" />
          </Border>
        </StackPanel>

        <!-- ── 2. KOMUNIKATY — kolumna elastyczna; wszystko, co ma coś do powiedzenia o BIEŻĄCEJ chwili ── -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                    Margin="20,0,0,0" VerticalAlignment="Center">

          <!-- Komunikat aplikacji z ikoną severity. ⚠ Mapowanie severity → pędzel i geometria czyta
               z `MessageBanner.BrushKeyFor`/`GeometryKeyFor` — tego samego, którym maluje się log Messages
               w edytorze SQL. ⛔ Zero drugiej definicji severity w aplikacji (§8.4.4). -->
          <controls:SvgIcon Width="{DynamicResource Size.Icon.Sm}" Height="{DynamicResource Size.Icon.Sm}"
                            IsVisible="{Binding HasStatusMessage}"
                            VerticalAlignment="Center"
                            Data="{Binding StatusMessageGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}">
            <controls:SvgIcon.Foreground>
              <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                <Binding Path="StatusMessageBrushKey" />
                <Binding ElementName="RootWindow" Path="ActualThemeVariant" />
              </MultiBinding>
            </controls:SvgIcon.Foreground>
          </controls:SvgIcon>
          <TextBlock Text="{Binding StatusMessage}"
                     IsVisible="{Binding HasStatusMessage}"
                     FontSize="{DynamicResource Text.Status.Size}"
                     TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding StatusMessage}"
                     VerticalAlignment="Center">
            <TextBlock.Foreground>
              <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                <Binding Path="StatusMessageBrushKey" />
                <Binding ElementName="RootWindow" Path="ActualThemeVariant" />
              </MultiBinding>
            </TextBlock.Foreground>
          </TextBlock>

          <!-- Kontekst AKTYWNEJ ZAKŁADKI: edytor SQL kładzie tu statystyki wykonania, debugger status sesji
               (UX Polish Seam 6a — wyprowadzony z paska debuggera, który potrzebował miejsca na Break on
               exception + Save). Każdy inny rodzaj zakładki zostawia to puste, a obie pozycje wykluczają się
               bramkami `IsVisible`. ⚠ VM debuggera jest nietknięty: `MainWindowViewModel` wystawia
               `ActiveDebugger`, a Avalonia subskrybuje `PropertyChanged` zagnieżdżonego VM wzdłuż ścieżki
               wiązania. ⛔ Status debuggera nigdy nie może być wpisywany w komunikat okna — to dwaj różni
               właściciele i właśnie ich zlanie w jedno było defektem H‑4. -->
          <TextBlock Text="{Binding QueryStatsText}"
                     IsVisible="{Binding IsQueryTabActive}"
                     Classes="subtle"
                     FontSize="{DynamicResource Text.Status.Size}"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding ActiveDebugger.StatusText}"
                     IsVisible="{Binding IsDebuggerTabActive}"
                     Classes="subtle"
                     Classes.error="{Binding ActiveDebugger.IsFaulted}"
                     FontSize="{DynamicResource Text.Status.Size}"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!-- ── 3. STAN — chipy współistniejące (§8.4.5). Trace i Debugger dochodzą w M3.1e ──────────── -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                    Margin="12,0,0,0" VerticalAlignment="Center">

          <!-- ⭐ CHIP TRANSAKCJI. Nieobecny, gdy transakcji nie ma — brak transakcji to stan domyślny
               i nie wymaga komunikatu (§8.4.5). Odpowiada GLOBALNIE na „czy mam otwartą transakcję
               i od jak dawna", niezależnie od aktywnej zakładki.
               ⚠⚠ TO NIE JEST PRZYCISK i nigdy nim nie będzie. Commit/Rollback zostają w toolbarze pod
               F6 / Shift+F6 — operacja nieodwracalna nie może stać w miejscu czytanym kątem oka. -->
          <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                      IsVisible="{Binding ShowTransactionChip}"
                      ToolTip.Tip="{Binding TransactionChipTooltip}">
            <!-- ⚠ 7×7 i Spacing 5 to WARTOŚCI LOKALNE ze świadomego wyboru.
                 Kropka jest GEOMETRIĄ (§18.0.5 ratyfikowało, że geometrii wychodzącej z arytmetyki
                 nie tokenizujemy) — katalog nie ma dla niej roli i mieć nie powinien.
                 ⚠ `Spacing="5"` to KOLIZJA, nie brak roli: `Space.Sm` niesie 6, czyli pasuje funkcją
                 i różni się o 1 px. Zamiana zmieniłaby wygląd chipa odebranego już przez użytkownika,
                 więc zgodnie z regułą etapu wartość zostaje z powodem, a kolizja idzie do rejestru
                 §18.R (K11). Rozstrzyga ją przegląd §13.3 — na komplecie chipów, nie na tym jednym. -->
            <Ellipse Width="7" Height="7" VerticalAlignment="Center">
              <Ellipse.Fill>
                <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                  <Binding Path="TransactionChipBrushKey" />
                  <Binding ElementName="RootWindow" Path="ActualThemeVariant" />
                </MultiBinding>
              </Ellipse.Fill>
            </Ellipse>
            <TextBlock Text="{Binding TransactionChipText}"
                       FontSize="{DynamicResource Text.Caption.Size}"
                       VerticalAlignment="Center">
              <TextBlock.Foreground>
                <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                  <Binding Path="TransactionChipBrushKey" />
                  <Binding ElementName="RootWindow" Path="ActualThemeVariant" />
                </MultiBinding>
              </TextBlock.Foreground>
            </TextBlock>
          </StackPanel>

          <!-- ⭐ CHIP DEBUGGERA (M3.1e). Prawdziwy, gdy sesja żyje GDZIEKOLWIEK — także na innej
               zakładce. ⛔ To nie dubluje `ActiveDebugger.StatusText` z sekcji 2: tamten jest
               bramkowany `IsDebuggerTabActive`, czyli znika dokładnie tam, gdzie fakt globalny zaczyna
               mieć znaczenie (§0.1.2). Etykieta = fakt, tooltip = szczegół (nazwa procedury + status).
               ⚠⚠ Kolor to `AccentIconBrush`, a NIE railowy `DebugCurrentLineBarBrush` — ten drugi jest
               półprzezroczysty i na tle paska daje 3,77:1, czyli poniżej progu §10 dla tekstu (4,5:1).
               Jako 2 px rail przechodzi (próg 3:1 dla elementu UI), jako napis nie. Zbieżność
               z trójkątem `DebuggerIcon` jest przy okazji zaletą — znak i napis czytają się jako
               jeden element. ⛔ Nie ujednolicać z railem bez ponownego policzenia kontrastu. -->
          <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                      IsVisible="{Binding IsDebugSessionLive}"
                      ToolTip.Tip="{Binding DebugChipTooltip}">
            <!-- Znak tożsamości debuggera (D15.2 Seam B) — kompozyt dwukolorowy w `Viewbox`, więc
                 skaluje się dowolnie. 12 px zrównuje go z ikoną severity w sekcji 2. -->
            <controls:DebuggerIcon Width="{DynamicResource Size.Icon.Sm}"
                                   Height="{DynamicResource Size.Icon.Sm}"
                                   VerticalAlignment="Center" />
            <TextBlock Text="{x:Static app:UiStrings.StatusBarDebugChipLabel}"
                       FontSize="{DynamicResource Text.Caption.Size}"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource AccentIconBrush}" />
          </StackPanel>

          <!-- ⭐ CHIP TRACE (M3.1e). `Icon.Activity` to znak tożsamości Monitora Aktywności — ten sam,
               który nosi jego zakładka i przycisk Monitoring; reuse-before-create.
               Kolor `IconColor_Query` zgodnie z railem (§8.4.2) — tu akurat próg §10 spełnia
               z zapasem (8,03:1 Dark / 6,58:1 Light), więc nie ma powodu go zmieniać.
               Tooltip czyta `TraceMonitorTabViewModel.StatusText` („Recording · 12/40 events”),
               czyli istniejące mapowanie stanu. ⛔ Zero drugiej definicji stanu Trace. -->
          <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                      IsVisible="{Binding IsTraceSessionLive}"
                      ToolTip.Tip="{Binding TraceChipTooltip}">
            <controls:SvgIcon Width="{DynamicResource Size.Icon.Sm}"
                              Height="{DynamicResource Size.Icon.Sm}"
                              VerticalAlignment="Center"
                              Data="{StaticResource Icon.Activity}"
                              Foreground="{DynamicResource IconColor_Query}" />
            <TextBlock Text="{x:Static app:UiStrings.StatusBarTraceChipLabel}"
                       FontSize="{DynamicResource Text.Caption.Size}"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource IconColor_Query}" />
          </StackPanel>
        </StackPanel>

        <!-- ── 4. POSTĘP (§8.4.6) — „co się teraz liczy" ────────────────────────────────────────────
             ⭐ GLOBALNA: operacja jest widoczna niezależnie od aktywnej zakładki. To trzecie
             zastosowanie tego samego podziału (§19.5.1, §19.6.1) — „Loading… N rows" to POSTĘP i mieszka
             tutaj, a „143 rows in 46 ms" to WYNIK i zostaje przy edytorze SQL w sekcji 2.
             ⚠⚠ Przycisk Cancel wiąże `Progress.CancelCommand`, czyli TEN SAM obiekt komendy, który
             naciska przycisk w toolbarze — dwa zasięgi jednej komendy, nie dwie implementacje. Zamyka to
             realną lukę: `ShowCancelButton` jest bramkowane `IsQueryTabActive`, więc przełączenie
             zakładki w trakcie długiego zapytania ODBIERAŁO możliwość anulowania.
             ⚠ Cancel w pasku statusu nie łamie §8.4.5 („chip nigdy nie jest przyciskiem") — tamten zakaz
             dotyczy operacji NIEODWRACALNEJ, a anulowanie jest zaworem bezpieczeństwa. -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8"
                    Margin="16,0,0,0" VerticalAlignment="Center"
                    IsVisible="{Binding Progress.IsRunning}">
          <TextBlock Text="{Binding Progress.Label}"
                     Classes="subtle"
                     FontSize="{DynamicResource Text.Caption.Size}"
                     VerticalAlignment="Center" />
          <ProgressBar Classes="status"
                       IsIndeterminate="{Binding Progress.IsIndeterminate}"
                       Minimum="0" Maximum="100"
                       Value="{Binding Progress.Percent}" />
          <!-- ⭐ Bez własnych `Width`/`Height`: `Button.icon` bierze wysokość chromy
               (`Size.ControlToolbar`) i nie ma podłogi szerokości, więc jego rozmiar wyznacza ikona,
               a wysokość — pasek, w którym stoi. To decyzja architektoniczna 2 z M2b („kontener
               rozstrzyga wielkość, element ją przyjmuje"); nadpisanie tutaj byłoby jej złamaniem. -->
          <Button Classes="icon"
                  Command="{Binding Progress.CancelCommand}"
                  IsVisible="{Binding Progress.HasCancel}"
                  ToolTip.Tip="{x:Static app:UiStrings.StatusBarCancelOperationTooltip}">
            <controls:SvgIcon Data="{StaticResource Icon.X}"
                              Width="{DynamicResource Size.Icon.Sm}"
                              Height="{DynamicResource Size.Icon.Sm}" />
          </Button>
        </StackPanel>

        <!-- ── zarezerwowane ────────────────────────────────────────────────────────────────────── -->
        <!-- ⛔ Nazwa aplikacji i numer wersji NIE wracają tutaj (decyzja D3) — mieszkają w oknie About,
             gdzie są tematem. Pasek statusu mówi, co dzieje się TERAZ; wersja nie zmienia się w sesji. -->
      </Grid>
    </Border>

  </Grid>
</Window>
