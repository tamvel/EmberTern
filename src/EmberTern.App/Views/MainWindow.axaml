<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EmberTern.App.ViewModels"
        xmlns:app="using:EmberTern.App"
        xmlns:views="using:EmberTern.App.Views"
        xmlns:controls="using:EmberTern.App.Controls"
        xmlns:behaviors="using:EmberTern.App.Behaviors"
        xmlns:ae="using:AvaloniaEdit"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="EmberTern.App.Views.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="EmberTern"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowDecorations="BorderOnly"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">

  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <Window.KeyBindings>
    <KeyBinding Gesture="F5" Command="{Binding ExecuteQueryCommand}" />
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding ExecuteQueryCommand}" />
    <KeyBinding Gesture="Alt+F" Command="{Binding FormatSqlCommand}" />
  </Window.KeyBindings>

  <Grid RowDefinitions="36,*,28">

    <!-- Custom titlebar: brand + active connection + connection toolbar + theme + window controls -->
    <Border Grid.Row="0"
            x:Name="Titlebar"
            Background="{DynamicResource ElevatedPanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            PointerPressed="OnTitleBarPointerPressed"
            DoubleTapped="OnTitleBarDoubleTapped">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">

        <!-- Brand + active connection name. Every item is VerticalAlignment=Center; the
             parent StackPanel is centered in the fixed 36px row, so all items share one
             vertical axis. No manual margin nudges. -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center" Margin="6,0,4,0">
          <!-- Sidebar collapse / restore toggle (VS Code style). One click hides
               the connections panel; one click brings it back at its last width. -->
          <Button Classes="icon"
                  ToolTip.Tip="{x:Static app:UiStrings.SidebarToggleTooltip}"
                  Click="OnToggleSidebarClick"
                  VerticalAlignment="Center">
            <controls:SvgIcon Data="{StaticResource Icon.PanelLeft}" />
          </Button>
          <!-- Square slot (source is 256x256) so Uniform fits exactly with no
               horizontal slop and the logo centre lines up with the text. -->
          <Image Source="avares://EmberTern/Assets/Branding/EmberTern_logo.png"
                 Width="26" Height="26"
                 Stretch="Uniform"
                 RenderOptions.BitmapInterpolationMode="HighQuality"
                 VerticalAlignment="Center" />
          <TextBlock Text="{Binding AppTitle}"
                     FontWeight="SemiBold" FontSize="13"
                     VerticalAlignment="Center" />
          <Border Width="1" Height="14"
                  Background="{DynamicResource BorderBrush}"
                  Margin="4,0"
                  VerticalAlignment="Center"
                  IsVisible="{Binding HasActiveConnection}" />
          <!-- Active DB name = key "where am I connected" info. Bold 14, full-contrast
               ForegroundBrush (white), plus a 2px ConnectedBrush underline (same green
               as the active-connection status) — Rider/DataGrip-style accent: instantly
               recognizable, no badge / glow / border / colored text. The underline is a
               stretched 2px Border inside a vertical StackPanel, so it spans exactly the
               name width. -->
          <StackPanel Orientation="Vertical" Spacing="2"
                      VerticalAlignment="Center"
                      IsVisible="{Binding HasActiveConnection}">
            <!-- MaxWidth + ellipsis so a very long profile name can't expand the
                 brand row and push the connection toolbar / window buttons off-screen.
                 Full name on hover. -->
            <TextBlock Text="{Binding ActiveConnectionName}"
                       FontWeight="Bold"
                       FontSize="14"
                       MaxWidth="260"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding ActiveConnectionName}"
                       Foreground="{DynamicResource ForegroundBrush}" />
            <Border Height="2"
                    HorizontalAlignment="Stretch"
                    Background="{DynamicResource ConnectedBrush}" />
          </StackPanel>
          <!-- Right separator: mirrors the left one so the connection name reads as its
               own section between the brand and the transaction-profile block. Same
               inline Border pattern (1px, 14 high, BorderBrush) used across the titlebar. -->
          <Border Width="1" Height="14"
                  Background="{DynamicResource BorderBrush}"
                  Margin="4,0"
                  VerticalAlignment="Center"
                  IsVisible="{Binding HasActiveConnection}" />
          <!-- Transaction-profile block: a 2x2 Grid (rows = Data / Meta). The Auto
               label column sizes to the wider of "Data:"/"Meta:", so both badges
               left-align in column 1. RowSpacing/ColumnSpacing give the gaps — no
               per-element margins. Whole block centered as a unit. -->
          <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto"
                RowSpacing="2" ColumnSpacing="4"
                VerticalAlignment="Center"
                IsVisible="{Binding HasActiveConnection}">
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{x:Static app:UiStrings.TransactionProfileDataLabel}"
                       FontSize="10" VerticalAlignment="Center" />
            <Border Grid.Row="0" Grid.Column="1"
                    Background="{DynamicResource DataLaneChipBrush}"
                    CornerRadius="2" Padding="4,0"
                    VerticalAlignment="Center"
                    ToolTip.Tip="{Binding DataTransactionProfileTooltip}">
              <TextBlock Text="{Binding DataProfileName}"
                         FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentBrush}" />
            </Border>
            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="{x:Static app:UiStrings.TransactionProfileMetadataLabel}"
                       FontSize="10" VerticalAlignment="Center" />
            <Border Grid.Row="1" Grid.Column="1"
                    Background="{DynamicResource MetadataLaneChipBrush}"
                    CornerRadius="2" Padding="4,0"
                    VerticalAlignment="Center"
                    ToolTip.Tip="{Binding MetadataTransactionProfileTooltip}">
              <TextBlock Text="{Binding MetadataProfileName}"
                         FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentBrush}" />
            </Border>
          </Grid>
        </StackPanel>

        <!-- Connection toolbar (moved from sidebar) -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2"
                    VerticalAlignment="Center" Margin="4,0,0,0">
          <!-- Leading divider between the brand/profile section and the toolbar.
               Same style as the toolbar's own group separators (1px, Margin 4,6). -->
          <Border Width="1" Margin="4,6" Background="{DynamicResource BorderBrush}" />
          <Button Classes="icon"
                  ToolTip.Tip="New Connection"
                  Click="OnNewConnectionClick">
            <controls:SvgIcon Data="{StaticResource Icon.Plus}" />
          </Button>
          <Button Classes="icon"
                  ToolTip.Tip="{x:Static app:UiStrings.FolderNewTooltip}"
                  Click="OnNewFolderClick">
            <controls:SvgIcon Data="{StaticResource Icon.FolderPlus}" />
          </Button>
          <Button Classes="icon"
                  ToolTip.Tip="Edit Connection"
                  Command="{Binding Metadata.EditSelectedCommand}">
            <controls:SvgIcon Data="{StaticResource Icon.Pencil}" />
          </Button>
          <Button Classes="icon"
                  ToolTip.Tip="Copy Connection"
                  Command="{Binding Metadata.CopySelectedCommand}">
            <controls:SvgIcon Data="{StaticResource Icon.Copy}" />
          </Button>
          <Button Classes="icon"
                  ToolTip.Tip="Delete Connection"
                  Command="{Binding Metadata.DeleteSelectedCommand}">
            <controls:SvgIcon Data="{StaticResource Icon.Trash}"
                              Foreground="{DynamicResource WarningIconBrush}" />
          </Button>
          <Border Width="1" Margin="4,6" Background="{DynamicResource BorderBrush}" />
          <Button Classes="icon"
                  ToolTip.Tip="Connect"
                  Command="{Binding Metadata.ConnectSelectedCommand}">
            <controls:SvgIcon Data="{StaticResource Icon.PlugZap}"
                              Foreground="{DynamicResource AccentIconBrush}" />
          </Button>
          <Button Classes="icon"
                  ToolTip.Tip="Disconnect"
                  Command="{Binding Metadata.DisconnectSelectedCommand}">
            <controls:SvgIcon Data="{StaticResource Icon.Unplug}" />
          </Button>
          <Button Classes="icon"
                  ToolTip.Tip="Reconnect"
                  Command="{Binding Metadata.ReconnectSelectedCommand}">
            <controls:SvgIcon Data="{StaticResource Icon.RotateCw}" />
          </Button>
          <Button Classes="icon"
                  ToolTip.Tip="{Binding Metadata.RefreshTooltip}"
                  Command="{Binding Metadata.RefreshCommand}">
            <controls:SvgIcon Data="{StaticResource Icon.RefreshCw}"
                              Foreground="{DynamicResource InfoIconBrush}" />
          </Button>
          <!-- Table-creation section sits AFTER all connection-related buttons.
               Icon ▦＋ mirrors the metadata tree's Table glyph with a plus —
               visually rhymes with the sidebar where new tables will appear. -->
          <Border Width="1" Margin="4,6" Background="{DynamicResource BorderBrush}" />
          <Button Classes="icon"
                  ToolTip.Tip="{x:Static app:UiStrings.ToolbarNewTableTooltip}"
                  Command="{Binding NewTableCommand}">
            <controls:SvgIcon Data="{StaticResource Icon.TablePlus}"
                              Foreground="{DynamicResource IconColor_Table}" />
          </Button>
          <Button Classes="icon"
                  ToolTip.Tip="{x:Static app:UiStrings.ToolbarNewViewTooltip}"
                  Command="{Binding NewViewCommand}">
            <controls:SvgIcon Data="{StaticResource Icon.ViewPlus}"
                              Foreground="{DynamicResource IconColor_View}" />
          </Button>
          <Button Classes="icon"
                  ToolTip.Tip="{x:Static app:UiStrings.ToolbarNewProcedureTooltip}"
                  Command="{Binding NewProcedureCommand}">
            <controls:SvgIcon Data="{StaticResource Icon.ProcedurePlus}"
                              Foreground="{DynamicResource IconColor_Procedure}" />
          </Button>
        </StackPanel>

        <!-- Drag spacer (column 2 = *) -->

        <!-- Theme toggle -->
        <Button Grid.Column="3" Classes="icon"
                ToolTip.Tip="{Binding ThemeToggleTooltip}"
                Click="OnThemeToggleClick"
                VerticalAlignment="Center"
                Margin="0,0,6,0">
          <controls:SvgIcon Data="{StaticResource Icon.ThemeToggle}" />
        </Button>

        <!-- Window controls -->
        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Stretch">
          <Button Classes="caption" Click="OnMinimizeClick" ToolTip.Tip="Minimize">
            <controls:SvgIcon Data="{StaticResource Icon.WindowMinimize}" Width="16" Height="16" />
          </Button>
          <Button Classes="caption" Click="OnMaxRestoreClick" ToolTip.Tip="Maximize / Restore"
                  x:Name="MaxRestoreButton">
            <controls:SvgIcon x:Name="MaxRestoreGlyph"
                              Data="{StaticResource Icon.WindowMaximize}"
                              Width="16" Height="16" />
          </Button>
          <Button Classes="caption close" Click="OnCloseClick" ToolTip.Tip="Close">
            <controls:SvgIcon Data="{StaticResource Icon.WindowClose}" Width="16" Height="16" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Main 3-zone body: sidebar | splitter | workspace+bottom.
         SidebarColumn width + the collapsed state persist in WorkspaceState; the
         native GridSplitter drives live resize within MinWidth/MaxWidth (220..600). -->
    <Grid Grid.Row="1" x:Name="MainBodyGrid">
      <Grid.ColumnDefinitions>
        <!-- SidebarColumn: reached in code-behind via MainBodyGrid.ColumnDefinitions[0]
             (x:Name isn't supported on Grid definitions in Avalonia). -->
        <ColumnDefinition Width="280" MinWidth="220" MaxWidth="600" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Sidebar — IBExpert-style connection tree -->
      <Border Grid.Column="0" x:Name="SidebarPanel" Background="{DynamicResource PanelBrush}">
        <DockPanel LastChildFill="True" DataContext="{Binding Metadata}">

          <!-- Filter -->
          <Border DockPanel.Dock="Top" Margin="8,6,8,4">
            <TextBox Text="{Binding FilterText, Mode=TwoWay}"
                     PlaceholderText="{Binding FilterPlaceholder}"
                     FontSize="12"
                     Padding="6,4" />
          </Border>

          <!-- Tree -->
          <TreeView ItemsSource="{Binding RootNodes}"
                    x:Name="SidebarTree"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectionChanged="OnSidebarTreeSelectionChanged">
            <!-- Virtualization at the nested level: a category can hold 2000+ leaves.
                 Without VSP, expanding Tables realizes ~2k TreeViewItems at once and the
                 UI freezes for ~1s. With VSP, only visible rows materialize. -->
            <TreeView.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </TreeView.ItemsPanel>
            <TreeView.Styles>
              <Style Selector="TreeViewItem">
                <Setter Property="ItemsPanel">
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </Setter>
              </Style>
              <!-- Drag-and-drop drop-target overlay. Templates use Classes="row-target"
                   as the base + Classes.drop-target="{Binding IsDropTarget}" toggle.
                   Background is driven by Style.Setter so the Boolean class can flip
                   between Transparent and the DropTarget overlay without each row
                   needing a LocalValue Background (LocalValue would beat Style). -->
              <Style Selector="Border.row-target">
                <Setter Property="Background" Value="Transparent" />
              </Style>
              <Style Selector="Border.row-target.drop-target">
                <Setter Property="Background" Value="{DynamicResource DropTargetBrush}" />
              </Style>
              <!-- ONE TreeViewItem container style. The `TreeViewItem` selector matches
                   EVERY item regardless of node type — x:DataType does NOT filter the
                   selector at runtime, it's only a compile-time hint for the binding.
                   The previous three concrete-typed styles therefore ALL applied to every
                   container, and the last one (MetadataNodeViewModel) won: for a connection
                   or folder node its compiled binding failed to cast the DataContext, the
                   IsExpanded setter resolved to UnsetValue, and it clobbered the correct
                   setter — so connection nodes never expanded (proven by the headless
                   ConnectionExpandBindingProbe: VM IsExpanded=true, container exists, but
                   container.IsExpanded stayed false). Fix: a single setter whose
                   ReflectionBinding resolves IsExpanded by name at runtime against whatever
                   VM is the DataContext — all three node types expose IsExpanded. IsVisible
                   exists only on MetadataNodeViewModel; FallbackValue keeps the other two
                   (which have no such property) visible. See gotcha #38. -->
              <Style Selector="TreeViewItem">
                <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
                <Setter Property="IsVisible" Value="{ReflectionBinding IsVisible, FallbackValue=True}" />
              </Style>
            </TreeView.Styles>

            <!-- BOTH templates live in DataTemplates so TreeView resolves per-type at
                 every nesting level. Setting TreeView.ItemTemplate to the ConnectionNode
                 template (even with DataType match) makes Avalonia 12 skip child template
                 lookup for nested MetadataNode items — categories rendered fine but their
                 own ItemsSource={Binding Children} didn't kick in, so chevrons never showed. -->
            <TreeView.DataTemplates>
              <TreeDataTemplate DataType="vm:FolderNodeViewModel"
                                ItemsSource="{Binding Connections}">
                <Border HorizontalAlignment="Stretch"
                        Classes="row-target"
                        Classes.drop-target="{Binding IsDropTarget}">
                  <Border.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="{x:Static app:UiStrings.FolderContextAddConnection}"
                                Command="{Binding AddConnectionCommand}" />
                      <Separator />
                      <MenuItem Header="{x:Static app:UiStrings.FolderContextRename}"
                                Command="{Binding BeginRenameCommand}" />
                      <MenuItem Header="{x:Static app:UiStrings.FolderContextDelete}"
                                Command="{Binding DeleteCommand}" />
                    </ContextMenu>
                  </Border.ContextMenu>
                  <Panel>
                    <StackPanel Orientation="Horizontal" Spacing="5"
                                IsVisible="{Binding IsNotRenaming}">
                      <controls:SvgIcon Data="{StaticResource Icon.Folder}"
                                        Width="15" Height="15"
                                        VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Name}"
                                 FontWeight="SemiBold"
                                 FontSize="11"
                                 VerticalAlignment="Center"
                                 DoubleTapped="OnFolderNameDoubleTapped" />
                    </StackPanel>
                    <TextBox Text="{Binding EditingName, Mode=TwoWay}"
                             FontSize="11"
                             Padding="2,1"
                             IsVisible="{Binding IsRenaming}"
                             behaviors:FocusBehavior.FocusOnVisible="True"
                             LostFocus="OnFolderRenameLostFocus"
                             KeyDown="OnFolderRenameKeyDown" />
                  </Panel>
                </Border>
              </TreeDataTemplate>

              <TreeDataTemplate DataType="vm:ConnectionNodeViewModel"
                                ItemsSource="{Binding Children}">
                <Border HorizontalAlignment="Stretch"
                        Classes="row-target"
                        Classes.drop-target="{Binding IsDropTarget}"
                        DoubleTapped="OnConnectionNodeDoubleTapped">
                  <Border.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Connect"
                                Command="{Binding ConnectCommand}"
                                IsVisible="{Binding !IsConnected}" />
                      <MenuItem Header="Disconnect"
                                Command="{Binding DisconnectCommand}"
                                IsVisible="{Binding IsConnected}" />
                      <Separator />
                      <MenuItem Header="Edit" Command="{Binding EditCommand}" />
                      <MenuItem Header="Copy" Command="{Binding CopyCommand}" />
                      <MenuItem Header="Delete" Command="{Binding DeleteCommand}" />
                      <Separator />
                      <MenuItem Header="{x:Static app:UiStrings.ConnectionContextSort}">
                        <MenuItem Header="{x:Static app:UiStrings.ConnectionContextSortAscending}"
                                  Command="{Binding SortAscendingCommand}" />
                        <MenuItem Header="{x:Static app:UiStrings.ConnectionContextSortDescending}"
                                  Command="{Binding SortDescendingCommand}" />
                      </MenuItem>
                    </ContextMenu>
                  </Border.ContextMenu>
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <!-- Connection (server) icon; color encodes status via StatusBrushKey
                         through IconBrushConverter: green connected, subtle disconnected.
                         Replaces the old ●/○ status glyph. -->
                    <controls:SvgIcon Data="{StaticResource Icon.Connection}"
                                      Width="15" Height="15"
                                      VerticalAlignment="Center">
                      <controls:SvgIcon.Foreground>
                        <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                          <Binding Path="StatusBrushKey" />
                          <Binding ElementName="RootWindow" Path="ActualThemeVariant" />
                        </MultiBinding>
                      </controls:SvgIcon.Foreground>
                    </controls:SvgIcon>
                    <TextBlock Text="{Binding DisplayName}"
                               FontWeight="SemiBold"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding DisplayName}"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </TreeDataTemplate>

              <TreeDataTemplate DataType="vm:MetadataNodeViewModel"
                                ItemsSource="{Binding Children}">
                <!-- Full-row hit target: Border with Stretch + transparent background. -->
                <Border HorizontalAlignment="Stretch"
                        Background="Transparent"
                        DoubleTapped="OnMetadataNodeDoubleTapped">
                  <Border.ContextMenu>
                    <ContextMenu>
                      <!-- Tables category → New Table. -->
                      <MenuItem Header="{x:Static app:UiStrings.MetadataContextNewTable}"
                                Command="{Binding NewTableCommand}"
                                IsVisible="{Binding IsTableGroup}" />
                      <!-- Table leaf → Open / Design / Delete. Open + Design
                           both route through OpenDdl (TableDetail tab). -->
                      <MenuItem Header="{x:Static app:UiStrings.MetadataContextOpenTable}"
                                Command="{Binding OpenDdlCommand}"
                                IsVisible="{Binding IsTableLeaf}" />
                      <MenuItem Header="{x:Static app:UiStrings.MetadataContextDesignTable}"
                                Command="{Binding OpenDdlCommand}"
                                IsVisible="{Binding IsTableLeaf}" />
                      <Separator IsVisible="{Binding IsTableLeaf}" />
                      <MenuItem Header="{x:Static app:UiStrings.MetadataContextDeleteTable}"
                                Command="{Binding DeleteTableCommand}"
                                IsVisible="{Binding IsTableLeaf}" />
                      <Separator IsVisible="{Binding IsTableLeaf}" />
                      <!-- Generic actions for every actionable leaf (incl. tables). -->
                      <MenuItem Header="{Binding ContextOpenDdlLabel}"
                                Command="{Binding OpenDdlCommand}"
                                IsVisible="{Binding IsActionable}" />
                      <MenuItem Header="{Binding ContextCopyNameLabel}"
                                Command="{Binding CopyNameCommand}"
                                IsVisible="{Binding IsActionable}" />
                    </ContextMenu>
                  </Border.ContextMenu>
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <!-- Per-kind SVG icon (Lucide, DataGrip-style). Shape resolves from the
                         geometry key via IconGeometryConverter (theme-invariant); color
                         resolves the per-kind resource key against the *current* theme via
                         IconBrushConverter, with the ActualThemeVariant binding forcing
                         re-evaluation on theme toggle. Hidden for placeholders (empty key). -->
                    <controls:SvgIcon Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}"
                                      Width="15" Height="15"
                                      VerticalAlignment="Center"
                                      IsVisible="{Binding !IsPlaceholder}">
                      <controls:SvgIcon.Foreground>
                        <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                          <Binding Path="IconResourceKey" />
                          <Binding ElementName="RootWindow" Path="ActualThemeVariant" />
                        </MultiBinding>
                      </controls:SvgIcon.Foreground>
                    </controls:SvgIcon>
                    <TextBlock Text="{Binding DisplayLabel}"
                               VerticalAlignment="Center"
                               Classes.subtle="{Binding IsPlaceholder}"
                               FontSize="11" />
                    <TextBlock Text="…"
                               Classes="subtle"
                               FontSize="10"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsLoading}" />
                  </StackPanel>
                </Border>
              </TreeDataTemplate>
            </TreeView.DataTemplates>
          </TreeView>
        </DockPanel>
      </Border>

      <!-- Resize handle between sidebar and workspace (visible when expanded).
           Double-click collapses the sidebar; the seam is wider than 1px for a
           comfortable grab. When collapsed it hides and the rail below takes over
           the same Auto column. -->
      <GridSplitter Grid.Column="1"
                    x:Name="SidebarSplitter"
                    Width="4"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"
                    Background="{DynamicResource BorderBrush}"
                    DoubleTapped="OnSidebarSplitterDoubleTapped" />

      <!-- Left-edge grab rail, shown only while collapsed (sidebar column = 0px,
           so this sits flush against the window's left edge). One click re-expands
           the sidebar to its last width. Shares column 1 with the splitter; only
           one of the two is visible at a time so the Auto column sizes to it. -->
      <!-- A Border, not a Button: a Button swallows PointerPressed in its class
           handler (so the press never reaches our handler) and its Click needs
           press+release on the same 12px strip (drift cancels it → "works on the
           Nth try"). The Border reacts on PointerPressed and re-expands reliably. -->
      <Border Grid.Column="1"
              x:Name="SidebarRail"
              Classes="sidebar-rail"
              IsVisible="False"
              ToolTip.Tip="{x:Static app:UiStrings.SidebarExpandTooltip}"
              PointerPressed="OnSidebarRailPointerPressed">
        <TextBlock Text="›"
                   FontSize="11"
                   Foreground="{DynamicResource SubtleForegroundBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
      </Border>

      <!-- Workspace + bottom panel. The results row is resizable via a native
           GridSplitter; ResultsRow.Height persists in WorkspaceState. On DDL /
           TableDetail tabs the splitter + results hide and ResultsRow collapses
           to 0 (managed in code-behind off IsQueryTabActive) so the editor fills. -->
      <Grid Grid.Column="2" x:Name="WorkspaceGrid">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <!-- ResultsRow: reached via WorkspaceGrid.RowDefinitions[2] in code-behind. -->
          <RowDefinition Height="280" MinHeight="120" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" RowDefinitions="Auto,Auto,*,Auto">

          <!-- Tab strip — WrapPanel so overflow flows to a second row (IBExpert style)
               instead of horizontal scrolling. Auto-height (Grid row was 36; we replaced
               it with Auto on the parent below). -->
          <Border Grid.Row="0"
                  Background="{DynamicResource PanelBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="0,0,0,1">
            <ItemsControl ItemsSource="{Binding WorkspaceTabs}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:WorkspaceTabViewModel">
                  <Border BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="0,0,1,0"
                          Background="{DynamicResource PanelBrush}"
                          Classes.active-tab="{Binding IsSelected}">
                    <Border.Styles>
                      <Style Selector="Border.active-tab">
                        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
                      </Style>
                      <!-- Active tab title: SemiBold + full-contrast (only the selected
                           tab; inactive tabs untouched). Pairs with the 2px accent top
                           line for a clear Rider/DataGrip active-tab read. -->
                      <Style Selector="Border.active-tab TextBlock">
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                      </Style>
                    </Border.Styles>
                    <!-- Rider/DataGrip-style active-tab indicator: a 2px accent line at
                         the top of the SELECTED tab. The 2px row is always reserved so
                         active/inactive tabs keep identical height + content baseline;
                         only the selected tab paints the accent (over the existing
                         background swap, which alone read too subtly). -->
                    <Grid RowDefinitions="2,*">
                      <Border Grid.Row="0"
                              Background="{DynamicResource AccentBrush}"
                              IsVisible="{Binding IsSelected}" />
                      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="0">
                      <Button Classes="flat"
                              Padding="8,4"
                              Background="Transparent"
                              BorderThickness="0"
                              Command="{Binding ActivateCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <controls:SvgIcon Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}"
                                            Width="14" Height="14"
                                            VerticalAlignment="Center">
                            <controls:SvgIcon.Foreground>
                              <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                                <Binding Path="IconResourceKey" />
                                <Binding ElementName="RootWindow" Path="ActualThemeVariant" />
                              </MultiBinding>
                            </controls:SvgIcon.Foreground>
                          </controls:SvgIcon>
                          <TextBlock Text="{Binding DisplayTitle}"
                                     FontSize="11"
                                     VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Button Classes="icon"
                              Padding="4,2"
                              Margin="0,0,3,0"
                              Background="Transparent"
                              BorderThickness="0"
                              ToolTip.Tip="Close tab"
                              IsVisible="{Binding IsClosable}"
                              Command="{Binding CloseCommand}">
                        <controls:SvgIcon Data="{StaticResource Icon.X}" Width="12" Height="12" />
                      </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>

          <!-- Editor toolbar. Final order (per V1.1 spec):
                 ▶ Execute | ⏹ Cancel | ✓ Commit | ✕ Rollback | sep |
                 + New query | ▤ Toggle panel | 🗑 Clear editor | ⎄ Format SQL | ✕ Close tab
               Commit/Rollback moved here from the transaction bar — that strip is
               status-only now (dot + text), no duplicate buttons. -->
          <Border Grid.Row="1"
                  Background="{DynamicResource PanelBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="10,4" VerticalAlignment="Center">
              <Button Classes="primary"
                      Padding="10,4"
                      Command="{Binding ExecuteQueryCommand}"
                      IsVisible="{Binding ShowExecuteButton}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <controls:SvgIcon Data="{StaticResource Icon.Play}"
                                    Foreground="{DynamicResource OnAccentBrush}"
                                    Width="14" Height="14" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding ExecuteLabel}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding ExecuteHint}"
                             FontSize="10"
                             Foreground="{DynamicResource OnAccentSubtleBrush}"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="flat"
                      Padding="10,4"
                      Command="{Binding CancelQueryCommand}"
                      IsVisible="{Binding ShowCancelButton}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <controls:SvgIcon Data="{StaticResource Icon.Stop}"
                                    Foreground="{DynamicResource DangerIconBrush}"
                                    Width="14" Height="14" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding CancelLabel}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <!-- Single unified Commit / Rollback pair. The app auto-routes each
                   statement to the Data or Metadata lane, so the user never picks a
                   lane: Commit settles every open lane, Rollback reverts every
                   active/error lane (both, when both are open). Enabled state follows
                   the actual transaction(s); visibility follows the tab as before. -->
              <Button Classes="icon"
                      ToolTip.Tip="{x:Static app:UiStrings.TransactionCommitTooltip}"
                      Command="{Binding CommitAllCommand}"
                      IsVisible="{Binding ShowTransactionButtons}">
                <controls:SvgIcon Data="{StaticResource Icon.Check}"
                                  Foreground="{DynamicResource SuccessIconBrush}" />
              </Button>
              <Button Classes="icon"
                      ToolTip.Tip="{x:Static app:UiStrings.TransactionRollbackTooltip}"
                      Command="{Binding RollbackAllCommand}"
                      IsVisible="{Binding ShowTransactionButtons}">
                <controls:SvgIcon Data="{StaticResource Icon.Undo}"
                                  Foreground="{DynamicResource DangerIconBrush}" />
              </Button>
              <!-- Refresh reuses the Dane sub-tab's existing reload path (with current
                   sort params). Visible only when the Dane sub-tab is active inside a
                   TableDetail tab. -->
              <Button Classes="icon"
                      ToolTip.Tip="{x:Static app:UiStrings.ToolbarRefreshDataTooltip}"
                      Command="{Binding RefreshDataPreviewCommand}"
                      IsVisible="{Binding IsDataTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.RefreshCw}"
                                  Foreground="{DynamicResource InfoIconBrush}" />
              </Button>
              <!-- Buffered Table Designer. ⚡ Compile + ⟲ Discard apply / abandon the
                   queued structural changes and are valid on EVERY TableDetail sub-tab
                   (ShowStructureCompileTools). The Pola-specific cluster (toggle / Add /
                   Drop / Move) below stays on ShowFieldEditTools (Pola sub-tab only).
                   NOTHING runs DDL on click — a structural edit only mutates the working
                   model + queues a change; Compile runs the whole batch in one autonomous
                   auto-committed transaction. Read-only system tables hide the cluster. -->
              <Border Width="1" Margin="4,4"
                      Background="{DynamicResource BorderBrush}"
                      IsVisible="{Binding ShowStructureCompileTools}" />
              <!-- Compile is the primary structural action — accent-filled primary style
                   + hammer (build) icon, mirroring the SQL Execute button. Enabled only
                   when there are pending changes (CompileCommand.CanExecute). -->
              <Button Classes="primary"
                      Padding="8,4"
                      ToolTip.Tip="{x:Static app:UiStrings.FieldEditCompileTooltip}"
                      Command="{Binding ActiveTableDetail.CompileCommand}"
                      IsVisible="{Binding ShowStructureCompileTools}">
                <controls:SvgIcon Data="{StaticResource Icon.Hammer}"
                                  Foreground="{DynamicResource OnAccentBrush}"
                                  Width="16" Height="16" />
              </Button>
              <Button Classes="icon"
                      ToolTip.Tip="{x:Static app:UiStrings.FieldEditDiscardTooltip}"
                      Command="{Binding ActiveTableDetail.DiscardPendingChangesCommand}"
                      IsVisible="{Binding ShowStructureCompileTools}">
                <controls:SvgIcon Data="{StaticResource Icon.Undo}" />
              </Button>
              <!-- Inline-edit toggle. Off by default on existing tables — explicit
                   opt-in stops accidental schema edits from a misclick. Highlights
                   when active via Classes="active-toggle" toggled below. -->
              <ToggleButton Classes="icon"
                            ToolTip.Tip="{x:Static app:UiStrings.ToolbarToggleFieldEditTooltip}"
                            IsChecked="{Binding ActiveTableDetail.IsFieldEditMode, Mode=TwoWay}"
                            IsVisible="{Binding ShowFieldEditTools}">
                <controls:SvgIcon Data="{StaticResource Icon.PencilRuler}" />
              </ToggleButton>
              <Button Classes="icon"
                      ToolTip.Tip="{x:Static app:UiStrings.FieldEditAddTooltip}"
                      Command="{Binding ActiveTableDetail.AddFieldCommand}"
                      IsVisible="{Binding ShowFieldEditTools}">
                <controls:SvgIcon Data="{StaticResource Icon.Plus}" />
              </Button>
              <Button Classes="icon"
                      ToolTip.Tip="{x:Static app:UiStrings.FieldEditDropTooltip}"
                      Command="{Binding ActiveTableDetail.DropFieldCommand}"
                      IsVisible="{Binding ShowFieldEditTools}">
                <controls:SvgIcon Data="{StaticResource Icon.Minus}" />
              </Button>
              <Button Classes="icon"
                      ToolTip.Tip="{x:Static app:UiStrings.FieldEditMoveUpTooltip}"
                      Command="{Binding ActiveTableDetail.MoveFieldUpCommand}"
                      IsVisible="{Binding ShowFieldEditTools}">
                <controls:SvgIcon Data="{StaticResource Icon.ArrowUp}" />
              </Button>
              <Button Classes="icon"
                      ToolTip.Tip="{x:Static app:UiStrings.FieldEditMoveDownTooltip}"
                      Command="{Binding ActiveTableDetail.MoveFieldDownCommand}"
                      IsVisible="{Binding ShowFieldEditTools}">
                <controls:SvgIcon Data="{StaticResource Icon.ArrowDown}" />
              </Button>
              <!-- ⚡ Compile + grid row commands for the New Table tab. All five
                   visible only when the New Table tab is active. The grid itself
                   carries no inline toolbar — these are the only entry points. -->
              <!-- New Table compile = create the table; the screen's primary action.
                   Same accent-filled primary + hammer + label treatment as Pola. -->
              <Button Classes="primary"
                      Padding="8,4"
                      ToolTip.Tip="{x:Static app:UiStrings.NewTableDialogCompile}"
                      Command="{Binding ActiveNewTable.CompileCommand}"
                      IsVisible="{Binding IsNewTableTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Hammer}"
                                  Foreground="{DynamicResource OnAccentBrush}"
                                  Width="16" Height="16" />
              </Button>
              <Button Classes="icon"
                      ToolTip.Tip="{x:Static app:UiStrings.NewTableAddRowTooltip}"
                      Command="{Binding ActiveNewTable.AddFieldCommand}"
                      IsVisible="{Binding IsNewTableTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Plus}" />
              </Button>
              <Button Classes="icon"
                      ToolTip.Tip="{x:Static app:UiStrings.NewTableDeleteRowTooltip}"
                      Command="{Binding ActiveNewTable.DeleteFieldCommand}"
                      IsVisible="{Binding IsNewTableTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Minus}" />
              </Button>
              <Button Classes="icon"
                      ToolTip.Tip="{x:Static app:UiStrings.NewTableMoveUpTooltip}"
                      Command="{Binding ActiveNewTable.MoveFieldUpCommand}"
                      IsVisible="{Binding IsNewTableTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.ArrowUp}" />
              </Button>
              <Button Classes="icon"
                      ToolTip.Tip="{x:Static app:UiStrings.NewTableMoveDownTooltip}"
                      Command="{Binding ActiveNewTable.MoveFieldDownCommand}"
                      IsVisible="{Binding IsNewTableTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.ArrowDown}" />
              </Button>
              <!-- ⚡ Compile for a View Detail tab (CREATE OR ALTER VIEW). Visible
                   on any view sub-tab; always acts on the editable SQL source. -->
              <Button Classes="primary"
                      Padding="8,4"
                      ToolTip.Tip="{x:Static app:UiStrings.ViewCompileTooltip}"
                      Command="{Binding ActiveViewDetail.CompileCommand}"
                      IsVisible="{Binding IsViewDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Hammer}"
                                  Foreground="{DynamicResource OnAccentBrush}"
                                  Width="16" Height="16" />
              </Button>
              <!-- Format SQL for the View source — reuses the shared SqlFormatter
                   (same Icon.Braces + tooltip as the SQL Editor's format button). -->
              <Button Classes="icon"
                      ToolTip.Tip="{x:Static app:UiStrings.ToolbarFormatSqlTooltip}"
                      Command="{Binding ActiveViewDetail.FormatSqlCommand}"
                      IsVisible="{Binding IsViewDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Braces}" />
              </Button>
              <!-- Procedure Detail: Source ⇄ Easy mode toggle (checked = Easy).
                   Disabled for a brand-new procedure (Source only — no catalog to
                   seed Easy mode). -->
              <ToggleButton Classes="icon"
                            ToolTip.Tip="{x:Static app:UiStrings.ProcedureModeToggleTooltip}"
                            IsChecked="{Binding ActiveProcedureDetail.EasyMode, Mode=TwoWay}"
                            IsEnabled="{Binding ActiveProcedureDetail.CanUseEasyMode}"
                            IsVisible="{Binding IsProcedureDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.PencilRuler}" />
              </ToggleButton>
              <!-- ⚡ Compile for a Procedure Detail tab (CREATE OR ALTER PROCEDURE).
                   Acts on the active mode (Easy → reassembled; Source → raw text). -->
              <Button Classes="primary"
                      Padding="8,4"
                      ToolTip.Tip="{x:Static app:UiStrings.ProcedureCompileTooltip}"
                      Command="{Binding ActiveProcedureDetail.CompileCommand}"
                      IsVisible="{Binding IsProcedureDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Hammer}"
                                  Foreground="{DynamicResource OnAccentBrush}"
                                  Width="16" Height="16" />
              </Button>
              <!-- Execute Procedure (Data lane, parameterized) — primary action,
                   green accent so it reads as "run" at a glance. -->
              <Button Classes="icon"
                      ToolTip.Tip="{x:Static app:UiStrings.ProcedureExecuteTooltip}"
                      Command="{Binding ActiveProcedureDetail.ExecuteProcedureCommand}"
                      IsVisible="{Binding IsProcedureDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Play}"
                                  Foreground="{DynamicResource SuccessIconBrush}" />
              </Button>
              <!-- Format SQL — the single shared SqlFormatter (now PSQL-aware:
                   BEGIN/END indentation, CASE…END kept inline, idempotent). -->
              <Button Classes="icon"
                      ToolTip.Tip="{x:Static app:UiStrings.ToolbarFormatSqlTooltip}"
                      Command="{Binding ActiveProcedureDetail.FormatSqlCommand}"
                      IsVisible="{Binding IsProcedureDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Braces}" />
              </Button>
              <!-- Comment Body (blue) / Uncomment Body (red) — wrap the outer
                   BEGIN…END in /* */. Distinct colours so the action is identifiable
                   without the tooltip. -->
              <Button Classes="icon"
                      ToolTip.Tip="{x:Static app:UiStrings.ProcedureCommentTooltip}"
                      Command="{Binding ActiveProcedureDetail.CommentBodyCommand}"
                      IsVisible="{Binding IsProcedureDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Comment}"
                                  Foreground="{DynamicResource InfoIconBrush}" />
              </Button>
              <Button Classes="icon"
                      ToolTip.Tip="{x:Static app:UiStrings.ProcedureUncommentTooltip}"
                      Command="{Binding ActiveProcedureDetail.UncommentBodyCommand}"
                      IsVisible="{Binding IsProcedureDetailTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Uncomment}"
                                  Foreground="{DynamicResource DangerIconBrush}" />
              </Button>
              <!-- Data-edit add/delete row buttons. Bound through ActiveTableDetail
                   because the commands live on TableDetailTabViewModel. Visible only
                   on the Dane sub-tab; the leading separator collapses to zero width
                   when not visible thanks to IsVisible on the Border. -->
              <Border Width="1" Margin="4,4"
                      Background="{DynamicResource BorderBrush}"
                      IsVisible="{Binding ShowDataEditTools}" />
              <Button Classes="icon"
                      ToolTip.Tip="{x:Static app:UiStrings.DataEditAddRowTooltip}"
                      Command="{Binding ActiveTableDetail.AddRowCommand}"
                      IsVisible="{Binding ShowDataEditTools}">
                <controls:SvgIcon Data="{StaticResource Icon.Plus}" />
              </Button>
              <Button Classes="icon"
                      ToolTip.Tip="{x:Static app:UiStrings.DataEditDeleteRowTooltip}"
                      Command="{Binding ActiveTableDetail.DeleteRowCommand}"
                      IsVisible="{Binding ShowDataEditTools}">
                <controls:SvgIcon Data="{StaticResource Icon.Minus}" />
              </Button>
              <!-- Pagination section. Same ActiveTableDetail binding pattern. -->
              <Border Width="1" Margin="4,4"
                      Background="{DynamicResource BorderBrush}"
                      IsVisible="{Binding IsDataTabActive}" />
              <Button Classes="icon"
                      ToolTip.Tip="{x:Static app:UiStrings.TableDetailPaginationFirstTooltip}"
                      Command="{Binding ActiveTableDetail.GoToFirstPageCommand}"
                      IsVisible="{Binding IsDataTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.ChevronFirst}" />
              </Button>
              <Button Classes="icon"
                      ToolTip.Tip="{x:Static app:UiStrings.TableDetailPaginationPreviousTooltip}"
                      Command="{Binding ActiveTableDetail.GoToPreviousPageCommand}"
                      IsVisible="{Binding IsDataTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.ChevronLeft}" />
              </Button>
              <Button Classes="icon"
                      ToolTip.Tip="{x:Static app:UiStrings.TableDetailPaginationNextTooltip}"
                      Command="{Binding ActiveTableDetail.GoToNextPageCommand}"
                      IsVisible="{Binding IsDataTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.ChevronRight}" />
              </Button>
              <Button Classes="icon"
                      ToolTip.Tip="{x:Static app:UiStrings.TableDetailPaginationLastTooltip}"
                      Command="{Binding ActiveTableDetail.GoToLastPageCommand}"
                      IsVisible="{Binding IsDataTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.ChevronLast}" />
              </Button>
              <Border Width="1" Margin="4,4"
                      Background="{DynamicResource BorderBrush}"
                      IsVisible="{Binding IsQueryTabActive}" />
              <Button Classes="icon"
                      ToolTip.Tip="{x:Static app:UiStrings.ToolbarNewQueryTooltip}"
                      Command="{Binding NewQueryCommand}"
                      IsVisible="{Binding IsQueryTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Plus}" />
              </Button>
              <Button Classes="icon"
                      ToolTip.Tip="{x:Static app:UiStrings.ToolbarToggleQueryPanelTooltip}"
                      Command="{Binding ToggleQueryPanelCommand}"
                      IsVisible="{Binding IsQueryTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.PanelRight}" />
              </Button>
              <Button Classes="icon"
                      ToolTip.Tip="{x:Static app:UiStrings.ToolbarClearEditorTooltip}"
                      Command="{Binding ClearActiveEditorCommand}"
                      IsVisible="{Binding IsQueryTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Eraser}" />
              </Button>
              <Button Classes="icon"
                      ToolTip.Tip="{x:Static app:UiStrings.ToolbarFormatSqlTooltip}"
                      Command="{Binding FormatSqlCommand}"
                      IsVisible="{Binding IsQueryTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.Braces}" />
              </Button>
              <Button Classes="icon"
                      ToolTip.Tip="{x:Static app:UiStrings.ToolbarCloseTabTooltip}"
                      Command="{Binding CloseActiveTabCommand}"
                      IsVisible="{Binding IsClosableTabActive}">
                <controls:SvgIcon Data="{StaticResource Icon.X}" />
              </Button>
            </StackPanel>
          </Border>

          <!-- Editor area: SQL editor for Query tabs, DDL editor for DDL tabs.
               Right-side saved-queries panel collapses to zero width when toggled off. -->
          <Grid Grid.Row="2" Background="{DynamicResource BackgroundBrush}"
                ColumnDefinitions="*,Auto">
            <Grid Grid.Column="0">
              <ae:TextEditor x:Name="SqlEditor"
                             ShowLineNumbers="True"
                             FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                             FontSize="13"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             Background="{DynamicResource BackgroundBrush}"
                             Foreground="{DynamicResource ForegroundBrush}"
                             IsVisible="{Binding IsQueryTabActive}" />
              <ae:TextEditor x:Name="DdlEditor"
                             ShowLineNumbers="True"
                             IsReadOnly="True"
                             FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                             FontSize="13"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             Background="{DynamicResource BackgroundBrush}"
                             Foreground="{DynamicResource ForegroundBrush}"
                             IsVisible="{Binding IsDdlTabActive}" />
              <views:TableDetailTabView x:Name="TableDetailView"
                                        DataContext="{Binding ActiveTableDetail}"
                                        IsVisible="{Binding DataContext.IsTableDetailTabActive, ElementName=RootWindow}" />
              <views:NewTableTabView x:Name="NewTableView"
                                     DataContext="{Binding ActiveNewTable}"
                                     IsVisible="{Binding DataContext.IsNewTableTabActive, ElementName=RootWindow}" />
              <views:ViewDetailTabView x:Name="ViewDetailView"
                                       DataContext="{Binding ActiveViewDetail}"
                                       IsVisible="{Binding DataContext.IsViewDetailTabActive, ElementName=RootWindow}" />
              <views:ProcedureDetailTabView x:Name="ProcedureDetailView"
                                            DataContext="{Binding ActiveProcedureDetail}"
                                            IsVisible="{Binding DataContext.IsProcedureDetailTabActive, ElementName=RootWindow}" />
            </Grid>

            <!-- Saved queries panel (IBExpert-style) — visible only when the Query
                 tab is active AND the user hasn't toggled it off. ShowQueryPanel
                 combines both gates so DDL / TableDetail tabs hide the panel. -->
            <Border Grid.Column="1"
                    Width="200"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,0,0"
                    IsVisible="{Binding ShowQueryPanel}">
              <Grid RowDefinitions="Auto,Auto,*">
                <Border Grid.Row="0"
                        Padding="8,6"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{x:Static app:UiStrings.QueryPanelHeader}"
                               FontWeight="SemiBold"
                               FontSize="11"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                      <Button Classes="icon"
                              ToolTip.Tip="{x:Static app:UiStrings.ToolbarNewQueryTooltip}"
                              Command="{Binding NewQueryCommand}">
                        <controls:SvgIcon Data="{StaticResource Icon.Plus}" />
                      </Button>
                      <Button Classes="icon"
                              ToolTip.Tip="{x:Static app:UiStrings.QueryDeleteTooltip}"
                              Command="{Binding DeleteSelectedQueryCommand}">
                        <controls:SvgIcon Data="{StaticResource Icon.Trash}"
                                          Foreground="{DynamicResource WarningIconBrush}" />
                      </Button>
                      <Button Classes="icon"
                              ToolTip.Tip="{x:Static app:UiStrings.QueryClearAllTooltip}"
                              Command="{Binding ClearAllQueriesCommand}">
                        <controls:SvgIcon Data="{StaticResource Icon.ListX}"
                                          Foreground="{DynamicResource WarningIconBrush}" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>

                <TextBlock Grid.Row="1"
                           Text="{x:Static app:UiStrings.QueryPanelEmptyHint}"
                           Classes="subtle"
                           FontSize="11"
                           Margin="10,8"
                           TextWrapping="Wrap"
                           IsVisible="{Binding ShowQueryPanelEmptyHint}" />

                <ListBox Grid.Row="2"
                         ItemsSource="{Binding SavedQueries}"
                         SelectedItem="{Binding SelectedSavedQuery, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         IsVisible="{Binding HasSavedQueries}">
                  <ListBox.Styles>
                    <!-- Hover-visible rename icon: hidden by default, fades in when
                         the ListBoxItem under the cursor is hovered. Same convention
                         as IBExpert / DataGrip row-action affordances. -->
                    <Style Selector="Button.row-hover-icon">
                      <Setter Property="Opacity" Value="0" />
                    </Style>
                    <Style Selector="ListBoxItem:pointerover Button.row-hover-icon">
                      <Setter Property="Opacity" Value="1" />
                    </Style>
                  </ListBox.Styles>
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:SavedQueryViewModel">
                      <!-- Full-row hit target: Border with Stretch + transparent
                           background captures DoubleTapped + right-click ContextMenu
                           anywhere on the row, not just on the text glyphs. -->
                      <Border HorizontalAlignment="Stretch"
                              Background="Transparent"
                              DoubleTapped="OnSavedQueryNameDoubleTapped">
                        <Border.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="{x:Static app:UiStrings.QueryContextRename}"
                                      Command="{Binding BeginRenameCommand}" />
                            <MenuItem Header="{x:Static app:UiStrings.QueryContextDelete}"
                                      Command="{Binding DeleteCommand}" />
                          </ContextMenu>
                        </Border.ContextMenu>
                        <Panel>
                          <Grid ColumnDefinitions="*,Auto"
                                IsVisible="{Binding IsNotRenaming}">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Name}"
                                       FontSize="11"
                                       Padding="2,1"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Classes="icon row-hover-icon"
                                    ToolTip.Tip="{x:Static app:UiStrings.QueryRenameTooltip}"
                                    Padding="3,1"
                                    Command="{Binding BeginRenameCommand}">
                              <controls:SvgIcon Data="{StaticResource Icon.Pencil}"
                                                Width="13" Height="13" />
                            </Button>
                          </Grid>
                          <TextBox Text="{Binding EditingName, Mode=TwoWay}"
                                   FontSize="11"
                                   Padding="2,1"
                                   IsVisible="{Binding IsRenaming}"
                                   behaviors:FocusBehavior.FocusOnVisible="True"
                                   LostFocus="OnRenameTextBoxLostFocus"
                                   KeyDown="OnRenameTextBoxKeyDown" />
                        </Panel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
          </Grid>

          <!-- Transaction bar — status only. Commit/Rollback live on the editor toolbar. -->
          <Border Grid.Row="3"
                  Background="{DynamicResource PanelBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="0,1,0,0"
                  IsVisible="{Binding IsQueryTabActive}">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="14,0" VerticalAlignment="Center">
              <!-- Data lane status -->
              <Ellipse Width="8" Height="8"
                       Fill="{DynamicResource SubtleForegroundBrush}"
                       IsVisible="{Binding IsTransactionIdle}" />
              <Ellipse Width="8" Height="8"
                       Fill="{DynamicResource TransactionActiveBrush}"
                       IsVisible="{Binding IsTransactionActive}" />
              <Ellipse Width="8" Height="8"
                       Fill="{DynamicResource ErrorBrush}"
                       IsVisible="{Binding IsTransactionError}" />
              <TextBlock Text="{Binding TransactionBarText}"
                         Classes="subtle"
                         Classes.error="{Binding IsTransactionError}"
                         VerticalAlignment="Center" />
              <!-- Metadata lane status (shown only when the metadata attachment is independent) -->
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                          IsVisible="{Binding MetadataLaneIndependent}">
                <Border Width="1" Height="12" Margin="0,0"
                        Background="{DynamicResource BorderBrush}" />
                <Ellipse Width="8" Height="8"
                         Fill="{DynamicResource SubtleForegroundBrush}"
                         IsVisible="{Binding IsMetadataTransactionIdle}" />
                <Ellipse Width="8" Height="8"
                         Fill="{DynamicResource TransactionActiveBrush}"
                         IsVisible="{Binding IsMetadataTransactionActive}" />
                <Ellipse Width="8" Height="8"
                         Fill="{DynamicResource ErrorBrush}"
                         IsVisible="{Binding IsMetadataTransactionError}" />
                <TextBlock Text="{Binding MetadataTransactionBarText}"
                           Classes="subtle"
                           Classes.error="{Binding IsMetadataTransactionError}"
                           VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Resize handle between editor and results. Double-click resets to the
             default height. Hidden (with the results panel) on non-Query tabs. -->
        <GridSplitter Grid.Row="1"
                      x:Name="ResultsSplitter"
                      Height="4"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource BorderBrush}"
                      DoubleTapped="OnResultsSplitterDoubleTapped"
                      IsVisible="{Binding IsQueryTabActive}" />

        <!-- Bottom panel: Results / Messages tabs -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}"
                IsVisible="{Binding IsQueryTabActive}">
          <Grid>
          <!-- Maximize / restore the results panel — same action as double-clicking
               the splitter. Overlaid at the top-right of the tab strip. ChevronsUp
               = maximize (grow upward), ChevronsDown = restore. -->
          <Button Classes="icon"
                  ZIndex="1"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="0,2,6,0"
                  ToolTip.Tip="{x:Static app:UiStrings.ResultsPanelMaximizeTooltip}"
                  Click="OnToggleResultsMaximizeClick">
            <Panel>
              <controls:SvgIcon Data="{StaticResource Icon.ChevronsUp}" Width="14" Height="14"
                                IsVisible="{Binding !IsResultsMaximized}" />
              <controls:SvgIcon Data="{StaticResource Icon.ChevronsDown}" Width="14" Height="14"
                                IsVisible="{Binding IsResultsMaximized}" />
            </Panel>
          </Button>
          <TabControl SelectedIndex="{Binding SelectedBottomTabIndex, Mode=TwoWay}"
                      Padding="0">
            <TabItem Classes="bottom-tab" Header="{Binding ResultsLabel}">
              <Grid Background="{DynamicResource BackgroundBrush}" RowDefinitions="Auto,Auto,*">
                <Border Grid.Row="0"
                        Background="{DynamicResource ElevatedPanelBrush}"
                        Padding="12,6"
                        IsVisible="{Binding ShowTruncatedBanner}">
                  <TextBlock Text="{Binding TruncatedBannerText}"
                             Classes="subtle"
                             FontSize="11" />
                </Border>
                <!-- Pagination bar — reuses the same first/prev/next/last icon
                     strings as the Table Data View. Client-side paging over the
                     materialized result set; the hint shows page + row counts. -->
                <Border Grid.Row="1"
                        Background="{DynamicResource ElevatedPanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="6,2"
                        IsVisible="{Binding HasCurrentResult}">
                  <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Classes="icon"
                            ToolTip.Tip="{x:Static app:UiStrings.TableDetailPaginationFirstTooltip}"
                            Command="{Binding ResultFirstPageCommand}">
                      <controls:SvgIcon Data="{StaticResource Icon.ChevronFirst}" Width="14" Height="14" />
                    </Button>
                    <Button Classes="icon"
                            ToolTip.Tip="{x:Static app:UiStrings.TableDetailPaginationPreviousTooltip}"
                            Command="{Binding ResultPreviousPageCommand}">
                      <controls:SvgIcon Data="{StaticResource Icon.ChevronLeft}" Width="14" Height="14" />
                    </Button>
                    <Button Classes="icon"
                            ToolTip.Tip="{x:Static app:UiStrings.TableDetailPaginationNextTooltip}"
                            Command="{Binding ResultNextPageCommand}">
                      <controls:SvgIcon Data="{StaticResource Icon.ChevronRight}" Width="14" Height="14" />
                    </Button>
                    <Button Classes="icon"
                            ToolTip.Tip="{x:Static app:UiStrings.TableDetailPaginationLastTooltip}"
                            Command="{Binding ResultLastPageCommand}">
                      <controls:SvgIcon Data="{StaticResource Icon.ChevronLast}" Width="14" Height="14" />
                    </Button>
                    <TextBlock Text="{Binding ResultPaginationHint}"
                               Classes="subtle"
                               FontSize="11"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
                <TextBlock Grid.Row="2"
                           Text="{Binding ResultsEmptyHint}"
                           Classes="subtle"
                           Margin="14,14,0,0"
                           IsVisible="{Binding ShowResultsEmptyHint}" />
                <DataGrid x:Name="ResultGrid"
                          Grid.Row="2"
                          behaviors:GridLayoutBehavior.GridId="QueryResults"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          CanUserSortColumns="False"
                          CanUserResizeColumns="True"
                          CanUserReorderColumns="False"
                          ColumnWidth="Auto"
                          RowBackground="Transparent"
                          HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                          VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                          IsVisible="{Binding HasCurrentResult}">
                  <DataGrid.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="{x:Static app:UiStrings.GridCopyCell}"
                                Click="OnCopyCellClick" />
                      <MenuItem Header="{x:Static app:UiStrings.GridCopyRow}"
                                Click="OnCopyRowClick" />
                      <MenuItem Header="{x:Static app:UiStrings.GridCopyRowWithHeaders}"
                                Click="OnCopyRowWithHeadersClick" />
                      <Separator />
                      <MenuItem Header="{x:Static app:UiStrings.GridCopyAllWithHeaders}"
                                Click="OnCopyAllWithHeadersClick" />
                    </ContextMenu>
                  </DataGrid.ContextMenu>
                </DataGrid>
              </Grid>
            </TabItem>
            <TabItem Classes="bottom-tab" Header="{Binding MessagesLabel}">
              <Grid Background="{DynamicResource BackgroundBrush}">
                <TextBlock Text="{Binding MessagesEmptyHint}"
                           Classes="subtle"
                           Margin="14,14,0,0"
                           IsVisible="{Binding ShowMessagesEmptyHint}" />
                <ScrollViewer IsVisible="{Binding HasMessages}">
                  <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:QueryMessageViewModel">
                        <Border Padding="14,6"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                          <Grid ColumnDefinitions="80,*">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding TimestampLabel}"
                                       Classes="subtle"
                                       FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Text}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Classes.error="{Binding IsError}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </TabItem>
            <TabItem Classes="bottom-tab" Header="{Binding OutputLabel}">
              <Grid Background="{DynamicResource BackgroundBrush}" />
            </TabItem>
          </TabControl>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="2"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="14,0">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Ellipse Width="7" Height="7" Fill="{DynamicResource ConnectedBrush}" IsVisible="{Binding IsConnected}" />
          <Ellipse Width="7" Height="7" Fill="{DynamicResource SubtleForegroundBrush}" IsVisible="{Binding !IsConnected}" />
          <TextBlock Text="{Binding StatusText}"
                     Classes="subtle"
                     Classes.error="{Binding IsStatusError}"
                     FontSize="11"
                     VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="1"
                   Text="{Binding QueryStatsText}"
                   Classes="subtle"
                   FontSize="11"
                   Margin="20,0,0,0"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="3"
                   Text="EmberTern 0.1.0"
                   Classes="subtle"
                   FontSize="11"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>

  </Grid>
</Window>
