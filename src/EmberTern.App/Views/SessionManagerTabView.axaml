<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:EmberTern.App"
             xmlns:vm="using:EmberTern.App.ViewModels"
             xmlns:controls="using:EmberTern.App.Controls"
             xmlns:behaviors="using:EmberTern.App.Behaviors"
             x:Class="EmberTern.App.Views.SessionManagerTabView"
             x:Name="RootControl"
             x:DataType="vm:SessionManagerTabViewModel"
             Background="{DynamicResource BackgroundBrush}"
             Foreground="{DynamicResource ForegroundBrush}">

  <UserControl.Styles>
    <!-- ⭐ M4.3c: styl `Button.seg` przeniesiony do `Themes/ControlStyles.axaml` — JEDEN styl na dziewięć
         segmentów w dwóch ekranach. Ten widok deklarował go lokalnie razem z Trace Monitorem, a kopie
         RÓŻNIŁY SIĘ jedną wartością (`Padding` 8,3 vs 10,3) — mimo że komentarz stojący tutaj deklarował
         wprost „same segmented language as the Activity Monitor toolbar". ⚠ Powód przeniesienia i powód
         wyboru poziomu 8 stoją przy stylu; ⛔ nie przywracać kopii lokalnej. -->
    <!-- Detail-panel section header (matches the trace detail) -->
    <Style Selector="TextBlock.section">
      <!-- ⭐ K8 ZAMKNIĘTA (M4, decyzja użytkownika A-2): rola `Text.SectionHeader` niesie teraz 12 SemiBold,
           czyli dokładnie to, co ten nagłówek deklarował lokalnie od M2c. Wartość się nie zmienia — zmienia
           się to, że przestaje być wyjątkiem. Powód korekty katalogu stoi przy roli w `Typography.axaml`. -->
      <Setter Property="FontWeight" Value="{DynamicResource Text.SectionHeader.Weight}" />
      <Setter Property="FontSize" Value="{DynamicResource Text.SectionHeader.Size}" />
      <Setter Property="Margin" Value="0,0,0,3" />
    </Style>
    <!-- Compact, uncramped column headers for these grids only (matches the trace) -->
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Padding" Value="6,4" />
    </Style>
    <!-- Session Details key/value label -->
    <Style Selector="TextBlock.kv">
      <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource Text.Compact.Size}" />
    </Style>
    <Style Selector="TextBlock.kvv">
      <Setter Property="FontSize" Value="{DynamicResource Text.Compact.Size}" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <!-- Shared warning card (Performance-findings shape) — ONE definition, used by the Warnings
         tab AND the scoped warnings in Session Details. -->
    <DataTemplate x:Key="SessionWarningCard" x:DataType="vm:SessionWarningViewModel">
      <!-- ⭐ Q1 ZAMKNIĘTE (M4.3, decyzja użytkownika na renderze): karta bierze `Radius.Surface` (4 → 3).
           M2c iteracja 6 zostawiła tu literał i oddała decyzję „karta: 3 czy 4" bramie §13.3 — ⚠ która
           NIGDY jej nie podjęła (Z‑1…Z‑6 tego nie dotyczą) i pozycja nie dostała numeru K, więc przeżyła
           zamknięcie rejestru kolizji „w całości". To ten sam mechanizm co przy B2 w M4.2, tylko że B2
           nie było wyjątkiem — w M4.3 takich sierot po §13.3 było dziewiętnaście.
           ⭐ Rola opisywała ten element od zawsze: jej komentarz w `Tokens.axaml` zaczyna się od „Karta". -->
      <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1" CornerRadius="{DynamicResource Radius.Surface}" Padding="10,8" Margin="0,0,0,8">
        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <controls:SvgIcon Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}" VerticalAlignment="Center"
                              Data="{Binding SeverityGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}">
              <controls:SvgIcon.Foreground>
                <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                  <Binding Path="SeverityBrushKey" />
                  <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                </MultiBinding>
              </controls:SvgIcon.Foreground>
            </controls:SvgIcon>
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" FontSize="{DynamicResource Text.Application.Size}" />
          <TextBlock Text="{Binding Impact}" TextWrapping="Wrap" FontSize="{DynamicResource Text.Compact.Size}"
                     Foreground="{DynamicResource SubtleForegroundBrush}" IsVisible="{Binding HasImpact}" />
          <ItemsControl ItemsSource="{Binding Evidence}" IsVisible="{Binding HasEvidence}" Margin="0,2,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="{DynamicResource Text.Compact.Size}"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel IsVisible="{Binding HasWhatToCheck}" Margin="0,3,0,0" Spacing="1">
            <TextBlock Text="{x:Static app:UiStrings.SessionManagerWarningWhatToCheck}"
                       FontSize="{DynamicResource Text.SectionHeader.Size}" FontWeight="SemiBold" Foreground="{DynamicResource SubtleForegroundBrush}" />
            <ItemsControl ItemsSource="{Binding WhatToCheck}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="{DynamicResource Text.Compact.Size}" Margin="0,1,0,0" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid x:Name="RootGrid" RowDefinitions="Auto,Auto,*,4,240">

    <!-- ① Toolbar (same density / spacing as the Activity Monitor session bar) -->
    <Border Classes="chrome" Grid.Row="0" Background="{DynamicResource ChromeStrongBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="6,4">
      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Button Classes="icon" Command="{Binding RefreshCommand}" ToolTip.Tip="{x:Static app:UiStrings.SessionManagerRefreshTip}">
          <controls:SvgIcon Data="{StaticResource Icon.RefreshCw}" />
        </Button>
        <ComboBox ItemsSource="{Binding RefreshOptions}" SelectedItem="{Binding SelectedRefreshOption}"
                  Width="74" VerticalAlignment="Center" ToolTip.Tip="{x:Static app:UiStrings.SessionManagerAutoRefreshTip}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SessionRefreshOption">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <Border Width="1" Margin="4,2" Background="{DynamicResource BorderBrush}" />

        <Button Classes="icon" Command="{Binding DisconnectCommand}"
                ToolTip.Tip="{x:Static app:UiStrings.SessionManagerDisconnectTip}">
          <controls:SvgIcon Data="{StaticResource Icon.Unplug}" Foreground="{DynamicResource DangerIconBrush}" />
        </Button>

        <Border Width="1" Margin="4,2" Background="{DynamicResource BorderBrush}" />

        <Button Classes="icon" Command="{Binding CopyCommand}" ToolTip.Tip="{x:Static app:UiStrings.SessionManagerCopyTip}">
          <controls:SvgIcon Data="{StaticResource Icon.Copy}" />
        </Button>

        <Border Width="1" Margin="4,2" Background="{DynamicResource BorderBrush}" />

        <ToggleButton Classes="icon" IsChecked="{Binding HideSelfActivity}"
                      ToolTip.Tip="{x:Static app:UiStrings.SessionManagerHideSelfTip}">
          <controls:SvgIcon Data="{StaticResource Icon.EyeOff}" />
        </ToggleButton>

        <TextBox Width="150" PlaceholderText="{x:Static app:UiStrings.SessionManagerFilterWatermark}"
                 Text="{Binding FilterText}" Margin="4,0,0,0" />

        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                   Foreground="{DynamicResource SubtleForegroundBrush}" Margin="8,0,0,0" />
      </StackPanel>
    </Border>

    <!-- ② Health Bar — verdict + clickable counter chips (answer at the top) -->
    <Border Grid.Row="1" Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,5">
      <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <!-- verdict dot (theme brush resolved from the grade key) -->
          <!-- ⚠ Promień zostaje lokalnie, ŚWIADOMIE (M2c iteracja 6, §18.6): to GEOMETRIA. Koła
               (`10×10` r=5, `9×9` r=4.5) i kapsuły (`Height=10` r=5) mają promień równy POŁOWIE BOKU.
               ⛔ Nie tokenizujemy arytmetyki (§18.0.5/2). ⚠ Zdanie „a karty i kontenery przy 4"
               zniknęło w M4.3: karty, ramki kontrolek i chip zeszły na role, więc poza tą geometrią
               nie ma już w tym pliku ani jednego promienia zapisanego liczbą. -->
          <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center">
            <Border.Background>
              <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                <Binding Path="GradeBrushKey" />
                <Binding ElementName="RootControl" Path="ActualThemeVariant" />
              </MultiBinding>
            </Border.Background>
          </Border>
          <TextBlock Text="{Binding GradeText}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Headline}" Foreground="{DynamicResource SubtleForegroundBrush}"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

          <Border Width="1" Margin="6,1" Background="{DynamicResource BorderBrush}" />

          <!-- informational counts -->
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="{x:Static app:UiStrings.SessionManagerCountSessions}" Foreground="{DynamicResource SubtleForegroundBrush}" />
            <TextBlock Text="{Binding SessionCount}" FontWeight="SemiBold" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="{x:Static app:UiStrings.SessionManagerCountTransactions}" Foreground="{DynamicResource SubtleForegroundBrush}" />
            <TextBlock Text="{Binding TransactionCount}" FontWeight="SemiBold" />
          </StackPanel>

          <Border Width="1" Margin="6,1" Background="{DynamicResource BorderBrush}" />

          <!-- filter chips (segmented) -->
          <!-- ⭐ Q1 ZAMKNIĘTE (M4.3): ramka przełącznika bierze `Radius.Surface` (4 → 3). ⚠ Argument jest tu
               INNY niż przy karcie i mocniejszy: ten element UDAJE obramowaną kontrolkę, a `ControlCornerRadius`
               Fluenta = 3 i jest świadomie NIENADPISANY w `FluentBridge` (pokrywa się z `Radius.Surface`) —
               więc każda PRAWDZIWA obramowana kontrolka w aplikacji renderuje się przy 3. Render postawił
               obok niej prawdziwy `TextBox` i to on rozstrzygnął. -->
          <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  CornerRadius="{DynamicResource Radius.Surface}" ClipToBounds="True">
            <StackPanel Orientation="Horizontal">
              <Button Classes="seg" Classes.active="{Binding IsFilterAll}" Command="{Binding FilterAllCommand}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="All" />
                </StackPanel>
              </Button>
              <Button Classes="seg" Classes.active="{Binding IsFilterLongTx}" Command="{Binding FilterLongTxCommand}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="{x:Static app:UiStrings.SessionManagerCountLongTx}" />
                  <TextBlock Text="{Binding LongTransactionCount}" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                </StackPanel>
              </Button>
              <Button Classes="seg" Classes.active="{Binding IsFilterGcRisk}" Command="{Binding FilterGcRiskCommand}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="{x:Static app:UiStrings.SessionManagerCountGcRisk}" />
                  <TextBlock Text="{Binding GcRiskCount}" FontWeight="SemiBold" Foreground="{DynamicResource DangerIconBrush}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>

          <Border Width="1" Margin="6,1" Background="{DynamicResource BorderBrush}" />

          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                      ToolTip.Tip="Transaction gap — how far the oldest active transaction is behind the newest (the number of transactions' record versions pinned from garbage collection)">
            <TextBlock Text="{x:Static app:UiStrings.SessionManagerCountOatLag}" Foreground="{DynamicResource SubtleForegroundBrush}" />
            <TextBlock Text="{Binding OldestActiveLagText}" FontWeight="SemiBold" />
          </StackPanel>
        </StackPanel>

        <!-- privilege banner (only when we can see just our own sessions) -->
        <TextBlock Text="{x:Static app:UiStrings.SessionManagerPrivilegeBanner}" FontSize="{DynamicResource Text.Compact.Size}"
                   Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                   IsVisible="{Binding ShowPrivilegeBanner}" />
      </StackPanel>
    </Border>

    <!-- ③ Sessions grid (sortable — sorting by risk/load is the point) -->
    <Panel Grid.Row="2">
      <DataGrid x:Name="SessionsGrid"
                behaviors:GridLayoutBehavior.GridId="SessionManagerSessions"
                CellPointerPressed="OnSessionCellPointerPressed"
                ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}"
                AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                CanUserSortColumns="True" CanUserReorderColumns="True"
                ColumnWidth="Auto" GridLinesVisibility="Horizontal" FontSize="{DynamicResource Text.Grid.Size}">
        <DataGrid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{x:Static app:UiStrings.SessionManagerMenuDisconnect}" Icon="{app:MenuIcon Icon.Unplug, Brush=DangerIconBrush}" Command="{Binding DisconnectCommand}" />
            <Separator />
            <!-- These two act on the SELECTED session's statement and were reachable only from the detail
                 pane's buttons, while Disconnect and Copy sat in both places — the same surface offering a
                 different set depending on where the user looked. Same commands, same icons as those buttons. -->
            <MenuItem Header="{x:Static app:UiStrings.SessionManagerOpenInEditor}" Icon="{app:MenuIcon Icon.Query}" Command="{Binding OpenInEditorCommand}" />
            <MenuItem Header="{x:Static app:UiStrings.SessionManagerAnalyze}" Icon="{app:MenuIcon Icon.Activity}" Command="{Binding AnalyzeInPerformanceCommand}" />
            <Separator />
            <MenuItem Header="{x:Static app:UiStrings.SessionManagerMenuCopy}" Icon="{app:MenuIcon Icon.Copy}" Command="{Binding CopyCommand}" />
          </ContextMenu>
        </DataGrid.ContextMenu>
        <DataGrid.Columns>
          <!-- Health: an always-on status dot (never blank), tooltip explains the state -->
          <DataGridTemplateColumn Header="{x:Static app:UiStrings.SessionColHealth}" MinWidth="58"
                                  CanUserResize="False" CanUserReorder="False" CanUserSort="False">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:SessionRowViewModel">
                <!-- ⚠ Promień zostaje lokalnie, ŚWIADOMIE (M2c iteracja 6, §18.6): to GEOMETRIA. Koła
                     (`10×10` r=5, `9×9` r=4.5) i kapsuły (`Height=10` r=5) mają promień równy POŁOWIE BOKU.
                     ⛔ Nie tokenizujemy arytmetyki (§18.0.5/2). ⚠ Zdanie „a karty i kontenery przy 4"
               zniknęło w M4.3: karty, ramki kontrolek i chip zeszły na role, więc poza tą geometrią
               nie ma już w tym pliku ani jednego promienia zapisanego liczbą. -->
                <Border Width="10" Height="10" CornerRadius="5" HorizontalAlignment="Center" VerticalAlignment="Center"
                        ToolTip.Tip="{Binding HealthTooltip}">
                  <Border.Background>
                    <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                      <Binding Path="HealthBrushKey" />
                      <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                    </MultiBinding>
                  </Border.Background>
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTextColumn Header="{x:Static app:UiStrings.SessionColId}" Binding="{Binding IdText}"
                              SortMemberPath="AttachmentId" MinWidth="60" />
          <DataGridTextColumn Header="{x:Static app:UiStrings.SessionColUser}" Binding="{Binding User}"
                              SortMemberPath="User" MinWidth="90" />
          <DataGridTextColumn Header="{x:Static app:UiStrings.SessionColApplication}" Binding="{Binding Application}"
                              SortMemberPath="Application" MinWidth="130" />
          <DataGridTextColumn Header="{x:Static app:UiStrings.SessionColHost}" Binding="{Binding Host}"
                              SortMemberPath="Host" MinWidth="110" />
          <DataGridTextColumn Header="{x:Static app:UiStrings.SessionColState}" Binding="{Binding StateText}"
                              SortMemberPath="StateText" MinWidth="70" />
          <DataGridTextColumn Header="{x:Static app:UiStrings.SessionColTx}" Binding="{Binding ActiveTxText}"
                              SortMemberPath="ActiveTxValue" MinWidth="50" />
          <DataGridTextColumn Header="{x:Static app:UiStrings.SessionColOldestTx}" Binding="{Binding OldestTxText}"
                              SortMemberPath="OldestTxValue" MinWidth="90" />
          <!-- Load: cumulative records touched since connect (a lifetime total, sortable) -->
          <DataGridTextColumn Header="{x:Static app:UiStrings.SessionColLoad}" Binding="{Binding LoadText}"
                              SortMemberPath="LoadValue" MinWidth="90" />
        </DataGrid.Columns>
      </DataGrid>

      <!-- ⭐ Q3/A ZAMKNIĘTE (M4.3): komunikat pustego stanu bierze `Text.Application` (13 → 12). Dawny
           komentarz był trafny w diagnozie („katalog ma przy 13 wyłącznie rolę kodu, a to jest tekst")
           i tylko oddawał wniosek bramie, która go nie podjęła.
           ⚠ Ten sam element żyje w Trace Monitorze i jest tam KONSTRUKCYJNIE IDENTYCZNY (ten sam pędzel,
           ten sam `Margin`, to samo centrowanie), więc to była JEDNA decyzja na dwa ekrany, nie dwie —
           i pilnuje tego test relacyjny `BothEmptyStates_ShareOneTextRole` (#335: ta sama kontrolka na
           dwóch ekranach musi zgadzać się sama ze sobą). -->
      <TextBlock IsVisible="{Binding ShowSessionsEmpty}" Text="{x:Static app:UiStrings.SessionsEmpty}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0"
                 Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="{DynamicResource Text.Application.Size}" />
    </Panel>

    <!-- splitter: double-tap to maximize/restore (identical to the Activity Monitor bottom panel) -->
    <GridSplitter Grid.Row="3" ResizeDirection="Rows" HorizontalAlignment="Stretch"
                  Background="{DynamicResource BorderBrush}"
                  DoubleTapped="OnBottomSplitterDoubleTapped" />

    <!-- ④ Bottom tabs (Transactions / Session Details / Warnings) -->
    <Panel Grid.Row="4">
      <TabControl>
        <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.SessionManagerTabTransactions}">
          <Grid RowDefinitions="Auto,Auto,*">
            <!-- Transaction-gap GAUGE: the OAT lag measured against the GC-danger budget, so a
                 small/normal gap is a calm sliver and only a materially large one turns orange/red
                 (scale-before-alarm — the gauge and the Health Bar can't contradict). -->
            <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" IsVisible="{Binding HasGap}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,5"
                    ToolTip.Tip="{x:Static app:UiStrings.SessionManagerGapExplain}">
              <StackPanel Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="{x:Static app:UiStrings.SessionManagerGapCaption}" FontWeight="SemiBold" FontSize="{DynamicResource Text.Compact.Size}" />
                  <!-- value coloured by severity (grey when healthy — no permanent orange) -->
                  <TextBlock Text="{Binding GapValueText}" FontSize="{DynamicResource Text.Compact.Size}" FontWeight="SemiBold">
                    <TextBlock.Foreground>
                      <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                        <Binding Path="GapSeverityBrushKey" />
                        <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                      </MultiBinding>
                    </TextBlock.Foreground>
                  </TextBlock>
                  <TextBlock Text="{Binding GapStatusText}" FontSize="{DynamicResource Text.Caption.Size}"
                             Foreground="{DynamicResource SubtleForegroundBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <!-- One rounded, clipped pill track so BOTH ends stay rounded regardless of the fill -->
                <!-- ⚠ Promień zostaje lokalnie, ŚWIADOMIE (M2c iteracja 6, §18.6): to GEOMETRIA. Koła
                     (`10×10` r=5, `9×9` r=4.5) i kapsuły (`Height=10` r=5) mają promień równy POŁOWIE BOKU.
                     ⛔ Nie tokenizujemy arytmetyki (§18.0.5/2). ⚠ Zdanie „a karty i kontenery przy 4"
               zniknęło w M4.3: karty, ramki kontrolek i chip zeszły na role, więc poza tą geometrią
               nie ma już w tym pliku ani jednego promienia zapisanego liczbą. -->
                <Border Width="280" Height="10" HorizontalAlignment="Left" CornerRadius="5" ClipToBounds="True"
                        Background="{DynamicResource RowAlternateBrush}">
                  <Border Width="{Binding GapFillWidth}" HorizontalAlignment="Left">
                    <Border.Background>
                      <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                        <Binding Path="GapSeverityBrushKey" />
                        <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                      </MultiBinding>
                    </Border.Background>
                  </Border>
                </Border>
                <Grid Width="280" HorizontalAlignment="Left">
                  <!-- ⭐ Q3/B ZAMKNIĘTE (M4.3): podpis skali bierze `Text.Caption` (9 → 10). To jest TEKST,
                       a nie znak strojony do kontenera — więc trafia na najbliższą rolę tekstową zamiast
                       zostawać przy wartości, której katalog nie zna. -->
                  <TextBlock HorizontalAlignment="Left" FontSize="{DynamicResource Text.Caption.Size}"
                             Foreground="{DynamicResource SubtleForegroundBrush}"
                             Text="{x:Static app:UiStrings.SessionManagerGapScaleMin}" />
                  <!-- ⭐ Q3/B ZAMKNIĘTE (M4.3): jak wyżej — `Text.Caption` (9 → 10). -->
                  <TextBlock HorizontalAlignment="Right" FontSize="{DynamicResource Text.Caption.Size}"
                             Foreground="{DynamicResource SubtleForegroundBrush}"
                             Text="{Binding GapScaleMaxText, StringFormat='GC risk near {0}'}" />
                </Grid>
              </StackPanel>
            </Border>

            <!-- "Filtered by session N ✕" chip -->
            <!-- ⭐ M4.3: ten element NAZYWA SIĘ chipem we własnym komentarzu, a rola `Radius.Chip` nazywa się
                 „Odznaka i chip" — więc migracja jest wyłącznie nazwaniem decyzji, którą autor już podjął
                 (R12). Wartość 4 → 4, wygląd bez zmiany; to jedyna pozycja Q1 bez pytania. -->
            <Border Grid.Row="1" Background="{DynamicResource SelectionBrush}" CornerRadius="{DynamicResource Radius.Chip}"
                    Padding="8,3" Margin="6,6,6,0" HorizontalAlignment="Left"
                    IsVisible="{Binding IsSessionFilterActive}">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="{Binding SessionFilterText}" FontSize="{DynamicResource Text.Compact.Size}" VerticalAlignment="Center" />
                <Button Classes="icon" Padding="2" Command="{Binding ClearSessionFilterCommand}">
                  <!-- ⭐ Q2 (M4.3): inline ✕ na `Size.Icon.Sm` (11 → 12). Rola opisuje wprost ten host —
                       „ikona inline w tekście 11 px (chip, wiersz siatki)" — a obok stoi `Text.Compact` (11).
                       Ten sam ✕ w debuggerze niósł 12 i 11 w jednym pliku; pięć wystąpień, jedna rola. -->
                  <controls:SvgIcon Width="{DynamicResource Size.Icon.Sm}" Height="{DynamicResource Size.Icon.Sm}"
                                    Data="{StaticResource Icon.X}" />
                </Button>
              </StackPanel>
            </Border>

            <DataGrid Grid.Row="2" x:Name="TransactionsGrid"
                      behaviors:GridLayoutBehavior.GridId="SessionManagerTransactions"
                      ItemsSource="{Binding Transactions}" SelectedItem="{Binding SelectedTransaction}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      CanUserSortColumns="True" CanUserReorderColumns="True"
                      ColumnWidth="Auto" GridLinesVisibility="Horizontal" FontSize="{DynamicResource Text.Grid.Size}">
              <DataGrid.Columns>
                <!-- Health: an always-on status dot (never blank), tooltip explains the state —
                     mirrors the Sessions grid so both grids read the same way -->
                <DataGridTemplateColumn Header="{x:Static app:UiStrings.SessionColHealth}" MinWidth="58"
                                        CanUserResize="False" CanUserReorder="False" CanUserSort="False">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:TransactionRowViewModel">
                      <!-- ⚠ Promień zostaje lokalnie, ŚWIADOMIE (M2c iteracja 6, §18.6): to GEOMETRIA. Koła
                           (`10×10` r=5, `9×9` r=4.5) i kapsuły (`Height=10` r=5) mają promień równy POŁOWIE BOKU.
                           ⛔ Nie tokenizujemy arytmetyki (§18.0.5/2). ⚠ Zdanie „a karty i kontenery przy 4"
               zniknęło w M4.3: karty, ramki kontrolek i chip zeszły na role, więc poza tą geometrią
               nie ma już w tym pliku ani jednego promienia zapisanego liczbą. -->
                      <Border Width="10" Height="10" CornerRadius="5" HorizontalAlignment="Center" VerticalAlignment="Center"
                              ToolTip.Tip="{Binding HealthTooltip}">
                        <Border.Background>
                          <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                            <Binding Path="HealthBrushKey" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </Border.Background>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{x:Static app:UiStrings.TxColId}" Binding="{Binding TransactionIdText}"
                                    SortMemberPath="TransactionId" MinWidth="80" />
                <DataGridTextColumn Header="{x:Static app:UiStrings.TxColSession}" Binding="{Binding SessionLabel}"
                                    SortMemberPath="SessionLabel" MinWidth="120" />
                <DataGridTextColumn Header="{x:Static app:UiStrings.TxColState}" Binding="{Binding StateText}"
                                    SortMemberPath="StateText" MinWidth="70" />
                <DataGridTextColumn Header="{x:Static app:UiStrings.TxColAge}" Binding="{Binding AgeText}"
                                    SortMemberPath="AgeValue" MinWidth="80" />
                <DataGridTextColumn Header="{x:Static app:UiStrings.TxColIsolation}" Binding="{Binding IsolationText}"
                                    SortMemberPath="IsolationText" MinWidth="120" />
                <DataGridTextColumn Header="{x:Static app:UiStrings.TxColReadOnly}" Binding="{Binding ReadOnlyText}"
                                    SortMemberPath="ReadOnlyText" MinWidth="80" />
                <DataGridTextColumn Header="{x:Static app:UiStrings.TxColGcImpact}" Binding="{Binding GcImpactText}"
                                    SortMemberPath="GcImpactValue" MinWidth="90" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>

        <!-- Session Details — General / Why it matters / Statement (+bridges) / Activity / Transactions / Warnings -->
        <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.SessionManagerTabDetails}">
          <Panel>
            <TextBlock Text="{x:Static app:UiStrings.SessionManagerDetailsNoSelection}"
                       Foreground="{DynamicResource SubtleForegroundBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding !HasSelectedSession}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasSelectedSession}">
              <StackPanel Spacing="10" Margin="10,8">

                <!-- General + one-line session verdict -->
                <StackPanel Spacing="4">
                  <TextBlock Classes="section" Text="{x:Static app:UiStrings.SessionManagerGeneralHeader}" />
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- ⚠ Promień zostaje lokalnie, ŚWIADOMIE (M2c iteracja 6, §18.6): to GEOMETRIA. Koła
                         (`10×10` r=5, `9×9` r=4.5) i kapsuły (`Height=10` r=5) mają promień równy POŁOWIE BOKU.
                         ⛔ Nie tokenizujemy arytmetyki (§18.0.5/2). ⚠ Zdanie „a karty i kontenery przy 4"
               zniknęło w M4.3: karty, ramki kontrolek i chip zeszły na role, więc poza tą geometrią
               nie ma już w tym pliku ani jednego promienia zapisanego liczbą. -->
                    <Border Width="9" Height="9" CornerRadius="4.5" VerticalAlignment="Center">
                      <Border.Background>
                        <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                          <Binding Path="SelectedSession.RiskBrushKey" />
                          <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                        </MultiBinding>
                      </Border.Background>
                    </Border>
                    <TextBlock Text="{Binding SelectedSession.RiskText}" FontSize="{DynamicResource Text.Application.Size}" VerticalAlignment="Center" />
                  </StackPanel>
                  <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="kv" Text="{x:Static app:UiStrings.SessionColId}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Classes="kvv" Text="{Binding SelectedSession.IdText}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="kv" Text="{x:Static app:UiStrings.SessionColUser}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="kvv" Text="{Binding SelectedSession.User}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="kv" Text="{x:Static app:UiStrings.SessionManagerRoleLabel}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="kvv" Text="{Binding SelectedSession.Role}" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="kv" Text="{x:Static app:UiStrings.SessionColApplication}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Classes="kvv" Text="{Binding SelectedSession.Application}" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Classes="kv" Text="{x:Static app:UiStrings.SessionColHost}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Classes="kvv" Text="{Binding SelectedSession.Host}" />
                    <TextBlock Grid.Row="5" Grid.Column="0" Classes="kv" Text="{x:Static app:UiStrings.SessionColState}" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Classes="kvv" Text="{Binding SelectedSession.StateText}" />
                    <TextBlock Grid.Row="6" Grid.Column="0" Classes="kv" Text="{x:Static app:UiStrings.SessionManagerConnectedLabel}" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Classes="kvv" Text="{Binding SelectedSession.ConnectedText}" />
                  </Grid>
                </StackPanel>

                <!-- Why it matters (plain-language) -->
                <StackPanel Spacing="3" IsVisible="{Binding HasSelectedSessionWhyItMatters}">
                  <TextBlock Classes="section" Text="{x:Static app:UiStrings.SessionManagerWhyHeader}" />
                  <TextBlock Text="{Binding SelectedSessionWhyItMatters}" TextWrapping="Wrap" FontSize="{DynamicResource Text.Compact.Size}" />
                </StackPanel>

                <!-- Current statement + integration bridges -->
                <StackPanel Spacing="3" IsVisible="{Binding SelectedSession.HasStatement}">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Grid.Column="0" Classes="section" VerticalAlignment="Center"
                               Text="{x:Static app:UiStrings.SessionManagerCurrentStatementHeader}" />
                    <Button Grid.Column="1" Classes="icon" Command="{Binding OpenInEditorCommand}"
                            ToolTip.Tip="{x:Static app:UiStrings.SessionManagerOpenInEditorTip}">
                      <controls:SvgIcon Data="{StaticResource Icon.Query}" />
                    </Button>
                    <Button Grid.Column="2" Classes="icon" Command="{Binding AnalyzeInPerformanceCommand}"
                            ToolTip.Tip="{x:Static app:UiStrings.SessionManagerAnalyzeTip}">
                      <controls:SvgIcon Data="{StaticResource Icon.Activity}" />
                    </Button>
                  </Grid>
                  <TextBox Text="{Binding SelectedSession.CurrentStatement}" IsReadOnly="True" TextWrapping="Wrap"
                           FontFamily="Cascadia Code,Consolas,monospace" FontSize="{DynamicResource Text.Compact.Size}"
                           Background="{DynamicResource BackgroundBrush}" />
                </StackPanel>

                <!-- Activity (lifetime totals) -->
                <StackPanel Spacing="3">
                  <TextBlock Classes="section" Text="{x:Static app:UiStrings.SessionManagerActivityHeader}" />
                  <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="kv" Text="{x:Static app:UiStrings.SessionManagerActivitySeqReads}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Classes="kvv" Text="{Binding SelectedSession.SequentialReadsText}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="kv" Text="{x:Static app:UiStrings.SessionManagerActivityIdxReads}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="kvv" Text="{Binding SelectedSession.IndexedReadsText}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="kv" Text="{x:Static app:UiStrings.SessionManagerActivityInserts}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="kvv" Text="{Binding SelectedSession.InsertsText}" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="kv" Text="{x:Static app:UiStrings.SessionManagerActivityUpdates}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Classes="kvv" Text="{Binding SelectedSession.UpdatesText}" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Classes="kv" Text="{x:Static app:UiStrings.SessionManagerActivityDeletes}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Classes="kvv" Text="{Binding SelectedSession.DeletesText}" />
                  </Grid>
                </StackPanel>

                <!-- This session's transactions (compact; the full grid is the Transactions tab) -->
                <StackPanel Spacing="3" IsVisible="{Binding IsSessionFilterActive}">
                  <TextBlock Classes="section" Text="{x:Static app:UiStrings.SessionManagerTabTransactions}" />
                  <ItemsControl ItemsSource="{Binding Transactions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TransactionRowViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1">
                          <TextBlock Text="{Binding TransactionIdText}" FontSize="{DynamicResource Text.Compact.Size}" FontWeight="SemiBold"
                                     FontFamily="Cascadia Code,Consolas,monospace" />
                          <TextBlock Text="{Binding IsolationText}" FontSize="{DynamicResource Text.Compact.Size}" />
                          <TextBlock Text="{Binding AgeText}" FontSize="{DynamicResource Text.Compact.Size}" Foreground="{DynamicResource SubtleForegroundBrush}" />
                          <TextBlock Text="{Binding GcImpactText, StringFormat='GC {0}'}" FontSize="{DynamicResource Text.Compact.Size}"
                                     Foreground="{DynamicResource SubtleForegroundBrush}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <!-- Warnings scoped to this session (shared card) -->
                <StackPanel Spacing="3" IsVisible="{Binding HasSelectedSessionWarnings}">
                  <TextBlock Classes="section" Text="{x:Static app:UiStrings.SessionManagerTabWarnings}" />
                  <ItemsControl ItemsSource="{Binding SelectedSessionWarnings}"
                                ItemTemplate="{StaticResource SessionWarningCard}" />
                </StackPanel>

              </StackPanel>
            </ScrollViewer>
          </Panel>
        </TabItem>

        <!-- Warnings — same card shape as the Performance findings -->
        <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.SessionManagerTabWarnings}">
          <Panel>
            <!-- clean state -->
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsVisible="{Binding !HasWarnings}">
              <controls:SvgIcon Width="15" Height="15" Data="{StaticResource Icon.Check}"
                                Foreground="{DynamicResource SuccessIconBrush}" />
              <TextBlock Text="{x:Static app:UiStrings.SessionManagerNoWarnings}"
                         Foreground="{DynamicResource SubtleForegroundBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasWarnings}">
              <ItemsControl ItemsSource="{Binding Warnings}" Margin="8"
                            ItemTemplate="{StaticResource SessionWarningCard}" />
            </ScrollViewer>
          </Panel>

          <!-- overlaid maximize / restore (mirrors the trace detail-panel affordance) -->
        </TabItem>
      </TabControl>

      <Button Classes="icon" Click="OnToggleBottomMaximizeClick" ToolTip.Tip="{x:Static app:UiStrings.SessionManagerMaximizeTip}"
              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,6,0">
        <Panel>
          <controls:SvgIcon Data="{StaticResource Icon.ChevronsUp}" Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}" IsVisible="{Binding !IsDetailMaximized}" />
          <controls:SvgIcon Data="{StaticResource Icon.ChevronsDown}" Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}" IsVisible="{Binding IsDetailMaximized}" />
        </Panel>
      </Button>
    </Panel>
  </Grid>
</UserControl>
