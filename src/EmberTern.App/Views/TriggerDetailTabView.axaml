<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EmberTern.App.ViewModels"
             xmlns:app="using:EmberTern.App"
             xmlns:controls="using:EmberTern.App.Controls"
             xmlns:behaviors="using:EmberTern.App.Behaviors"
             xmlns:views="using:EmberTern.App.Views"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
             x:Class="EmberTern.App.Views.TriggerDetailTabView"
             x:Name="RootControl"
             x:DataType="vm:TriggerDetailTabViewModel"
             Background="{DynamicResource BackgroundBrush}">

  <UserControl.Styles>
    <Style Selector="DataGridRow">
      <Setter Property="Height" Value="{DynamicResource Size.Row.GridEdit}" />
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="Padding" Value="6 2" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">

    <TabControl Grid.Row="0"
                SelectedIndex="{Binding ActiveSubTabIndex, Mode=TwoWay}"
                Padding="0">

      <!-- Editor — Source mode (full text) OR Easy mode (metadata + Variables grid
           ABOVE a body-only editor). Compile / Format / Comment live in the main app
           toolbar (gated on IsTriggerDetailTabActive). -->
      <TabItem Classes="bottom-tab" Header="{app:Loc ProcedureDetailTabEditor}">
        <Grid>
          <!-- Source mode -->
          <ae:TextEditor x:Name="TriggerSqlEditor"
                         IsVisible="{Binding IsSourceMode}"
                         ShowLineNumbers="True"
                         FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                         FontSize="{DynamicResource Text.Code.Size}"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource BackgroundBrush}"
                         Foreground="{DynamicResource ForegroundBrush}" />

          <!-- Easy mode: metadata header + Variables grid (top) over body editor (bottom) -->
          <Grid IsVisible="{Binding EasyMode}" RowDefinitions="Auto,170,4,*">

            <!-- Trigger metadata header. -->
            <StackPanel Grid.Row="0" Orientation="Vertical" Spacing="4" Margin="8,6,8,4">
              <Grid ColumnDefinitions="Auto,2*,Auto,3*">
                <TextBlock Grid.Column="0" Classes="field-label" VerticalAlignment="Center"
                           Margin="0,0,8,0" Text="{app:Loc TriggerNameHeader}" />
                <TextBox Grid.Column="1" Text="{Binding EditableTriggerName, Mode=TwoWay}"
                         IsReadOnly="{Binding !IsNew}" />
                <TextBlock Grid.Column="2" Classes="field-label" VerticalAlignment="Center"
                           Margin="12,0,8,0" Text="{app:Loc TriggerTableHeader}" />
                <controls:SearchableComboBox Grid.Column="3" ItemsSource="{Binding AvailableTables}"
                          SelectedItem="{Binding SelectedTable, Mode=TwoWay}"
                          Watermark=""
                          HorizontalAlignment="Stretch" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Classes="field-label" VerticalAlignment="Center"
                             Text="{app:Loc TriggerTimingHeader}" />
                  <ComboBox ItemsSource="{Binding TimingOptions}"
                            SelectedItem="{Binding SelectedTiming, Mode=TwoWay}"
 MinWidth="100" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Classes="field-label" VerticalAlignment="Center"
                             Text="{app:Loc TriggerEventsHeader}" />
                  <CheckBox IsChecked="{Binding FiresInsert, Mode=TwoWay}"
                            Content="{app:Loc TriggerEventInsert}" FontSize="{DynamicResource Text.Compact.Size}" />
                  <CheckBox IsChecked="{Binding FiresUpdate, Mode=TwoWay}"
                            Content="{app:Loc TriggerEventUpdate}" FontSize="{DynamicResource Text.Compact.Size}" />
                  <CheckBox IsChecked="{Binding FiresDelete, Mode=TwoWay}"
                            Content="{app:Loc TriggerEventDelete}" FontSize="{DynamicResource Text.Compact.Size}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Classes="field-label" VerticalAlignment="Center"
                             Text="{app:Loc TriggerPositionHeader}" />
                  <NumericUpDown Value="{Binding PositionValue, Mode=TwoWay}"
                                 Minimum="0" Maximum="32767" Increment="1" FormatString="0"
 MinWidth="110" />
                </StackPanel>
                <CheckBox IsChecked="{Binding Active, Mode=TwoWay}"
                          Content="{app:Loc TriggerActive}" FontSize="{DynamicResource Text.Compact.Size}"
                          VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>

            <!-- Variables grid (the IBExpert improvement: structured DECLARE editing).
                 Columns built in code-behind via the shared FieldGridColumns. -->
            <DataGrid x:Name="VariablesGrid" Grid.Row="1"
                      ItemsSource="{Binding Variables}"
                      SelectedItem="{Binding SelectedVariable, Mode=TwoWay}"
                      PointerPressed="OnEasyGridPointerPressed"
                      IsReadOnly="False" AutoGenerateColumns="False"
                      CanUserSortColumns="False" CanUserResizeColumns="True"
                      CanUserReorderColumns="True" ColumnWidth="Auto" FontSize="{DynamicResource Text.Grid.Size}"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                      VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                      Background="{DynamicResource BackgroundBrush}">
              <DataGrid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{app:Loc CollectionMenuNew}" Icon="{app:MenuIcon Icon.Plus}" InputGesture="{app:CommandGesture CollectionAdd}" Command="{Binding AddVariableCommand}" />
                  <MenuItem Header="{app:Loc CollectionMenuDelete}" Icon="{app:MenuIcon Icon.Minus}" InputGesture="{app:CommandGesture CollectionRemove}" Command="{Binding DeleteVariableCommand}" />
                  <Separator />
                  <MenuItem Header="{app:Loc CollectionMoveUpTooltip}" Icon="{app:MenuIcon Icon.ArrowUp}" Command="{Binding MoveVariableUpCommand}" />
                  <MenuItem Header="{app:Loc CollectionMoveDownTooltip}" Icon="{app:MenuIcon Icon.ArrowDown}" Command="{Binding MoveVariableDownCommand}" />
                </ContextMenu>
              </DataGrid.ContextMenu>
            </DataGrid>

            <GridSplitter Grid.Row="2" Height="4" ResizeDirection="Rows"
                          Background="{DynamicResource BorderBrush}"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <ae:TextEditor x:Name="TriggerBodyEditor"
                           Grid.Row="3"
                           ShowLineNumbers="True"
                           FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                           FontSize="{DynamicResource Text.Code.Size}"
                           HorizontalScrollBarVisibility="Auto"
                           VerticalScrollBarVisibility="Auto"
                           Background="{DynamicResource BackgroundBrush}"
                           Foreground="{DynamicResource ForegroundBrush}" />
          </Grid>
        </Grid>
      </TabItem>

      <!-- Description — editable COMMENT ON TRIGGER. -->
      <TabItem Classes="bottom-tab" Header="{app:Loc ProcedureDetailTabDescription}">
        <Grid RowDefinitions="Auto,*" Background="{DynamicResource BackgroundBrush}">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="8,6,8,4"
                      IsVisible="{Binding CanEditDescription}">
            <TextBlock Text="{app:Loc TriggerDescriptionEditLabel}"
                       Classes="subtle" FontSize="{DynamicResource Text.Compact.Size}" VerticalAlignment="Center" />
            <Button Classes="icon" ToolTip.Tip="{app:Loc TableDescriptionSave}"
                    Command="{Binding SaveDescriptionCommand}">
              <controls:SvgIcon Data="{StaticResource Icon.Save}" />
            </Button>
            <Button Classes="flat" Padding="8,2"
                    Content="{app:Loc TableDescriptionClear}"
                    Command="{Binding ClearDescriptionCommand}" />
          </StackPanel>
          <TextBox Grid.Row="1"
                   Text="{Binding EditableDescription, Mode=TwoWay}"
                   IsEnabled="{Binding CanEditDescription}"
                   AcceptsReturn="True" TextWrapping="Wrap" FontSize="{DynamicResource Text.Compact.Size}"
                   Margin="8,0,8,8" Background="{DynamicResource BackgroundBrush}" />
        </Grid>
      </TabItem>

      <!-- Dependencies — dual tree (Used by / Depends on). -->
      <TabItem Classes="bottom-tab" Header="{app:Loc ProcedureDetailTabDependencies}">
        <Grid ColumnDefinitions="*,4,*">
          <Grid Grid.Column="0" RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Text="{app:Loc TableDetailDependedOnByHeader}"
                       FontSize="{DynamicResource Text.Compact.Size}" Foreground="{DynamicResource SubtleForegroundBrush}" Margin="{DynamicResource Margin.PanelCaption}" />
            <controls:DependencyTreeView Grid.Row="1" ItemsSource="{Binding DependedOnByTree}" />
          </Grid>

          <GridSplitter Grid.Column="1" Width="4" Background="{DynamicResource BorderBrush}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

          <Grid Grid.Column="2" RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Text="{app:Loc TableDetailDependsOnHeader}"
                       FontSize="{DynamicResource Text.Compact.Size}" Foreground="{DynamicResource SubtleForegroundBrush}" Margin="{DynamicResource Margin.PanelCaption}" />
            <controls:DependencyTreeView Grid.Row="1" ItemsSource="{Binding DependsOnTree}" />
          </Grid>
        </Grid>
      </TabItem>

      <!-- DDL — read-only reconstructed CREATE OR ALTER TRIGGER. -->
      <TabItem Classes="bottom-tab" Header="{app:Loc ProcedureDetailTabDdl}">
        <ae:TextEditor x:Name="TriggerDdlEditor"
                       ShowLineNumbers="True" IsReadOnly="True"
                       FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                       FontSize="{DynamicResource Text.Code.Size}"
                       HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                       Background="{DynamicResource BackgroundBrush}"
                       Foreground="{DynamicResource ForegroundBrush}" />
      </TabItem>

      <!-- Diagnostics (Stage 7 / S4) — the SAME view + VM the SQL Editor's Diagnostics tab uses,
           hosted per object. Shows the ACTIVE SQL document's findings (the LastFocusedSqlDocument
           rule — see DiagnosticsPanelHost). Appended LAST so the persisted ActiveSubTabIndex and the
           existing sub-tab indices never shift. -->
      <TabItem Classes="bottom-tab" Header="{app:Loc BottomTabDiagnostics}">
        <views:DiagnosticsPanelView x:Name="TriggerDiagnosticsPanel"
                                    DataContext="{Binding DiagnosticsPanel}" />
      </TabItem>

    </TabControl>

    <!-- Status panel — loading hint + error (consistent with Procedure Detail). -->
    <StackPanel Grid.Row="1" Orientation="Vertical">
      <TextBlock Text="{app:Loc TriggerDetailLoadingHint}" Classes="subtle"
                 Margin="10,4" FontSize="{DynamicResource Text.Compact.Size}" IsVisible="{Binding IsLoading}" />
      <!-- Compile / load errors go through the IDE's ONE message surface (UX Polish Seam 4) —
           same severity stripe, icon, wrapping and Copy affordance on every editor. -->
      <controls:MessageBanner Classes="docked" Severity="Error"
                              Message="{Binding ErrorMessage}"
                              IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </Grid>

</UserControl>
