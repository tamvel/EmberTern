<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EmberTern.App.ViewModels"
             xmlns:app="using:EmberTern.App"
             xmlns:controls="using:EmberTern.App.Controls"
             xmlns:behaviors="using:EmberTern.App.Behaviors"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
             x:Class="EmberTern.App.Views.TriggerDetailTabView"
             x:Name="RootControl"
             x:DataType="vm:TriggerDetailTabViewModel"
             Background="{DynamicResource BackgroundBrush}">

  <UserControl.Styles>
    <Style Selector="DataGridRow">
      <Setter Property="Height" Value="30" />
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="Padding" Value="6 2" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">

    <TabControl Grid.Row="0"
                SelectedIndex="{Binding ActiveSubTabIndex, Mode=TwoWay}"
                Padding="0">

      <!-- Editor — Source mode (full text) OR Easy mode (metadata + Variables grid
           ABOVE a body-only editor). Compile / Format / Comment live in the main app
           toolbar (gated on IsTriggerDetailTabActive). -->
      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.ProcedureDetailTabEditor}">
        <Grid>
          <!-- Source mode -->
          <ae:TextEditor x:Name="TriggerSqlEditor"
                         IsVisible="{Binding IsSourceMode}"
                         ShowLineNumbers="True"
                         FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                         FontSize="13"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource BackgroundBrush}"
                         Foreground="{DynamicResource ForegroundBrush}" />

          <!-- Easy mode: metadata header + Variables grid (top) over body editor (bottom) -->
          <Grid IsVisible="{Binding EasyMode}" RowDefinitions="Auto,170,4,*">

            <!-- Trigger metadata header. -->
            <StackPanel Grid.Row="0" Orientation="Vertical" Spacing="4" Margin="8,6,8,4">
              <Grid ColumnDefinitions="Auto,2*,Auto,3*">
                <TextBlock Grid.Column="0" Classes="field-label" VerticalAlignment="Center"
                           Margin="0,0,8,0" Text="{x:Static app:UiStrings.TriggerNameHeader}" />
                <TextBox Grid.Column="1" Text="{Binding EditableTriggerName, Mode=TwoWay}"
                         IsReadOnly="{Binding !IsNew}" FontSize="12" />
                <TextBlock Grid.Column="2" Classes="field-label" VerticalAlignment="Center"
                           Margin="12,0,8,0" Text="{x:Static app:UiStrings.TriggerTableHeader}" />
                <ComboBox Grid.Column="3" ItemsSource="{Binding AvailableTables}"
                          SelectedItem="{Binding SelectedTable, Mode=TwoWay}"
                          IsTextSearchEnabled="True" FontSize="12"
                          HorizontalAlignment="Stretch" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Classes="field-label" VerticalAlignment="Center"
                             Text="{x:Static app:UiStrings.TriggerTimingHeader}" />
                  <ComboBox ItemsSource="{Binding TimingOptions}"
                            SelectedItem="{Binding SelectedTiming, Mode=TwoWay}"
                            FontSize="12" MinWidth="100" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Classes="field-label" VerticalAlignment="Center"
                             Text="{x:Static app:UiStrings.TriggerEventsHeader}" />
                  <CheckBox IsChecked="{Binding FiresInsert, Mode=TwoWay}"
                            Content="{x:Static app:UiStrings.TriggerEventInsert}" FontSize="11" />
                  <CheckBox IsChecked="{Binding FiresUpdate, Mode=TwoWay}"
                            Content="{x:Static app:UiStrings.TriggerEventUpdate}" FontSize="11" />
                  <CheckBox IsChecked="{Binding FiresDelete, Mode=TwoWay}"
                            Content="{x:Static app:UiStrings.TriggerEventDelete}" FontSize="11" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Classes="field-label" VerticalAlignment="Center"
                             Text="{x:Static app:UiStrings.TriggerPositionHeader}" />
                  <NumericUpDown Value="{Binding PositionValue, Mode=TwoWay}"
                                 Minimum="0" Maximum="32767" Increment="1" FormatString="0"
                                 FontSize="12" MinWidth="110" />
                </StackPanel>
                <CheckBox IsChecked="{Binding Active, Mode=TwoWay}"
                          Content="{x:Static app:UiStrings.TriggerActive}" FontSize="11"
                          VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>

            <!-- Variables grid (the IBExpert improvement: structured DECLARE editing).
                 Columns built in code-behind via the shared FieldGridColumns. -->
            <DataGrid x:Name="VariablesGrid" Grid.Row="1"
                      ItemsSource="{Binding Variables}"
                      SelectedItem="{Binding SelectedVariable, Mode=TwoWay}"
                      IsReadOnly="False" AutoGenerateColumns="False"
                      CanUserSortColumns="False" CanUserResizeColumns="True"
                      CanUserReorderColumns="True" ColumnWidth="Auto" FontSize="11"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                      VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                      Background="{DynamicResource BackgroundBrush}" />

            <GridSplitter Grid.Row="2" Height="4" ResizeDirection="Rows"
                          Background="{DynamicResource BorderBrush}"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <ae:TextEditor x:Name="TriggerBodyEditor"
                           Grid.Row="3"
                           ShowLineNumbers="True"
                           FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                           FontSize="13"
                           HorizontalScrollBarVisibility="Auto"
                           VerticalScrollBarVisibility="Auto"
                           Background="{DynamicResource BackgroundBrush}"
                           Foreground="{DynamicResource ForegroundBrush}" />
          </Grid>
        </Grid>
      </TabItem>

      <!-- Description — editable COMMENT ON TRIGGER. -->
      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.ProcedureDetailTabDescription}">
        <Grid RowDefinitions="Auto,*" Background="{DynamicResource BackgroundBrush}">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="8,6,8,4"
                      IsVisible="{Binding CanEditDescription}">
            <TextBlock Text="{x:Static app:UiStrings.TableDescriptionEditLabel}"
                       Classes="subtle" FontSize="11" VerticalAlignment="Center" />
            <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.TableDescriptionSave}"
                    Command="{Binding SaveDescriptionCommand}">
              <controls:SvgIcon Data="{StaticResource Icon.Save}" />
            </Button>
            <Button Classes="flat" Padding="8,2"
                    Content="{x:Static app:UiStrings.TableDescriptionClear}"
                    Command="{Binding ClearDescriptionCommand}" />
          </StackPanel>
          <TextBox Grid.Row="1"
                   Text="{Binding EditableDescription, Mode=TwoWay}"
                   IsEnabled="{Binding CanEditDescription}"
                   AcceptsReturn="True" TextWrapping="Wrap" FontSize="11"
                   Margin="8,0,8,8" Background="{DynamicResource BackgroundBrush}" />
        </Grid>
      </TabItem>

      <!-- Dependencies — dual tree (Used by / Depends on). -->
      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.ProcedureDetailTabDependencies}">
        <Grid ColumnDefinitions="*,4,*">
          <Grid Grid.Column="0" RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Text="{x:Static app:UiStrings.TableDetailDependedOnByHeader}"
                       FontSize="11" Foreground="{DynamicResource SubtleForegroundBrush}" Margin="0,4,0,4" />
            <TreeView Grid.Row="1" ItemsSource="{Binding DependedOnByTree}"
                      Background="{DynamicResource BackgroundBrush}">
              <TreeView.DataTemplates>
                <TreeDataTemplate DataType="vm:DependencyGroupNode" ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <controls:SvgIcon Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}"
                                      Width="15" Height="15" VerticalAlignment="Center">
                      <controls:SvgIcon.Foreground>
                        <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                          <Binding Path="IconResourceKey" />
                          <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                        </MultiBinding>
                      </controls:SvgIcon.Foreground>
                    </controls:SvgIcon>
                    <TextBlock Text="{Binding Header}" FontSize="11" VerticalAlignment="Center" />
                  </StackPanel>
                </TreeDataTemplate>
                <DataTemplate DataType="vm:DependencyLeafNode">
                  <Border HorizontalAlignment="Stretch" Background="Transparent"
                          DoubleTapped="OnDependencyNodeDoubleTapped">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <controls:SvgIcon Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}"
                                        Width="15" Height="15" VerticalAlignment="Center">
                        <controls:SvgIcon.Foreground>
                          <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                            <Binding Path="IconResourceKey" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </controls:SvgIcon.Foreground>
                      </controls:SvgIcon>
                      <TextBlock Text="{Binding ObjectName}" FontSize="11" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding FieldName}" FontSize="10"
                                 Foreground="{DynamicResource SubtleForegroundBrush}" VerticalAlignment="Center"
                                 IsVisible="{Binding FieldName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </TreeView.DataTemplates>
            </TreeView>
          </Grid>

          <GridSplitter Grid.Column="1" Width="4" Background="{DynamicResource BorderBrush}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

          <Grid Grid.Column="2" RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Text="{x:Static app:UiStrings.TableDetailDependsOnHeader}"
                       FontSize="11" Foreground="{DynamicResource SubtleForegroundBrush}" Margin="0,4,0,4" />
            <TreeView Grid.Row="1" ItemsSource="{Binding DependsOnTree}"
                      Background="{DynamicResource BackgroundBrush}">
              <TreeView.DataTemplates>
                <TreeDataTemplate DataType="vm:DependencyGroupNode" ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <controls:SvgIcon Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}"
                                      Width="15" Height="15" VerticalAlignment="Center">
                      <controls:SvgIcon.Foreground>
                        <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                          <Binding Path="IconResourceKey" />
                          <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                        </MultiBinding>
                      </controls:SvgIcon.Foreground>
                    </controls:SvgIcon>
                    <TextBlock Text="{Binding Header}" FontSize="11" VerticalAlignment="Center" />
                  </StackPanel>
                </TreeDataTemplate>
                <DataTemplate DataType="vm:DependencyLeafNode">
                  <Border HorizontalAlignment="Stretch" Background="Transparent"
                          DoubleTapped="OnDependencyNodeDoubleTapped">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <controls:SvgIcon Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}"
                                        Width="15" Height="15" VerticalAlignment="Center">
                        <controls:SvgIcon.Foreground>
                          <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                            <Binding Path="IconResourceKey" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </controls:SvgIcon.Foreground>
                      </controls:SvgIcon>
                      <TextBlock Text="{Binding ObjectName}" FontSize="11" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding FieldName}" FontSize="10"
                                 Foreground="{DynamicResource SubtleForegroundBrush}" VerticalAlignment="Center"
                                 IsVisible="{Binding FieldName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </TreeView.DataTemplates>
            </TreeView>
          </Grid>
        </Grid>
      </TabItem>

      <!-- DDL — read-only reconstructed CREATE OR ALTER TRIGGER. -->
      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.ProcedureDetailTabDdl}">
        <ae:TextEditor x:Name="TriggerDdlEditor"
                       ShowLineNumbers="True" IsReadOnly="True"
                       FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                       FontSize="13"
                       HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                       Background="{DynamicResource BackgroundBrush}"
                       Foreground="{DynamicResource ForegroundBrush}" />
      </TabItem>

    </TabControl>

    <!-- Status panel — loading hint + error (consistent with Procedure Detail). -->
    <StackPanel Grid.Row="1" Orientation="Vertical">
      <TextBlock Text="{x:Static app:UiStrings.TriggerDetailLoadingHint}" Classes="subtle"
                 Margin="10,4" FontSize="11" IsVisible="{Binding IsLoading}" />
      <TextBlock Text="{Binding ErrorMessage}" Classes="subtle error" Margin="10,4" FontSize="11"
                 TextWrapping="Wrap" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </Grid>

</UserControl>
