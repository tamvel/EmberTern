<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:EmberTern.App"
             xmlns:vm="using:EmberTern.App.ViewModels"
             xmlns:controls="using:EmberTern.App.Controls"
             xmlns:views="using:EmberTern.App.Views"
             xmlns:behaviors="using:EmberTern.App.Behaviors"
             xmlns:ae="using:AvaloniaEdit"
             x:Class="EmberTern.App.Views.TraceMonitorTabView"
             x:Name="RootControl"
             x:DataType="vm:TraceMonitorTabViewModel"
             Background="{DynamicResource BackgroundBrush}"
             Foreground="{DynamicResource ForegroundBrush}">

  <UserControl.Styles>
    <!-- Amber, slightly-heavier Duration for operations at/above the slow threshold -->
    <Style Selector="TextBlock.slow">
      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Error rows: the message shown in the Object column reads in the danger colour -->
    <Style Selector="TextBlock.trace-error">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <!-- Segmented control (grouping + quick filter): flat segments, active one raised -->
    <Style Selector="Button.seg">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.seg:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
    </Style>
    <Style Selector="Button.seg.active">
      <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Detail-panel section header -->
    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,0,3" />
    </Style>
    <!-- Compact, uncramped column headers for this grid only -->
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Padding" Value="6,4" />
    </Style>
  </UserControl.Styles>

  <Grid x:Name="RootGrid" RowDefinitions="Auto,Auto,*,4,240">

    <!-- ① Session bar -->
    <Border Grid.Row="0" Background="{DynamicResource ChromeStrongBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="6,4">
      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Button Classes="icon" Command="{Binding StartCommand}" ToolTip.Tip="{x:Static app:UiStrings.TraceStart}">
          <controls:SvgIcon Data="{StaticResource Icon.Play}" Foreground="{DynamicResource SuccessIconBrush}" />
        </Button>
        <!-- Pause is enabled only while Running; once paused it disables and Start (which doubles
             as Resume) lights up. Two distinct buttons, never both usable at once. -->
        <Button Classes="icon" Command="{Binding PauseCommand}" ToolTip.Tip="{x:Static app:UiStrings.TracePause}">
          <controls:SvgIcon Data="{StaticResource Icon.Pause}" Foreground="{DynamicResource WarningBrush}" />
        </Button>
        <Button Classes="icon" Command="{Binding StopCommand}" ToolTip.Tip="{x:Static app:UiStrings.TraceStop}">
          <controls:SvgIcon Data="{StaticResource Icon.Stop}" Foreground="{DynamicResource DangerIconBrush}" />
        </Button>
        <Button Classes="icon" Command="{Binding ClearCommand}" ToolTip.Tip="{x:Static app:UiStrings.TraceClear}">
          <controls:SvgIcon Data="{StaticResource Icon.Eraser}" />
        </Button>

        <Border Width="1" Margin="4,2" Background="{DynamicResource BorderBrush}" />

        <!-- Grouping / lens selector (segmented) -->
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
          <StackPanel Orientation="Horizontal">
            <Button Classes="seg" Classes.active="{Binding IsGroupNone}"
                    Content="{x:Static app:UiStrings.TraceGroupNone}" Command="{Binding ShowChronologicalCommand}" />
            <Button Classes="seg" Classes.active="{Binding IsTransactionLens}"
                    Content="{x:Static app:UiStrings.TraceGroupTransaction}" Command="{Binding ShowTransactionsCommand}" />
            <Button Classes="seg" Classes.active="{Binding IsStatementLens}"
                    Content="{x:Static app:UiStrings.TraceGroupStatement}" Command="{Binding ShowStatementsCommand}" />
          </StackPanel>
        </Border>

        <Border Width="1" Margin="4,2" Background="{DynamicResource BorderBrush}" />

        <!-- Quick filter chips (segmented) -->
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
          <StackPanel Orientation="Horizontal">
            <Button Classes="seg" Classes.active="{Binding IsQuickFilterAll}"
                    Content="{x:Static app:UiStrings.TraceFilterAll}" Command="{Binding ShowAllCommand}" />
            <Button Classes="seg" Classes.active="{Binding IsQuickFilterErrors}"
                    Content="{x:Static app:UiStrings.TraceFilterErrors}" Command="{Binding ShowErrorsCommand}" />
            <Button Classes="seg" Classes.active="{Binding IsQuickFilterSlow}"
                    Content="{x:Static app:UiStrings.TraceFilterSlow}" Command="{Binding ShowSlowCommand}" />
          </StackPanel>
        </Border>

        <!-- Filter events (flyout, not toolbar buttons): hide captured rows by kind + operation.
             DISPLAY-level — distinct from the source-level "Include function calls" capture toggle. -->
        <Button Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.TraceFilterEventsTip}">
          <Panel>
            <controls:SvgIcon Data="{StaticResource Icon.Filter}" />
            <Border Classes="filter-active-dot" IsVisible="{Binding IsEventFilterActive}" />
          </Panel>
          <Button.Flyout>
            <Flyout Placement="Bottom">
              <StackPanel Spacing="5" MinWidth="190">
                <TextBlock Classes="section" Text="{x:Static app:UiStrings.TraceFilterSectionTypes}" />
                <CheckBox IsChecked="{Binding ShowStatementEvents}"><TextBlock Text="{x:Static app:UiStrings.TraceFilterStatements}" /></CheckBox>
                <CheckBox IsChecked="{Binding ShowProcedureEvents}"><TextBlock Text="{x:Static app:UiStrings.TraceFilterProcedures}" /></CheckBox>
                <CheckBox IsChecked="{Binding ShowTriggerEvents}"><TextBlock Text="{x:Static app:UiStrings.TraceFilterTriggers}" /></CheckBox>
                <CheckBox IsChecked="{Binding ShowFunctionEvents}"><TextBlock Text="{x:Static app:UiStrings.TraceFilterFunctions}" /></CheckBox>
                <Border Height="1" Margin="0,3" Background="{DynamicResource BorderBrush}" />
                <TextBlock Classes="section" Text="{x:Static app:UiStrings.TraceFilterSectionOperations}" />
                <CheckBox IsChecked="{Binding ShowOpSelect}"><TextBlock Text="{x:Static app:UiStrings.TraceFilterOpSelect}" /></CheckBox>
                <CheckBox IsChecked="{Binding ShowOpInsert}"><TextBlock Text="{x:Static app:UiStrings.TraceFilterOpInsert}" /></CheckBox>
                <CheckBox IsChecked="{Binding ShowOpUpdate}"><TextBlock Text="{x:Static app:UiStrings.TraceFilterOpUpdate}" /></CheckBox>
                <CheckBox IsChecked="{Binding ShowOpDelete}"><TextBlock Text="{x:Static app:UiStrings.TraceFilterOpDelete}" /></CheckBox>
                <CheckBox IsChecked="{Binding ShowOpExecute}"><TextBlock Text="{x:Static app:UiStrings.TraceFilterOpExecute}" /></CheckBox>
                <CheckBox IsChecked="{Binding ShowOpDdl}"><TextBlock Text="{x:Static app:UiStrings.TraceFilterOpDdl}" /></CheckBox>
                <Button Classes="flat" HorizontalAlignment="Right" Margin="0,4,0,0"
                        Command="{Binding ResetEventFilterCommand}" Content="{x:Static app:UiStrings.TraceFilterReset}" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>

        <!-- Free-text search over the visible rows — full SQL, object/routine name, error message,
             session identity (user/role/process/host) and the ids (tx/attachment/pid). A FILLED
             search field (BackgroundBrush contrasts the ChromeStrong toolbar) so it reads clearly
             as a text input, not another segmented button group. Grouped with the quick chips +
             funnel as the one "filter" zone; distinct from the funnel (structured). -->
        <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="4" Height="26" Padding="7,0,6,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <controls:SvgIcon Data="{StaticResource Icon.Search}" Width="14" Height="14"
                              Foreground="{DynamicResource SubtleForegroundBrush}" VerticalAlignment="Center" />
            <TextBox Width="200" Classes="frameless" Padding="0" MinHeight="0"
                     VerticalAlignment="Center" VerticalContentAlignment="Center"
                     PlaceholderText="{x:Static app:UiStrings.TraceFilterWatermark}"
                     Text="{Binding FilterText}" />
          </StackPanel>
        </Border>

        <!-- Conditional grid filter ("Add condition"): the shared FilterPanelView opens below the
             toolbar. Distinct icon (list-filter) from the structured funnel; a ToggleButton so the
             "on" look tracks panel visibility, with the active-filter dot when a filter is applied. -->
        <ToggleButton Classes="icon" ToolTip.Tip="{x:Static app:UiStrings.TraceGridFilterTip}"
                      IsChecked="{Binding GridFilterPanel.IsPanelOpen, Mode=TwoWay}">
          <Panel>
            <controls:SvgIcon Data="{StaticResource Icon.ListFilter}" />
            <Border Classes="filter-active-dot" IsVisible="{Binding GridFilterPanel.IsFilterActive}" />
          </Panel>
        </ToggleButton>

        <Border Width="1" Margin="4,2" Background="{DynamicResource BorderBrush}" />

        <!-- Compact icon toggles (view behaviour, not filtering) -->
        <ToggleButton Classes="icon" IsChecked="{Binding HideSelfActivity}" ToolTip.Tip="{x:Static app:UiStrings.TraceHideSelfTip}">
          <controls:SvgIcon Data="{StaticResource Icon.EyeOff}" />
        </ToggleButton>
        <ToggleButton Classes="icon" IsChecked="{Binding FollowTail}" ToolTip.Tip="{x:Static app:UiStrings.TraceFollowTailTip}">
          <controls:SvgIcon Data="{StaticResource Icon.ArrowDown}" />
        </ToggleButton>
        <ToggleButton Classes="icon" IsChecked="{Binding ShowOnlySelected}" IsVisible="{Binding IsLensOpen}"
                      ToolTip.Tip="{x:Static app:UiStrings.TraceShowOnlySelectedTip}">
          <controls:SvgIcon Data="{StaticResource Icon.Crosshair}" />
        </ToggleButton>
        <ToggleButton Classes="icon" IsChecked="{Binding IncludeFunctions}"
                      ToolTip.Tip="{x:Static app:UiStrings.TraceIncludeFunctionsTip}">
          <controls:SvgIcon Data="{StaticResource Icon.Function}" />
        </ToggleButton>
        <!-- Export the trace grid via the shared Export Framework (default = the filtered view). -->
        <Button Classes="icon" Click="OnExportClick" IsEnabled="{Binding CanExport}"
                ToolTip.Tip="{x:Static app:UiStrings.ExportResultsTooltip}">
          <controls:SvgIcon Data="{StaticResource Icon.Download}" />
        </Button>

        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                   Foreground="{DynamicResource SubtleForegroundBrush}" Margin="8,0,0,0" />
      </StackPanel>
    </Border>

    <!-- Conditional grid filter panel (shared) — self-hides via IsPanelOpen. -->
    <views:FilterPanelView Grid.Row="1" DataContext="{Binding GridFilterPanel}" />

    <!-- ② Lens rail (optional) + chronological grid -->
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*">

      <Border Grid.Column="0" Width="290" IsVisible="{Binding IsLensOpen}"
              Background="{DynamicResource PanelBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <ListBox ItemsSource="{Binding CurrentLens}" SelectedItem="{Binding SelectedLensItem}">
          <ListBox.DataTemplates>
            <!-- Transaction lens: representative statement, then TRA · N stmt · duration -->
            <DataTemplate DataType="vm:TraceTransactionLensItem">
              <StackPanel Spacing="1" Margin="2,3">
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontSize="11"
                           FontFamily="Cascadia Code,Consolas,monospace" />
                <TextBlock Text="{Binding SubText}" FontSize="10" Foreground="{DynamicResource SubtleForegroundBrush}" />
              </StackPanel>
            </DataTemplate>
            <!-- Statements lens: representative SQL, then ×N (accent) + total · avg · max -->
            <DataTemplate DataType="vm:TraceFingerprintLensItem">
              <StackPanel Spacing="1" Margin="2,3">
                <TextBlock Text="{Binding Sql}" TextTrimming="CharacterEllipsis" FontSize="11"
                           FontFamily="Cascadia Code,Consolas,monospace" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding CountText}" FontSize="11" FontWeight="SemiBold"
                             Foreground="{DynamicResource AccentBrush}" />
                  <TextBlock Text="{Binding MetricsText}" FontSize="10"
                             Foreground="{DynamicResource SubtleForegroundBrush}" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ListBox.DataTemplates>
        </ListBox>
      </Border>

      <!-- grid + empty-state overlay + jump-to-latest affordance -->
      <Panel Grid.Column="1">
        <DataGrid x:Name="EventsGrid"
                  behaviors:GridLayoutBehavior.GridId="TraceEvents"
                  CellPointerPressed="OnEventCellPointerPressed"
                  ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  CanUserSortColumns="False" CanUserReorderColumns="True"
                  ColumnWidth="Auto"
                  GridLinesVisibility="Horizontal" FontSize="11">
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{x:Static app:UiStrings.GridCopyCell}" Icon="{app:MenuIcon Icon.Copy}" Click="OnCopyCellClick" />
              <MenuItem Header="{x:Static app:UiStrings.GridCopyRow}" Icon="{app:MenuIcon Icon.Copy}" Click="OnCopyRowClick" />
              <MenuItem Header="{x:Static app:UiStrings.GridCopyRowWithHeaders}" Icon="{app:MenuIcon Icon.Copy}" Click="OnCopyRowWithHeadersClick" />
              <MenuItem Header="{x:Static app:UiStrings.GridCopyAllWithHeaders}" Icon="{app:MenuIcon Icon.Copy}" Click="OnCopyAllWithHeadersClick" />
              <MenuItem Header="{x:Static app:UiStrings.TraceDetailCopySql}" Icon="{app:MenuIcon Icon.Query}" Click="OnCopySqlClick" />
              <MenuItem Header="{x:Static app:UiStrings.ExportResultsMenuItem}" Icon="{app:MenuIcon Icon.Download}" Click="OnExportClick" />
              <Separator />
              <!-- Filter-from-cell verbs → add a condition to the shared grid filter (gotcha #99:
                   the clicked cell is resolved via CellPointerPressed). No-op on non-filterable
                   columns (# / gutter, which carry no filter-column Tag). -->
              <MenuItem Header="{x:Static app:UiStrings.FilterByValue}" Icon="{app:MenuIcon Icon.Filter}" Click="OnFilterByValueClick" />
              <MenuItem Header="{x:Static app:UiStrings.FilterExcludeValue}" Icon="{app:MenuIcon Icon.ListX}" Click="OnExcludeValueClick" />
              <MenuItem Header="{x:Static app:UiStrings.FilterContainsValue}" Icon="{app:MenuIcon Icon.Search}" Click="OnFilterContainsClick" />
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.Columns>
            <!-- gutter: transaction-boundary rule (4A) + error stripe + lens highlight.
                 Space header (not empty) so grid-layout ordering keeps it stable + non-reorderable;
                 Auto width over a fixed-width cell so it survives the auto-fit reset. -->
            <DataGridTemplateColumn Header=" " Width="Auto" CanUserResize="False" CanUserReorder="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:TraceEventRowViewModel">
                  <Panel Width="8">
                    <Border Height="2" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                            Background="{DynamicResource AccentMutedBrush}"
                            IsVisible="{Binding IsTransactionStart}" />
                    <Border Background="{DynamicResource AccentBrush}" IsVisible="{Binding IsHighlighted}" />
                    <Border Background="{DynamicResource DangerIconBrush}" IsVisible="{Binding IsError}" />
                  </Panel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Header="{x:Static app:UiStrings.TraceColSeq}" Binding="{Binding Sequence}" MinWidth="48" />
            <DataGridTextColumn Header="{x:Static app:UiStrings.TraceColTime}" Binding="{Binding TimeText}" MinWidth="86" />

            <DataGridTemplateColumn Header="{x:Static app:UiStrings.TraceColEvent}" MinWidth="100">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:TraceEventRowViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <controls:SvgIcon Width="13" Height="13"
                                      Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}">
                      <controls:SvgIcon.Foreground>
                        <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                          <Binding Path="IconResourceKey" />
                          <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                        </MultiBinding>
                      </controls:SvgIcon.Foreground>
                    </controls:SvgIcon>
                    <TextBlock Text="{Binding KindLabel}" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{x:Static app:UiStrings.TraceColDuration}" MinWidth="90">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:TraceEventRowViewModel">
                  <TextBlock Text="{Binding DurationText}" Classes.slow="{Binding IsSlow}"
                             VerticalAlignment="Center" Margin="6,0" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Object: hierarchy indentation + branch glyph + elided SQL / name -->
            <DataGridTemplateColumn Header="{x:Static app:UiStrings.TraceColObject}" MinWidth="320">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:TraceEventRowViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                    <Border Width="{Binding IndentMargin}" />
                    <TextBlock Text="└" Foreground="{DynamicResource SubtleForegroundBrush}"
                               IsVisible="{Binding IsChild}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ObjectText}" Classes.trace-error="{Binding IsError}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Header="{x:Static app:UiStrings.TraceColRows}" Binding="{Binding RowsText}" MinWidth="64" />
            <DataGridTextColumn Header="{x:Static app:UiStrings.TraceColReads}" Binding="{Binding ReadsText}" MinWidth="72" />
            <DataGridTextColumn Header="{x:Static app:UiStrings.TraceColTx}" Binding="{Binding TransactionId}" MinWidth="90" />
          </DataGrid.Columns>
        </DataGrid>

        <!-- Empty state (no session / waiting / no match) -->
        <TextBlock IsVisible="{Binding ShowEmptyState}" Text="{Binding EmptyStateText}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0"
                   Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="13" />

        <!-- Resume follow-tail (appears when follow is paused, e.g. after a manual scroll-up) -->
        <Button Classes="primary" Command="{Binding JumpToLatestCommand}" IsVisible="{Binding !FollowTail}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,14">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <controls:SvgIcon Width="13" Height="13" Data="{StaticResource Icon.ArrowDown}"
                              Foreground="{DynamicResource OnAccentBrush}" />
            <TextBlock Text="{x:Static app:UiStrings.TraceJumpLatest}" />
          </StackPanel>
        </Button>
      </Panel>
    </Grid>

    <!-- Double-tap the splitter to maximize/restore the detail panel (mirrors the SQL editor). -->
    <GridSplitter Grid.Row="3" ResizeDirection="Rows" HorizontalAlignment="Stretch"
                  Background="{DynamicResource BorderBrush}"
                  DoubleTapped="OnDetailSplitterDoubleTapped" />

    <!-- ③ Detail panel -->
    <Border Grid.Row="4" Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,8">
      <Grid RowDefinitions="*">
        <TextBlock Text="{x:Static app:UiStrings.TraceDetailNoSelection}"
                   Foreground="{DynamicResource SubtleForegroundBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding !Detail.HasSelection}" />

        <Grid IsVisible="{Binding Detail.HasSelection}" ColumnDefinitions="*,14,340">
          <!-- left: header + SQL -->
          <DockPanel Grid.Column="0">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" Margin="0,0,0,6">
              <controls:SvgIcon Grid.Column="0" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0"
                                Data="{Binding Detail.IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}">
                <controls:SvgIcon.Foreground>
                  <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                    <Binding Path="Detail.IconResourceKey" />
                    <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                  </MultiBinding>
                </controls:SvgIcon.Foreground>
              </controls:SvgIcon>
              <TextBlock Grid.Column="1" Text="{Binding Detail.KindLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding Detail.ObjectName}" Foreground="{DynamicResource AccentBrush}"
                         IsVisible="{Binding Detail.HasObjectName}" Margin="8,0,0,0" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
              <ToggleButton Grid.Column="3" Classes="icon" IsChecked="{Binding ShowValues}"
                            IsVisible="{Binding Detail.HasParameters}" ToolTip.Tip="{x:Static app:UiStrings.TraceDetailShowValuesTip}">
                <controls:SvgIcon Data="{StaticResource Icon.Braces}" />
              </ToggleButton>
              <Button Grid.Column="4" Classes="icon" Command="{Binding CopySqlCommand}"
                      IsVisible="{Binding Detail.HasSql}" ToolTip.Tip="{x:Static app:UiStrings.TraceDetailCopySql}">
                <controls:SvgIcon Data="{StaticResource Icon.Copy}" />
              </Button>
              <Button Grid.Column="5" Classes="icon" Command="{Binding OpenInEditorCommand}"
                      IsVisible="{Binding Detail.HasSql}" ToolTip.Tip="{x:Static app:UiStrings.TraceDetailOpenInEditor}">
                <controls:SvgIcon Data="{StaticResource Icon.Query}" />
              </Button>
              <Button Grid.Column="6" Classes="icon" Click="OnToggleDetailMaximizeClick"
                      ToolTip.Tip="{x:Static app:UiStrings.TraceDetailMaximizeTip}">
                <Panel>
                  <controls:SvgIcon Data="{StaticResource Icon.ChevronsUp}" IsVisible="{Binding !IsDetailMaximized}" />
                  <controls:SvgIcon Data="{StaticResource Icon.ChevronsDown}" IsVisible="{Binding IsDetailMaximized}" />
                </Panel>
              </Button>
            </Grid>
            <ae:TextEditor x:Name="DetailSqlEditor" IsReadOnly="True"
                           FontFamily="Cascadia Code,Consolas,Menlo,monospace" FontSize="12"
                           HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                           Background="{DynamicResource BackgroundBrush}"
                           Foreground="{DynamicResource ForegroundBrush}"
                           IsVisible="{Binding Detail.HasSql}" />
          </DockPanel>

          <!-- right: scrollable info sections -->
          <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">

              <!-- error -->
              <Border Background="{DynamicResource RowAlternateBrush}" CornerRadius="4" Padding="8,6"
                      IsVisible="{Binding Detail.HasError}">
                <TextBlock Text="{Binding Detail.ErrorText}" Foreground="{DynamicResource ErrorBrush}"
                           TextWrapping="Wrap" FontSize="11" />
              </Border>

              <!-- timing -->
              <StackPanel IsVisible="{Binding Detail.HasTiming}">
                <TextBlock Classes="section" Text="{x:Static app:UiStrings.TraceDetailTiming}" />
                <TextBlock Text="{Binding Detail.TimingText}" FontSize="11" />
              </StackPanel>

              <!-- session (who ran this) -->
              <StackPanel IsVisible="{Binding Detail.HasSession}">
                <TextBlock Classes="section" Text="{x:Static app:UiStrings.TraceDetailSession}" />
                <ItemsControl ItemsSource="{Binding Detail.SessionRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TraceDetailKv">
                      <Grid ColumnDefinitions="86,*" Margin="0,1">
                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11"
                                   Foreground="{DynamicResource SubtleForegroundBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Value}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- table access (red = sequential, blue = index) -->
              <StackPanel IsVisible="{Binding Detail.HasTableAccess}">
                <TextBlock Classes="section" Text="{x:Static app:UiStrings.TraceDetailTableAccess}" />
                <ItemsControl ItemsSource="{Binding Detail.TableAccess}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TableAccessBarViewModel">
                      <Grid ColumnDefinitions="110,160,Auto" Margin="0,2" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="{Binding Table}" FontSize="11"
                                   FontFamily="Consolas,Cascadia Code,monospace" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Table}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <!-- One rounded, clipped pill track so BOTH ends stay rounded regardless of the seq/idx split -->
                        <Border Grid.Column="1" Width="160" Height="10" CornerRadius="5" ClipToBounds="True"
                                Background="{DynamicResource RowAlternateBrush}" VerticalAlignment="Center" HorizontalAlignment="Left">
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Border Width="{Binding SeqWidth}" Background="{DynamicResource DangerIconBrush}" />
                            <Border Width="{Binding IdxWidth}" Background="{DynamicResource InfoIconBrush}" />
                          </StackPanel>
                        </Border>
                        <TextBlock Grid.Column="2" Text="{Binding ReadsText}" FontSize="10" Margin="8,0,0,0"
                                   Foreground="{DynamicResource SubtleForegroundBrush}" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- parameters -->
              <StackPanel IsVisible="{Binding Detail.HasParameters}">
                <TextBlock Classes="section" Text="{x:Static app:UiStrings.TraceDetailParameters}" />
                <ItemsControl ItemsSource="{Binding Detail.Parameters}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
