<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EmberTern.App.ViewModels"
             xmlns:app="using:EmberTern.App"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="480"
             x:Class="EmberTern.App.Views.PerformancePanelView"
             x:Name="RootControl"
             x:DataType="vm:PerformancePanelViewModel"
             Background="{DynamicResource BackgroundBrush}">

  <!-- Phase 1: verdict + execution plan tree + details drawer. The findings (zone 2)
       and table-access (zone 3-left) areas render placeholder empty-states; later
       phases fill them without changing this layout. -->
  <Grid RowDefinitions="Auto,*">

    <!-- (1) VERDICT BAR -->
    <Border Grid.Row="0"
            Background="{DynamicResource ElevatedPanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,8">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
          <!-- verdict line (report present) -->
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasReport}">
            <TextBlock Text="●" FontSize="13" VerticalAlignment="Center">
              <TextBlock.Foreground>
                <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                  <Binding Path="Verdict.GradeBrushKey" />
                  <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                </MultiBinding>
              </TextBlock.Foreground>
            </TextBlock>
            <TextBlock Text="{Binding Verdict.GradeText}" FontWeight="SemiBold" FontSize="13"
                       Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center" />
            <TextBlock Text="·" Foreground="{DynamicResource SubtleForegroundBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Verdict.DurationText}" FontSize="12"
                       Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center" />
            <TextBlock Text="·" Foreground="{DynamicResource SubtleForegroundBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Verdict.RowsText}" FontSize="12"
                       Foreground="{DynamicResource SubtleForegroundBrush}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding Verdict.Headline}" FontSize="12" TextWrapping="Wrap"
                     Foreground="{DynamicResource SubtleForegroundBrush}"
                     IsVisible="{Binding HasReport}" />

          <!-- empty / progress / error states -->
          <TextBlock Text="{x:Static app:UiStrings.PerformanceEmptyHint}" FontSize="12"
                     Foreground="{DynamicResource SubtleForegroundBrush}"
                     IsVisible="{Binding ShowEmptyState}" />
          <TextBlock Text="{x:Static app:UiStrings.PerformanceProfilingHint}" FontSize="12"
                     Foreground="{DynamicResource SubtleForegroundBrush}"
                     IsVisible="{Binding IsProfiling}" />
          <TextBlock Text="{Binding ErrorMessage}" FontSize="12" TextWrapping="Wrap"
                     Foreground="{DynamicResource DangerIconBrush}"
                     IsVisible="{Binding HasError}" />
        </StackPanel>

        <Button Grid.Column="1" Classes="primary"
                Content="{x:Static app:UiStrings.PerformanceRunProfile}"
                ToolTip.Tip="{x:Static app:UiStrings.PerformanceRunProfileTooltip}"
                Command="{Binding RunAndProfileCommand}"
                VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Analysis body: one scroll, answer-first -->
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="0">

        <!-- (2) FINDINGS — placeholder in Phase 1 -->
        <Border Padding="12,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
          <StackPanel Spacing="4">
            <TextBlock Text="{x:Static app:UiStrings.PerformanceFindingsHeader}"
                       FontWeight="SemiBold" FontSize="12"
                       Foreground="{DynamicResource ForegroundBrush}" />
            <TextBlock Text="{x:Static app:UiStrings.PerformanceFindingsPlaceholder}"
                       FontSize="11" FontStyle="Italic"
                       Foreground="{DynamicResource SubtleForegroundBrush}" />
          </StackPanel>
        </Border>

        <!-- (3) ACCESS & PLAN -->
        <Grid ColumnDefinitions="*,*" MinHeight="200">
          <!-- left: table access placeholder (Phase 2) -->
          <Border Grid.Column="0" Padding="12,10"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <StackPanel Spacing="4">
              <TextBlock Text="{x:Static app:UiStrings.PerformanceAccessHeader}"
                         FontWeight="SemiBold" FontSize="12"
                         Foreground="{DynamicResource ForegroundBrush}" />
              <TextBlock Text="{x:Static app:UiStrings.PerformanceAccessPlaceholder}"
                         FontSize="11" FontStyle="Italic" TextWrapping="Wrap"
                         Foreground="{DynamicResource SubtleForegroundBrush}" />
            </StackPanel>
          </Border>

          <!-- right: execution plan tree -->
          <DockPanel Grid.Column="1" Margin="12,10">
            <TextBlock DockPanel.Dock="Top" Text="{x:Static app:UiStrings.PerformancePlanHeader}"
                       FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"
                       Foreground="{DynamicResource ForegroundBrush}" />
            <TextBlock DockPanel.Dock="Top" Text="{x:Static app:UiStrings.PerformancePlanEmptyHint}"
                       FontSize="11" FontStyle="Italic"
                       Foreground="{DynamicResource SubtleForegroundBrush}"
                       IsVisible="{Binding ShowPlanEmpty}" />
            <TreeView ItemsSource="{Binding PlanRoots}" IsVisible="{Binding HasPlan}"
                      Background="Transparent" BorderThickness="0">
              <TreeView.ItemTemplate>
                <TreeDataTemplate ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="●" FontSize="9" VerticalAlignment="Center"
                               Foreground="{DynamicResource WarningBrush}"
                               IsVisible="{Binding IsSequentialScan}"
                               ToolTip.Tip="Sequential (full) table scan" />
                    <TextBlock Text="{Binding DisplayText}" FontSize="11"
                               FontFamily="Consolas,Cascadia Code,monospace"
                               Foreground="{DynamicResource ForegroundBrush}"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
          </DockPanel>
        </Grid>

        <!-- (4) DETAILS — expert drawer -->
        <Expander Header="{x:Static app:UiStrings.PerformanceDetailsHeader}"
                  IsExpanded="False" Margin="0,4,0,0"
                  IsVisible="{Binding HasReport}">
          <StackPanel Spacing="8" Margin="12,4,12,12">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static app:UiStrings.PerformanceTimingLabel}"
                         FontSize="11" Margin="0,0,12,2"
                         Foreground="{DynamicResource SubtleForegroundBrush}" />
              <SelectableTextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Details.TimingsText}"
                                   FontSize="11" Foreground="{DynamicResource ForegroundBrush}" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static app:UiStrings.PerformanceCaptureLabel}"
                         FontSize="11" Margin="0,0,12,2"
                         Foreground="{DynamicResource SubtleForegroundBrush}" />
              <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Details.CaptureMethodText}"
                                   FontSize="11" Foreground="{DynamicResource ForegroundBrush}" />
              <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static app:UiStrings.PerformancePlanDialectLabel}"
                         FontSize="11" Margin="0,0,12,2"
                         Foreground="{DynamicResource SubtleForegroundBrush}" />
              <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Details.PlanDialectText}"
                                   FontSize="11" Foreground="{DynamicResource ForegroundBrush}" />
            </Grid>

            <DockPanel IsVisible="{Binding Details.HasPlanText}">
              <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                <TextBlock Grid.Column="0" Text="{x:Static app:UiStrings.PerformanceRawPlanLabel}"
                           FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />
                <Button Grid.Column="1" Classes="flat"
                        Content="{x:Static app:UiStrings.PerformanceCopy}"
                        Command="{Binding CopyDetailsCommand}" />
              </Grid>
              <Border Background="{DynamicResource PanelBrush}"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                      CornerRadius="3" Padding="8">
                <SelectableTextBlock Text="{Binding Details.RawPlanText}"
                                     FontFamily="Consolas,Cascadia Code,monospace" FontSize="11"
                                     Foreground="{DynamicResource ForegroundBrush}" />
              </Border>
            </DockPanel>
          </StackPanel>
        </Expander>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
