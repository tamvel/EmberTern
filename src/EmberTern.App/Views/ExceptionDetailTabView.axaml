<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EmberTern.App.ViewModels"
             xmlns:app="using:EmberTern.App"
             xmlns:controls="using:EmberTern.App.Controls"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="EmberTern.App.Views.ExceptionDetailTabView"
             x:Name="RootControl"
             x:DataType="vm:ExceptionDetailTabViewModel"
             Background="{DynamicResource BackgroundBrush}">

  <Grid RowDefinitions="*,Auto">

    <TabControl Grid.Row="0"
                SelectedIndex="{Binding ActiveSubTabIndex, Mode=TwoWay}"
                Padding="0">

      <!-- Exception — the editable form (name + message). Name is read-only for an
           existing exception (editable only in the New flow); Message is editable.
           Compile / Revert / Delete live in the main app toolbar. -->
      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.ExceptionDetailTabException}">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,*"
              Margin="12" VerticalAlignment="Top">

          <TextBlock Grid.Row="0" Grid.Column="0" Classes="field-label" VerticalAlignment="Center"
                     Margin="0,0,12,8" Text="{x:Static app:UiStrings.ExceptionNameHeader}" />
          <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                   Text="{Binding EditableName, Mode=TwoWay}"
                   IsReadOnly="{Binding !IsNew}" />

          <TextBlock Grid.Row="1" Grid.Column="0" Classes="field-label"
                     Margin="0,0,12,0" Text="{x:Static app:UiStrings.ExceptionMessageHeader}" />
          <TextBox Grid.Row="1" Grid.Column="1"
                   Text="{Binding Message, Mode=TwoWay}"
                   AcceptsReturn="True" TextWrapping="Wrap"
                   MinHeight="80"
                   Background="{DynamicResource BackgroundBrush}" />
        </Grid>
      </TabItem>

      <!-- Description — editable COMMENT ON EXCEPTION. -->
      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.ExceptionDetailTabDescription}">
        <Grid RowDefinitions="Auto,*" Margin="12">
          <TextBlock Grid.Row="0" Classes="field-label"
                     Margin="0,0,0,6" Text="{x:Static app:UiStrings.ExceptionDescriptionEditLabel}" />
          <TextBox Grid.Row="1"
                   Text="{Binding EditableDescription, Mode=TwoWay}"
                   AcceptsReturn="True" TextWrapping="Wrap"
                   VerticalAlignment="Stretch"
                   Background="{DynamicResource BackgroundBrush}" />
        </Grid>
      </TabItem>

      <!-- Dependencies — reuses the same dual-tree layout + templates as
           TableDetail / Generator (Used by / Depends on). An exception is normally
           only "depended on by" procedures / triggers / functions / packages. -->
      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.ExceptionDetailTabDependencies}">
        <Grid ColumnDefinitions="*,4,*">
          <Grid Grid.Column="0" RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0"
                       Text="{x:Static app:UiStrings.TableDetailDependedOnByHeader}"
                       FontSize="{DynamicResource Text.Compact.Size}"
                       Foreground="{DynamicResource SubtleForegroundBrush}"
                       Margin="0,4,0,4" />
            <TreeView Grid.Row="1"
                      ItemsSource="{Binding DependedOnByTree}"
                      Background="{DynamicResource BackgroundBrush}">
              <TreeView.DataTemplates>
                <TreeDataTemplate DataType="vm:DependencyGroupNode"
                                  ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <controls:SvgIcon Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}"
                                      Width="15" Height="15"
                                      VerticalAlignment="Center">
                      <controls:SvgIcon.Foreground>
                        <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                          <Binding Path="IconResourceKey" />
                          <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                        </MultiBinding>
                      </controls:SvgIcon.Foreground>
                    </controls:SvgIcon>
                    <TextBlock Text="{Binding Header}" FontSize="{DynamicResource Text.Compact.Size}" VerticalAlignment="Center" />
                  </StackPanel>
                </TreeDataTemplate>
                <DataTemplate DataType="vm:DependencyLeafNode">
                  <Border HorizontalAlignment="Stretch"
                          Background="Transparent"
                          DoubleTapped="OnDependencyNodeDoubleTapped">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <controls:SvgIcon Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}"
                                        Width="15" Height="15"
                                        VerticalAlignment="Center">
                        <controls:SvgIcon.Foreground>
                          <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                            <Binding Path="IconResourceKey" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </controls:SvgIcon.Foreground>
                      </controls:SvgIcon>
                      <TextBlock Text="{Binding ObjectName}" FontSize="{DynamicResource Text.Compact.Size}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding FieldName}"
                                 FontSize="{DynamicResource Text.Caption.Size}"
                                 Foreground="{DynamicResource SubtleForegroundBrush}"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding FieldName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </TreeView.DataTemplates>
            </TreeView>
          </Grid>

          <GridSplitter Grid.Column="1"
                        Width="4"
                        Background="{DynamicResource BorderBrush}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />

          <Grid Grid.Column="2" RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0"
                       Text="{x:Static app:UiStrings.TableDetailDependsOnHeader}"
                       FontSize="{DynamicResource Text.Compact.Size}"
                       Foreground="{DynamicResource SubtleForegroundBrush}"
                       Margin="0,4,0,4" />
            <TreeView Grid.Row="1"
                      ItemsSource="{Binding DependsOnTree}"
                      Background="{DynamicResource BackgroundBrush}">
              <TreeView.DataTemplates>
                <TreeDataTemplate DataType="vm:DependencyGroupNode"
                                  ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <controls:SvgIcon Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}"
                                      Width="15" Height="15"
                                      VerticalAlignment="Center">
                      <controls:SvgIcon.Foreground>
                        <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                          <Binding Path="IconResourceKey" />
                          <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                        </MultiBinding>
                      </controls:SvgIcon.Foreground>
                    </controls:SvgIcon>
                    <TextBlock Text="{Binding Header}" FontSize="{DynamicResource Text.Compact.Size}" VerticalAlignment="Center" />
                  </StackPanel>
                </TreeDataTemplate>
                <DataTemplate DataType="vm:DependencyLeafNode">
                  <Border HorizontalAlignment="Stretch"
                          Background="Transparent"
                          DoubleTapped="OnDependencyNodeDoubleTapped">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <controls:SvgIcon Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}"
                                        Width="15" Height="15"
                                        VerticalAlignment="Center">
                        <controls:SvgIcon.Foreground>
                          <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                            <Binding Path="IconResourceKey" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </controls:SvgIcon.Foreground>
                      </controls:SvgIcon>
                      <TextBlock Text="{Binding ObjectName}" FontSize="{DynamicResource Text.Compact.Size}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding FieldName}"
                                 FontSize="{DynamicResource Text.Caption.Size}"
                                 Foreground="{DynamicResource SubtleForegroundBrush}"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding FieldName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </TreeView.DataTemplates>
            </TreeView>
          </Grid>
        </Grid>
      </TabItem>

      <!-- DDL — read-only reconstructed CREATE EXCEPTION. -->
      <TabItem Classes="bottom-tab" Header="{x:Static app:UiStrings.ExceptionDetailTabDdl}">
        <ae:TextEditor x:Name="ExceptionDdlEditor"
                       ShowLineNumbers="True"
                       IsReadOnly="True"
                       FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                       FontSize="{DynamicResource Text.Code.Size}"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto"
                       Background="{DynamicResource BackgroundBrush}"
                       Foreground="{DynamicResource ForegroundBrush}" />
      </TabItem>

    </TabControl>

    <StackPanel Grid.Row="1" Orientation="Vertical">
      <TextBlock Text="{x:Static app:UiStrings.ExceptionLoadingHint}"
                 Classes="subtle"
                 Margin="10,4"
                 FontSize="{DynamicResource Text.Compact.Size}"
                 IsVisible="{Binding IsLoading}" />
      <!-- Compile / load errors go through the IDE's ONE message surface (UX Polish Seam 4) —
           same severity stripe, icon, wrapping and Copy affordance on every editor. -->
      <controls:MessageBanner Classes="docked" Severity="Error"
                              Message="{Binding ErrorMessage}"
                              IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </Grid>

</UserControl>
