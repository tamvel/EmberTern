<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:EmberTern.App"
             xmlns:vm="using:EmberTern.App.ViewModels"
             xmlns:controls="using:EmberTern.App.Controls"
             xmlns:m="using:EmberTern.Core.Metadata"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="EmberTern.App.Views.NewTableTabView"
             x:DataType="vm:NewTableTabViewModel"
             Background="{DynamicResource BackgroundBrush}">

  <UserControl.Styles>
    <!-- field-label lives in Themes/ControlStyles.axaml (app-wide). Only the
         grid-sizing styles below are local to this view. -->
    <Style Selector="DataGridRow">
      <Setter Property="Height" Value="34" />
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="Padding" Value="6 2" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto,Auto">

    <!-- Top: name + kind -->
    <Border Grid.Row="0" Padding="14,10">
      <Grid ColumnDefinitions="*,12,260" RowDefinitions="Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="{x:Static app:UiStrings.NewTableDialogTableNameLabel}"
                   Classes="field-label" />
        <TextBlock Grid.Row="0" Grid.Column="2"
                   Text="{x:Static app:UiStrings.NewTableDialogTableKindLabel}"
                   Classes="field-label" />
        <TextBox Grid.Row="1" Grid.Column="0"
                 Text="{Binding TableName, Mode=TwoWay}"
                 PlaceholderText="{x:Static app:UiStrings.NewTableNamePlaceholder}" />
        <ComboBox Grid.Row="1" Grid.Column="2"
                  ItemsSource="{Binding TableKinds}"
                  SelectedItem="{Binding SelectedKind, Mode=TwoWay}"
                  HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NewTableTabViewModel+NamedTableKind">
              <TextBlock Text="{Binding Label}" FontSize="12" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>
    </Border>

    <!-- Fields grid + Description tabs -->
    <TabControl Grid.Row="1" Padding="0" Margin="10,0">
      <TabItem Header="{x:Static app:UiStrings.NewTableTabFields}">
        <!-- Add / Drop / Move buttons live in the main toolbar — see MainWindow.axaml,
             gated on IsNewTableTabActive — so this tab carries just the grid. -->
          <DataGrid x:Name="NewTableFieldsGrid"
                    ItemsSource="{Binding Fields}"
                    SelectedItem="{Binding SelectedField, Mode=TwoWay}"
                    PointerPressed="OnEasyGridPointerPressed"
                    FontSize="11"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    CanUserSortColumns="False"
                    CanUserResizeColumns="True"
                    CanUserReorderColumns="False"
                    RowBackground="Transparent"
                    HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                    VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                    Background="{DynamicResource BackgroundBrush}">
            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{x:Static app:UiStrings.CollectionAddTooltip}" Command="{Binding AddFieldCommand}" />
                <MenuItem Header="{x:Static app:UiStrings.CollectionRemoveTooltip}" Command="{Binding DeleteFieldCommand}" />
                <Separator />
                <MenuItem Header="{x:Static app:UiStrings.CollectionMoveUpTooltip}" Command="{Binding MoveFieldUpCommand}" />
                <MenuItem Header="{x:Static app:UiStrings.CollectionMoveDownTooltip}" Command="{Binding MoveFieldDownCommand}" />
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
              <!-- Every editable cell is a template column whose editor binds
                   IsEnabled to a per-row gate (Is*Enabled) so the field
                   dependency model (Computed/Domain/PK/Autoincrement) DISABLES
                   the cells that don't apply, not just clears them once (#1/#4).
                   DataGridTextColumn / DataGridCheckBoxColumn can't bind a
                   per-row IsEnabled, hence the templates. Name + Description are
                   always editable so they stay plain text columns. -->
              <DataGridTemplateColumn Header="{x:Static app:UiStrings.NewTableFieldPk}"
                                      MinWidth="40" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:NewTableFieldRowViewModel">
                    <CheckBox IsChecked="{Binding PrimaryKey, Mode=TwoWay}"
                              IsEnabled="{Binding IsPkEnabled}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="{x:Static app:UiStrings.NewTableFieldName}"
                                  Binding="{Binding Name, Mode=TwoWay}"
                                  MinWidth="160" />
              <!-- Type — always-visible ComboBox in CellTemplate (no separate
                   CellEditingTemplate). Avalonia 12 DataGrid's edit-mode swap
                   from TextBlock to ComboBox loses focus on the popup open
                   pass, which both closes the dropdown immediately and (under
                   repeated clicks) hangs the cell-edit cycle. Always-visible
                   means the user clicks once and the dropdown opens natively. -->
              <DataGridTemplateColumn Header="{x:Static app:UiStrings.NewTableFieldType}"
                                      MinWidth="140"
                                      IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:NewTableFieldRowViewModel">
                    <!-- When a domain is picked it governs the type, so show the
                         domain's resolved type (read-only) instead of the combo (#3). -->
                    <Panel>
                      <ComboBox ItemsSource="{Binding BasicTypes}"
                                SelectedItem="{Binding SelectedTypeItem, Mode=TwoWay}"
                                IsEnabled="{Binding IsTypeEnabled}"
                                IsTextSearchEnabled="True"
                                BorderThickness="0"
                                Background="Transparent"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                IsVisible="{Binding !HasDomain}" />
                      <TextBlock Text="{Binding EffectiveTypeDisplay}"
                                 FontStyle="Italic"
                                 Foreground="{DynamicResource SubtleForegroundBrush}"
                                 VerticalAlignment="Center"
                                 Margin="6,0"
                                 IsVisible="{Binding HasDomain}" />
                    </Panel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <!-- Domain — same always-visible CellTemplate ComboBox pattern as Type. -->
              <DataGridTemplateColumn Header="{x:Static app:UiStrings.NewTableFieldDomain}"
                                      MinWidth="140"
                                      IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:NewTableFieldRowViewModel">
                    <controls:SearchableComboBox ItemsSource="{Binding AvailableDomains}"
                              SelectedItem="{Binding SelectedDomainSpec, Mode=TwoWay}"
                              IsEnabled="{Binding IsDomainEnabled}"
                              DisplayMemberPath="Name"
                              ItemTemplate="{StaticResource DomainRowTemplate}"
                              HeaderTemplate="{StaticResource DomainHeaderTemplate}"
                              Watermark=""
                              BorderThickness="0"
                              Background="Transparent"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="{x:Static app:UiStrings.NewTableFieldSize}"
                                      MinWidth="60" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:NewTableFieldRowViewModel">
                    <TextBox Text="{Binding Size, Mode=TwoWay}"
                             IsEnabled="{Binding IsSizeEnabled}"
                             BorderThickness="0" Background="Transparent"
                             VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="{x:Static app:UiStrings.NewTableFieldScale}"
                                      MinWidth="60" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:NewTableFieldRowViewModel">
                    <TextBox Text="{Binding Scale, Mode=TwoWay}"
                             IsEnabled="{Binding IsPrecisionScaleEnabled}"
                             BorderThickness="0" Background="Transparent"
                             VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="{x:Static app:UiStrings.NewTableFieldNotNull}"
                                      MinWidth="70" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:NewTableFieldRowViewModel">
                    <CheckBox IsChecked="{Binding NotNull, Mode=TwoWay}"
                              IsEnabled="{Binding IsNotNullEnabled}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="{x:Static app:UiStrings.NewTableFieldDefault}"
                                      MinWidth="100" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:NewTableFieldRowViewModel">
                    <TextBox Text="{Binding DefaultValue, Mode=TwoWay}"
                             IsEnabled="{Binding IsDefaultEnabled}"
                             BorderThickness="0" Background="Transparent"
                             VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="{x:Static app:UiStrings.NewTableFieldComputed}"
                                      MinWidth="100" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:NewTableFieldRowViewModel">
                    <TextBox Text="{Binding ComputedExpression, Mode=TwoWay}"
                             IsEnabled="{Binding IsComputedEnabled}"
                             BorderThickness="0" Background="Transparent"
                             VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="{x:Static app:UiStrings.NewTableFieldCheck}"
                                      MinWidth="100" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:NewTableFieldRowViewModel">
                    <TextBox Text="{Binding CheckExpression, Mode=TwoWay}"
                             IsEnabled="{Binding IsCheckEnabled}"
                             BorderThickness="0" Background="Transparent"
                             VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="{x:Static app:UiStrings.NewTableFieldCharset}"
                                      MinWidth="80" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:NewTableFieldRowViewModel">
                    <TextBox Text="{Binding Charset, Mode=TwoWay}"
                             IsEnabled="{Binding IsCharsetEnabled}"
                             BorderThickness="0" Background="Transparent"
                             VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="{x:Static app:UiStrings.NewTableFieldAi}"
                                      MinWidth="50" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:NewTableFieldRowViewModel">
                    <CheckBox IsChecked="{Binding AutoIncrement, Mode=TwoWay}"
                              IsEnabled="{Binding IsAiEnabled}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <!-- MinWidth, NOT Width="*". A star-width column makes the DataGrid
                   lay its columns out to fit the viewport (the star absorbs the
                   remaining width), which SUPPRESSES the horizontal scrollbar —
                   so with 13 columns the ones past the viewport get cut off and
                   become unreachable (#1). With every column fixed/MinWidth the
                   grid's content width exceeds the viewport and its built-in
                   horizontal scrollbar engages. -->
              <DataGridTextColumn Header="{x:Static app:UiStrings.NewTableFieldDescription}"
                                  Binding="{Binding Description, Mode=TwoWay}"
                                  MinWidth="160" />
            </DataGrid.Columns>
          </DataGrid>
      </TabItem>

      <TabItem Header="{x:Static app:UiStrings.NewTableTabDescription}">
        <StackPanel Margin="8" Spacing="6">
          <TextBlock Text="{x:Static app:UiStrings.NewTableDescriptionLabel}" Classes="field-label" />
          <TextBox Text="{Binding Description, Mode=TwoWay}"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   MinHeight="180" />
        </StackPanel>
      </TabItem>
    </TabControl>

    <!-- Live DDL preview. Capped + shrink-friendly (no MinHeight) so it can't
         starve the fields grid above it — with many fields the grid (row 1, *)
         keeps the bulk of the editor height and its built-in vertical scrollbar
         engages. The preview's own scrollbars handle long DDL (#5). -->
    <Border Grid.Row="2" Padding="14,4">
      <StackPanel Spacing="4">
        <TextBlock Text="{x:Static app:UiStrings.NewTableDdlLabel}" Classes="field-label" />
        <TextBox Text="{Binding DdlPreview, Mode=OneWay}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                 FontSize="12"
                 MaxHeight="140"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
      </StackPanel>
    </Border>

    <!-- Validation -->
    <Border Grid.Row="3"
            Padding="14,4"
            IsVisible="{Binding HasValidationMessage}">
      <TextBlock Text="{Binding ValidationMessage}"
                 Classes="error"
                 FontSize="12"
                 TextWrapping="Wrap" />
    </Border>

  </Grid>
</UserControl>
