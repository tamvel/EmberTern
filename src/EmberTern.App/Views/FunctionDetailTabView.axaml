<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EmberTern.App.ViewModels"
             xmlns:app="using:EmberTern.App"
             xmlns:controls="using:EmberTern.App.Controls"
             xmlns:behaviors="using:EmberTern.App.Behaviors"
             xmlns:views="using:EmberTern.App.Views"
             xmlns:conv="using:EmberTern.App.Converters"
             xmlns:core="using:EmberTern.Core.Query"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
             x:Class="EmberTern.App.Views.FunctionDetailTabView"
             x:Name="RootControl"
             x:DataType="vm:FunctionDetailTabViewModel"
             Background="{DynamicResource BackgroundBrush}">

  <UserControl.Styles>
    <Style Selector="DataGridRow">
      <Setter Property="Height" Value="{DynamicResource Size.Row.GridEdit}" />
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="Padding" Value="6 2" />
    </Style>
    <Style Selector="TextBlock.null-cell">
      <Setter Property="FontStyle" Value="Italic" />
      <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">

    <TabControl Grid.Row="0"
                SelectedIndex="{Binding ActiveSubTabIndex, Mode=TwoWay}"
                Padding="0">

      <!-- Editor — Source mode (full text) OR Easy mode (metadata panels ABOVE a
           body-only editor). Compile / Format / Comment / Execute live in the main
           app toolbar (gated on IsFunctionDetailTabActive). -->
      <TabItem Classes="bottom-tab" Header="{app:Loc ProcedureDetailTabEditor}">
        <Grid>
          <!-- Source mode -->
          <ae:TextEditor x:Name="FuncSqlEditor"
                         IsVisible="{Binding IsSourceMode}"
                         ShowLineNumbers="True"
                         FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                         FontSize="{DynamicResource Text.Code.Size}"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource BackgroundBrush}"
                         Foreground="{DynamicResource ForegroundBrush}" />

          <!-- Easy mode: name + metadata (top) over body editor (bottom) -->
          <Grid IsVisible="{Binding EasyMode}" RowDefinitions="Auto,240,4,*">

            <!-- Function name. Editable in the New Function flow; read-only display for
                 an existing function. -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="8,6,8,2">
              <TextBlock Grid.Column="0" Classes="field-label" VerticalAlignment="Center"
                         Margin="0,0,8,0" Text="{app:Loc ProcedureNameHeader}" />
              <TextBox Grid.Column="1" Text="{Binding EditableFunctionName, Mode=TwoWay}"
                       IsReadOnly="{Binding !IsNew}" />
            </Grid>

            <!-- Easy sub-tab strip (Arguments / Result / Variables / Cursors / Subprograms).
                 SelectedIndex drives ActiveEasyCollectionIndex so the main toolbar's
                 Collection section routes to the active sub-tab's collection (the Result
                 sub-tab is a single record — the toolbar hides there). -->
            <TabControl Grid.Row="1" Padding="0"
                        SelectedIndex="{Binding ActiveEasyCollectionIndex, Mode=TwoWay}">
              <!-- Arguments (editable, full field model — columns built in code-behind). -->
              <TabItem Classes="sub-tab" Header="{Binding ArgumentsTabHeader}">
                <DataGrid x:Name="FuncArgumentsGrid"
                          ItemsSource="{Binding Arguments}"
                          SelectedItem="{Binding SelectedArgument, Mode=TwoWay}"
                          PointerPressed="OnEasyGridPointerPressed"
                          IsReadOnly="False" AutoGenerateColumns="False"
                          CanUserSortColumns="False" CanUserResizeColumns="True"
                          CanUserReorderColumns="True" ColumnWidth="Auto" FontSize="{DynamicResource Text.Grid.Size}"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                          VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                          Background="{DynamicResource BackgroundBrush}">
                  <DataGrid.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="{app:Loc CollectionMenuNew}" Icon="{app:MenuIcon Icon.Plus}" InputGesture="{app:CommandGesture CollectionAdd}" Command="{Binding AddCollectionItemCommand}" />
                      <MenuItem Header="{app:Loc CollectionMenuDelete}" Icon="{app:MenuIcon Icon.Minus}" InputGesture="{app:CommandGesture CollectionRemove}" Command="{Binding RemoveCollectionItemCommand}" />
                      <Separator />
                      <MenuItem Header="{app:Loc CollectionMoveUpTooltip}" Icon="{app:MenuIcon Icon.ArrowUp}" Command="{Binding MoveCollectionItemUpCommand}" />
                      <MenuItem Header="{app:Loc CollectionMoveDownTooltip}" Icon="{app:MenuIcon Icon.ArrowDown}" Command="{Binding MoveCollectionItemDownCommand}" />
                    </ContextMenu>
                  </DataGrid.ContextMenu>
                </DataGrid>
              </TabItem>

              <!-- Result — the single return value (no Add/Remove/Move) + Deterministic. -->
              <TabItem Classes="sub-tab" Header="{app:Loc FunctionDetailTabResult}">
                <Grid RowDefinitions="Auto,*">
                  <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="8,4">
                    <TextBlock Text="{app:Loc FunctionDetailReturnTypeLabel}"
                               Classes="field-label" VerticalAlignment="Center" />
                    <CheckBox IsChecked="{Binding Deterministic, Mode=TwoWay}"
                              Content="{app:Loc FunctionDetailDeterministicLabel}"
                              FontSize="{DynamicResource Text.Compact.Size}" VerticalAlignment="Center" />
                  </StackPanel>
                  <DataGrid Grid.Row="1" x:Name="FuncResultTypeGrid"
                            ItemsSource="{Binding ResultRows}"
                            IsReadOnly="False" AutoGenerateColumns="False"
                            CanUserSortColumns="False" CanUserResizeColumns="True"
                            CanUserReorderColumns="True" ColumnWidth="Auto" FontSize="{DynamicResource Text.Grid.Size}"
                            GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                            HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                            VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                            Background="{DynamicResource BackgroundBrush}" />
                </Grid>
              </TabItem>

              <!-- Variables (editable, full field model). -->
              <TabItem Classes="sub-tab" Header="{Binding VariablesTabHeader}">
                <DataGrid x:Name="FuncVariablesGrid"
                          ItemsSource="{Binding Variables}"
                          SelectedItem="{Binding SelectedVariable, Mode=TwoWay}"
                          PointerPressed="OnEasyGridPointerPressed"
                          IsReadOnly="False" AutoGenerateColumns="False"
                          CanUserSortColumns="False" CanUserResizeColumns="True"
                          CanUserReorderColumns="True" ColumnWidth="Auto" FontSize="{DynamicResource Text.Grid.Size}"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                          VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                          Background="{DynamicResource BackgroundBrush}">
                  <DataGrid.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="{app:Loc CollectionMenuNew}" Icon="{app:MenuIcon Icon.Plus}" InputGesture="{app:CommandGesture CollectionAdd}" Command="{Binding AddCollectionItemCommand}" />
                      <MenuItem Header="{app:Loc CollectionMenuDelete}" Icon="{app:MenuIcon Icon.Minus}" InputGesture="{app:CommandGesture CollectionRemove}" Command="{Binding RemoveCollectionItemCommand}" />
                      <Separator />
                      <MenuItem Header="{app:Loc CollectionMoveUpTooltip}" Icon="{app:MenuIcon Icon.ArrowUp}" Command="{Binding MoveCollectionItemUpCommand}" />
                      <MenuItem Header="{app:Loc CollectionMoveDownTooltip}" Icon="{app:MenuIcon Icon.ArrowDown}" Command="{Binding MoveCollectionItemDownCommand}" />
                    </ContextMenu>
                  </DataGrid.ContextMenu>
                </DataGrid>
              </TabItem>

              <!-- Cursors — IBExpert-style split: names (left) + editable source (right). -->
              <TabItem Classes="sub-tab" Header="{Binding CursorsTabHeader}">
                <Grid ColumnDefinitions="200,4,*">
                  <ListBox Grid.Column="0" ItemsSource="{Binding Cursors}"
                           SelectedItem="{Binding SelectedCursor, Mode=TwoWay}"
                           FontSize="{DynamicResource Text.Compact.Size}" Background="{DynamicResource BackgroundBrush}">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ProcedureCursorRowViewModel">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBox Grid.Column="0" Text="{Binding Name, Mode=TwoWay}" FontSize="{DynamicResource Text.Compact.Size}"
                                   BorderThickness="0" Background="Transparent" Padding="0" />
                          <CheckBox Grid.Column="1" IsChecked="{Binding Scroll, Mode=TwoWay}"
                                    Content="{app:Loc ProcedureCursorScroll}"
                                    FontSize="{DynamicResource Text.Caption.Size}" VerticalAlignment="Center"
                                    ToolTip.Tip="{app:Loc ProcedureCursorScroll}" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <GridSplitter Grid.Column="1" Width="4" Background="{DynamicResource BorderBrush}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                  <!-- ⚠ 12 px lokalnie, ŚWIADOMIE (M2c iteracja 4, §18.4). Edytor stoi W WIERSZU SIATKI, więc
                       o rozmiarze decyduje gęstość wiersza, a nie dryf — to ta sama zasada „kontener rozstrzyga
                       wielkość", którą M2b ratyfikował (§17.2/2), a krok 0 zmierzył (§18.0.5/3). Rola `Text.Code`
                       niesie 13, więc migracja byłaby skokiem układu. Rozstrzyga §13.3. -->
                  <ae:TextEditor x:Name="FuncCursorEditor" Grid.Column="2"
                                 IsReadOnly="False" ShowLineNumbers="True"
                                 FontFamily="Cascadia Code,Consolas,Menlo,monospace" FontSize="12"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                 Background="{DynamicResource BackgroundBrush}"
                                 Foreground="{DynamicResource ForegroundBrush}" />
                </Grid>
              </TabItem>

              <!-- Subprograms — IBExpert-style split: names (left) + editable source (right). -->
              <TabItem Classes="sub-tab" Header="{Binding SubprogramsTabHeader}">
                <Grid ColumnDefinitions="200,4,*">
                  <ListBox Grid.Column="0" ItemsSource="{Binding Subprograms}"
                           SelectedItem="{Binding SelectedSubprogram, Mode=TwoWay}"
                           FontSize="{DynamicResource Text.Compact.Size}" Background="{DynamicResource BackgroundBrush}">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ProcedureSubprogramRowViewModel">
                        <Grid ColumnDefinitions="Auto,*">
                          <!-- ⚠ 9 px lokalnie, ŚWIADOMIE (M2c iteracja 4, §18.4). Katalog nie ma roli o tej wartości,
                               a `Text.Caption` (10) zmieniłaby wygląd. Rozstrzyga §13.3. -->
                          <TextBlock Grid.Column="0" Text="{Binding Kind}" FontSize="9"
                                     Foreground="{DynamicResource SubtleForegroundBrush}"
                                     VerticalAlignment="Center" Margin="0,0,6,0" />
                          <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay}" FontSize="{DynamicResource Text.Compact.Size}"
                                   BorderThickness="0" Background="Transparent" Padding="0" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <GridSplitter Grid.Column="1" Width="4" Background="{DynamicResource BorderBrush}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                  <!-- ⚠ 12 px lokalnie, ŚWIADOMIE (M2c iteracja 4, §18.4). Edytor stoi W WIERSZU SIATKI, więc
                       o rozmiarze decyduje gęstość wiersza, a nie dryf — to ta sama zasada „kontener rozstrzyga
                       wielkość", którą M2b ratyfikował (§17.2/2), a krok 0 zmierzył (§18.0.5/3). Rola `Text.Code`
                       niesie 13, więc migracja byłaby skokiem układu. Rozstrzyga §13.3. -->
                  <ae:TextEditor x:Name="FuncSubprogramEditor" Grid.Column="2"
                                 IsReadOnly="False" ShowLineNumbers="True"
                                 FontFamily="Cascadia Code,Consolas,Menlo,monospace" FontSize="12"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                 Background="{DynamicResource BackgroundBrush}"
                                 Foreground="{DynamicResource ForegroundBrush}" />
                </Grid>
              </TabItem>
            </TabControl>

            <GridSplitter Grid.Row="2" Height="4" ResizeDirection="Rows"
                          Background="{DynamicResource BorderBrush}"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <ae:TextEditor x:Name="FuncBodyEditor"
                           Grid.Row="3"
                           ShowLineNumbers="True"
                           FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                           FontSize="{DynamicResource Text.Code.Size}"
                           HorizontalScrollBarVisibility="Auto"
                           VerticalScrollBarVisibility="Auto"
                           Background="{DynamicResource BackgroundBrush}"
                           Foreground="{DynamicResource ForegroundBrush}" />
          </Grid>
        </Grid>
      </TabItem>

      <!-- Description — editable COMMENT ON FUNCTION. -->
      <TabItem Classes="bottom-tab" Header="{app:Loc ProcedureDetailTabDescription}">
        <Grid RowDefinitions="Auto,*" Background="{DynamicResource BackgroundBrush}">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="8,6,8,4"
                      IsVisible="{Binding CanEditDescription}">
            <TextBlock Text="{app:Loc FunctionDescriptionEditLabel}"
                       Classes="subtle" FontSize="{DynamicResource Text.Compact.Size}" VerticalAlignment="Center" />
            <Button Classes="icon" ToolTip.Tip="{app:Loc TableDescriptionSave}"
                    Command="{Binding SaveDescriptionCommand}">
              <controls:SvgIcon Data="{StaticResource Icon.Save}" />
            </Button>
            <Button Classes="flat" Padding="8,2"
                    Content="{app:Loc TableDescriptionClear}"
                    Command="{Binding ClearDescriptionCommand}" />
          </StackPanel>
          <TextBox Grid.Row="1"
                   Text="{Binding EditableDescription, Mode=TwoWay}"
                   IsEnabled="{Binding CanEditDescription}"
                   AcceptsReturn="True" TextWrapping="Wrap" FontSize="{DynamicResource Text.Compact.Size}"
                   Margin="8,0,8,8" Background="{DynamicResource BackgroundBrush}" />
        </Grid>
      </TabItem>

      <!-- Dependencies — dual tree (Used by / Depends on). -->
      <TabItem Classes="bottom-tab" Header="{app:Loc ProcedureDetailTabDependencies}">
        <Grid ColumnDefinitions="*,4,*">
          <Grid Grid.Column="0" RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Text="{app:Loc TableDetailDependedOnByHeader}"
                       FontSize="{DynamicResource Text.Compact.Size}" Foreground="{DynamicResource SubtleForegroundBrush}" Margin="{DynamicResource Margin.PanelCaption}" />
            <controls:DependencyTreeView Grid.Row="1" ItemsSource="{Binding DependedOnByTree}" />
          </Grid>

          <GridSplitter Grid.Column="1" Width="4" Background="{DynamicResource BorderBrush}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

          <Grid Grid.Column="2" RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Text="{app:Loc TableDetailDependsOnHeader}"
                       FontSize="{DynamicResource Text.Compact.Size}" Foreground="{DynamicResource SubtleForegroundBrush}" Margin="{DynamicResource Margin.PanelCaption}" />
            <controls:DependencyTreeView Grid.Row="1" ItemsSource="{Binding DependsOnTree}" />
          </Grid>
        </Grid>
      </TabItem>

      <!-- DDL — read-only reconstructed CREATE OR ALTER FUNCTION. -->
      <TabItem Classes="bottom-tab" Header="{app:Loc ProcedureDetailTabDdl}">
        <ae:TextEditor x:Name="FuncDdlEditor"
                       ShowLineNumbers="True" IsReadOnly="True"
                       FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                       FontSize="{DynamicResource Text.Code.Size}"
                       HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                       Background="{DynamicResource BackgroundBrush}"
                       Foreground="{DynamicResource ForegroundBrush}" />
      </TabItem>

      <!-- Execute Result — read-only function-execution output (distinct from the
           Easy-mode Result metadata). Client-side paging over the materialized result. -->
      <TabItem Classes="bottom-tab" Header="{app:Loc FunctionDetailExecuteResultTab}">
        <!-- Rows: pagination+filter/agg toggles · filter panel · aggregation bar · grid. -->
        <Grid RowDefinitions="Auto,Auto,Auto,*">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="8,4"
                      IsVisible="{Binding HasExecResult}">
            <Button Classes="icon" ToolTip.Tip="{app:Loc TableDetailPaginationFirstTooltip}"
                    Command="{Binding ExecFirstPageCommand}">
              <controls:SvgIcon Data="{StaticResource Icon.ChevronFirst}" Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}" />
            </Button>
            <Button Classes="icon" ToolTip.Tip="{app:Loc TableDetailPaginationPreviousTooltip}"
                    Command="{Binding ExecPreviousPageCommand}">
              <controls:SvgIcon Data="{StaticResource Icon.ChevronLeft}" Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}" />
            </Button>
            <Button Classes="icon" ToolTip.Tip="{app:Loc TableDetailPaginationNextTooltip}"
                    Command="{Binding ExecNextPageCommand}">
              <controls:SvgIcon Data="{StaticResource Icon.ChevronRight}" Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}" />
            </Button>
            <Button Classes="icon" ToolTip.Tip="{app:Loc TableDetailPaginationLastTooltip}"
                    Command="{Binding ExecLastPageCommand}">
              <controls:SvgIcon Data="{StaticResource Icon.ChevronLast}" Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}" />
            </Button>
            <TextBlock Text="{Binding ExecPaginationHint}" Classes="subtle" FontSize="{DynamicResource Text.Compact.Size}"
                       VerticalAlignment="Center" Margin="6,0,0,0" />
            <TextBlock Text="{Binding ExecRecordInfo}" Classes="subtle" FontSize="{DynamicResource Text.Compact.Size}"
                       VerticalAlignment="Center" Margin="12,0,0,0" />
            <ToggleButton Classes="icon" Margin="12,0,0,0"
                    ToolTip.Tip="{app:Loc FilterToggleTooltip}"
                    IsChecked="{Binding ExecFilterPanel.IsPanelOpen, Mode=TwoWay}">
              <Panel>
                <controls:SvgIcon Data="{StaticResource Icon.Filter}" Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}" />
                <Border Classes="filter-active-dot" IsVisible="{Binding ExecFilterPanel.IsFilterActive}" />
              </Panel>
            </ToggleButton>
            <ToggleButton Classes="icon"
                    ToolTip.Tip="{app:Loc AggregationToggleTooltip}"
                    IsChecked="{Binding ExecAggregationBar.IsBarOpen, Mode=TwoWay}">
              <controls:SvgIcon Data="{StaticResource Icon.Sigma}" Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}" />
            </ToggleButton>
            <!-- Export the function result via the shared Export Framework (default = all rows). -->
            <Button Classes="icon" Click="OnFuncExportClick" IsEnabled="{Binding CanExportExecResult}"
                    ToolTip.Tip="{app:Loc ExportResultsTooltip}">
              <controls:SvgIcon Data="{StaticResource Icon.Download}" Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}" />
            </Button>
          </StackPanel>

          <views:FilterPanelView Grid.Row="1" DataContext="{Binding ExecFilterPanel}" />
          <views:AggregationBarView Grid.Row="2" DataContext="{Binding ExecAggregationBar}" />

          <TextBlock Grid.Row="3" Text="{app:Loc ProcedureExecEmptyHint}" Classes="subtle"
                     FontSize="{DynamicResource Text.Compact.Size}" Margin="8,4" IsVisible="{Binding !HasExecInfo}" />
          <!-- Execute Function failure — the IDE's ONE message surface (UX Polish Seam 4). Top-aligned so
               it stays a bar over the (hidden) result grid rather than filling the whole results area. -->
          <controls:MessageBanner Grid.Row="3" Severity="Error" Message="{Binding ExecError}"
                                  Margin="8,4"
                                  VerticalAlignment="Top"
                                  IsVisible="{Binding ShowExecError}" />
          <DataGrid Grid.Row="3" x:Name="FuncExecResultGrid"
                    behaviors:GridLayoutBehavior.GridId="FunctionDetail.ExecResult"
                    SelectionChanged="OnFuncExecResultSelectionChanged"
                    IsReadOnly="True" FontSize="{DynamicResource Text.Grid.Size}"
                    GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                    CanUserSortColumns="False" CanUserResizeColumns="True"
                    ColumnWidth="Auto" RowBackground="Transparent"
                    HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                    VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                    Background="{DynamicResource BackgroundBrush}"
                    IsVisible="{Binding HasExecResult}">
            <DataGrid.ContextMenu>
              <!-- ⭐ The SQL Editor results grid's menu, item for item and in the same order (user request,
                   2026-08-07). ⚠ Copy as INSERT / UPDATE is absent by design, not omission: a function's
                   result set is not a table, so there is no provenance to build a runnable statement from. -->
              <ContextMenu>
                <MenuItem Header="{app:Loc GridCopyCell}" Icon="{app:MenuIcon Icon.Copy}" Click="OnFuncCopyCellClick" />
                <MenuItem Header="{app:Loc GridCopyRow}" Icon="{app:MenuIcon Icon.Copy}" Click="OnFuncCopyRowClick" />
                <MenuItem Header="{app:Loc GridCopyRowWithHeaders}" Icon="{app:MenuIcon Icon.Copy}" Click="OnFuncCopyRowWithHeadersClick" />
                <Separator />
                <MenuItem Header="{app:Loc GridCopyAllWithHeaders}" Icon="{app:MenuIcon Icon.Copy}" Click="OnFuncCopyAllWithHeadersClick" />
                <MenuItem Header="{app:Loc ExportResultsMenuItem}" Icon="{app:MenuIcon Icon.Download}" Click="OnFuncExportClick" />
                <Separator />
                <MenuItem Header="{app:Loc FilterByValue}" Icon="{app:MenuIcon Icon.Filter}" Click="OnFuncFilterByValueClick" />
                <MenuItem Header="{app:Loc FilterExcludeValue}" Icon="{app:MenuIcon Icon.ListX}" Click="OnFuncExcludeValueClick" />
                <MenuItem x:Name="FuncFilterContainsItem"
                          Header="{app:Loc FilterContainsValue}" Icon="{app:MenuIcon Icon.Search}" Click="OnFuncFilterContainsClick" />
              </ContextMenu>
            </DataGrid.ContextMenu>
          </DataGrid>
        </Grid>
      </TabItem>

      <!-- Performance — the reusable PerformancePanelView bound to THIS function tab's OWN
           PerformanceContext (fed by this function's last Execute via the unified metrics
           pipeline). Same view type as the SQL Editor's panel, but each host owns a separate
           context — no shared global state. -->
      <TabItem Classes="bottom-tab" Header="{app:Loc DetailTabPerformance}">
        <!-- DataContext set in code-behind to this tab's own PerformanceContext.Panel
             (the current FunctionDetailTabViewModel.Performance). -->
        <views:PerformancePanelView x:Name="FuncPerformancePanel" />
      </TabItem>

      <!-- Diagnostics (Stage 7 / S4) — the SAME view + VM the SQL Editor's Diagnostics tab uses,
           hosted per object exactly like Performance above. Shows the ACTIVE SQL document's findings
           (the LastFocusedSqlDocument rule — see DiagnosticsPanelHost), never a merge of the four
           editors. Appended LAST: ActiveSubTabIndex is persisted AND PerformanceSubTabIndex = 5 is a
           hard-coded constant, so the existing indices must not shift. -->
      <TabItem Classes="bottom-tab" Header="{app:Loc BottomTabDiagnostics}">
        <views:DiagnosticsPanelView x:Name="FuncDiagnosticsPanel"
                                    DataContext="{Binding DiagnosticsPanel}" />
      </TabItem>

    </TabControl>

    <!-- Persistent execution-info panel — feedback after any Execute regardless of tab. -->
    <StackPanel Grid.Row="1" Orientation="Vertical">
      <Border IsVisible="{Binding HasExecInfo}"
              Background="{DynamicResource ChromeStrongBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,1,0,0"
              Padding="10,3">
        <Panel>
          <!-- Success: collapsible summary — compact one-line header ("Executed in 19 ms · 14
               inserted · … · 376 read"); the expanded body is the PER-TABLE breakdown from the
               same MON$ delta. Default expanded; the user can collapse it. MinHeight + the
               header/content padding resources shrink the Fluent Expander's chunky 48px chrome
               so the COLLAPSED state stays compact. -->
          <!-- ⭐ K7 ZAMKNIĘTA (M4, decyzja użytkownika D): lokalne `MinHeight` 26 USUNIĘTE — nagłówek bierze
               `Size.Control` (24) z mostu `FluentBridge` (`ExpanderMinHeight`), czyli rolę, którą i tak miał.
               ⛔ Nie przywracać liczby: element ma przyjmować wielkość od kontenera, a nie deklarować własną
               (decyzja architektoniczna 2 z M2b). Różnica 2 px jest przy 1:1 podprogowa — sprawdzona na
               renderze sondy, widoczna dopiero przy ×3. -->
          <Expander IsExpanded="True" IsVisible="{Binding !ExecInfoIsError}" Padding="0">
            <Expander.Resources>
              <Thickness x:Key="ExpanderHeaderPadding">8,0,0,0</Thickness>
              <Thickness x:Key="ExpanderContentPadding">0</Thickness>
            </Expander.Resources>
            <Expander.Header>
              <TextBlock Text="{Binding ExecInfoCompact}" Classes="subtle" FontSize="{DynamicResource Text.Compact.Size}" TextWrapping="Wrap" />
            </Expander.Header>
            <StackPanel Margin="6,6,10,8" Spacing="6">
              <TextBlock Text="{app:Loc ExecutionSummaryHeader}"
                         Foreground="{DynamicResource SubtleForegroundBrush}"
                         FontSize="{DynamicResource Text.Caption.Size}" FontWeight="SemiBold" />
              <!-- What was CHANGED, one distinct card per table (reads live in Performance). -->
              <ItemsControl x:Name="ExecActivityCards"
                            ItemsSource="{Binding ExecTableActivity}" IsVisible="{Binding HasExecTableActivity}">
                <ItemsControl.ItemTemplate>
                  <!-- ⚠ The DataType MUST be the App row VM, not Core's TableActivityLine — see the same
                       template in ProcedureDetailTabView: a stale x:DataType made the ItemsControl fall back
                       to ToString() and print the VM's type name (user report 2026-08-12). -->
                  <DataTemplate x:DataType="vm:ExecActivityLineViewModel">
                    <!-- ⭐ B2 ZAMKNIĘTE (M4.2, decyzja użytkownika na renderze): karta bierze `Radius.Surface` (3).
                         M2c iteracja 4 zostawiła tu literał 4 i oddała decyzję „karta: 3 czy 4" bramie §13.3 —
                         ⚠ która NIGDY jej nie podjęła (Z‑1…Z‑6 tego nie dotyczą), więc pozycja wypadła między
                         etapami i nie miała nawet numeru K. ⭐ Rola opisywała ten element od zawsze: jej własny
                         komentarz w `Tokens.axaml` zaczyna się od słowa „Karta". Wariant `Radius.Card` = 4
                         rozważony i ODRZUCONY — nie tworzymy roli po to, żeby zalegalizować wartość. -->
                    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="{DynamicResource Radius.Surface}"
                            Padding="8,6" Margin="0,0,0,8">
                      <StackPanel Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <controls:SvgIcon Data="{StaticResource Icon.Table}"
                                            Foreground="{DynamicResource AccentBrush}"
                                            Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}" VerticalAlignment="Center" />
                          <!-- ⭐ K6 ZAMKNIĘTA (M4, decyzja użytkownika A-2): rola `Text.SectionHeader` niesie teraz 12 SemiBold,
                               czyli tyle, ile ten nagłówek karty deklarował lokalnie od M2c. Wartość bez zmian. -->
                          <TextBlock Text="{Binding Table}" FontSize="{DynamicResource Text.SectionHeader.Size}" FontWeight="{DynamicResource Text.SectionHeader.Weight}"
                                     VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- ⭐ M4.2: trzy ikony karty aktywności na `Size.Icon.Sm` (12). Rola trafia własnym
                             opisem — „ikona inline w tekście 11 px" — a każda z nich stoi obok tekstu
                             `Text.Compact.Size` (11) w tym samym wierszu. Wartość 12 → 12, wygląd bez zmiany;
                             migracja nazywa decyzję, którą autor już podjął (R12). -->
                        <ItemsControl ItemsSource="{Binding Changes}" Margin="2,0,0,0">
                          <ItemsControl.ItemTemplate>
                            <!-- ⭐ C6: ONE template over an App row view model, where there used to be three
                                 keyed on Core's record subtypes. The old shape drew `Count` and `Verb` as two
                                 adjacent bindings, which pinned ENGLISH WORD ORDER into the layout — Polish
                                 says "wstawiono 14 wierszy", with the number in the middle. The row now
                                 carries one localized sentence split around its number (`Loc.FormatParts`),
                                 so the translator chooses the order and the number keeps its kind colour
                                 wherever it lands. ⛔ Do not bind `TableChange.Verb` again. -->
                            <DataTemplate x:DataType="vm:ExecActivityChangeViewModel">
                              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1">
                                <controls:SvgIcon Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}"
                                                  Width="{DynamicResource Size.Icon.Sm}" Height="{DynamicResource Size.Icon.Sm}" VerticalAlignment="Center">
                                  <controls:SvgIcon.Foreground>
                                    <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                                      <Binding Path="IconResourceKey" />
                                      <Binding Path="ActualThemeVariant" ElementName="RootControl" />
                                    </MultiBinding>
                                  </controls:SvgIcon.Foreground>
                                </controls:SvgIcon>
                                <!-- ⚠ The three runs sit on ONE line on purpose: whitespace between inline
                                     elements is content, and a newline here renders as a stray space inside
                                     the sentence. ExecActivityCardTests reads the realized text back. -->
                                <TextBlock Classes="subtle" FontSize="{DynamicResource Text.Compact.Size}" VerticalAlignment="Center"><Run Text="{Binding Before}" /><Run Text="{Binding Value}" FontWeight="SemiBold"><Run.Foreground><MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}"><Binding Path="IconResourceKey" /><Binding Path="ActualThemeVariant" ElementName="RootControl" /></MultiBinding></Run.Foreground></Run><Run Text="{Binding After}" /></TextBlock>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <!-- No change cards: a read-only run shows a clean "nothing changed" line; a run
                   with unmeasured changes falls back to the concise aggregate (never the raw dump). -->
              <TextBlock Text="{Binding ExecSummaryFallbackText}" Classes="subtle" FontSize="{DynamicResource Text.Compact.Size}" TextWrapping="Wrap"
                         IsVisible="{Binding !HasExecTableActivity}" />
            </StackPanel>
          </Expander>
          <controls:MessageBanner Severity="Error" Message="{Binding ExecInfo}"
                                  IsVisible="{Binding ExecInfoIsError}" />
        </Panel>
      </Border>
      <TextBlock Text="{app:Loc FunctionDetailLoadingHint}" Classes="subtle"
                 Margin="10,4" FontSize="{DynamicResource Text.Compact.Size}" IsVisible="{Binding IsLoading}" />
      <!-- Compile / load errors go through the IDE's ONE message surface (UX Polish Seam 4) —
           same severity stripe, icon, wrapping and Copy affordance on every editor. -->
      <controls:MessageBanner Classes="docked" Severity="Error"
                              Message="{Binding ErrorMessage}"
                              IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </Grid>

</UserControl>
