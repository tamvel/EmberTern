<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EmberTern.App.ViewModels"
        xmlns:app="using:EmberTern.App"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="EmberTern.App.Views.RecompileDependentsDialog"
        x:DataType="vm:RecompileDependentsDialogViewModel"
        Title="{x:Static app:UiStrings.RecompileDependentsTitle}"
        Width="520"
        SizeToContent="Height"
        MaxHeight="640"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">

  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

    <Border Grid.Row="0"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="20,14">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding HeaderText}" Classes="h1" TextWrapping="Wrap" />
        <TextBlock Text="{x:Static app:UiStrings.RecompileDependentsHint}"
                   Foreground="{DynamicResource SubtleForegroundBrush}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- Select all / none -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="20,10,20,4">
      <Button Classes="flat" Content="{x:Static app:UiStrings.RecompileDependentsSelectAll}"
              Command="{Binding SelectAllCommand}" />
      <Button Classes="flat" Content="{x:Static app:UiStrings.RecompileDependentsSelectNone}"
              Command="{Binding SelectNoneCommand}" />
    </StackPanel>

    <ScrollViewer Grid.Row="2" Margin="20,0" MaxHeight="380" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RecompileDependentItem">
            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,2">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding TypeLabel}" VerticalAlignment="Center"
                           Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="{DynamicResource Text.Compact.Size}" />
              </StackPanel>
            </CheckBox>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <CheckBox Grid.Row="3" Margin="20,12,20,4"
              Content="{x:Static app:UiStrings.RecompileDependentsDontAskAgain}"
              IsChecked="{Binding DontAskAgain, Mode=TwoWay}" />

    <Border Grid.Row="4"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="20,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Classes="flat" Content="{x:Static app:UiStrings.RecompileDependentsSkip}"
                Command="{Binding SkipCommand}" />
        <Button Classes="primary" Content="{x:Static app:UiStrings.RecompileDependentsRecompile}"
                Command="{Binding RecompileCommand}" IsDefault="True" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
