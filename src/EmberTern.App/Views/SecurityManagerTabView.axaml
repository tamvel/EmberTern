<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EmberTern.App.ViewModels"
             xmlns:app="using:EmberTern.App"
             xmlns:controls="using:EmberTern.App.Controls"
             xmlns:conv="using:EmberTern.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="EmberTern.App.Views.SecurityManagerTabView"
             x:Name="RootControl"
             x:DataType="vm:SecurityManagerTabViewModel"
             Background="{DynamicResource BackgroundBrush}">

  <UserControl.Resources>
    <!-- Grantee option (user/role) row for the Membership / Privileges pickers. -->
    <DataTemplate x:Key="GranteeOptionTemplate" x:DataType="vm:GranteeOptionViewModel">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <controls:SvgIcon Width="14" Height="14" VerticalAlignment="Center"
                          Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}">
          <controls:SvgIcon.Foreground>
            <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
              <Binding Path="IconResourceKey" />
              <Binding ElementName="RootControl" Path="ActualThemeVariant" />
            </MultiBinding>
          </controls:SvgIcon.Foreground>
        </controls:SvgIcon>
        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding TypeLabel}" VerticalAlignment="Center"
                   Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="10" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="DataGridRow"><Setter Property="Height" Value="28" /></Style>
    <Style Selector="DataGridCell"><Setter Property="Padding" Value="6 2" /></Style>
    <Style Selector="DataGrid"><Setter Property="FontSize" Value="11" /></Style>
    <!-- Grids with real interactive CheckBoxes need more row height (FluentTheme
         CheckBox is ~22px and gets clipped below ~32 — gotcha #1/#83). -->
    <Style Selector="DataGrid.checkbox-grid DataGridRow"><Setter Property="Height" Value="34" /></Style>
    <!-- Tri-state privilege cell: fills the cell, transparent, click cycles. -->
    <Style Selector="Button.priv-cell">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.priv-cell:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">

    <TabControl Grid.Row="0" SelectedIndex="{Binding ActiveSubTabIndex, Mode=TwoWay}">

      <!-- ════════════════ USERS ════════════════ -->
      <TabItem Header="{x:Static app:UiStrings.SecurityTabUsers}" Classes="sub-tab">
        <Grid RowDefinitions="Auto,Auto,*" Margin="8">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
            <Button Classes="flat" Content="{x:Static app:UiStrings.SecurityAddUser}"
                    Command="{Binding Users.AddUserCommand}" />
            <Button Classes="flat" Content="{x:Static app:UiStrings.SecurityEditUser}"
                    Command="{Binding Users.EditUserCommand}" />
            <Button Classes="flat" Content="{x:Static app:UiStrings.SecurityDeleteUser}"
                    Command="{Binding Users.DeleteUserCommand}" />
            <Button Classes="flat" Content="{x:Static app:UiStrings.SecurityRefresh}"
                    Command="{Binding Users.RefreshCommand}" />
          </StackPanel>
          <TextBlock Grid.Row="1" Text="{x:Static app:UiStrings.SecurityUsersHint}"
                     Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="11" Margin="0,0,0,6" />
          <DataGrid Grid.Row="2" ItemsSource="{Binding Users.Items}"
                    SelectedItem="{Binding Users.SelectedUser, Mode=TwoWay}"
                    IsReadOnly="True" CanUserResizeColumns="True" GridLinesVisibility="Horizontal"
                    AutoGenerateColumns="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{x:Static app:UiStrings.SecurityColUserName}" Binding="{Binding UserName}" Width="160" />
              <DataGridTextColumn Header="{x:Static app:UiStrings.SecurityColFirstName}" Binding="{Binding FirstName}" Width="120" />
              <DataGridTextColumn Header="{x:Static app:UiStrings.SecurityColLastName}" Binding="{Binding LastName}" Width="120" />
              <DataGridTextColumn Header="{x:Static app:UiStrings.SecurityColActive}" Width="60"
                                  Binding="{Binding Active, Converter={x:Static conv:BoolToCheckmarkConverter.Instance}}" />
              <DataGridTextColumn Header="{x:Static app:UiStrings.SecurityColAdmin}" Width="60"
                                  Binding="{Binding Admin, Converter={x:Static conv:BoolToCheckmarkConverter.Instance}}" />
              <DataGridTextColumn Header="{x:Static app:UiStrings.SecurityColPlugin}" Binding="{Binding Plugin}" Width="90" />
              <DataGridTextColumn Header="{x:Static app:UiStrings.SecurityColDescription}" Binding="{Binding Description}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <!-- ════════════════ ROLES ════════════════ -->
      <TabItem Header="{x:Static app:UiStrings.SecurityTabRoles}" Classes="sub-tab">
        <Grid ColumnDefinitions="*,260" Margin="8">
          <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="0,0,8,0">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
              <Button Classes="flat" Content="{x:Static app:UiStrings.SecurityAddRole}"
                      Command="{Binding Roles.AddRoleCommand}" />
              <Button Classes="flat" Content="{x:Static app:UiStrings.SecurityDropRole}"
                      Command="{Binding Roles.DropRoleCommand}" />
              <Button Classes="flat" Content="{x:Static app:UiStrings.SecurityRefresh}"
                      Command="{Binding Roles.RefreshCommand}" />
            </StackPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Roles.Items}"
                      SelectedItem="{Binding Roles.SelectedRole, Mode=TwoWay}"
                      IsReadOnly="True" CanUserResizeColumns="True" GridLinesVisibility="Horizontal"
                      AutoGenerateColumns="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static app:UiStrings.SecurityColRoleName}" Binding="{Binding Name}" Width="200" />
                <DataGridTextColumn Header="{x:Static app:UiStrings.SecurityColOwner}" Binding="{Binding Owner}" Width="140" />
                <DataGridTextColumn Header="{x:Static app:UiStrings.SecurityColDescription}" Binding="{Binding Description}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
          <StackPanel Grid.Column="1" Spacing="6" IsEnabled="{Binding Roles.HasSelectedRole}">
            <TextBlock Text="{x:Static app:UiStrings.SecurityRoleDescriptionLabel}" Classes="field-label" />
            <TextBox Text="{Binding Roles.EditableDescription}" AcceptsReturn="True"
                     TextWrapping="Wrap" Height="120" />
            <Button Classes="primary" HorizontalAlignment="Right"
                    Content="{x:Static app:UiStrings.SecuritySaveDescription}"
                    Command="{Binding Roles.SaveDescriptionCommand}" />
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- ════════════════ MEMBERSHIP ════════════════ -->
      <TabItem Header="{x:Static app:UiStrings.SecurityTabMembership}" Classes="sub-tab">
        <Grid RowDefinitions="Auto,Auto,*" Margin="8">
          <!-- Direction switch (A) + context picker (C) + legend -->
          <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="{x:Static app:UiStrings.SecurityDirectionLabel}" VerticalAlignment="Center" Classes="field-label" />
              <ComboBox Width="130" ItemsSource="{Binding Membership.Directions}"
                        SelectedItem="{Binding Membership.SelectedDirection, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:MembershipDirectionOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{Binding Membership.PickerLabel}" VerticalAlignment="Center" Classes="field-label" />
              <ComboBox Width="220" ItemsSource="{Binding Membership.PickerItems}"
                        SelectedItem="{Binding Membership.SelectedPicker, Mode=TwoWay}"
                        ItemTemplate="{StaticResource GranteeOptionTemplate}" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Right" Text="{x:Static app:UiStrings.SecurityMembershipLegend}"
                       Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="11" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Grid.Row="1" Text="{x:Static app:UiStrings.SecurityMembershipHint}"
                     Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="11" Margin="0,0,0,6" />
          <DataGrid Grid.Row="2" ItemsSource="{Binding Membership.Rows}"
                    IsReadOnly="True" CanUserResizeColumns="True" CanUserSortColumns="False"
                    GridLinesVisibility="Horizontal" AutoGenerateColumns="False">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="{Binding Membership.RowHeader}" Width="*" MinWidth="220">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:MembershipRowViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <controls:SvgIcon Width="14" Height="14" VerticalAlignment="Center"
                                        Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}">
                        <controls:SvgIcon.Foreground>
                          <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                            <Binding Path="IconResourceKey" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </controls:SvgIcon.Foreground>
                      </controls:SvgIcon>
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding TypeLabel}" VerticalAlignment="Center"
                                 Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="10" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="{x:Static app:UiStrings.SecurityColMembership}" Width="160" MinWidth="140">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:MembershipRowViewModel">
                    <Button Classes="priv-cell" Command="{Binding CycleCommand}"
                            ToolTip.Tip="{x:Static app:UiStrings.SecurityMembershipLegend}">
                      <TextBlock FontWeight="Bold" FontSize="13"
                                 Text="{Binding State, Converter={x:Static conv:PrivilegeStateGlyphConverter.Instance}}">
                        <TextBlock.Foreground>
                          <MultiBinding Converter="{x:Static conv:PrivilegeStateBrushConverter.Instance}">
                            <Binding Path="State" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </TextBlock.Foreground>
                      </TextBlock>
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <!-- ════════════════ PRIVILEGES ════════════════ -->
      <TabItem Header="{x:Static app:UiStrings.SecurityTabPrivileges}" Classes="sub-tab">
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="8">

          <!-- Filters row (compact) -->
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,6" VerticalAlignment="Center">
            <TextBlock Text="{x:Static app:UiStrings.SecurityGranteeLabel}" VerticalAlignment="Center" Classes="field-label" />
            <ComboBox Width="200" ItemsSource="{Binding Privileges.Grantees}"
                      SelectedItem="{Binding Privileges.SelectedGrantee, Mode=TwoWay}"
                      ItemTemplate="{StaticResource GranteeOptionTemplate}" />
            <TextBlock Text="{x:Static app:UiStrings.SecurityCategoryLabel}" VerticalAlignment="Center" Classes="field-label" />
            <ComboBox Width="130" ItemsSource="{Binding Privileges.Categories}"
                      SelectedItem="{Binding Privileges.SelectedCategory, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PrivilegeCategory">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox Width="150" VerticalAlignment="Center"
                     Text="{Binding Privileges.FilterText, Mode=TwoWay}"
                     PlaceholderText="{x:Static app:UiStrings.SecurityFilterWatermark}" />
          </StackPanel>

          <!-- Bulk toolbar (acts on the visible/filtered set) + tri-state legend -->
          <DockPanel Grid.Row="1" Margin="0,0,0,6" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="{x:Static app:UiStrings.SecurityBulkLabel}" Classes="field-label" VerticalAlignment="Center" />
              <ComboBox Width="150" ItemsSource="{Binding Privileges.BulkPrivileges}"
                        SelectedItem="{Binding Privileges.SelectedBulkPrivilege, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:BulkPrivilegeOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Classes="flat" Content="{x:Static app:UiStrings.SecurityBulkGrant}"
                      Command="{Binding Privileges.BulkGrantCommand}" />
              <Button Classes="flat" Content="{x:Static app:UiStrings.SecurityBulkRevoke}"
                      Command="{Binding Privileges.BulkRevokeCommand}" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Right" Text="{x:Static app:UiStrings.SecurityPrivilegeLegend}"
                       Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="11" VerticalAlignment="Center" />
          </DockPanel>

          <!-- Privilege matrix (tri-state cells; right-click a row for Grant/Revoke all) -->
          <DataGrid Grid.Row="2" x:Name="PrivilegeGrid" ItemsSource="{Binding Privileges.Rows}"
                    SelectedItem="{Binding Privileges.SelectedRow, Mode=TwoWay}"
                    IsReadOnly="True" CanUserResizeColumns="True" CanUserSortColumns="False"
                    CanUserReorderColumns="False" GridLinesVisibility="All"
                    AutoGenerateColumns="False">
            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{x:Static app:UiStrings.SecurityRowGrantAll}"
                          Command="{Binding Privileges.SelectedRow.GrantAllCommand}" />
                <MenuItem Header="{x:Static app:UiStrings.SecurityRowRevokeAll}"
                          Command="{Binding Privileges.SelectedRow.RevokeAllCommand}" />
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="{x:Static app:UiStrings.SecurityColObject}" Width="*" MinWidth="220" MaxWidth="440">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:PrivilegeRowViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <controls:SvgIcon Width="14" Height="14" VerticalAlignment="Center"
                                        Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}">
                        <controls:SvgIcon.Foreground>
                          <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                            <Binding Path="IconResourceKey" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </controls:SvgIcon.Foreground>
                      </controls:SvgIcon>
                      <TextBlock Text="{Binding ObjectName}" VerticalAlignment="Center" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn Width="100" MinWidth="90">
                <DataGridTemplateColumn.Header>
                  <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static app:UiStrings.SecurityColSelect}" VerticalAlignment="Center" />
                    <Button Classes="icon" Width="18" Height="18" Padding="0" VerticalAlignment="Center"
                            ToolTip.Tip="{x:Static app:UiStrings.SecurityColMenuTooltip}">
                      <Button.Flyout>
                        <MenuFlyout>
                          <MenuItem Header="{x:Static app:UiStrings.SecurityColGrantAllVisible}"
                                    Command="{Binding DataContext.Privileges.GrantColumnCommand, ElementName=RootControl}" CommandParameter="S" />
                          <MenuItem Header="{x:Static app:UiStrings.SecurityColRevokeAllVisible}"
                                    Command="{Binding DataContext.Privileges.RevokeColumnCommand, ElementName=RootControl}" CommandParameter="S" />
                        </MenuFlyout>
                      </Button.Flyout>
                      <controls:SvgIcon Data="{StaticResource Icon.ChevronDown}" Width="11" Height="11" />
                    </Button>
                  </StackPanel>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:PrivilegeRowViewModel">
                    <Button Classes="priv-cell" IsVisible="{Binding CanSelect}"
                            Command="{Binding CycleCommand}" CommandParameter="S"
                            ToolTip.Tip="{x:Static app:UiStrings.SecurityPrivilegeLegend}">
                      <TextBlock FontWeight="Bold" FontSize="13"
                                 Text="{Binding SelectState, Converter={x:Static conv:PrivilegeStateGlyphConverter.Instance}}">
                        <TextBlock.Foreground>
                          <MultiBinding Converter="{x:Static conv:PrivilegeStateBrushConverter.Instance}">
                            <Binding Path="SelectState" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </TextBlock.Foreground>
                      </TextBlock>
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn Width="96" MinWidth="88">
                <DataGridTemplateColumn.Header>
                  <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static app:UiStrings.SecurityColInsert}" VerticalAlignment="Center" />
                    <Button Classes="icon" Width="18" Height="18" Padding="0" VerticalAlignment="Center"
                            ToolTip.Tip="{x:Static app:UiStrings.SecurityColMenuTooltip}">
                      <Button.Flyout>
                        <MenuFlyout>
                          <MenuItem Header="{x:Static app:UiStrings.SecurityColGrantAllVisible}"
                                    Command="{Binding DataContext.Privileges.GrantColumnCommand, ElementName=RootControl}" CommandParameter="I" />
                          <MenuItem Header="{x:Static app:UiStrings.SecurityColRevokeAllVisible}"
                                    Command="{Binding DataContext.Privileges.RevokeColumnCommand, ElementName=RootControl}" CommandParameter="I" />
                        </MenuFlyout>
                      </Button.Flyout>
                      <controls:SvgIcon Data="{StaticResource Icon.ChevronDown}" Width="11" Height="11" />
                    </Button>
                  </StackPanel>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:PrivilegeRowViewModel">
                    <Button Classes="priv-cell" IsVisible="{Binding CanInsert}"
                            Command="{Binding CycleCommand}" CommandParameter="I"
                            ToolTip.Tip="{x:Static app:UiStrings.SecurityPrivilegeLegend}">
                      <TextBlock FontWeight="Bold" FontSize="13"
                                 Text="{Binding InsertState, Converter={x:Static conv:PrivilegeStateGlyphConverter.Instance}}">
                        <TextBlock.Foreground>
                          <MultiBinding Converter="{x:Static conv:PrivilegeStateBrushConverter.Instance}">
                            <Binding Path="InsertState" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </TextBlock.Foreground>
                      </TextBlock>
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn Width="98" MinWidth="90">
                <DataGridTemplateColumn.Header>
                  <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static app:UiStrings.SecurityColUpdate}" VerticalAlignment="Center" />
                    <Button Classes="icon" Width="18" Height="18" Padding="0" VerticalAlignment="Center"
                            ToolTip.Tip="{x:Static app:UiStrings.SecurityColMenuTooltip}">
                      <Button.Flyout>
                        <MenuFlyout>
                          <MenuItem Header="{x:Static app:UiStrings.SecurityColGrantAllVisible}"
                                    Command="{Binding DataContext.Privileges.GrantColumnCommand, ElementName=RootControl}" CommandParameter="U" />
                          <MenuItem Header="{x:Static app:UiStrings.SecurityColRevokeAllVisible}"
                                    Command="{Binding DataContext.Privileges.RevokeColumnCommand, ElementName=RootControl}" CommandParameter="U" />
                        </MenuFlyout>
                      </Button.Flyout>
                      <controls:SvgIcon Data="{StaticResource Icon.ChevronDown}" Width="11" Height="11" />
                    </Button>
                  </StackPanel>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:PrivilegeRowViewModel">
                    <Button Classes="priv-cell" IsVisible="{Binding CanUpdate}"
                            Command="{Binding CycleCommand}" CommandParameter="U"
                            ToolTip.Tip="{x:Static app:UiStrings.SecurityPrivilegeLegend}">
                      <TextBlock FontWeight="Bold" FontSize="13"
                                 Text="{Binding UpdateState, Converter={x:Static conv:PrivilegeStateGlyphConverter.Instance}}">
                        <TextBlock.Foreground>
                          <MultiBinding Converter="{x:Static conv:PrivilegeStateBrushConverter.Instance}">
                            <Binding Path="UpdateState" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </TextBlock.Foreground>
                      </TextBlock>
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn Width="96" MinWidth="88">
                <DataGridTemplateColumn.Header>
                  <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static app:UiStrings.SecurityColDelete}" VerticalAlignment="Center" />
                    <Button Classes="icon" Width="18" Height="18" Padding="0" VerticalAlignment="Center"
                            ToolTip.Tip="{x:Static app:UiStrings.SecurityColMenuTooltip}">
                      <Button.Flyout>
                        <MenuFlyout>
                          <MenuItem Header="{x:Static app:UiStrings.SecurityColGrantAllVisible}"
                                    Command="{Binding DataContext.Privileges.GrantColumnCommand, ElementName=RootControl}" CommandParameter="D" />
                          <MenuItem Header="{x:Static app:UiStrings.SecurityColRevokeAllVisible}"
                                    Command="{Binding DataContext.Privileges.RevokeColumnCommand, ElementName=RootControl}" CommandParameter="D" />
                        </MenuFlyout>
                      </Button.Flyout>
                      <controls:SvgIcon Data="{StaticResource Icon.ChevronDown}" Width="11" Height="11" />
                    </Button>
                  </StackPanel>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:PrivilegeRowViewModel">
                    <Button Classes="priv-cell" IsVisible="{Binding CanDelete}"
                            Command="{Binding CycleCommand}" CommandParameter="D"
                            ToolTip.Tip="{x:Static app:UiStrings.SecurityPrivilegeLegend}">
                      <TextBlock FontWeight="Bold" FontSize="13"
                                 Text="{Binding DeleteState, Converter={x:Static conv:PrivilegeStateGlyphConverter.Instance}}">
                        <TextBlock.Foreground>
                          <MultiBinding Converter="{x:Static conv:PrivilegeStateBrushConverter.Instance}">
                            <Binding Path="DeleteState" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </TextBlock.Foreground>
                      </TextBlock>
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn Width="122" MinWidth="112">
                <DataGridTemplateColumn.Header>
                  <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static app:UiStrings.SecurityColReferences}" VerticalAlignment="Center" />
                    <Button Classes="icon" Width="18" Height="18" Padding="0" VerticalAlignment="Center"
                            ToolTip.Tip="{x:Static app:UiStrings.SecurityColMenuTooltip}">
                      <Button.Flyout>
                        <MenuFlyout>
                          <MenuItem Header="{x:Static app:UiStrings.SecurityColGrantAllVisible}"
                                    Command="{Binding DataContext.Privileges.GrantColumnCommand, ElementName=RootControl}" CommandParameter="R" />
                          <MenuItem Header="{x:Static app:UiStrings.SecurityColRevokeAllVisible}"
                                    Command="{Binding DataContext.Privileges.RevokeColumnCommand, ElementName=RootControl}" CommandParameter="R" />
                        </MenuFlyout>
                      </Button.Flyout>
                      <controls:SvgIcon Data="{StaticResource Icon.ChevronDown}" Width="11" Height="11" />
                    </Button>
                  </StackPanel>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:PrivilegeRowViewModel">
                    <Button Classes="priv-cell" IsVisible="{Binding CanReferences}"
                            Command="{Binding CycleCommand}" CommandParameter="R"
                            ToolTip.Tip="{x:Static app:UiStrings.SecurityPrivilegeLegend}">
                      <TextBlock FontWeight="Bold" FontSize="13"
                                 Text="{Binding ReferencesState, Converter={x:Static conv:PrivilegeStateGlyphConverter.Instance}}">
                        <TextBlock.Foreground>
                          <MultiBinding Converter="{x:Static conv:PrivilegeStateBrushConverter.Instance}">
                            <Binding Path="ReferencesState" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </TextBlock.Foreground>
                      </TextBlock>
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn Width="102" MinWidth="94">
                <DataGridTemplateColumn.Header>
                  <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static app:UiStrings.SecurityColExecute}" VerticalAlignment="Center" />
                    <Button Classes="icon" Width="18" Height="18" Padding="0" VerticalAlignment="Center"
                            ToolTip.Tip="{x:Static app:UiStrings.SecurityColMenuTooltip}">
                      <Button.Flyout>
                        <MenuFlyout>
                          <MenuItem Header="{x:Static app:UiStrings.SecurityColGrantAllVisible}"
                                    Command="{Binding DataContext.Privileges.GrantColumnCommand, ElementName=RootControl}" CommandParameter="X" />
                          <MenuItem Header="{x:Static app:UiStrings.SecurityColRevokeAllVisible}"
                                    Command="{Binding DataContext.Privileges.RevokeColumnCommand, ElementName=RootControl}" CommandParameter="X" />
                        </MenuFlyout>
                      </Button.Flyout>
                      <controls:SvgIcon Data="{StaticResource Icon.ChevronDown}" Width="11" Height="11" />
                    </Button>
                  </StackPanel>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:PrivilegeRowViewModel">
                    <Button Classes="priv-cell" IsVisible="{Binding CanExecute}"
                            Command="{Binding CycleCommand}" CommandParameter="X"
                            ToolTip.Tip="{x:Static app:UiStrings.SecurityPrivilegeLegend}">
                      <TextBlock FontWeight="Bold" FontSize="13"
                                 Text="{Binding ExecuteState, Converter={x:Static conv:PrivilegeStateGlyphConverter.Instance}}">
                        <TextBlock.Foreground>
                          <MultiBinding Converter="{x:Static conv:PrivilegeStateBrushConverter.Instance}">
                            <Binding Path="ExecuteState" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </TextBlock.Foreground>
                      </TextBlock>
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn Width="92" MinWidth="84">
                <DataGridTemplateColumn.Header>
                  <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static app:UiStrings.SecurityColUsage}" VerticalAlignment="Center" />
                    <Button Classes="icon" Width="18" Height="18" Padding="0" VerticalAlignment="Center"
                            ToolTip.Tip="{x:Static app:UiStrings.SecurityColMenuTooltip}">
                      <Button.Flyout>
                        <MenuFlyout>
                          <MenuItem Header="{x:Static app:UiStrings.SecurityColGrantAllVisible}"
                                    Command="{Binding DataContext.Privileges.GrantColumnCommand, ElementName=RootControl}" CommandParameter="G" />
                          <MenuItem Header="{x:Static app:UiStrings.SecurityColRevokeAllVisible}"
                                    Command="{Binding DataContext.Privileges.RevokeColumnCommand, ElementName=RootControl}" CommandParameter="G" />
                        </MenuFlyout>
                      </Button.Flyout>
                      <controls:SvgIcon Data="{StaticResource Icon.ChevronDown}" Width="11" Height="11" />
                    </Button>
                  </StackPanel>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:PrivilegeRowViewModel">
                    <Button Classes="priv-cell" IsVisible="{Binding CanUsage}"
                            Command="{Binding CycleCommand}" CommandParameter="G"
                            ToolTip.Tip="{x:Static app:UiStrings.SecurityPrivilegeLegend}">
                      <TextBlock FontWeight="Bold" FontSize="13"
                                 Text="{Binding UsageState, Converter={x:Static conv:PrivilegeStateGlyphConverter.Instance}}">
                        <TextBlock.Foreground>
                          <MultiBinding Converter="{x:Static conv:PrivilegeStateBrushConverter.Instance}">
                            <Binding Path="UsageState" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </TextBlock.Foreground>
                      </TextBlock>
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <!-- Column-level privileges (Tables category only) -->
          <Border Grid.Row="3" Margin="0,8,0,0" IsVisible="{Binding Privileges.ShowColumnPanel}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3">
            <Grid RowDefinitions="Auto,Auto">
              <TextBlock Grid.Row="0" Margin="8,6" Classes="field-label"
                         Text="{Binding Privileges.ColumnPanelHeader}" />
              <TextBlock Grid.Row="1" Margin="8,2,8,10"
                         IsVisible="{Binding Privileges.ShowColumnHint}"
                         Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="11"
                         Text="{x:Static app:UiStrings.SecurityColumnHint}" />
              <DataGrid Grid.Row="1" Height="150" Classes="checkbox-grid"
                        IsVisible="{Binding Privileges.HasColumnTable}"
                        ItemsSource="{Binding Privileges.Columns}"
                        IsReadOnly="True" CanUserResizeColumns="True" GridLinesVisibility="All"
                        AutoGenerateColumns="False">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="{x:Static app:UiStrings.SecurityColColumn}" Binding="{Binding ColumnName}" Width="*" MinWidth="160" />
                  <DataGridTemplateColumn Header="{x:Static app:UiStrings.SecurityColUpdate}" Width="90" MinWidth="70">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:ColumnPrivilegeRowViewModel">
                        <CheckBox IsChecked="{Binding Update, Mode=TwoWay}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="{x:Static app:UiStrings.SecurityColReferences}" Width="110" MinWidth="90">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:ColumnPrivilegeRowViewModel">
                        <CheckBox IsChecked="{Binding References, Mode=TwoWay}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>

    <!-- Error banner -->
    <Border Grid.Row="1" IsVisible="{Binding HasError}" Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,6">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" />
    </Border>
  </Grid>
</UserControl>
