<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EmberTern.App.ViewModels"
             xmlns:app="using:EmberTern.App"
             xmlns:controls="using:EmberTern.App.Controls"
             xmlns:conv="using:EmberTern.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="EmberTern.App.Views.SecurityManagerTabView"
             x:Name="RootControl"
             x:DataType="vm:SecurityManagerTabViewModel"
             Background="{DynamicResource BackgroundBrush}">

  <UserControl.Resources>
    <!-- Grantee option (user/role) row for the Membership / Privileges pickers. -->
    <DataTemplate x:Key="GranteeOptionTemplate" x:DataType="vm:GranteeOptionViewModel">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <controls:SvgIcon Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}" VerticalAlignment="Center"
                          Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}">
          <controls:SvgIcon.Foreground>
            <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
              <Binding Path="IconResourceKey" />
              <Binding ElementName="RootControl" Path="ActualThemeVariant" />
            </MultiBinding>
          </controls:SvgIcon.Foreground>
        </controls:SvgIcon>
        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding TypeLabel}" VerticalAlignment="Center"
                   Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="{DynamicResource Text.Caption.Size}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- ⛔ ŚWIADOMIE POZA rolą `Size.Row.GridEdit` (30), wprowadzoną w M4 / C‑1 — i to jest wykluczenie
         z powodem, nie przeoczenie. Ta rola stoi na arytmetyce „padding 4 + edytor `Size.Control` 24",
         a Security Manager NIE MA edytora `Size.Control`: jego komórką interaktywną jest `CheckBox`
         albo `Button.priv-cell`, więc przesłanka roli jest tu po prostu inna. Podciągnięcie tych dwóch
         siatek pod rolę byłoby zastosowaniem reguły o KLASIE do elementu, którego nikt nie zmierzył —
         dokładnie gotcha #322. ⏸ Wysokości Security Managera wymagają własnego pomiaru. -->
    <Style Selector="DataGridRow"><Setter Property="Height" Value="28" /></Style>
    <Style Selector="DataGridCell"><Setter Property="Padding" Value="6 2" /></Style>
    <Style Selector="DataGrid"><Setter Property="FontSize" Value="{DynamicResource Text.Grid.Size}" /></Style>
    <!-- Grids with real interactive CheckBoxes need more row height (FluentTheme
         CheckBox is ~22px and gets clipped below ~32 — gotcha #1/#83). -->
    <Style Selector="DataGrid.checkbox-grid DataGridRow"><Setter Property="Height" Value="34" /></Style>
    <!-- Tri-state privilege cell: fills the cell, transparent, click cycles. -->
    <Style Selector="Button.priv-cell">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.priv-cell:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
    </Style>
    <!-- Bulk-action glyph button (✓ / ✓+ / ✕) used by the all-visible toolbar, each
         column header, and the per-row hover trio. -->
    <Style Selector="Button.bulk-glyph">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <!-- ⚠ 12 px lokalnie, ŚWIADOMIE (M2c iteracja 6, §18.6). To ELEMENT UKŁADU: rozmiar znaku dobrany
           do przycisku o `Height="18"`, nie do sąsiedniego tekstu (ta sama zasada co gwiazdki w debuggerze,
           §18.1.4). Rozstrzyga §13.3. -->
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.bulk-glyph:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Surface}" />
    </Style>
    <!-- Per-row bulk trio lives in the Object cell, revealed only on row hover /
         selection so the grid stays clean at rest (gotcha #35). -->
    <Style Selector="StackPanel.row-bulk"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="DataGridRow:pointerover StackPanel.row-bulk"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="DataGridRow:selected StackPanel.row-bulk"><Setter Property="IsVisible" Value="True" /></Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">

    <TabControl Grid.Row="0" SelectedIndex="{Binding ActiveSubTabIndex, Mode=TwoWay}">

      <!-- ════════════════ USERS ════════════════ -->
      <TabItem Header="{x:Static app:UiStrings.SecurityTabUsers}" Classes="sub-tab">
        <Grid RowDefinitions="Auto,Auto,*" Margin="8">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
            <Button Classes="flat" Content="{x:Static app:UiStrings.SecurityAddUser}"
                    Command="{Binding Users.AddUserCommand}" />
            <Button Classes="flat" Content="{x:Static app:UiStrings.SecurityEditUser}"
                    Command="{Binding Users.EditUserCommand}" />
            <Button Classes="flat" Content="{x:Static app:UiStrings.SecurityDeleteUser}"
                    Command="{Binding Users.DeleteUserCommand}" />
            <Button Classes="flat" Content="{x:Static app:UiStrings.SecurityRefresh}"
                    Command="{Binding Users.RefreshCommand}" />
          </StackPanel>
          <TextBlock Grid.Row="1" Text="{x:Static app:UiStrings.SecurityUsersHint}"
                     Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="{DynamicResource Text.Compact.Size}" Margin="0,0,0,6" />
          <DataGrid Grid.Row="2" ItemsSource="{Binding Users.Items}"
                    SelectedItem="{Binding Users.SelectedUser, Mode=TwoWay}"
                    IsReadOnly="True" CanUserResizeColumns="True" GridLinesVisibility="Horizontal"
                    AutoGenerateColumns="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{x:Static app:UiStrings.SecurityColUserName}" Binding="{Binding UserName}" Width="160" />
              <DataGridTextColumn Header="{x:Static app:UiStrings.SecurityColFirstName}" Binding="{Binding FirstName}" Width="120" />
              <DataGridTextColumn Header="{x:Static app:UiStrings.SecurityColLastName}" Binding="{Binding LastName}" Width="120" />
              <DataGridTextColumn Header="{x:Static app:UiStrings.SecurityColActive}" Width="60"
                                  Binding="{Binding Active, Converter={x:Static conv:BoolToCheckmarkConverter.Instance}}" />
              <DataGridTextColumn Header="{x:Static app:UiStrings.SecurityColAdmin}" Width="60"
                                  Binding="{Binding Admin, Converter={x:Static conv:BoolToCheckmarkConverter.Instance}}" />
              <DataGridTextColumn Header="{x:Static app:UiStrings.SecurityColPlugin}" Binding="{Binding Plugin}" Width="90" />
              <DataGridTextColumn Header="{x:Static app:UiStrings.SecurityColDescription}" Binding="{Binding Description}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <!-- ════════════════ ROLES ════════════════ -->
      <TabItem Header="{x:Static app:UiStrings.SecurityTabRoles}" Classes="sub-tab">
        <Grid ColumnDefinitions="*,260" Margin="8">
          <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="0,0,8,0">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
              <Button Classes="flat" Content="{x:Static app:UiStrings.SecurityAddRole}"
                      Command="{Binding Roles.AddRoleCommand}" />
              <Button Classes="flat" Content="{x:Static app:UiStrings.SecurityDropRole}"
                      Command="{Binding Roles.DropRoleCommand}" />
              <Button Classes="flat" Content="{x:Static app:UiStrings.SecurityRefresh}"
                      Command="{Binding Roles.RefreshCommand}" />
            </StackPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Roles.Items}"
                      SelectedItem="{Binding Roles.SelectedRole, Mode=TwoWay}"
                      IsReadOnly="True" CanUserResizeColumns="True" GridLinesVisibility="Horizontal"
                      AutoGenerateColumns="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static app:UiStrings.SecurityColRoleName}" Binding="{Binding Name}" Width="200" />
                <DataGridTextColumn Header="{x:Static app:UiStrings.SecurityColOwner}" Binding="{Binding Owner}" Width="140" />
                <DataGridTextColumn Header="{x:Static app:UiStrings.SecurityColDescription}" Binding="{Binding Description}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
          <StackPanel Grid.Column="1" Spacing="6" IsEnabled="{Binding Roles.HasSelectedRole}">
            <TextBlock Text="{x:Static app:UiStrings.SecurityRoleDescriptionLabel}" Classes="field-label" />
            <TextBox Text="{Binding Roles.EditableDescription}" AcceptsReturn="True"
                     TextWrapping="Wrap" Height="120" />
            <Button Classes="primary" HorizontalAlignment="Right"
                    Content="{x:Static app:UiStrings.SecuritySaveDescription}"
                    Command="{Binding Roles.SaveDescriptionCommand}" />
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- ════════════════ MEMBERSHIP ════════════════ -->
      <TabItem Header="{x:Static app:UiStrings.SecurityTabMembership}" Classes="sub-tab">
        <Grid RowDefinitions="Auto,Auto,*" Margin="8">
          <!-- Direction switch (A) + context picker (C) + legend -->
          <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="{x:Static app:UiStrings.SecurityDirectionLabel}" VerticalAlignment="Center" Classes="field-label" />
              <ComboBox Width="130" ItemsSource="{Binding Membership.Directions}"
                        SelectedItem="{Binding Membership.SelectedDirection, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:MembershipDirectionOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{Binding Membership.PickerLabel}" VerticalAlignment="Center" Classes="field-label" />
              <ComboBox Width="220" ItemsSource="{Binding Membership.PickerItems}"
                        SelectedItem="{Binding Membership.SelectedPicker, Mode=TwoWay}"
                        ItemTemplate="{StaticResource GranteeOptionTemplate}" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Right" Text="{x:Static app:UiStrings.SecurityMembershipLegend}"
                       Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="{DynamicResource Text.Compact.Size}" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Grid.Row="1" Text="{x:Static app:UiStrings.SecurityMembershipHint}"
                     Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="{DynamicResource Text.Compact.Size}" Margin="0,0,0,6" />
          <DataGrid Grid.Row="2" ItemsSource="{Binding Membership.Rows}"
                    IsReadOnly="True" CanUserResizeColumns="True" CanUserSortColumns="False"
                    GridLinesVisibility="Horizontal" AutoGenerateColumns="False">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="{Binding Membership.RowHeader}" Width="*" MinWidth="220">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:MembershipRowViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <controls:SvgIcon Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}" VerticalAlignment="Center"
                                        Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}">
                        <controls:SvgIcon.Foreground>
                          <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                            <Binding Path="IconResourceKey" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </controls:SvgIcon.Foreground>
                      </controls:SvgIcon>
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding TypeLabel}" VerticalAlignment="Center"
                                 Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="{DynamicResource Text.Caption.Size}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="{x:Static app:UiStrings.SecurityColMembership}" Width="160" MinWidth="140">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:MembershipRowViewModel">
                    <Button Classes="priv-cell" Command="{Binding CycleCommand}"
                            ToolTip.Tip="{x:Static app:UiStrings.SecurityMembershipLegend}">
                      <!-- ⚠ 13 px lokalnie, ŚWIADOMIE (M2c iteracja 6, §18.6). Katalog ma przy 13 wyłącznie rolę kodu,
                           a to jest tekst. Grupa „TextBlock 13 px" z §18.0.5/3 — rozstrzyga §13.3. -->
                      <TextBlock FontWeight="Bold" FontSize="13"
                                 Text="{Binding State, Converter={x:Static conv:PrivilegeStateGlyphConverter.Instance}}">
                        <TextBlock.Foreground>
                          <MultiBinding Converter="{x:Static conv:PrivilegeStateBrushConverter.Instance}">
                            <Binding Path="State" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </TextBlock.Foreground>
                      </TextBlock>
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <!-- ════════════════ PRIVILEGES ════════════════ -->
      <TabItem Header="{x:Static app:UiStrings.SecurityTabPrivileges}" Classes="sub-tab">
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="8">

          <!-- Filters row (compact) -->
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,6" VerticalAlignment="Center">
            <TextBlock Text="{x:Static app:UiStrings.SecurityGranteeLabel}" VerticalAlignment="Center" Classes="field-label" />
            <ComboBox Width="200" ItemsSource="{Binding Privileges.Grantees}"
                      SelectedItem="{Binding Privileges.SelectedGrantee, Mode=TwoWay}"
                      ItemTemplate="{StaticResource GranteeOptionTemplate}" />
            <TextBlock Text="{x:Static app:UiStrings.SecurityCategoryLabel}" VerticalAlignment="Center" Classes="field-label" />
            <ComboBox Width="130" ItemsSource="{Binding Privileges.Categories}"
                      SelectedItem="{Binding Privileges.SelectedCategory, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PrivilegeCategory">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox Width="150" VerticalAlignment="Center"
                     Text="{Binding Privileges.FilterText, Mode=TwoWay}"
                     PlaceholderText="{x:Static app:UiStrings.SecurityFilterWatermark}" />
          </StackPanel>

          <!-- All-visible toolbar: grant / grant + option / revoke for every visible object + tri-state legend -->
          <DockPanel Grid.Row="1" Margin="0,0,0,6" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="{x:Static app:UiStrings.SecurityBulkAllLabel}" Classes="field-label" VerticalAlignment="Center" />
              <Button Classes="flat" Command="{Binding Privileges.BulkGrantCommand}"
                      ToolTip.Tip="{x:Static app:UiStrings.SecurityBulkGrantAllTip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{x:Static app:UiStrings.SecurityGrantGlyph}" FontWeight="Bold" Foreground="{DynamicResource SuccessIconBrush}" />
                  <TextBlock Text="{x:Static app:UiStrings.SecurityBulkGrantAll}" />
                </StackPanel>
              </Button>
              <Button Classes="flat" Command="{Binding Privileges.BulkGrantWithOptionCommand}"
                      ToolTip.Tip="{x:Static app:UiStrings.SecurityBulkGrantAllOptionTip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{x:Static app:UiStrings.SecurityGrantOptionGlyph}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                  <TextBlock Text="{x:Static app:UiStrings.SecurityBulkGrantAllOption}" />
                </StackPanel>
              </Button>
              <Button Classes="flat" Command="{Binding Privileges.BulkRevokeCommand}"
                      ToolTip.Tip="{x:Static app:UiStrings.SecurityBulkRevokeAllTip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{x:Static app:UiStrings.SecurityRevokeGlyph}" FontWeight="Bold" Foreground="{DynamicResource DangerIconBrush}" />
                  <TextBlock Text="{x:Static app:UiStrings.SecurityBulkRevokeAll}" />
                </StackPanel>
              </Button>
            </StackPanel>
            <TextBlock DockPanel.Dock="Right" Text="{x:Static app:UiStrings.SecurityPrivilegeLegend}"
                       Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="{DynamicResource Text.Compact.Size}" VerticalAlignment="Center" />
          </DockPanel>

          <!-- Privilege matrix (tri-state cells; right-click a row for Grant/Revoke all) -->
          <DataGrid Grid.Row="2" x:Name="PrivilegeGrid" ItemsSource="{Binding Privileges.Rows}"
                    SelectedItem="{Binding Privileges.SelectedRow, Mode=TwoWay}"
                    IsReadOnly="True" CanUserResizeColumns="True" CanUserSortColumns="False"
                    CanUserReorderColumns="False" GridLinesVisibility="All"
                    AutoGenerateColumns="False">
            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{x:Static app:UiStrings.SecurityRowGrantAll}" Icon="{app:MenuIcon Icon.Check}"
                          Command="{Binding Privileges.SelectedRow.GrantAllCommand}" />
                <MenuItem Header="{x:Static app:UiStrings.SecurityRowGrantAllOption}" Icon="{app:MenuIcon Icon.Check}"
                          Command="{Binding Privileges.SelectedRow.GrantAllWithOptionCommand}" />
                <MenuItem Header="{x:Static app:UiStrings.SecurityRowRevokeAll}" Icon="{app:MenuIcon Icon.X, Brush=DangerIconBrush}"
                          Command="{Binding Privileges.SelectedRow.RevokeAllCommand}" />
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="{x:Static app:UiStrings.SecurityColObject}" Width="*" MinWidth="220" MaxWidth="440">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:PrivilegeRowViewModel">
                    <DockPanel LastChildFill="True">
                      <!-- Row-scope bulk trio: revealed on hover/selection (see Styles). -->
                      <StackPanel DockPanel.Dock="Right" Classes="row-bulk" Orientation="Horizontal"
                                  Spacing="1" VerticalAlignment="Center" Margin="6,0,0,0">
                        <Button Classes="bulk-glyph" Command="{Binding GrantAllCommand}"
                                ToolTip.Tip="{x:Static app:UiStrings.SecurityRowGrantTip}">
                          <TextBlock Text="{x:Static app:UiStrings.SecurityGrantGlyph}" FontWeight="Bold" Foreground="{DynamicResource SuccessIconBrush}" />
                        </Button>
                        <Button Classes="bulk-glyph" Command="{Binding GrantAllWithOptionCommand}"
                                ToolTip.Tip="{x:Static app:UiStrings.SecurityRowGrantOptionTip}">
                          <TextBlock Text="{x:Static app:UiStrings.SecurityGrantOptionGlyph}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                        </Button>
                        <Button Classes="bulk-glyph" Command="{Binding RevokeAllCommand}"
                                ToolTip.Tip="{x:Static app:UiStrings.SecurityRowRevokeTip}">
                          <TextBlock Text="{x:Static app:UiStrings.SecurityRevokeGlyph}" FontWeight="Bold" Foreground="{DynamicResource DangerIconBrush}" />
                        </Button>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <controls:SvgIcon Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}" VerticalAlignment="Center"
                                          Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}">
                          <controls:SvgIcon.Foreground>
                            <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                              <Binding Path="IconResourceKey" />
                              <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                            </MultiBinding>
                          </controls:SvgIcon.Foreground>
                        </controls:SvgIcon>
                        <TextBlock Text="{Binding ObjectName}" VerticalAlignment="Center" />
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn Width="100" MinWidth="90">
                <DataGridTemplateColumn.Header>
                  <StackPanel Spacing="2" HorizontalAlignment="Center">
                    <TextBlock Text="{x:Static app:UiStrings.SecurityColSelect}" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="1" HorizontalAlignment="Center">
                      <Button Classes="bulk-glyph" CommandParameter="S" ToolTip.Tip="{x:Static app:UiStrings.SecurityColGrantTip}"
                              Command="{Binding DataContext.Privileges.GrantColumnCommand, ElementName=RootControl}">
                        <TextBlock Text="{x:Static app:UiStrings.SecurityGrantGlyph}" FontWeight="Bold" Foreground="{DynamicResource SuccessIconBrush}" />
                      </Button>
                      <Button Classes="bulk-glyph" CommandParameter="S" ToolTip.Tip="{x:Static app:UiStrings.SecurityColGrantOptionTip}"
                              Command="{Binding DataContext.Privileges.GrantColumnWithOptionCommand, ElementName=RootControl}">
                        <TextBlock Text="{x:Static app:UiStrings.SecurityGrantOptionGlyph}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                      </Button>
                      <Button Classes="bulk-glyph" CommandParameter="S" ToolTip.Tip="{x:Static app:UiStrings.SecurityColRevokeTip}"
                              Command="{Binding DataContext.Privileges.RevokeColumnCommand, ElementName=RootControl}">
                        <TextBlock Text="{x:Static app:UiStrings.SecurityRevokeGlyph}" FontWeight="Bold" Foreground="{DynamicResource DangerIconBrush}" />
                      </Button>
                    </StackPanel>
                  </StackPanel>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:PrivilegeRowViewModel">
                    <Button Classes="priv-cell" IsVisible="{Binding CanSelect}"
                            Command="{Binding CycleCommand}" CommandParameter="S"
                            ToolTip.Tip="{x:Static app:UiStrings.SecurityPrivilegeLegend}">
                      <!-- ⚠ 13 px lokalnie, ŚWIADOMIE (M2c iteracja 6, §18.6). Katalog ma przy 13 wyłącznie rolę kodu,
                           a to jest tekst. Grupa „TextBlock 13 px" z §18.0.5/3 — rozstrzyga §13.3. -->
                      <TextBlock FontWeight="Bold" FontSize="13"
                                 Text="{Binding SelectState, Converter={x:Static conv:PrivilegeStateGlyphConverter.Instance}}">
                        <TextBlock.Foreground>
                          <MultiBinding Converter="{x:Static conv:PrivilegeStateBrushConverter.Instance}">
                            <Binding Path="SelectState" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </TextBlock.Foreground>
                      </TextBlock>
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn Width="96" MinWidth="88">
                <DataGridTemplateColumn.Header>
                  <StackPanel Spacing="2" HorizontalAlignment="Center">
                    <TextBlock Text="{x:Static app:UiStrings.SecurityColInsert}" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="1" HorizontalAlignment="Center">
                      <Button Classes="bulk-glyph" CommandParameter="I" ToolTip.Tip="{x:Static app:UiStrings.SecurityColGrantTip}"
                              Command="{Binding DataContext.Privileges.GrantColumnCommand, ElementName=RootControl}">
                        <TextBlock Text="{x:Static app:UiStrings.SecurityGrantGlyph}" FontWeight="Bold" Foreground="{DynamicResource SuccessIconBrush}" />
                      </Button>
                      <Button Classes="bulk-glyph" CommandParameter="I" ToolTip.Tip="{x:Static app:UiStrings.SecurityColGrantOptionTip}"
                              Command="{Binding DataContext.Privileges.GrantColumnWithOptionCommand, ElementName=RootControl}">
                        <TextBlock Text="{x:Static app:UiStrings.SecurityGrantOptionGlyph}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                      </Button>
                      <Button Classes="bulk-glyph" CommandParameter="I" ToolTip.Tip="{x:Static app:UiStrings.SecurityColRevokeTip}"
                              Command="{Binding DataContext.Privileges.RevokeColumnCommand, ElementName=RootControl}">
                        <TextBlock Text="{x:Static app:UiStrings.SecurityRevokeGlyph}" FontWeight="Bold" Foreground="{DynamicResource DangerIconBrush}" />
                      </Button>
                    </StackPanel>
                  </StackPanel>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:PrivilegeRowViewModel">
                    <Button Classes="priv-cell" IsVisible="{Binding CanInsert}"
                            Command="{Binding CycleCommand}" CommandParameter="I"
                            ToolTip.Tip="{x:Static app:UiStrings.SecurityPrivilegeLegend}">
                      <!-- ⚠ 13 px lokalnie, ŚWIADOMIE (M2c iteracja 6, §18.6). Katalog ma przy 13 wyłącznie rolę kodu,
                           a to jest tekst. Grupa „TextBlock 13 px" z §18.0.5/3 — rozstrzyga §13.3. -->
                      <TextBlock FontWeight="Bold" FontSize="13"
                                 Text="{Binding InsertState, Converter={x:Static conv:PrivilegeStateGlyphConverter.Instance}}">
                        <TextBlock.Foreground>
                          <MultiBinding Converter="{x:Static conv:PrivilegeStateBrushConverter.Instance}">
                            <Binding Path="InsertState" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </TextBlock.Foreground>
                      </TextBlock>
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn Width="98" MinWidth="90">
                <DataGridTemplateColumn.Header>
                  <StackPanel Spacing="2" HorizontalAlignment="Center">
                    <TextBlock Text="{x:Static app:UiStrings.SecurityColUpdate}" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="1" HorizontalAlignment="Center">
                      <Button Classes="bulk-glyph" CommandParameter="U" ToolTip.Tip="{x:Static app:UiStrings.SecurityColGrantTip}"
                              Command="{Binding DataContext.Privileges.GrantColumnCommand, ElementName=RootControl}">
                        <TextBlock Text="{x:Static app:UiStrings.SecurityGrantGlyph}" FontWeight="Bold" Foreground="{DynamicResource SuccessIconBrush}" />
                      </Button>
                      <Button Classes="bulk-glyph" CommandParameter="U" ToolTip.Tip="{x:Static app:UiStrings.SecurityColGrantOptionTip}"
                              Command="{Binding DataContext.Privileges.GrantColumnWithOptionCommand, ElementName=RootControl}">
                        <TextBlock Text="{x:Static app:UiStrings.SecurityGrantOptionGlyph}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                      </Button>
                      <Button Classes="bulk-glyph" CommandParameter="U" ToolTip.Tip="{x:Static app:UiStrings.SecurityColRevokeTip}"
                              Command="{Binding DataContext.Privileges.RevokeColumnCommand, ElementName=RootControl}">
                        <TextBlock Text="{x:Static app:UiStrings.SecurityRevokeGlyph}" FontWeight="Bold" Foreground="{DynamicResource DangerIconBrush}" />
                      </Button>
                    </StackPanel>
                  </StackPanel>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:PrivilegeRowViewModel">
                    <Button Classes="priv-cell" IsVisible="{Binding CanUpdate}"
                            Command="{Binding CycleCommand}" CommandParameter="U"
                            ToolTip.Tip="{x:Static app:UiStrings.SecurityPrivilegeLegend}">
                      <!-- ⚠ 13 px lokalnie, ŚWIADOMIE (M2c iteracja 6, §18.6). Katalog ma przy 13 wyłącznie rolę kodu,
                           a to jest tekst. Grupa „TextBlock 13 px" z §18.0.5/3 — rozstrzyga §13.3. -->
                      <TextBlock FontWeight="Bold" FontSize="13"
                                 Text="{Binding UpdateState, Converter={x:Static conv:PrivilegeStateGlyphConverter.Instance}}">
                        <TextBlock.Foreground>
                          <MultiBinding Converter="{x:Static conv:PrivilegeStateBrushConverter.Instance}">
                            <Binding Path="UpdateState" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </TextBlock.Foreground>
                      </TextBlock>
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn Width="96" MinWidth="88">
                <DataGridTemplateColumn.Header>
                  <StackPanel Spacing="2" HorizontalAlignment="Center">
                    <TextBlock Text="{x:Static app:UiStrings.SecurityColDelete}" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="1" HorizontalAlignment="Center">
                      <Button Classes="bulk-glyph" CommandParameter="D" ToolTip.Tip="{x:Static app:UiStrings.SecurityColGrantTip}"
                              Command="{Binding DataContext.Privileges.GrantColumnCommand, ElementName=RootControl}">
                        <TextBlock Text="{x:Static app:UiStrings.SecurityGrantGlyph}" FontWeight="Bold" Foreground="{DynamicResource SuccessIconBrush}" />
                      </Button>
                      <Button Classes="bulk-glyph" CommandParameter="D" ToolTip.Tip="{x:Static app:UiStrings.SecurityColGrantOptionTip}"
                              Command="{Binding DataContext.Privileges.GrantColumnWithOptionCommand, ElementName=RootControl}">
                        <TextBlock Text="{x:Static app:UiStrings.SecurityGrantOptionGlyph}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                      </Button>
                      <Button Classes="bulk-glyph" CommandParameter="D" ToolTip.Tip="{x:Static app:UiStrings.SecurityColRevokeTip}"
                              Command="{Binding DataContext.Privileges.RevokeColumnCommand, ElementName=RootControl}">
                        <TextBlock Text="{x:Static app:UiStrings.SecurityRevokeGlyph}" FontWeight="Bold" Foreground="{DynamicResource DangerIconBrush}" />
                      </Button>
                    </StackPanel>
                  </StackPanel>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:PrivilegeRowViewModel">
                    <Button Classes="priv-cell" IsVisible="{Binding CanDelete}"
                            Command="{Binding CycleCommand}" CommandParameter="D"
                            ToolTip.Tip="{x:Static app:UiStrings.SecurityPrivilegeLegend}">
                      <!-- ⚠ 13 px lokalnie, ŚWIADOMIE (M2c iteracja 6, §18.6). Katalog ma przy 13 wyłącznie rolę kodu,
                           a to jest tekst. Grupa „TextBlock 13 px" z §18.0.5/3 — rozstrzyga §13.3. -->
                      <TextBlock FontWeight="Bold" FontSize="13"
                                 Text="{Binding DeleteState, Converter={x:Static conv:PrivilegeStateGlyphConverter.Instance}}">
                        <TextBlock.Foreground>
                          <MultiBinding Converter="{x:Static conv:PrivilegeStateBrushConverter.Instance}">
                            <Binding Path="DeleteState" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </TextBlock.Foreground>
                      </TextBlock>
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn Width="122" MinWidth="112">
                <DataGridTemplateColumn.Header>
                  <StackPanel Spacing="2" HorizontalAlignment="Center">
                    <TextBlock Text="{x:Static app:UiStrings.SecurityColReferences}" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="1" HorizontalAlignment="Center">
                      <Button Classes="bulk-glyph" CommandParameter="R" ToolTip.Tip="{x:Static app:UiStrings.SecurityColGrantTip}"
                              Command="{Binding DataContext.Privileges.GrantColumnCommand, ElementName=RootControl}">
                        <TextBlock Text="{x:Static app:UiStrings.SecurityGrantGlyph}" FontWeight="Bold" Foreground="{DynamicResource SuccessIconBrush}" />
                      </Button>
                      <Button Classes="bulk-glyph" CommandParameter="R" ToolTip.Tip="{x:Static app:UiStrings.SecurityColGrantOptionTip}"
                              Command="{Binding DataContext.Privileges.GrantColumnWithOptionCommand, ElementName=RootControl}">
                        <TextBlock Text="{x:Static app:UiStrings.SecurityGrantOptionGlyph}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                      </Button>
                      <Button Classes="bulk-glyph" CommandParameter="R" ToolTip.Tip="{x:Static app:UiStrings.SecurityColRevokeTip}"
                              Command="{Binding DataContext.Privileges.RevokeColumnCommand, ElementName=RootControl}">
                        <TextBlock Text="{x:Static app:UiStrings.SecurityRevokeGlyph}" FontWeight="Bold" Foreground="{DynamicResource DangerIconBrush}" />
                      </Button>
                    </StackPanel>
                  </StackPanel>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:PrivilegeRowViewModel">
                    <Button Classes="priv-cell" IsVisible="{Binding CanReferences}"
                            Command="{Binding CycleCommand}" CommandParameter="R"
                            ToolTip.Tip="{x:Static app:UiStrings.SecurityPrivilegeLegend}">
                      <!-- ⚠ 13 px lokalnie, ŚWIADOMIE (M2c iteracja 6, §18.6). Katalog ma przy 13 wyłącznie rolę kodu,
                           a to jest tekst. Grupa „TextBlock 13 px" z §18.0.5/3 — rozstrzyga §13.3. -->
                      <TextBlock FontWeight="Bold" FontSize="13"
                                 Text="{Binding ReferencesState, Converter={x:Static conv:PrivilegeStateGlyphConverter.Instance}}">
                        <TextBlock.Foreground>
                          <MultiBinding Converter="{x:Static conv:PrivilegeStateBrushConverter.Instance}">
                            <Binding Path="ReferencesState" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </TextBlock.Foreground>
                      </TextBlock>
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn Width="102" MinWidth="94">
                <DataGridTemplateColumn.Header>
                  <StackPanel Spacing="2" HorizontalAlignment="Center">
                    <TextBlock Text="{x:Static app:UiStrings.SecurityColExecute}" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="1" HorizontalAlignment="Center">
                      <Button Classes="bulk-glyph" CommandParameter="X" ToolTip.Tip="{x:Static app:UiStrings.SecurityColGrantTip}"
                              Command="{Binding DataContext.Privileges.GrantColumnCommand, ElementName=RootControl}">
                        <TextBlock Text="{x:Static app:UiStrings.SecurityGrantGlyph}" FontWeight="Bold" Foreground="{DynamicResource SuccessIconBrush}" />
                      </Button>
                      <Button Classes="bulk-glyph" CommandParameter="X" ToolTip.Tip="{x:Static app:UiStrings.SecurityColGrantOptionTip}"
                              Command="{Binding DataContext.Privileges.GrantColumnWithOptionCommand, ElementName=RootControl}">
                        <TextBlock Text="{x:Static app:UiStrings.SecurityGrantOptionGlyph}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                      </Button>
                      <Button Classes="bulk-glyph" CommandParameter="X" ToolTip.Tip="{x:Static app:UiStrings.SecurityColRevokeTip}"
                              Command="{Binding DataContext.Privileges.RevokeColumnCommand, ElementName=RootControl}">
                        <TextBlock Text="{x:Static app:UiStrings.SecurityRevokeGlyph}" FontWeight="Bold" Foreground="{DynamicResource DangerIconBrush}" />
                      </Button>
                    </StackPanel>
                  </StackPanel>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:PrivilegeRowViewModel">
                    <Button Classes="priv-cell" IsVisible="{Binding CanExecute}"
                            Command="{Binding CycleCommand}" CommandParameter="X"
                            ToolTip.Tip="{x:Static app:UiStrings.SecurityPrivilegeLegend}">
                      <!-- ⚠ 13 px lokalnie, ŚWIADOMIE (M2c iteracja 6, §18.6). Katalog ma przy 13 wyłącznie rolę kodu,
                           a to jest tekst. Grupa „TextBlock 13 px" z §18.0.5/3 — rozstrzyga §13.3. -->
                      <TextBlock FontWeight="Bold" FontSize="13"
                                 Text="{Binding ExecuteState, Converter={x:Static conv:PrivilegeStateGlyphConverter.Instance}}">
                        <TextBlock.Foreground>
                          <MultiBinding Converter="{x:Static conv:PrivilegeStateBrushConverter.Instance}">
                            <Binding Path="ExecuteState" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </TextBlock.Foreground>
                      </TextBlock>
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn Width="92" MinWidth="84">
                <DataGridTemplateColumn.Header>
                  <StackPanel Spacing="2" HorizontalAlignment="Center">
                    <TextBlock Text="{x:Static app:UiStrings.SecurityColUsage}" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="1" HorizontalAlignment="Center">
                      <Button Classes="bulk-glyph" CommandParameter="G" ToolTip.Tip="{x:Static app:UiStrings.SecurityColGrantTip}"
                              Command="{Binding DataContext.Privileges.GrantColumnCommand, ElementName=RootControl}">
                        <TextBlock Text="{x:Static app:UiStrings.SecurityGrantGlyph}" FontWeight="Bold" Foreground="{DynamicResource SuccessIconBrush}" />
                      </Button>
                      <Button Classes="bulk-glyph" CommandParameter="G" ToolTip.Tip="{x:Static app:UiStrings.SecurityColGrantOptionTip}"
                              Command="{Binding DataContext.Privileges.GrantColumnWithOptionCommand, ElementName=RootControl}">
                        <TextBlock Text="{x:Static app:UiStrings.SecurityGrantOptionGlyph}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                      </Button>
                      <Button Classes="bulk-glyph" CommandParameter="G" ToolTip.Tip="{x:Static app:UiStrings.SecurityColRevokeTip}"
                              Command="{Binding DataContext.Privileges.RevokeColumnCommand, ElementName=RootControl}">
                        <TextBlock Text="{x:Static app:UiStrings.SecurityRevokeGlyph}" FontWeight="Bold" Foreground="{DynamicResource DangerIconBrush}" />
                      </Button>
                    </StackPanel>
                  </StackPanel>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:PrivilegeRowViewModel">
                    <Button Classes="priv-cell" IsVisible="{Binding CanUsage}"
                            Command="{Binding CycleCommand}" CommandParameter="G"
                            ToolTip.Tip="{x:Static app:UiStrings.SecurityPrivilegeLegend}">
                      <!-- ⚠ 13 px lokalnie, ŚWIADOMIE (M2c iteracja 6, §18.6). Katalog ma przy 13 wyłącznie rolę kodu,
                           a to jest tekst. Grupa „TextBlock 13 px" z §18.0.5/3 — rozstrzyga §13.3. -->
                      <TextBlock FontWeight="Bold" FontSize="13"
                                 Text="{Binding UsageState, Converter={x:Static conv:PrivilegeStateGlyphConverter.Instance}}">
                        <TextBlock.Foreground>
                          <MultiBinding Converter="{x:Static conv:PrivilegeStateBrushConverter.Instance}">
                            <Binding Path="UsageState" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </TextBlock.Foreground>
                      </TextBlock>
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <!-- Column-level privileges (Tables category only) -->
          <Border Grid.Row="3" Margin="0,8,0,0" IsVisible="{Binding Privileges.ShowColumnPanel}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Surface}">
            <Grid RowDefinitions="Auto,Auto">
              <TextBlock Grid.Row="0" Margin="8,6" Classes="field-label"
                         Text="{Binding Privileges.ColumnPanelHeader}" />
              <TextBlock Grid.Row="1" Margin="8,2,8,10"
                         IsVisible="{Binding Privileges.ShowColumnHint}"
                         Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="{DynamicResource Text.Compact.Size}"
                         Text="{x:Static app:UiStrings.SecurityColumnHint}" />
              <DataGrid Grid.Row="1" Height="150" Classes="checkbox-grid"
                        IsVisible="{Binding Privileges.HasColumnTable}"
                        ItemsSource="{Binding Privileges.Columns}"
                        IsReadOnly="True" CanUserResizeColumns="True" GridLinesVisibility="All"
                        AutoGenerateColumns="False">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="{x:Static app:UiStrings.SecurityColColumn}" Binding="{Binding ColumnName}" Width="*" MinWidth="160" />
                  <DataGridTemplateColumn Header="{x:Static app:UiStrings.SecurityColUpdate}" Width="90" MinWidth="70">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:ColumnPrivilegeRowViewModel">
                        <CheckBox IsChecked="{Binding Update, Mode=TwoWay}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="{x:Static app:UiStrings.SecurityColReferences}" Width="110" MinWidth="90">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:ColumnPrivilegeRowViewModel">
                        <CheckBox IsChecked="{Binding References, Mode=TwoWay}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>

    <!-- Error banner — the IDE's ONE message surface (UX Polish Seam 4). -->
    <controls:MessageBanner Grid.Row="1" Classes="docked"
                            IsVisible="{Binding HasError}"
                            Severity="Error" Message="{Binding ErrorMessage}" />
  </Grid>
</UserControl>
