<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EmberTern.App.ViewModels"
             xmlns:app="using:EmberTern.App"
             xmlns:controls="using:EmberTern.App.Controls"
             xmlns:conv="using:EmberTern.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="EmberTern.App.Views.SecurityManagerTabView"
             x:Name="RootControl"
             x:DataType="vm:SecurityManagerTabViewModel"
             Background="{DynamicResource BackgroundBrush}">

  <UserControl.Resources>
    <!-- Grantee option (user/role) row for the Membership / Privileges pickers. -->
    <DataTemplate x:Key="GranteeOptionTemplate" x:DataType="vm:GranteeOptionViewModel">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <controls:SvgIcon Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}" VerticalAlignment="Center"
                          Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}">
          <controls:SvgIcon.Foreground>
            <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
              <Binding Path="IconResourceKey" />
              <Binding ElementName="RootControl" Path="ActualThemeVariant" />
            </MultiBinding>
          </controls:SvgIcon.Foreground>
        </controls:SvgIcon>
        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding TypeLabel}" VerticalAlignment="Center"
                   Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="{DynamicResource Text.Caption.Size}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- ⛔ ŚWIADOMIE POZA rolą `Size.Row.GridEdit` (30), wprowadzoną w M4 / C‑1 — i to jest wykluczenie
         z powodem, nie przeoczenie. Ta rola stoi na arytmetyce „padding 4 + edytor `Size.Control` 24",
         a Security Manager NIE MA edytora `Size.Control`: jego komórką interaktywną jest `CheckBox`
         albo `Button.priv-cell`, więc przesłanka roli jest tu po prostu inna. Podciągnięcie tych dwóch
         siatek pod rolę byłoby zastosowaniem reguły o KLASIE do elementu, którego nikt nie zmierzył —
         dokładnie gotcha #322. ⏸ Wysokości Security Managera wymagają własnego pomiaru. -->
    <Style Selector="DataGridRow"><Setter Property="Height" Value="28" /></Style>
    <Style Selector="DataGridCell"><Setter Property="Padding" Value="6 2" /></Style>
    <Style Selector="DataGrid"><Setter Property="FontSize" Value="{DynamicResource Text.Grid.Size}" /></Style>
    <!-- Grids with real interactive CheckBoxes need more row height (FluentTheme
         CheckBox is ~22px and gets clipped below ~32 — gotcha #1/#83). -->
    <Style Selector="DataGrid.checkbox-grid DataGridRow"><Setter Property="Height" Value="34" /></Style>
    <!-- Tri-state privilege cell: fills the cell, transparent, click cycles. -->
    <Style Selector="Button.priv-cell">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.priv-cell:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
    </Style>
    <!-- Bulk-action glyph button (✓ / ✓+ / ✕) used by the all-visible toolbar, each
         column header, and the per-row hover trio. -->
    <Style Selector="Button.bulk-glyph">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <!-- ⚠ 12 px lokalnie, ŚWIADOMIE (M2c iteracja 6, §18.6). To ELEMENT UKŁADU: rozmiar znaku dobrany
           do przycisku o `Height="18"`, nie do sąsiedniego tekstu (ta sama zasada co gwiazdki w debuggerze,
           §18.1.4). Rozstrzyga §13.3. -->
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.bulk-glyph:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Surface}" />
    </Style>
    <!-- Per-row bulk trio lives in the Object cell, revealed only on row hover /
         selection so the grid stays clean at rest (gotcha #35). -->
    <Style Selector="StackPanel.row-bulk"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="DataGridRow:pointerover StackPanel.row-bulk"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="DataGridRow:selected StackPanel.row-bulk"><Setter Property="IsVisible" Value="True" /></Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">

    <TabControl Grid.Row="0" SelectedIndex="{Binding ActiveSubTabIndex, Mode=TwoWay}">

      <!-- ════════════════ USERS ════════════════ -->
      <TabItem Header="{app:Loc SecurityTabUsers}" Classes="sub-tab">
        <Grid RowDefinitions="Auto,Auto,*" Margin="8">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
            <Button Classes="flat" Content="{app:Loc SecurityAddUser}"
                    Command="{Binding Users.AddUserCommand}" />
            <Button Classes="flat" Content="{app:Loc SecurityEditUser}"
                    Command="{Binding Users.EditUserCommand}" />
            <Button Classes="flat" Content="{app:Loc SecurityDeleteUser}"
                    Command="{Binding Users.DeleteUserCommand}" />
            <Button Classes="flat" Content="{app:Loc SecurityRefresh}"
                    Command="{Binding Users.RefreshCommand}" />
          </StackPanel>
          <TextBlock Grid.Row="1" Text="{app:Loc SecurityUsersHint}"
                     Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="{DynamicResource Text.Compact.Size}" Margin="0,0,0,6" />
          <DataGrid Grid.Row="2" ItemsSource="{Binding Users.Items}"
                    SelectedItem="{Binding Users.SelectedUser, Mode=TwoWay}"
                    IsReadOnly="True" CanUserResizeColumns="True" GridLinesVisibility="Horizontal"
                    AutoGenerateColumns="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{app:Loc SecurityColUserName}" Binding="{Binding UserName}" Width="160" />
              <DataGridTextColumn Header="{app:Loc SecurityColFirstName}" Binding="{Binding FirstName}" Width="120" />
              <DataGridTextColumn Header="{app:Loc SecurityColLastName}" Binding="{Binding LastName}" Width="120" />
              <DataGridTextColumn Header="{app:Loc SecurityColActive}" Width="60"
                                  Binding="{Binding Active, Converter={x:Static conv:BoolToCheckmarkConverter.Instance}}" />
              <DataGridTextColumn Header="{app:Loc SecurityColAdmin}" Width="60"
                                  Binding="{Binding Admin, Converter={x:Static conv:BoolToCheckmarkConverter.Instance}}" />
              <DataGridTextColumn Header="{app:Loc SecurityColPlugin}" Binding="{Binding Plugin}" Width="90" />
              <DataGridTextColumn Header="{app:Loc SecurityColDescription}" Binding="{Binding Description}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <!-- ════════════════ ROLES ════════════════ -->
      <TabItem Header="{app:Loc SecurityTabRoles}" Classes="sub-tab">
        <Grid ColumnDefinitions="*,260" Margin="8">
          <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="0,0,8,0">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
              <Button Classes="flat" Content="{app:Loc SecurityAddRole}"
                      Command="{Binding Roles.AddRoleCommand}" />
              <Button Classes="flat" Content="{app:Loc SecurityDropRole}"
                      Command="{Binding Roles.DropRoleCommand}" />
              <Button Classes="flat" Content="{app:Loc SecurityRefresh}"
                      Command="{Binding Roles.RefreshCommand}" />
            </StackPanel>
            <!-- ⭐ `Panel`, żeby stan pusty leżał NA siatce: nagłówki kolumn zostają widoczne (są informacją
                 o tym, co się tu pojawi), a komunikat nie zabiera wiersza i nie przesuwa układu. -->
            <Panel Grid.Row="1">
              <DataGrid ItemsSource="{Binding Roles.Items}"
                        SelectedItem="{Binding Roles.SelectedRole, Mode=TwoWay}"
                        IsReadOnly="True" CanUserResizeColumns="True" GridLinesVisibility="Horizontal"
                        AutoGenerateColumns="False">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="{app:Loc SecurityColRoleName}" Binding="{Binding Name}" Width="200" />
                  <DataGridTextColumn Header="{app:Loc SecurityColOwner}" Binding="{Binding Owner}" Width="140" />
                  <DataGridTextColumn Header="{app:Loc SecurityColDescription}" Binding="{Binding Description}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
              <!-- Stan pusty (M5 / M‑3, B2). ⚠ Baza bez ról niesystemowych to stan ZWYCZAJNY — treść wskazuje
                   następny krok, bo przycisk „Add role" stoi nad siatką i ma widoczną etykietę. -->
              <TextBlock Text="{app:Loc SecurityRolesEmpty}"
                         IsVisible="{Binding Roles.ShowEmptyState}"
                         IsHitTestVisible="False"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Margin="{DynamicResource Pad.Panel}"
                         TextWrapping="Wrap" TextAlignment="Center"
                         Foreground="{DynamicResource SubtleForegroundBrush}"
                         FontSize="{DynamicResource Text.Application.Size}" />
            </Panel>
          </Grid>
          <StackPanel Grid.Column="1" Spacing="6" IsEnabled="{Binding Roles.HasSelectedRole}">
            <TextBlock Text="{app:Loc SecurityRoleDescriptionLabel}" Classes="field-label" />
            <TextBox Text="{Binding Roles.EditableDescription}" AcceptsReturn="True"
                     TextWrapping="Wrap" Height="120" />
            <Button Classes="primary" HorizontalAlignment="Right"
                    Content="{app:Loc SecuritySaveDescription}"
                    Command="{Binding Roles.SaveDescriptionCommand}" />
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- ════════════════ MEMBERSHIP ════════════════ -->
      <TabItem Header="{app:Loc SecurityTabMembership}" Classes="sub-tab">
        <Grid RowDefinitions="Auto,Auto,*" Margin="8">
          <!-- Direction switch (A) + context picker (C) + legend -->
          <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="{app:Loc SecurityDirectionLabel}" VerticalAlignment="Center" Classes="field-label" />
              <ComboBox Width="130" ItemsSource="{Binding Membership.Directions}"
                        SelectedItem="{Binding Membership.SelectedDirection, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:MembershipDirectionOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{Binding Membership.PickerLabel}" VerticalAlignment="Center" Classes="field-label" />
              <ComboBox Width="220" ItemsSource="{Binding Membership.PickerItems}"
                        SelectedItem="{Binding Membership.SelectedPicker, Mode=TwoWay}"
                        ItemTemplate="{StaticResource GranteeOptionTemplate}" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Right" Text="{app:Loc SecurityMembershipLegend}"
                       Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="{DynamicResource Text.Compact.Size}" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Grid.Row="1" Text="{app:Loc SecurityMembershipHint}"
                     Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="{DynamicResource Text.Compact.Size}" Margin="0,0,0,6" />
          <Panel Grid.Row="2">
          <DataGrid ItemsSource="{Binding Membership.Rows}"
                    IsReadOnly="True" CanUserResizeColumns="True" CanUserSortColumns="False"
                    GridLinesVisibility="Horizontal" AutoGenerateColumns="False">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="{Binding Membership.RowHeader}" Width="*" MinWidth="220">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:MembershipRowViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <controls:SvgIcon Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}" VerticalAlignment="Center"
                                        Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}">
                        <controls:SvgIcon.Foreground>
                          <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                            <Binding Path="IconResourceKey" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </controls:SvgIcon.Foreground>
                      </controls:SvgIcon>
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding TypeLabel}" VerticalAlignment="Center"
                                 Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="{DynamicResource Text.Caption.Size}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="{app:Loc SecurityColMembership}" Width="160" MinWidth="140">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:MembershipRowViewModel">
                    <Button Classes="priv-cell" Command="{Binding CycleCommand}"
                            ToolTip.Tip="{app:Loc SecurityMembershipLegend}">
                      <!-- ⭐ Q3/C ZAMKNIĘTE (M4.3): 13 px ZOSTAJE, ale POWÓD BYŁ ZAPISANY BŁĘDNIE i to jest
                           tu jedyna zmiana. Dawny komentarz twierdził „a to jest tekst" i zaliczał tę pozycję
                           do grupy „TextBlock 13 px" z §18.0.5/3 — ⚠ zmierzone: to NIE jest tekst. `Text` jest
                           bindowany do `PrivilegeStateGlyphConverter`, który zwraca „✓" albo „✓+", wewnątrz
                           przycisku `Button.priv-cell` o `Width=20` / `Height=18`. To GLIF strojony do
                           KONTENERA, czyli reguła #10 działająca poprawnie — dokładnie ta sama zasada, którą
                           komentarz przy `Button.bulk-glyph` w tym samym pliku stosuje do swoich 12 px.
                           ⭐ R12: wartość miała powód, powód był nieprawdziwy — i to on wymagał naprawy,
                           a nie wartość. Grupa z §18.0.5/3 opisywała pod jedną nazwą dwie różne rzeczy. -->
                      <TextBlock FontWeight="Bold" FontSize="13"
                                 Text="{Binding State, Converter={x:Static conv:PrivilegeStateGlyphConverter.Instance}}">
                        <TextBlock.Foreground>
                          <MultiBinding Converter="{x:Static conv:PrivilegeStateBrushConverter.Instance}">
                            <Binding Path="State" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </TextBlock.Foreground>
                      </TextBlock>
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
            <!-- Stan pusty przynależności (M5 / M‑3, B3).
                 ⭐⭐ TREŚĆ ZALEŻY OD KIERUNKU i to nie jest ozdoba: „Member of" pyta, do jakich ról należy
                 wybrany grantee, a „Members" — kto należy do wybranej roli. Jeden komunikat na oba byłby
                 nieprawdziwy w jednym z nich; że to dwa różne pytania, produkt wie od dawna — nagłówek
                 kolumny wyżej przełącza się „Role name" ↔ „Member name" dokładnie z tego powodu.
                 ⚠ Bramka wymaga WYBRANEGO elementu: picker autowybiera pierwszą pozycję, więc pusty picker
                 znaczy „w bazie nie ma ról" — ten sam fakt, który komunikuje już zakładka Roles, i decyzją
                 użytkownika NIE dostaje tu drugiego komunikatu. -->
            <TextBlock Text="{Binding Membership.EmptyText}"
                       IsVisible="{Binding Membership.ShowEmptyState}"
                       IsHitTestVisible="False"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="{DynamicResource Pad.Panel}"
                       TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource SubtleForegroundBrush}"
                       FontSize="{DynamicResource Text.Application.Size}" />
          </Panel>
        </Grid>
      </TabItem>

      <!-- ════════════════ PRIVILEGES ════════════════ -->
      <TabItem Header="{app:Loc SecurityTabPrivileges}" Classes="sub-tab">
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="8">

          <!-- Filters row (compact) -->
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,6" VerticalAlignment="Center">
            <TextBlock Text="{app:Loc SecurityGranteeLabel}" VerticalAlignment="Center" Classes="field-label" />
            <ComboBox Width="200" ItemsSource="{Binding Privileges.Grantees}"
                      SelectedItem="{Binding Privileges.SelectedGrantee, Mode=TwoWay}"
                      ItemTemplate="{StaticResource GranteeOptionTemplate}" />
            <TextBlock Text="{app:Loc SecurityCategoryLabel}" VerticalAlignment="Center" Classes="field-label" />
            <ComboBox Width="130" ItemsSource="{Binding Privileges.Categories}"
                      SelectedItem="{Binding Privileges.SelectedCategory, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PrivilegeCategory">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox Width="150" VerticalAlignment="Center"
                     Text="{Binding Privileges.FilterText, Mode=TwoWay}"
                     PlaceholderText="{app:Loc SecurityFilterWatermark}" />
          </StackPanel>

          <!-- All-visible toolbar: grant / grant + option / revoke for every visible object + tri-state legend -->
          <DockPanel Grid.Row="1" Margin="0,0,0,6" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="{app:Loc SecurityBulkAllLabel}" Classes="field-label" VerticalAlignment="Center" />
              <Button Classes="flat" Command="{Binding Privileges.BulkGrantCommand}"
                      ToolTip.Tip="{app:Loc SecurityBulkGrantAllTip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{app:Loc SecurityGrantGlyph}" FontWeight="Bold" Foreground="{DynamicResource SuccessIconBrush}" />
                  <TextBlock Text="{app:Loc SecurityBulkGrantAll}" />
                </StackPanel>
              </Button>
              <Button Classes="flat" Command="{Binding Privileges.BulkGrantWithOptionCommand}"
                      ToolTip.Tip="{app:Loc SecurityBulkGrantAllOptionTip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{app:Loc SecurityGrantOptionGlyph}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                  <TextBlock Text="{app:Loc SecurityBulkGrantAllOption}" />
                </StackPanel>
              </Button>
              <Button Classes="flat" Command="{Binding Privileges.BulkRevokeCommand}"
                      ToolTip.Tip="{app:Loc SecurityBulkRevokeAllTip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{app:Loc SecurityRevokeGlyph}" FontWeight="Bold" Foreground="{DynamicResource DangerIconBrush}" />
                  <TextBlock Text="{app:Loc SecurityBulkRevokeAll}" />
                </StackPanel>
              </Button>
            </StackPanel>
            <TextBlock DockPanel.Dock="Right" Text="{app:Loc SecurityPrivilegeLegend}"
                       Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="{DynamicResource Text.Compact.Size}" VerticalAlignment="Center" />
          </DockPanel>

          <!-- Privilege matrix (tri-state cells; right-click a row for Grant/Revoke all) -->
          <DataGrid Grid.Row="2" x:Name="PrivilegeGrid" ItemsSource="{Binding Privileges.Rows}"
                    SelectedItem="{Binding Privileges.SelectedRow, Mode=TwoWay}"
                    IsReadOnly="True" CanUserResizeColumns="True" CanUserSortColumns="False"
                    CanUserReorderColumns="False" GridLinesVisibility="All"
                    AutoGenerateColumns="False">
            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{app:Loc SecurityRowGrantAll}" Icon="{app:MenuIcon Icon.Check}"
                          Command="{Binding Privileges.SelectedRow.GrantAllCommand}" />
                <MenuItem Header="{app:Loc SecurityRowGrantAllOption}" Icon="{app:MenuIcon Icon.Check}"
                          Command="{Binding Privileges.SelectedRow.GrantAllWithOptionCommand}" />
                <MenuItem Header="{app:Loc SecurityRowRevokeAll}" Icon="{app:MenuIcon Icon.X, Brush=DangerIconBrush}"
                          Command="{Binding Privileges.SelectedRow.RevokeAllCommand}" />
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="{app:Loc SecurityColObject}" Width="*" MinWidth="220" MaxWidth="440">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:PrivilegeRowViewModel">
                    <DockPanel LastChildFill="True">
                      <!-- Row-scope bulk trio: revealed on hover/selection (see Styles). -->
                      <StackPanel DockPanel.Dock="Right" Classes="row-bulk" Orientation="Horizontal"
                                  Spacing="1" VerticalAlignment="Center" Margin="6,0,0,0">
                        <Button Classes="bulk-glyph" Command="{Binding GrantAllCommand}"
                                ToolTip.Tip="{app:Loc SecurityRowGrantTip}">
                          <TextBlock Text="{app:Loc SecurityGrantGlyph}" FontWeight="Bold" Foreground="{DynamicResource SuccessIconBrush}" />
                        </Button>
                        <Button Classes="bulk-glyph" Command="{Binding GrantAllWithOptionCommand}"
                                ToolTip.Tip="{app:Loc SecurityRowGrantOptionTip}">
                          <TextBlock Text="{app:Loc SecurityGrantOptionGlyph}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                        </Button>
                        <Button Classes="bulk-glyph" Command="{Binding RevokeAllCommand}"
                                ToolTip.Tip="{app:Loc SecurityRowRevokeTip}">
                          <TextBlock Text="{app:Loc SecurityRevokeGlyph}" FontWeight="Bold" Foreground="{DynamicResource DangerIconBrush}" />
                        </Button>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <controls:SvgIcon Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}" VerticalAlignment="Center"
                                          Data="{Binding IconGeometryKey, Converter={x:Static app:IconGeometryConverter.Instance}}">
                          <controls:SvgIcon.Foreground>
                            <MultiBinding Converter="{x:Static app:IconBrushConverter.Instance}">
                              <Binding Path="IconResourceKey" />
                              <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                            </MultiBinding>
                          </controls:SvgIcon.Foreground>
                        </controls:SvgIcon>
                        <TextBlock Text="{Binding ObjectName}" VerticalAlignment="Center" />
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn Width="100" MinWidth="90">
                <DataGridTemplateColumn.Header>
                  <StackPanel Spacing="2" HorizontalAlignment="Center">
                    <TextBlock Text="{app:Loc SecurityColSelect}" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="1" HorizontalAlignment="Center">
                      <Button Classes="bulk-glyph" CommandParameter="S" ToolTip.Tip="{app:Loc SecurityColGrantTip}"
                              Command="{Binding DataContext.Privileges.GrantColumnCommand, ElementName=RootControl}">
                        <TextBlock Text="{app:Loc SecurityGrantGlyph}" FontWeight="Bold" Foreground="{DynamicResource SuccessIconBrush}" />
                      </Button>
                      <Button Classes="bulk-glyph" CommandParameter="S" ToolTip.Tip="{app:Loc SecurityColGrantOptionTip}"
                              Command="{Binding DataContext.Privileges.GrantColumnWithOptionCommand, ElementName=RootControl}">
                        <TextBlock Text="{app:Loc SecurityGrantOptionGlyph}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                      </Button>
                      <Button Classes="bulk-glyph" CommandParameter="S" ToolTip.Tip="{app:Loc SecurityColRevokeTip}"
                              Command="{Binding DataContext.Privileges.RevokeColumnCommand, ElementName=RootControl}">
                        <TextBlock Text="{app:Loc SecurityRevokeGlyph}" FontWeight="Bold" Foreground="{DynamicResource DangerIconBrush}" />
                      </Button>
                    </StackPanel>
                  </StackPanel>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:PrivilegeRowViewModel">
                    <Button Classes="priv-cell" IsVisible="{Binding CanSelect}"
                            Command="{Binding CycleCommand}" CommandParameter="S"
                            ToolTip.Tip="{app:Loc SecurityPrivilegeLegend}">
                      <!-- ⭐ Q3/C ZAMKNIĘTE (M4.3): 13 px ZOSTAJE, ale POWÓD BYŁ ZAPISANY BŁĘDNIE i to jest
                           tu jedyna zmiana. Dawny komentarz twierdził „a to jest tekst" i zaliczał tę pozycję
                           do grupy „TextBlock 13 px" z §18.0.5/3 — ⚠ zmierzone: to NIE jest tekst. `Text` jest
                           bindowany do `PrivilegeStateGlyphConverter`, który zwraca „✓" albo „✓+", wewnątrz
                           przycisku `Button.priv-cell` o `Width=20` / `Height=18`. To GLIF strojony do
                           KONTENERA, czyli reguła #10 działająca poprawnie — dokładnie ta sama zasada, którą
                           komentarz przy `Button.bulk-glyph` w tym samym pliku stosuje do swoich 12 px.
                           ⭐ R12: wartość miała powód, powód był nieprawdziwy — i to on wymagał naprawy,
                           a nie wartość. Grupa z §18.0.5/3 opisywała pod jedną nazwą dwie różne rzeczy. -->
                      <TextBlock FontWeight="Bold" FontSize="13"
                                 Text="{Binding SelectState, Converter={x:Static conv:PrivilegeStateGlyphConverter.Instance}}">
                        <TextBlock.Foreground>
                          <MultiBinding Converter="{x:Static conv:PrivilegeStateBrushConverter.Instance}">
                            <Binding Path="SelectState" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </TextBlock.Foreground>
                      </TextBlock>
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn Width="96" MinWidth="88">
                <DataGridTemplateColumn.Header>
                  <StackPanel Spacing="2" HorizontalAlignment="Center">
                    <TextBlock Text="{app:Loc SecurityColInsert}" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="1" HorizontalAlignment="Center">
                      <Button Classes="bulk-glyph" CommandParameter="I" ToolTip.Tip="{app:Loc SecurityColGrantTip}"
                              Command="{Binding DataContext.Privileges.GrantColumnCommand, ElementName=RootControl}">
                        <TextBlock Text="{app:Loc SecurityGrantGlyph}" FontWeight="Bold" Foreground="{DynamicResource SuccessIconBrush}" />
                      </Button>
                      <Button Classes="bulk-glyph" CommandParameter="I" ToolTip.Tip="{app:Loc SecurityColGrantOptionTip}"
                              Command="{Binding DataContext.Privileges.GrantColumnWithOptionCommand, ElementName=RootControl}">
                        <TextBlock Text="{app:Loc SecurityGrantOptionGlyph}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                      </Button>
                      <Button Classes="bulk-glyph" CommandParameter="I" ToolTip.Tip="{app:Loc SecurityColRevokeTip}"
                              Command="{Binding DataContext.Privileges.RevokeColumnCommand, ElementName=RootControl}">
                        <TextBlock Text="{app:Loc SecurityRevokeGlyph}" FontWeight="Bold" Foreground="{DynamicResource DangerIconBrush}" />
                      </Button>
                    </StackPanel>
                  </StackPanel>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:PrivilegeRowViewModel">
                    <Button Classes="priv-cell" IsVisible="{Binding CanInsert}"
                            Command="{Binding CycleCommand}" CommandParameter="I"
                            ToolTip.Tip="{app:Loc SecurityPrivilegeLegend}">
                      <!-- ⭐ Q3/C ZAMKNIĘTE (M4.3): 13 px ZOSTAJE, ale POWÓD BYŁ ZAPISANY BŁĘDNIE i to jest
                           tu jedyna zmiana. Dawny komentarz twierdził „a to jest tekst" i zaliczał tę pozycję
                           do grupy „TextBlock 13 px" z §18.0.5/3 — ⚠ zmierzone: to NIE jest tekst. `Text` jest
                           bindowany do `PrivilegeStateGlyphConverter`, który zwraca „✓" albo „✓+", wewnątrz
                           przycisku `Button.priv-cell` o `Width=20` / `Height=18`. To GLIF strojony do
                           KONTENERA, czyli reguła #10 działająca poprawnie — dokładnie ta sama zasada, którą
                           komentarz przy `Button.bulk-glyph` w tym samym pliku stosuje do swoich 12 px.
                           ⭐ R12: wartość miała powód, powód był nieprawdziwy — i to on wymagał naprawy,
                           a nie wartość. Grupa z §18.0.5/3 opisywała pod jedną nazwą dwie różne rzeczy. -->
                      <TextBlock FontWeight="Bold" FontSize="13"
                                 Text="{Binding InsertState, Converter={x:Static conv:PrivilegeStateGlyphConverter.Instance}}">
                        <TextBlock.Foreground>
                          <MultiBinding Converter="{x:Static conv:PrivilegeStateBrushConverter.Instance}">
                            <Binding Path="InsertState" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </TextBlock.Foreground>
                      </TextBlock>
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn Width="98" MinWidth="90">
                <DataGridTemplateColumn.Header>
                  <StackPanel Spacing="2" HorizontalAlignment="Center">
                    <TextBlock Text="{app:Loc SecurityColUpdate}" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="1" HorizontalAlignment="Center">
                      <Button Classes="bulk-glyph" CommandParameter="U" ToolTip.Tip="{app:Loc SecurityColGrantTip}"
                              Command="{Binding DataContext.Privileges.GrantColumnCommand, ElementName=RootControl}">
                        <TextBlock Text="{app:Loc SecurityGrantGlyph}" FontWeight="Bold" Foreground="{DynamicResource SuccessIconBrush}" />
                      </Button>
                      <Button Classes="bulk-glyph" CommandParameter="U" ToolTip.Tip="{app:Loc SecurityColGrantOptionTip}"
                              Command="{Binding DataContext.Privileges.GrantColumnWithOptionCommand, ElementName=RootControl}">
                        <TextBlock Text="{app:Loc SecurityGrantOptionGlyph}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                      </Button>
                      <Button Classes="bulk-glyph" CommandParameter="U" ToolTip.Tip="{app:Loc SecurityColRevokeTip}"
                              Command="{Binding DataContext.Privileges.RevokeColumnCommand, ElementName=RootControl}">
                        <TextBlock Text="{app:Loc SecurityRevokeGlyph}" FontWeight="Bold" Foreground="{DynamicResource DangerIconBrush}" />
                      </Button>
                    </StackPanel>
                  </StackPanel>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:PrivilegeRowViewModel">
                    <Button Classes="priv-cell" IsVisible="{Binding CanUpdate}"
                            Command="{Binding CycleCommand}" CommandParameter="U"
                            ToolTip.Tip="{app:Loc SecurityPrivilegeLegend}">
                      <!-- ⭐ Q3/C ZAMKNIĘTE (M4.3): 13 px ZOSTAJE, ale POWÓD BYŁ ZAPISANY BŁĘDNIE i to jest
                           tu jedyna zmiana. Dawny komentarz twierdził „a to jest tekst" i zaliczał tę pozycję
                           do grupy „TextBlock 13 px" z §18.0.5/3 — ⚠ zmierzone: to NIE jest tekst. `Text` jest
                           bindowany do `PrivilegeStateGlyphConverter`, który zwraca „✓" albo „✓+", wewnątrz
                           przycisku `Button.priv-cell` o `Width=20` / `Height=18`. To GLIF strojony do
                           KONTENERA, czyli reguła #10 działająca poprawnie — dokładnie ta sama zasada, którą
                           komentarz przy `Button.bulk-glyph` w tym samym pliku stosuje do swoich 12 px.
                           ⭐ R12: wartość miała powód, powód był nieprawdziwy — i to on wymagał naprawy,
                           a nie wartość. Grupa z §18.0.5/3 opisywała pod jedną nazwą dwie różne rzeczy. -->
                      <TextBlock FontWeight="Bold" FontSize="13"
                                 Text="{Binding UpdateState, Converter={x:Static conv:PrivilegeStateGlyphConverter.Instance}}">
                        <TextBlock.Foreground>
                          <MultiBinding Converter="{x:Static conv:PrivilegeStateBrushConverter.Instance}">
                            <Binding Path="UpdateState" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </TextBlock.Foreground>
                      </TextBlock>
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn Width="96" MinWidth="88">
                <DataGridTemplateColumn.Header>
                  <StackPanel Spacing="2" HorizontalAlignment="Center">
                    <TextBlock Text="{app:Loc SecurityColDelete}" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="1" HorizontalAlignment="Center">
                      <Button Classes="bulk-glyph" CommandParameter="D" ToolTip.Tip="{app:Loc SecurityColGrantTip}"
                              Command="{Binding DataContext.Privileges.GrantColumnCommand, ElementName=RootControl}">
                        <TextBlock Text="{app:Loc SecurityGrantGlyph}" FontWeight="Bold" Foreground="{DynamicResource SuccessIconBrush}" />
                      </Button>
                      <Button Classes="bulk-glyph" CommandParameter="D" ToolTip.Tip="{app:Loc SecurityColGrantOptionTip}"
                              Command="{Binding DataContext.Privileges.GrantColumnWithOptionCommand, ElementName=RootControl}">
                        <TextBlock Text="{app:Loc SecurityGrantOptionGlyph}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                      </Button>
                      <Button Classes="bulk-glyph" CommandParameter="D" ToolTip.Tip="{app:Loc SecurityColRevokeTip}"
                              Command="{Binding DataContext.Privileges.RevokeColumnCommand, ElementName=RootControl}">
                        <TextBlock Text="{app:Loc SecurityRevokeGlyph}" FontWeight="Bold" Foreground="{DynamicResource DangerIconBrush}" />
                      </Button>
                    </StackPanel>
                  </StackPanel>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:PrivilegeRowViewModel">
                    <Button Classes="priv-cell" IsVisible="{Binding CanDelete}"
                            Command="{Binding CycleCommand}" CommandParameter="D"
                            ToolTip.Tip="{app:Loc SecurityPrivilegeLegend}">
                      <!-- ⭐ Q3/C ZAMKNIĘTE (M4.3): 13 px ZOSTAJE, ale POWÓD BYŁ ZAPISANY BŁĘDNIE i to jest
                           tu jedyna zmiana. Dawny komentarz twierdził „a to jest tekst" i zaliczał tę pozycję
                           do grupy „TextBlock 13 px" z §18.0.5/3 — ⚠ zmierzone: to NIE jest tekst. `Text` jest
                           bindowany do `PrivilegeStateGlyphConverter`, który zwraca „✓" albo „✓+", wewnątrz
                           przycisku `Button.priv-cell` o `Width=20` / `Height=18`. To GLIF strojony do
                           KONTENERA, czyli reguła #10 działająca poprawnie — dokładnie ta sama zasada, którą
                           komentarz przy `Button.bulk-glyph` w tym samym pliku stosuje do swoich 12 px.
                           ⭐ R12: wartość miała powód, powód był nieprawdziwy — i to on wymagał naprawy,
                           a nie wartość. Grupa z §18.0.5/3 opisywała pod jedną nazwą dwie różne rzeczy. -->
                      <TextBlock FontWeight="Bold" FontSize="13"
                                 Text="{Binding DeleteState, Converter={x:Static conv:PrivilegeStateGlyphConverter.Instance}}">
                        <TextBlock.Foreground>
                          <MultiBinding Converter="{x:Static conv:PrivilegeStateBrushConverter.Instance}">
                            <Binding Path="DeleteState" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </TextBlock.Foreground>
                      </TextBlock>
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn Width="122" MinWidth="112">
                <DataGridTemplateColumn.Header>
                  <StackPanel Spacing="2" HorizontalAlignment="Center">
                    <TextBlock Text="{app:Loc SecurityColReferences}" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="1" HorizontalAlignment="Center">
                      <Button Classes="bulk-glyph" CommandParameter="R" ToolTip.Tip="{app:Loc SecurityColGrantTip}"
                              Command="{Binding DataContext.Privileges.GrantColumnCommand, ElementName=RootControl}">
                        <TextBlock Text="{app:Loc SecurityGrantGlyph}" FontWeight="Bold" Foreground="{DynamicResource SuccessIconBrush}" />
                      </Button>
                      <Button Classes="bulk-glyph" CommandParameter="R" ToolTip.Tip="{app:Loc SecurityColGrantOptionTip}"
                              Command="{Binding DataContext.Privileges.GrantColumnWithOptionCommand, ElementName=RootControl}">
                        <TextBlock Text="{app:Loc SecurityGrantOptionGlyph}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                      </Button>
                      <Button Classes="bulk-glyph" CommandParameter="R" ToolTip.Tip="{app:Loc SecurityColRevokeTip}"
                              Command="{Binding DataContext.Privileges.RevokeColumnCommand, ElementName=RootControl}">
                        <TextBlock Text="{app:Loc SecurityRevokeGlyph}" FontWeight="Bold" Foreground="{DynamicResource DangerIconBrush}" />
                      </Button>
                    </StackPanel>
                  </StackPanel>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:PrivilegeRowViewModel">
                    <Button Classes="priv-cell" IsVisible="{Binding CanReferences}"
                            Command="{Binding CycleCommand}" CommandParameter="R"
                            ToolTip.Tip="{app:Loc SecurityPrivilegeLegend}">
                      <!-- ⭐ Q3/C ZAMKNIĘTE (M4.3): 13 px ZOSTAJE, ale POWÓD BYŁ ZAPISANY BŁĘDNIE i to jest
                           tu jedyna zmiana. Dawny komentarz twierdził „a to jest tekst" i zaliczał tę pozycję
                           do grupy „TextBlock 13 px" z §18.0.5/3 — ⚠ zmierzone: to NIE jest tekst. `Text` jest
                           bindowany do `PrivilegeStateGlyphConverter`, który zwraca „✓" albo „✓+", wewnątrz
                           przycisku `Button.priv-cell` o `Width=20` / `Height=18`. To GLIF strojony do
                           KONTENERA, czyli reguła #10 działająca poprawnie — dokładnie ta sama zasada, którą
                           komentarz przy `Button.bulk-glyph` w tym samym pliku stosuje do swoich 12 px.
                           ⭐ R12: wartość miała powód, powód był nieprawdziwy — i to on wymagał naprawy,
                           a nie wartość. Grupa z §18.0.5/3 opisywała pod jedną nazwą dwie różne rzeczy. -->
                      <TextBlock FontWeight="Bold" FontSize="13"
                                 Text="{Binding ReferencesState, Converter={x:Static conv:PrivilegeStateGlyphConverter.Instance}}">
                        <TextBlock.Foreground>
                          <MultiBinding Converter="{x:Static conv:PrivilegeStateBrushConverter.Instance}">
                            <Binding Path="ReferencesState" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </TextBlock.Foreground>
                      </TextBlock>
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn Width="102" MinWidth="94">
                <DataGridTemplateColumn.Header>
                  <StackPanel Spacing="2" HorizontalAlignment="Center">
                    <TextBlock Text="{app:Loc SecurityColExecute}" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="1" HorizontalAlignment="Center">
                      <Button Classes="bulk-glyph" CommandParameter="X" ToolTip.Tip="{app:Loc SecurityColGrantTip}"
                              Command="{Binding DataContext.Privileges.GrantColumnCommand, ElementName=RootControl}">
                        <TextBlock Text="{app:Loc SecurityGrantGlyph}" FontWeight="Bold" Foreground="{DynamicResource SuccessIconBrush}" />
                      </Button>
                      <Button Classes="bulk-glyph" CommandParameter="X" ToolTip.Tip="{app:Loc SecurityColGrantOptionTip}"
                              Command="{Binding DataContext.Privileges.GrantColumnWithOptionCommand, ElementName=RootControl}">
                        <TextBlock Text="{app:Loc SecurityGrantOptionGlyph}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                      </Button>
                      <Button Classes="bulk-glyph" CommandParameter="X" ToolTip.Tip="{app:Loc SecurityColRevokeTip}"
                              Command="{Binding DataContext.Privileges.RevokeColumnCommand, ElementName=RootControl}">
                        <TextBlock Text="{app:Loc SecurityRevokeGlyph}" FontWeight="Bold" Foreground="{DynamicResource DangerIconBrush}" />
                      </Button>
                    </StackPanel>
                  </StackPanel>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:PrivilegeRowViewModel">
                    <Button Classes="priv-cell" IsVisible="{Binding CanExecute}"
                            Command="{Binding CycleCommand}" CommandParameter="X"
                            ToolTip.Tip="{app:Loc SecurityPrivilegeLegend}">
                      <!-- ⭐ Q3/C ZAMKNIĘTE (M4.3): 13 px ZOSTAJE, ale POWÓD BYŁ ZAPISANY BŁĘDNIE i to jest
                           tu jedyna zmiana. Dawny komentarz twierdził „a to jest tekst" i zaliczał tę pozycję
                           do grupy „TextBlock 13 px" z §18.0.5/3 — ⚠ zmierzone: to NIE jest tekst. `Text` jest
                           bindowany do `PrivilegeStateGlyphConverter`, który zwraca „✓" albo „✓+", wewnątrz
                           przycisku `Button.priv-cell` o `Width=20` / `Height=18`. To GLIF strojony do
                           KONTENERA, czyli reguła #10 działająca poprawnie — dokładnie ta sama zasada, którą
                           komentarz przy `Button.bulk-glyph` w tym samym pliku stosuje do swoich 12 px.
                           ⭐ R12: wartość miała powód, powód był nieprawdziwy — i to on wymagał naprawy,
                           a nie wartość. Grupa z §18.0.5/3 opisywała pod jedną nazwą dwie różne rzeczy. -->
                      <TextBlock FontWeight="Bold" FontSize="13"
                                 Text="{Binding ExecuteState, Converter={x:Static conv:PrivilegeStateGlyphConverter.Instance}}">
                        <TextBlock.Foreground>
                          <MultiBinding Converter="{x:Static conv:PrivilegeStateBrushConverter.Instance}">
                            <Binding Path="ExecuteState" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </TextBlock.Foreground>
                      </TextBlock>
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn Width="92" MinWidth="84">
                <DataGridTemplateColumn.Header>
                  <StackPanel Spacing="2" HorizontalAlignment="Center">
                    <TextBlock Text="{app:Loc SecurityColUsage}" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="1" HorizontalAlignment="Center">
                      <Button Classes="bulk-glyph" CommandParameter="G" ToolTip.Tip="{app:Loc SecurityColGrantTip}"
                              Command="{Binding DataContext.Privileges.GrantColumnCommand, ElementName=RootControl}">
                        <TextBlock Text="{app:Loc SecurityGrantGlyph}" FontWeight="Bold" Foreground="{DynamicResource SuccessIconBrush}" />
                      </Button>
                      <Button Classes="bulk-glyph" CommandParameter="G" ToolTip.Tip="{app:Loc SecurityColGrantOptionTip}"
                              Command="{Binding DataContext.Privileges.GrantColumnWithOptionCommand, ElementName=RootControl}">
                        <TextBlock Text="{app:Loc SecurityGrantOptionGlyph}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                      </Button>
                      <Button Classes="bulk-glyph" CommandParameter="G" ToolTip.Tip="{app:Loc SecurityColRevokeTip}"
                              Command="{Binding DataContext.Privileges.RevokeColumnCommand, ElementName=RootControl}">
                        <TextBlock Text="{app:Loc SecurityRevokeGlyph}" FontWeight="Bold" Foreground="{DynamicResource DangerIconBrush}" />
                      </Button>
                    </StackPanel>
                  </StackPanel>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:PrivilegeRowViewModel">
                    <Button Classes="priv-cell" IsVisible="{Binding CanUsage}"
                            Command="{Binding CycleCommand}" CommandParameter="G"
                            ToolTip.Tip="{app:Loc SecurityPrivilegeLegend}">
                      <!-- ⭐ Q3/C ZAMKNIĘTE (M4.3): 13 px ZOSTAJE, ale POWÓD BYŁ ZAPISANY BŁĘDNIE i to jest
                           tu jedyna zmiana. Dawny komentarz twierdził „a to jest tekst" i zaliczał tę pozycję
                           do grupy „TextBlock 13 px" z §18.0.5/3 — ⚠ zmierzone: to NIE jest tekst. `Text` jest
                           bindowany do `PrivilegeStateGlyphConverter`, który zwraca „✓" albo „✓+", wewnątrz
                           przycisku `Button.priv-cell` o `Width=20` / `Height=18`. To GLIF strojony do
                           KONTENERA, czyli reguła #10 działająca poprawnie — dokładnie ta sama zasada, którą
                           komentarz przy `Button.bulk-glyph` w tym samym pliku stosuje do swoich 12 px.
                           ⭐ R12: wartość miała powód, powód był nieprawdziwy — i to on wymagał naprawy,
                           a nie wartość. Grupa z §18.0.5/3 opisywała pod jedną nazwą dwie różne rzeczy. -->
                      <TextBlock FontWeight="Bold" FontSize="13"
                                 Text="{Binding UsageState, Converter={x:Static conv:PrivilegeStateGlyphConverter.Instance}}">
                        <TextBlock.Foreground>
                          <MultiBinding Converter="{x:Static conv:PrivilegeStateBrushConverter.Instance}">
                            <Binding Path="UsageState" />
                            <Binding ElementName="RootControl" Path="ActualThemeVariant" />
                          </MultiBinding>
                        </TextBlock.Foreground>
                      </TextBlock>
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <!-- Column-level privileges (Tables category only) -->
          <Border Grid.Row="3" Margin="0,8,0,0" IsVisible="{Binding Privileges.ShowColumnPanel}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Surface}">
            <Grid RowDefinitions="Auto,Auto">
              <TextBlock Grid.Row="0" Margin="8,6" Classes="field-label"
                         Text="{Binding Privileges.ColumnPanelHeader}" />
              <TextBlock Grid.Row="1" Margin="8,2,8,10"
                         IsVisible="{Binding Privileges.ShowColumnHint}"
                         Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="{DynamicResource Text.Compact.Size}"
                         Text="{app:Loc SecurityColumnHint}" />
              <DataGrid Grid.Row="1" Height="150" Classes="checkbox-grid"
                        IsVisible="{Binding Privileges.HasColumnTable}"
                        ItemsSource="{Binding Privileges.Columns}"
                        IsReadOnly="True" CanUserResizeColumns="True" GridLinesVisibility="All"
                        AutoGenerateColumns="False">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="{app:Loc SecurityColColumn}" Binding="{Binding ColumnName}" Width="*" MinWidth="160" />
                  <DataGridTemplateColumn Header="{app:Loc SecurityColUpdate}" Width="90" MinWidth="70">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:ColumnPrivilegeRowViewModel">
                        <CheckBox IsChecked="{Binding Update, Mode=TwoWay}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="{app:Loc SecurityColReferences}" Width="110" MinWidth="90">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:ColumnPrivilegeRowViewModel">
                        <CheckBox IsChecked="{Binding References, Mode=TwoWay}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>

    <!-- Error banner — the IDE's ONE message surface (UX Polish Seam 4). -->
    <controls:MessageBanner Grid.Row="1" Classes="docked"
                            IsVisible="{Binding HasError}"
                            Severity="Error" Message="{Binding ErrorMessage}" />
  </Grid>
</UserControl>
