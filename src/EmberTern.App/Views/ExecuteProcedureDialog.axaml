<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:EmberTern.App"
        xmlns:controls="using:EmberTern.App.Controls"
        xmlns:vm="using:EmberTern.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="EmberTern.App.Views.ExecuteProcedureDialog"
        x:DataType="vm:ExecuteProcedureDialogViewModel"
        Title="{x:Static app:UiStrings.ProcedureExecuteDialogTitle}"
        Width="660"
        SizeToContent="Height"
        MaxHeight="720"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">

  <Window.Styles>
    <!-- Invalid time entry: red border, no hardcoded color. -->
    <Style Selector="TextBox.time-error">
      <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox.time-error:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

    <Border Grid.Row="0"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="20,16">
      <TextBlock Text="{x:Static app:UiStrings.ProcedureExecuteDialogTitle}" Classes="h1" />
    </Border>

    <!-- History dropdown (hidden until there's at least one saved set). Selecting an
         entry loads its values into the parameter grid; the newest is auto-selected. -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="16,12,16,4" IsVisible="{Binding HasHistory}">
      <TextBlock Grid.Column="0" Text="{x:Static app:UiStrings.ProcedureExecuteDialogHistoryLabel}"
                 Classes="field-label" VerticalAlignment="Center" Margin="0,0,10,0" />
      <ComboBox Grid.Column="1"
                ItemsSource="{Binding History}"
                SelectedItem="{Binding SelectedHistory, Mode=TwoWay}"
                HorizontalAlignment="Stretch" FontSize="11">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ParameterHistorySnapshotViewModel">
            <StackPanel Spacing="1" Margin="0,2">
              <TextBlock Text="{Binding TimestampText}" FontSize="11"
                         Foreground="{DynamicResource SubtleForegroundBrush}" />
              <TextBlock Text="{Binding PreviewText}" FontSize="11" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>

    <!-- Column headers -->
    <Grid Grid.Row="2" ColumnDefinitions="170,130,46,*" Margin="16,8,16,2">
      <TextBlock Grid.Column="0" Text="{x:Static app:UiStrings.ProcedureExecuteDialogColumnName}" Classes="field-label" />
      <TextBlock Grid.Column="1" Text="{x:Static app:UiStrings.ProcedureExecuteDialogColumnType}" Classes="field-label" />
      <TextBlock Grid.Column="2" Text="{x:Static app:UiStrings.ProcedureExecuteDialogColumnNull}" Classes="field-label" />
      <TextBlock Grid.Column="3" Text="{x:Static app:UiStrings.ProcedureExecuteDialogColumnValue}" Classes="field-label" />
    </Grid>

    <ScrollViewer Grid.Row="3" Margin="16,0,16,8" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Params}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ExecuteProcedureParamRowViewModel">
            <Grid ColumnDefinitions="170,130,46,*" Margin="0,3" MinHeight="30">
              <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding TypeText}" FontSize="11"
                         Foreground="{DynamicResource SubtleForegroundBrush}" VerticalAlignment="Center" />
              <CheckBox Grid.Column="2" IsChecked="{Binding IsNull, Mode=TwoWay}" VerticalAlignment="Center" />
              <Panel Grid.Column="3" VerticalAlignment="Center">
                <!-- CHAR / VARCHAR -->
                <TextBox IsVisible="{Binding IsSingleLineTextKind}" IsEnabled="{Binding IsValueEnabled}"
                         Text="{Binding TextValue, Mode=TwoWay}" FontSize="11" />
                <!-- BLOB (text / binary) -->
                <TextBox IsVisible="{Binding IsMultilineKind}" IsEnabled="{Binding IsValueEnabled}"
                         Text="{Binding TextValue, Mode=TwoWay}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" FontSize="11"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                <NumericUpDown IsVisible="{Binding IsNumericKind}" IsEnabled="{Binding IsValueEnabled}"
                               Value="{Binding NumericValue, Mode=TwoWay}" FontSize="11" />
                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsDateTimeKind}">
                  <CalendarDatePicker IsVisible="{Binding IsDateKind}"
                                      SelectedDate="{Binding DateValue, Mode=TwoWay}"
                                      IsEnabled="{Binding IsValueEnabled}" />
                  <!-- Time as free text (type 8 / 8:30 / 8:30:15); parsed on focus-loss + OK. -->
                  <TextBox IsVisible="{Binding IsTimeKind}" IsEnabled="{Binding IsValueEnabled}"
                           Text="{Binding TimeText, Mode=TwoWay}"
                           Classes.time-error="{Binding HasTimeError}"
                           Width="92" FontSize="11"
                           PlaceholderText="{x:Static app:UiStrings.ProcedureExecuteDialogTimeWatermark}"
                           GotFocus="OnTimeBoxGotFocus" LostFocus="OnTimeBoxLostFocus" />
                </StackPanel>
                <CheckBox IsVisible="{Binding IsBooleanKind}" IsEnabled="{Binding IsValueEnabled}"
                          IsChecked="{Binding BoolValue, Mode=TwoWay}" />
              </Panel>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Validation line (invalid time blocks Execute) — the IDE's ONE message surface (UX Polish Seam 4). -->
    <controls:MessageBanner Grid.Row="4" Margin="16,0,16,8"
                            Severity="Error" BorderThickness="1"
                            Message="{x:Static app:UiStrings.ProcedureExecuteDialogTimeInvalid}"
                            IsVisible="{Binding HasValidationError}" />

    <Border Grid.Row="5"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="20,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Classes="flat"
                Content="{x:Static app:UiStrings.DialogCancel}"
                Command="{Binding CancelCommand}" />
        <Button Classes="primary"
                Content="{x:Static app:UiStrings.ProcedureExecuteDialogRun}"
                Command="{Binding AcceptCommand}"
                IsDefault="True" />
      </StackPanel>
    </Border>

  </Grid>
</Window>
