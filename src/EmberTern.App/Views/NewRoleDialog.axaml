<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:EmberTern.App"
        xmlns:vm="using:EmberTern.App.ViewModels"
        x:Class="EmberTern.App.Views.NewRoleDialog"
        x:DataType="vm:NewRoleDialogViewModel"
        Title="{app:Loc SecurityRoleDialogTitle}"
        Width="400"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">

  <Grid RowDefinitions="Auto,Auto,Auto">
    <Border Grid.Row="0"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="20,14">
      <TextBlock Text="{app:Loc SecurityRoleDialogTitle}" Classes="h1" />
    </Border>

    <StackPanel Grid.Row="1" Margin="20,18" Spacing="6">
      <TextBlock Text="{app:Loc SecurityRoleNameLabel}" Classes="field-label" />
      <TextBox x:Name="NameBox" Text="{Binding RoleName}"
               PlaceholderText="{app:Loc SecurityRoleNameWatermark}"
               KeyDown="OnNameKeyDown" />
    </StackPanel>

    <Border Grid.Row="2"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="20,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Classes="flat" Content="{app:Loc SecurityDialogCancel}"
                Command="{Binding CancelCommand}" />
        <Button Classes="primary" Content="{app:Loc SecurityDialogOk}"
                Command="{Binding AcceptCommand}" IsDefault="True" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
