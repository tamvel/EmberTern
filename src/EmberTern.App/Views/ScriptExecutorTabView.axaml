<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:EmberTern.App"
             xmlns:vm="using:EmberTern.App.ViewModels"
             xmlns:controls="using:EmberTern.App.Controls"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
             x:Class="EmberTern.App.Views.ScriptExecutorTabView"
             x:DataType="vm:ScriptExecutorTabViewModel"
             Background="{DynamicResource BackgroundBrush}"
             Foreground="{DynamicResource ForegroundBrush}">

  <Grid RowDefinitions="Auto,*,4,240">

    <!-- Toolbar: Run / Stop · transaction mode + stop-on-error · Commit / Rollback -->
    <Border Grid.Row="0"
            Classes="chrome"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="10,8">
      <DockPanel LastChildFill="True">
        <!-- Live elapsed timer (shared ExecutionTimer) — RIGHT-ALIGNED status element (docked
             right, outside the button StackPanel) so it never shifts the toolbar buttons. -->
        <TextBlock DockPanel.Dock="Right" Text="{Binding ExecutionTimer.ElapsedDisplay}" FontSize="{DynamicResource Text.Compact.Size}"
                   FontFamily="Consolas,Menlo,monospace" Margin="8,0,4,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource SubtleForegroundBrush}"
                   IsVisible="{Binding ExecutionTimer.IsRunning}" />
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

        <Button Classes="primary" Command="{Binding RunCommand}"
                ToolTip.Tip="{x:Static app:UiStrings.ScriptRunTooltip}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <!-- ⭐ `Size.Icon` (14), nie `Size.Icon.Toolbar` (16): ta ikona stoi PRZY ETYKIECIE, więc
                 celem myszy jest przycisk, a nie ona. Dokładnie ta różnica, którą A‑3 nazwało w M4 —
                 samotna ikona w `Button.icon` obok bierze 16 z `ControlTheme`. Wartość bez zmiany. -->
            <controls:SvgIcon Data="{StaticResource Icon.Play}"
                              Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}"
                              Foreground="{DynamicResource OnAccentBrush}" />
            <TextBlock Text="{x:Static app:UiStrings.ScriptRun}" VerticalAlignment="Center" />
            <!-- ⭐ TA SAMA AKCJA, TEN SAM SKRÓT, TO SAMO ŹRÓDŁO. Run w Script Executorze to `CommandId.Go`
                 — dokładnie ta, którą pasek SQL Editora pokazuje jako „Execute F5". Chip czyta ten sam
                 `ToolbarExecuteHint` (czyli katalog komend), więc nie da się ich rozjechać: gest jest
                 zapisany w JEDNYM miejscu (gotcha #284). Zgłoszenie QA: „jeżeli Execute pokazuje F5,
                 Run również powinien — to jest ta sama akcja". -->
            <TextBlock Classes="shortcut-chip" Text="{x:Static app:UiStrings.ToolbarExecuteHint}" />
          </StackPanel>
        </Button>

        <Button Classes="icon" Command="{Binding StopCommand}"
                IsVisible="{Binding IsRunning}"
                ToolTip.Tip="{x:Static app:UiStrings.ScriptStopTooltip}">
          <controls:SvgIcon Data="{StaticResource Icon.Stop}" Foreground="{DynamicResource DangerIconBrush}" />
        </Button>

        <Border Width="1" Margin="4,2" Background="{DynamicResource BorderBrush}" />

        <TextBlock Text="{x:Static app:UiStrings.ScriptTransactionLabel}"
                   VerticalAlignment="Center" Foreground="{DynamicResource SubtleForegroundBrush}" />
        <ComboBox SelectedIndex="{Binding TransactionModeIndex, Mode=TwoWay}" MinWidth="200"
                  VerticalAlignment="Center"
                  ToolTip.Tip="{Binding SelectedModeDescription}">
          <ComboBoxItem Content="{x:Static app:UiStrings.ScriptModeManual}" />
          <ComboBoxItem Content="{x:Static app:UiStrings.ScriptModeAutoCommit}" />
          <ComboBoxItem Content="{x:Static app:UiStrings.ScriptModeSequenced}" />
        </ComboBox>
        <CheckBox Content="{x:Static app:UiStrings.ScriptStopOnError}"
                  IsChecked="{Binding StopOnError, Mode=TwoWay}" VerticalAlignment="Center" />

        <Border Width="1" Margin="4,2" Background="{DynamicResource BorderBrush}" />

        <Button Classes="flat" Command="{Binding CommitScriptCommand}"
                ToolTip.Tip="{x:Static app:UiStrings.ScriptCommitTooltip}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <!-- Role R‑2 / R‑3 na własnych tokenach (K7) — patrz MainWindow. Wygląd bez zmiany. -->
            <controls:SvgIcon Data="{StaticResource Icon.Check}"
                              Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}"
                              Foreground="{DynamicResource CommitButtonBrush}" />
            <TextBlock Text="{x:Static app:UiStrings.ScriptCommit}" />
          </StackPanel>
        </Button>
        <Button Classes="flat" Command="{Binding RollbackScriptCommand}"
                ToolTip.Tip="{x:Static app:UiStrings.ScriptRollbackTooltip}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <controls:SvgIcon Data="{StaticResource Icon.Undo}"
                              Width="{DynamicResource Size.Icon}" Height="{DynamicResource Size.Icon}"
                              Foreground="{DynamicResource RollbackButtonBrush}" />
            <TextBlock Text="{x:Static app:UiStrings.ScriptRollback}" />
          </StackPanel>
        </Button>

        <Border Width="1" Margin="4,2" Background="{DynamicResource BorderBrush}" />

        <Button Classes="icon" Command="{Binding OpenScriptCommand}"
                ToolTip.Tip="{x:Static app:UiStrings.ScriptOpenTooltip}">
          <controls:SvgIcon Data="{StaticResource Icon.Folder}" Foreground="{DynamicResource AccentBrush}" />
        </Button>
        <Button Classes="icon" Command="{Binding SaveScriptCommand}"
                ToolTip.Tip="{x:Static app:UiStrings.ScriptSaveTooltip}">
          <controls:SvgIcon Data="{StaticResource Icon.Save}" Foreground="{DynamicResource AccentBrush}" />
        </Button>

        <TextBlock Text="{x:Static app:UiStrings.ScriptTransactionOpenMarker}"
                   Margin="6,0,0,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource WarningBrush}"
                   IsVisible="{Binding TransactionOpen}" />
      </StackPanel>
      </DockPanel>
    </Border>

    <!-- Script editor (reuses SqlEditorBehavior for highlighting/autocomplete/find-replace). -->
    <ae:TextEditor Grid.Row="1" x:Name="ScriptEditor"
                   ShowLineNumbers="True"
                   FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                   FontSize="{DynamicResource Text.Code.Size}"
                   HorizontalScrollBarVisibility="Auto"
                   VerticalScrollBarVisibility="Auto"
                   Background="{DynamicResource BackgroundBrush}"
                   Foreground="{DynamicResource ForegroundBrush}" />

    <GridSplitter Grid.Row="2" ResizeDirection="Rows"
                  HorizontalAlignment="Stretch" Height="4"
                  Background="{DynamicResource BorderBrush}" />

    <!-- Results -->
    <Grid Grid.Row="3" RowDefinitions="Auto,*">
      <Border Grid.Row="0"
              Background="{DynamicResource PanelBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,1,0,0"
              Padding="10,6">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*">
          <TextBlock Grid.Column="0" Text="{x:Static app:UiStrings.BatchResultsFilterLabel}"
                     VerticalAlignment="Center" Margin="0,0,6,0"
                     Foreground="{DynamicResource SubtleForegroundBrush}" />
          <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedFilterIndex, Mode=TwoWay}"
                    MinWidth="110" VerticalAlignment="Center">
            <ComboBoxItem Content="{x:Static app:UiStrings.BatchResultsFilterAll}" />
            <ComboBoxItem Content="{x:Static app:UiStrings.BatchResultsFilterSuccess}" />
            <ComboBoxItem Content="{x:Static app:UiStrings.BatchResultsFilterFailed}" />
          </ComboBox>
          <Button Grid.Column="2" Classes="flat" Margin="8,0,0,0"
                  Content="{x:Static app:UiStrings.BatchResultsCopyAll}"
                  Command="{Binding CopyAllCommand}" IsEnabled="{Binding HasResults}" />
          <Button Grid.Column="3" Classes="flat"
                  Content="{x:Static app:UiStrings.BatchResultsCopyFailed}"
                  Command="{Binding CopyFailedCommand}" IsEnabled="{Binding HasResults}" />
          <TextBlock Grid.Column="4" Text="{Binding StatusText}"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     Margin="12,0,0,0"
                     Classes.error="{Binding HasError}">
            <!-- UX Polish Seam 4 — the local DangerIconBrush override is gone: an error message reads in
                 ErrorBrush everywhere in the IDE (DangerIconBrush is for destructive-action ICONS). The
                 shared ":is(TextBlock).error" style in ControlStyles.axaml now supplies it. -->
          </TextBlock>
        </Grid>
      </Border>

      <Panel Grid.Row="1">
      <DataGrid x:Name="ResultsGrid"
                ItemsSource="{Binding Rows}"
                IsReadOnly="True"
                CanUserSortColumns="False"
                CanUserResizeColumns="True"
                GridLinesVisibility="Horizontal"
                DoubleTapped="OnResultsDoubleTapped">
        <DataGrid.Styles>
          <Style Selector="TextBlock.result-ok">
            <Setter Property="Foreground" Value="{DynamicResource SuccessIconBrush}" />
          </Style>
          <Style Selector="TextBlock.result-failed">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
          </Style>
          <!-- Sequenced: a statement a stop / cancellation never reached — muted, neither OK nor failed. -->
          <Style Selector="TextBlock.result-notrun">
            <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}" />
            <Setter Property="FontStyle" Value="Italic" />
          </Style>
          <!-- Sequenced per-step outcome (Step cell): committed = green, rolled back = amber. -->
          <Style Selector="TextBlock.step-committed">
            <Setter Property="Foreground" Value="{DynamicResource SuccessIconBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
          </Style>
          <Style Selector="TextBlock.step-rolledback">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
          </Style>
        </DataGrid.Styles>
        <DataGrid.Columns>
          <DataGridTextColumn Header="{x:Static app:UiStrings.ScriptColumnLine}"
                              Binding="{Binding Line}" Width="46" />
          <DataGridTemplateColumn Header="{x:Static app:UiStrings.ScriptColumnStep}" Width="52">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:ScriptResultRowViewModel">
                <TextBlock Text="{Binding StepText}" VerticalAlignment="Center" Margin="8,0"
                           ToolTip.Tip="{Binding StepStatusTooltip}"
                           Classes.step-committed="{Binding IsStepCommitted}"
                           Classes.step-rolledback="{Binding IsStepRolledBack}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="{x:Static app:UiStrings.ScriptColumnStatement}"
                              Binding="{Binding Statement}" Width="2*" MinWidth="220"
                              FontFamily="Cascadia Code,Consolas,Menlo,monospace" />
          <DataGridTextColumn Header="{x:Static app:UiStrings.ScriptColumnType}"
                              Binding="{Binding TypeText}" Width="140" />
          <DataGridTemplateColumn Header="{x:Static app:UiStrings.ScriptColumnResult}" Width="80">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:ScriptResultRowViewModel">
                <TextBlock Text="{Binding Result}" VerticalAlignment="Center" Margin="8,0"
                           ToolTip.Tip="{Binding ResultTooltip}"
                           Classes.result-failed="{Binding IsFailed}"
                           Classes.result-ok="{Binding IsSucceeded}"
                           Classes.result-notrun="{Binding IsNotRun}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="{x:Static app:UiStrings.ScriptColumnRows}"
                              Binding="{Binding RowsText}" Width="70" />
          <DataGridTextColumn Header="{x:Static app:UiStrings.ScriptColumnDuration}"
                              Binding="{Binding Duration}" Width="90" />
          <DataGridTextColumn Header="{x:Static app:UiStrings.ScriptColumnError}"
                              Binding="{Binding Error}" Width="2*" MinWidth="160" />
        </DataGrid.Columns>
      </DataGrid>

        <!-- ══ STANY PUSTE SIATKI WYNIKÓW — M5 / M‑3, B6 ═══════════════════════════════════════════
             ⭐⭐ DWA, I TO ROZRÓŻNIENIE NIE JEST NASZE — model niósł je na długo przed M‑3: `HasResults`
             liczy się z `_allRows` (PRZED filtrem), a siatka wiąże się z `Rows` (PO filtrze). Jeden
             komunikat mówiłby „uruchom skrypt" komuś, kto właśnie go uruchomił i tylko przełączył filtr
             na „Failed".
             ⚠ Druga treść świadomie powtarza język Session Managera i Trace Monitora — ta sama sytuacja
             ma brzmieć tak samo niezależnie od ekranu. -->
        <TextBlock Text="{x:Static app:UiStrings.ScriptResultsEmpty}"
                   IsVisible="{Binding ShowNoResults}"
                   IsHitTestVisible="False"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Margin="{DynamicResource Pad.Panel}"
                   TextWrapping="Wrap" TextAlignment="Center"
                   Foreground="{DynamicResource SubtleForegroundBrush}"
                   FontSize="{DynamicResource Text.Application.Size}" />
        <TextBlock Text="{x:Static app:UiStrings.ScriptResultsNoFilterMatch}"
                   IsVisible="{Binding ShowNoFilterMatch}"
                   IsHitTestVisible="False"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Margin="{DynamicResource Pad.Panel}"
                   TextWrapping="Wrap" TextAlignment="Center"
                   Foreground="{DynamicResource SubtleForegroundBrush}"
                   FontSize="{DynamicResource Text.Application.Size}" />
      </Panel>
    </Grid>
  </Grid>
</UserControl>
