<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:EmberTern.App"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="EmberTern.App.Views.ThirdPartyNoticesWindow"
        Title="{app:Loc ThirdPartyNoticesTitle}"
        Width="760" Height="600"
        MinWidth="480" MinHeight="320"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">

  <!-- The notices document, verbatim. Read-only, scrollable, selectable so a reviewer can copy any part of
       it, and resizable because licence texts are long — unlike About, which is a fixed composition.
       Monospace: section 1 is an aligned column layout and a proportional font would break it.

       Wrapped, not horizontally scrolled: a licence paragraph is one very long line, and a notice the reader
       has to scroll sideways to finish is a notice they do not read. ⚠ The two settings are ONE decision —
       `TextWrapping="Wrap"` alone does nothing here, because a ScrollViewer offering a horizontal scrollbar
       measures its child with infinite width, so there is no width to wrap against; the horizontal bar must be
       Disabled for the wrap to take effect. Section 1's column alignment survives at the default window width
       and degrades gracefully (it re-flows) when the window is narrowed, which is the right trade. -->
  <Grid RowDefinitions="*,Auto">

    <ScrollViewer Grid.Row="0"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  Padding="20,16,16,16">
      <SelectableTextBlock x:Name="NoticesText"
                           FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                           FontSize="{DynamicResource Text.Application.Size}"
                           LineHeight="17"
                           TextWrapping="Wrap" />
    </ScrollViewer>

    <Border Grid.Row="1"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="20,12">
      <Button Classes="flat"
              Content="{app:Loc AboutClose}"
              Click="OnCloseClick"
              IsDefault="True"
              IsCancel="True"
              HorizontalAlignment="Right" />
    </Border>

  </Grid>
</Window>
