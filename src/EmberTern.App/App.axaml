<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EmberTern.App.App"
             RequestedThemeVariant="Dark">
  <!-- ⚠ Dark here is the BOOTSTRAP value, not the user's preference, and it must stay. The stored theme is
       read and applied in App.OnFrameworkInitializationCompleted; this is what the framework holds until that
       line runs. Delete it and the value in between is ThemeVariant.Default, which follows the OS theme — a
       silent behaviour change that reads like a regression. It agrees with PreferenceOptions.Theme.Default. -->

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- ⭐ Tokens/Typography PRZED Colors: warstwa niekolorowa (odstępy, wysokości, ikony,
             promienie, krawędzie) i typograficzna nie zależą od motywu — nie mają `ThemeDictionaries`
             i są identyczne w Light i Dark. Kolejność nie zmienia rozstrzygania kluczy (żaden się nie
             powtarza), ale utrwala czytelność: najpierw metryka, potem barwa. -->
        <ResourceInclude Source="avares://EmberTern/Themes/Tokens.axaml" />
        <ResourceInclude Source="avares://EmberTern/Themes/Typography.axaml" />
        <ResourceInclude Source="avares://EmberTern/Themes/Colors.axaml" />
        <!-- ⚠ FluentBridge PO Colors: mapuje zasoby FluentTheme na nasze KOLORY przez
             `Color="{StaticResource …Color}"`, więc tokeny barw muszą być już wczytane. -->
        <ResourceInclude Source="avares://EmberTern/Themes/FluentBridge.axaml" />
        <ResourceInclude Source="avares://EmberTern/Themes/IconGeometries.axaml" />
        <!-- ⭐⭐ IconControlThemes PO IconGeometries, i to jest ta sama reguła co niżej: motyw CreateIcon
             sięga po `{StaticResource Icon.Play}`.

             ⚠ DLACZEGO TE DWA PLIKI SĄ OSOBNE (2026-08-16). `IconGeometries.axaml` to 86 czystych
             `StreamGeometry` — dane i nic więcej. Trzy `ControlTheme`, które stąd wyszły, były JEDYNYM
             w tamtym pliku odwołaniem do TYPU (`controls:SvgIcon` / `DebuggerIcon` / `CreateIcon`), i to
             ono czyniło cały słownik nielinkowalnym z drugiej aplikacji. EmberTern License Manager
             potrzebuje ikon i ⛔ nie może nabyć kontrolek `EmberTern.App`
             (`docs/design/licensing-system.md` §12.1) — po rozdzieleniu linkuje sobie samą połowę
             danych. Jedno źródło każdej ikony dla dwóch aplikacji, zamiast kopii, która zdryfuje przy
             pierwszej dołożonej ikonie. -->
        <ResourceInclude Source="avares://EmberTern/Themes/IconControlThemes.axaml" />
        <!-- ⚠ ControlThemes PO IconGeometries: szablon CheckBoxa sięga po `{StaticResource Icon.Check}`,
             a `StaticResource` rozwiązuje się przy wczytywaniu — geometria musi już tu być. -->
        <ResourceInclude Source="avares://EmberTern/Themes/ControlThemes.axaml" />
        <ResourceInclude Source="avares://EmberTern/Themes/SearchableComboBox.axaml" />
        <ResourceInclude Source="avares://EmberTern/Themes/PickerTemplates.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <StyleInclude Source="avares://EmberTern/Themes/ControlStyles.axaml" />
  </Application.Styles>
</Application>
