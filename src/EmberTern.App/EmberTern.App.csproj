<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>EmberTern.App</RootNamespace>
    <AssemblyName>EmberTern</AssemblyName>
    <ApplicationIcon>Assets\Branding\EmberTern.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- Icon SVGs are source-of-truth only (repo). Runtime renders the geometries
         in Themes/IconGeometries.axaml, so the .svg files are excluded from the
         build output — zero app-size impact. The ICONS.md catalog is also docs-only. -->
    <AvaloniaResource Remove="Assets\Icons\**\*.svg" />
    <AvaloniaResource Remove="Assets\Icons\**\*.md" />
    <!-- Same rule for branding. Assets\Branding\Masters\ holds the SOURCE artwork the shipped files are
         rendered from (see Assets/Branding/BRANDING.md) — multi-megabyte originals with no avares
         reference anywhere. Only EmberTern.ico (the OS icon) and EmberTern_logo.png (the mark About
         shows) ship.
         ⭐ The exclusion is the whole FOLDER, not a list of filenames, and that is deliberate: the two
         masters are different artwork with different jobs, and a third one will arrive the same way.
         A per-file rule is something the next person has to remember; a folder rule cannot be forgotten,
         and the failure it prevents is silent — a forgotten master simply ships, costing 1.5 MB with
         nothing to show for it.
         ⚠ Do NOT "fix" this by adding an <AvaloniaResource Include="Assets\Branding\**" /> — the
         Assets\** include above already covers the folder, and a second more-specific include fails
         the build as a duplicate item (NETSDK1022) under TreatWarningsAsErrors. -->
    <AvaloniaResource Remove="Assets\Branding\Masters\**" />
    <AvaloniaResource Remove="Assets\Branding\**\*.md" />
  </ItemGroup>

  <!-- Third-party notices. Required, not a courtesy: MIT alone obliges us to include its copyright and
       permission notice "in all copies", and FirebirdSql.Data.FirebirdClient is IDPL 1.0, whose §3.6 wants a
       source-availability notice with any executable distribution.

       It ships TWICE on purpose, and each copy has a job: embedded in the assembly so the application can
       show it with no file-system dependency (About → Third-party notices), and beside the executable so a
       reviewer, a packager or an auditor finds it without launching anything. One file at the repository root
       is the single source for both.

       ⚠ A plain EmbeddedResource with an explicit LogicalName, deliberately NOT an AvaloniaResource. Both
       embed the file, but Avalonia's asset system needs a live Avalonia application to read from — so the
       notices could only be loaded (and tested) inside a headless UI session, for a plain text file that has
       nothing to do with the UI framework. GetManifestResourceStream needs nothing, and LogicalName makes the
       name explicit instead of derived from a linked path outside the project directory. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.txt" LogicalName="EmberTern.THIRD-PARTY-NOTICES.txt" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- ⚠⚠ ZOSTAJE NA 12.0.0 SPECJALNIE, przy corze 12.1.1 — i ten komentarz jest JEDYNYM sygnałem, jaki
         dostaniesz. Wersji 12.1.x AvaloniaEdit po prostu nie ma; jego zależność to `Avalonia (>= 12.0.0)`,
         więc NuGet spełnia ją corem 12.1.1 BEZ SŁOWA OSTRZEŻENIA: build wychodzi 0/0, a suite jest zielona,
         bo nasze testy headless asertują właściwości i pędzle, nie piksele.
         ⭐ A 12.1 rusza dokładnie ten stos, na którym AvaloniaEdit stoi: `Rework text fallback itemization`,
         `TextRunCache`, `Preserve lines at rounded fractional heights` (#21834), `line break enumerator`,
         `Padding` w `ScrollContentPresenter` (#21872). Na `TextView` i `GetRectsForSegment` wisi u nas sześć
         `IBackgroundRenderer`ów, `BreakpointMargin` z własnym hit-testem, `InlineValuesRenderer` (rysuje
         w pustym miejscu ZA końcem linii, czyli czyta geometrię linii), cztery karty w `OverlayLayer`,
         `SqlIndentationStrategy` i jedenaście read-only preview DDL.
         ⛔ Podniesienie tego pakietu jest zadaniem z WŁASNYM QA WZROKOWYM edytora — nie „przy okazji".
         Decyzja ratyfikowana 2026-08-05 (D-3); zakres, ryzyko R1 i checklista:
         docs/design/avalonia-12.1.1-update.md. Gotcha #321. -->
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <!-- ⚠ NUMER NIE ZGADZA SIĘ Z COREM CELOWO. DataGrid został wyprowadzony z głównego repo Avalonii do
         własnego i ma własny cykl wydań: przy corze 12.1.1 najnowszy DataGrid to 12.1.2, a DataGrida
         12.1.1 po prostu NIE MA. Zależność pakietu to `Avalonia (>= 12.1.0)`, więc kombinacja jest
         legalna. ⛔ Nie „naprawiać" tego przez zejście do 12.1.0 — to kupuje wygląd spójności zamiast
         spójności, oddając dwa patche.
         ⚠⚠ Pakiet jest OFICJALNIE DEPRECATED („DataGrid is deprecated and only receives bug fixes",
         rekomendacja: TableView dla read-only, TreeDataGrid dla edycji). U nas to 53 pliki / 559
         wystąpień w AXAML, więc migracja jest osobną decyzją produktową — NIE tematem aktualizacji
         frameworka i NIE tematem M4. Zapis: docs/design/avalonia-12.1.1-update.md §3 R4. -->
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <!-- DPAPI (ProtectedData) for encrypting connection passwords at rest. Not part of the BCL on
         .NET Core+; this Microsoft-owned package supplies it.
         ⭐ FAZA 6 (2026-08-15): 9.0.0 → 10.0.11, najnowsza stabilna. Poprzedni komentarz trzymał to na
         9.0.0 głównie argumentem „nasz TFM to net9.0, więc pasmo 9.0.x" — ten argument został ZMIERZONY
         i jest nieprawdziwy dla 10.0.11: pakiet zawiera realny asset `lib/net9.0`, więc na net9.0
         dostajemy binarkę celowaną w net9.0, a nie fallback na netstandard2.0. Zostaje natomiast w mocy
         powód, dla którego ten pakiet w ogóle wymaga uwagi: ⭐ leży na ścieżce reguły #11 — wykonuje
         `Protect`/`Unprotect` na `settings.dat`, czyli na profilach połączeń i hasłach. Dlatego
         aktualizacja jest domknięta CELOWANĄ weryfikacją round-tripu szyfrowania (testy magazynu
         ustawień i profili), a nie samym zielonym buildem. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EmberTern.Core\EmberTern.Core.csproj" />
    <!-- ⭐ The licence VERIFIER only. ⛔ `EmberTern.Licensing.Issuing` — which can sign — is not referenced
         here, is not in `EmberTern.slnx`, and six `PrivateKeyNeverShipsTests` fail the build if either
         changes. Licensing is a pure assembly: zero package references, zero `System.Net.*`, and
         `LicensingMakesNoNetworkCallsTests` is the machine-checkable form of decision D1 (V1 is offline). -->
    <ProjectReference Include="..\EmberTern.Licensing\EmberTern.Licensing.csproj" />
    <ProjectReference Include="..\EmberTern.Office\EmberTern.Office.csproj" />
    <ProjectReference Include="..\EmberTern.Firebird\EmberTern.Firebird.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EmberTern.Tests" />
  </ItemGroup>
</Project>
