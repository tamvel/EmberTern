<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>EmberTern.App</RootNamespace>
    <AssemblyName>EmberTern</AssemblyName>
    <ApplicationIcon>Assets\Branding\EmberTern.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- Icon SVGs are source-of-truth only (repo). Runtime renders the geometries
         in Themes/IconGeometries.axaml, so the .svg files are excluded from the
         build output — zero app-size impact. The ICONS.md catalog is also docs-only. -->
    <AvaloniaResource Remove="Assets\Icons\**\*.svg" />
    <AvaloniaResource Remove="Assets\Icons\**\*.md" />
    <!-- Same rule for branding. Assets\Branding\Masters\ holds the SOURCE artwork the shipped files are
         rendered from (see Assets/Branding/BRANDING.md) — multi-megabyte originals with no avares
         reference anywhere. Only EmberTern.ico (the OS icon) and EmberTern_logo.png (the mark About
         shows) ship.
         ⭐ The exclusion is the whole FOLDER, not a list of filenames, and that is deliberate: the two
         masters are different artwork with different jobs, and a third one will arrive the same way.
         A per-file rule is something the next person has to remember; a folder rule cannot be forgotten,
         and the failure it prevents is silent — a forgotten master simply ships, costing 1.5 MB with
         nothing to show for it.
         ⚠ Do NOT "fix" this by adding an <AvaloniaResource Include="Assets\Branding\**" /> — the
         Assets\** include above already covers the folder, and a second more-specific include fails
         the build as a duplicate item (NETSDK1022) under TreatWarningsAsErrors. -->
    <AvaloniaResource Remove="Assets\Branding\Masters\**" />
    <AvaloniaResource Remove="Assets\Branding\**\*.md" />
  </ItemGroup>

  <!-- Third-party notices. Required, not a courtesy: MIT alone obliges us to include its copyright and
       permission notice "in all copies", and FirebirdSql.Data.FirebirdClient is IDPL 1.0, whose §3.6 wants a
       source-availability notice with any executable distribution.

       It ships TWICE on purpose, and each copy has a job: embedded in the assembly so the application can
       show it with no file-system dependency (About → Third-party notices), and beside the executable so a
       reviewer, a packager or an auditor finds it without launching anything. One file at the repository root
       is the single source for both.

       ⚠ A plain EmbeddedResource with an explicit LogicalName, deliberately NOT an AvaloniaResource. Both
       embed the file, but Avalonia's asset system needs a live Avalonia application to read from — so the
       notices could only be loaded (and tested) inside a headless UI session, for a plain text file that has
       nothing to do with the UI framework. GetManifestResourceStream needs nothing, and LogicalName makes the
       name explicit instead of derived from a linked path outside the project directory. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.txt" LogicalName="EmberTern.THIRD-PARTY-NOTICES.txt" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.0.0" />
    <!-- DPAPI (ProtectedData) for encrypting connection passwords at rest. Not part
         of the BCL on .NET Core+; this Microsoft-owned package supplies it. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EmberTern.Core\EmberTern.Core.csproj" />
    <ProjectReference Include="..\EmberTern.Office\EmberTern.Office.csproj" />
    <ProjectReference Include="..\EmberTern.Firebird\EmberTern.Firebird.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EmberTern.Tests" />
  </ItemGroup>
</Project>
